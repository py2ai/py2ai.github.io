{
  "owner": "archlinux",
  "repo": "pacman",
  "branch": "master",
  "groups": [
    { "id": "frontend", "name": "frontend", "label": "CLI frontend (src/pacman)" },
    { "id": "api", "name": "api", "label": "public API & handle" },
    { "id": "engine", "name": "engine", "label": "dependency engine" },
    { "id": "ops", "name": "ops", "label": "package operations" },
    { "id": "store", "name": "store", "label": "database backends" },
    { "id": "net", "name": "net", "label": "download & sandbox" }
  ],
  "nodes": [
    { "id": "cli", "label": "pacman CLI", "file": "pacman.c", "path": "src/pacman/pacman.c", "group": "frontend", "groupId": "frontend", "desc": "main() at L1178 dispatches parsed operations" },
    { "id": "conf", "label": "config loader", "file": "conf.c", "path": "src/pacman/conf.c", "group": "frontend", "groupId": "frontend", "desc": "parseconfig reads pacman.conf, mirrors options into libalpm" },
    { "id": "sync_cli", "label": "sync command", "file": "sync.c", "path": "src/pacman/sync.c", "group": "frontend", "groupId": "frontend", "desc": "pacman_sync drives -S, -Sy, -Su flows" },
    { "id": "query_cli", "label": "query command", "file": "query.c", "path": "src/pacman/query.c", "group": "frontend", "groupId": "frontend", "desc": "pacman_query answers -Q against the local db" },
    { "id": "upgrade_cli", "label": "upgrade command", "file": "upgrade.c", "path": "src/pacman/upgrade.c", "group": "frontend", "groupId": "frontend", "desc": "pacman_upgrade loads local .pkg.tar.zst files" },
    { "id": "remove_cli", "label": "remove command", "file": "remove.c", "path": "src/pacman/remove.c", "group": "frontend", "groupId": "frontend", "desc": "pacman_remove queues -R targets" },
    { "id": "database_cli", "label": "database command", "file": "database.c", "path": "src/pacman/database.c", "group": "frontend", "groupId": "frontend", "desc": "pacman_database edits install reason via -D" },
    { "id": "callback", "label": "event renderer", "file": "callback.c", "path": "src/pacman/callback.c", "group": "frontend", "groupId": "frontend", "desc": "progress bars and event text from libalpm callbacks" },
    { "id": "alpm_c", "label": "library entry", "file": "alpm.c", "path": "lib/libalpm/alpm.c", "group": "api", "groupId": "api", "desc": "alpm_initialize(root, dbpath) creates the handle" },
    { "id": "alpm_h", "label": "public header", "file": "alpm.h", "path": "lib/libalpm/alpm.h", "group": "api", "groupId": "api", "desc": "~2600-line contract: types, enums, alpm_capabilities" },
    { "id": "handle", "label": "handle & options", "file": "handle.c", "path": "lib/libalpm/handle.c", "group": "api", "groupId": "api", "desc": "root, dbpath, servers, SandboxUser, log callbacks" },
    { "id": "trans", "label": "transaction", "file": "trans.c", "path": "lib/libalpm/trans.c", "group": "api", "groupId": "api", "desc": "commit runs sync load, hooks, then add or remove" },
    { "id": "deps", "label": "deps resolver", "file": "deps.c", "path": "lib/libalpm/deps.c", "group": "engine", "groupId": "engine", "desc": "alpm_checkdeps, dep_graph_init, _alpm_sortbydeps" },
    { "id": "graph_c", "label": "dep graph", "file": "graph.c", "path": "lib/libalpm/graph.c", "group": "engine", "groupId": "engine", "desc": "alpm_graph_t vertices feeding the topo sort" },
    { "id": "conflict", "label": "conflict check", "file": "conflict.c", "path": "lib/libalpm/conflict.c", "group": "engine", "groupId": "engine", "desc": "package and file conflict detection" },
    { "id": "pkghash", "label": "pkgcache hash", "file": "pkghash.c", "path": "lib/libalpm/pkghash.c", "group": "engine", "groupId": "engine", "desc": "_alpm_pkghash_create hashed package cache" },
    { "id": "sync_lib", "label": "sync engine", "file": "sync.c", "path": "lib/libalpm/sync.c", "group": "engine", "groupId": "engine", "desc": "alpm_sync_sysupgrade, _alpm_sync_prepare, download_files" },
    { "id": "add", "label": "install/upgrade", "file": "add.c", "path": "lib/libalpm/add.c", "group": "ops", "groupId": "ops", "desc": "_alpm_upgrade_packages unpacks archives via libarchive" },
    { "id": "remove", "label": "removal", "file": "remove.c", "path": "lib/libalpm/remove.c", "group": "ops", "groupId": "ops", "desc": "_alpm_remove_packages unlinks files then ldconfig" },
    { "id": "diskspace", "label": "disk checks", "file": "diskspace.c", "path": "lib/libalpm/diskspace.c", "group": "ops", "groupId": "ops", "desc": "statvfs estimate before committing" },
    { "id": "hook", "label": "hook runner", "file": "hook.c", "path": "lib/libalpm/hook.c", "group": "ops", "groupId": "ops", "desc": "_alpm_hook_run executes Pre/PostTransaction hooks" },
    { "id": "package", "label": "package model", "file": "package.c", "path": "lib/libalpm/package.c", "group": "ops", "groupId": "ops", "desc": "alpm_pkg_t accessors shared by both backends" },
    { "id": "db", "label": "db registry", "file": "db.c", "path": "lib/libalpm/db.c", "group": "store", "groupId": "store", "desc": "alpm_register_syncdb, alpm_db_search, pkgcache API" },
    { "id": "be_local", "label": "local db backend", "file": "be_local.c", "path": "lib/libalpm/be_local.c", "group": "store", "groupId": "store", "desc": "directory-per-package flat files under local/", "shape": "database" },
    { "id": "be_sync", "label": "sync db backend", "file": "be_sync.c", "path": "lib/libalpm/be_sync.c", "group": "store", "groupId": "store", "desc": "alpm_db_update fetches repo databases", "shape": "database" },
    { "id": "signing", "label": "signature checks", "file": "signing.c", "path": "lib/libalpm/signing.c", "group": "store", "groupId": "store", "desc": "gpgme verification of dbs and packages" },
    { "id": "dload", "label": "downloader", "file": "dload.c", "path": "lib/libalpm/dload.c", "group": "net", "groupId": "net", "desc": "curl multi, retries, If-Modified-Since" },
    { "id": "sandbox", "label": "sandbox setup", "file": "sandbox.c", "path": "lib/libalpm/sandbox.c", "group": "net", "groupId": "net", "desc": "drops downloads to the SandboxUser account" },
    { "id": "sandbox_fs", "label": "fs restriction", "file": "sandbox_fs.c", "path": "lib/libalpm/sandbox_fs.c", "group": "net", "groupId": "net", "desc": "_alpm_sandbox_fs_restrict_writes_to limits writes" },
    { "id": "sandbox_sys", "label": "syscall filter", "file": "sandbox_syscalls.c", "path": "lib/libalpm/sandbox_syscalls.c", "group": "net", "groupId": "net", "desc": "seccomp filter for the download child" }
  ],

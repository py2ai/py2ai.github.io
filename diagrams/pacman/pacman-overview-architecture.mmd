flowchart TD

subgraph group_frontend["CLI frontend &#40;src/pacman&#41;"]
  node_cli["pacman CLI<br/>[pacman.c]"]
  node_conf["config loader<br/>[conf.c]"]
end

subgraph group_core["libalpm core"]
  node_api["library entry<br/>[alpm.c]"]
  node_trans["transaction<br/>[trans.c]"]
  node_add["install/upgrade<br/>[add.c]"]
  node_remove["removal<br/>[remove.c]"]
end

subgraph group_engine["dependency engine"]
  node_deps["deps resolver<br/>[deps.c]"]
  node_sync_lib["sync engine<br/>[sync.c]"]
end

subgraph group_store["databases &amp; download"]
  node_db["db registry<br/>[db.c]"]
  node_be_local[("local db backend<br/>[be_local.c]")]
  node_be_sync[("sync db backend<br/>[be_sync.c]")]
  node_dload["downloader<br/>[dload.c]"]
end

node_cli -->|"reads pacman.conf"| node_conf
node_cli -->|"alpm_* calls"| node_api
node_conf -->|"sets options"| node_api
node_api -->|"transaction lifecycle"| node_trans
node_trans -->|"prepare: checkdeps"| node_deps
node_trans -->|"commit: install"| node_add
node_trans -->|"commit: delete"| node_remove
node_api -->|"plan sysupgrade"| node_sync_lib
node_sync_lib -->|"resolve satisfiers"| node_deps
node_api -->|"register syncdbs"| node_db
node_deps -->|"query pkgcaches"| node_db
node_db -->|"local backend"| node_be_local
node_db -->|"sync backend"| node_be_sync
node_be_sync -->|"fetch core.db"| node_dload
node_add -->|"write local entries"| node_be_local


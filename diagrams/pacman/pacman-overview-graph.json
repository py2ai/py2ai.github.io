{
  "owner": "archlinux",
  "repo": "pacman",
  "branch": "master",
  "groups": [
    { "id": "frontend", "name": "frontend", "label": "CLI frontend (src/pacman)" },
    { "id": "core", "name": "core", "label": "libalpm core" },
    { "id": "engine", "name": "engine", "label": "dependency engine" },
    { "id": "store", "name": "store", "label": "databases & download" }
  ],
  "nodes": [
    { "id": "cli", "label": "pacman CLI", "file": "pacman.c", "path": "src/pacman/pacman.c", "group": "frontend", "groupId": "frontend", "desc": "main() dispatches -S/-Q/-R/-U after parseargs" },
    { "id": "conf", "label": "config loader", "file": "conf.c", "path": "src/pacman/conf.c", "group": "frontend", "groupId": "frontend", "desc": "parses pacman.conf into an alpm handle" },
    { "id": "api", "label": "library entry", "file": "alpm.c", "path": "lib/libalpm/alpm.c", "group": "core", "groupId": "core", "desc": "alpm_initialize binds root + dbpath" },
    { "id": "trans", "label": "transaction", "file": "trans.c", "path": "lib/libalpm/trans.c", "group": "core", "groupId": "core", "desc": "alpm_trans_init/prepare/commit state machine" },
    { "id": "add", "label": "install/upgrade", "file": "add.c", "path": "lib/libalpm/add.c", "group": "core", "groupId": "core", "desc": "alpm_add_pkg queues, _alpm_upgrade_packages unpacks" },
    { "id": "remove", "label": "removal", "file": "remove.c", "path": "lib/libalpm/remove.c", "group": "core", "groupId": "core", "desc": "alpm_remove_pkg and _alpm_remove_packages" },
    { "id": "deps", "label": "deps resolver", "file": "deps.c", "path": "lib/libalpm/deps.c", "group": "engine", "groupId": "engine", "desc": "alpm_checkdeps, satisfier search, _alpm_sortbydeps" },
    { "id": "sync_lib", "label": "sync engine", "file": "sync.c", "path": "lib/libalpm/sync.c", "group": "engine", "groupId": "engine", "desc": "alpm_sync_sysupgrade computes the upgrade set" },
    { "id": "db", "label": "db registry", "file": "db.c", "path": "lib/libalpm/db.c", "group": "store", "groupId": "store", "desc": "alpm_register_syncdb, pkgcache, alpm_db_search" },
    { "id": "be_local", "label": "local db backend", "file": "be_local.c", "path": "lib/libalpm/be_local.c", "group": "store", "groupId": "store", "desc": "flat-file /var/lib/pacman/local database", "shape": "database" },
    { "id": "be_sync", "label": "sync db backend", "file": "be_sync.c", "path": "lib/libalpm/be_sync.c", "group": "store", "groupId": "store", "desc": "alpm_db_update downloads repo .db archives", "shape": "database" },
    { "id": "dload", "label": "downloader", "file": "dload.c", "path": "lib/libalpm/dload.c", "group": "store", "groupId": "store", "desc": "libcurl multi transfers with server failover" }
  ],
  "edges": [
    { "from": "cli", "to": "conf", "label": "reads pacman.conf" },
    { "from": "cli", "to": "api", "label": "alpm_* calls" },
    { "from": "conf", "to": "api", "label": "sets options" },
    { "from": "api", "to": "trans", "label": "transaction lifecycle" },
    { "from": "trans", "to": "deps", "label": "prepare: checkdeps" },
    { "from": "trans", "to": "add", "label": "commit: install" },
    { "from": "trans", "to": "remove", "label": "commit: delete" },
    { "from": "api", "to": "sync_lib", "label": "plan sysupgrade" },
    { "from": "sync_lib", "to": "deps", "label": "resolve satisfiers" },
    { "from": "api", "to": "db", "label": "register syncdbs" },
    { "from": "deps", "to": "db", "label": "query pkgcaches" },
    { "from": "db", "to": "be_local", "label": "local backend" },
    { "from": "db", "to": "be_sync", "label": "sync backend" },
    { "from": "be_sync", "to": "dload", "label": "fetch core.db" },
    { "from": "add", "to": "be_local", "label": "write local entries" }
  ]
}

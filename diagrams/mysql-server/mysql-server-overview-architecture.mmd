flowchart TD

subgraph group_g1["Connection Layer"]
  node_mysqld["mysqld main<br/>[mysqld.cc]"]
  node_connmgr["connection manager"]
  node_protocol["classic protocol"]
end

subgraph group_g2["Parser &amp; Resolver"]
  node_parse["dispatch &amp; parser<br/>[sql_parse.cc]"]
end

subgraph group_g3["Optimizer &amp; Executor"]
  node_optimizer["JOIN::optimize<br/>[sql_optimizer.cc]"]
  node_executor["iterator executor<br/>[sql_union.cc]"]
end

subgraph group_g4["Handler API"]
  node_handler["handler API<br/>[handler.cc]"]
end

subgraph group_g5["InnoDB Engine"]
  node_innodb["ha_innobase<br/>[ha_innodb.cc]"]
  node_bufpool["buffer pool<br/>[buf0buf.cc]"]
  node_redo["redo log<br/>[log0write.cc]"]
end

subgraph group_g6["Binlog &amp; Replication"]
  node_binlog["binary log<br/>[binlog.cc]"]
  node_replica["replica threads<br/>[rpl_replica.cc]"]
end

node_mysqld -->|"starts connection threads"| node_connmgr
node_connmgr -->|"binds socket to protocol"| node_protocol
node_protocol -->|"COM_QUERY packets"| node_parse
node_parse -->|"resolved query block"| node_optimizer
node_optimizer -->|"iterator plan"| node_executor
node_executor -->|"row reads &amp; writes"| node_handler
node_handler -->|"engine callbacks"| node_innodb
node_innodb -->|"page access"| node_bufpool
node_bufpool -->|"dirty pages via mtr"| node_redo
node_innodb -->|"commit with GTID"| node_binlog
node_binlog -->|"ship events"| node_replica


end

node_mysqld -->|"spawns connection threads"| node_connmgr
node_connmgr -->|"binds per-connection protocol"| node_protocol
node_protocol -->|"delivers decoded commands"| node_dispatch
node_dispatch -->|"tokenizes SQL text"| node_lex
node_dispatch -->|"executes resolved statement"| node_optimizer
node_optimizer -->|"emits access-path tree"| node_accesspath
node_accesspath -->|"drives root iterator"| node_rootiter
node_accesspath -->|"builds scan iterators"| node_scaniter
node_accesspath -->|"builds grouping iterators"| node_aggiter
node_rootiter -->|"pulls rows"| node_scaniter
node_aggiter -->|"pulls child rows"| node_scaniter
node_scaniter -->|"row reads"| node_handread
node_handread -->|"engine read callback"| node_innoread
node_handwrite -->|"engine write callback"| node_innowrite
node_handcommit -->|"TC log commit"| node_binlogcommit
node_innoread -->|"fetch path"| node_rowsearch
node_rowsearch -->|"positions cursor"| node_btrsearch
node_rowsearch -->|"visibility checks"| node_readview
node_rowsearch -->|"locks matched rows"| node_lockrec
node_btrsearch -->|"latches leaf pages"| node_bufpool
node_innowrite -->|"insert path"| node_rowinsert
node_rowinsert -->|"splits full pages"| node_btrsplit
node_rowinsert -->|"latches leaf page"| node_bufpool
node_rowinsert -->|"logs row changes"| node_mtrcommit
node_btrsplit -->|"logs structural changes"| node_mtrcommit
node_bufpool -->|"evicts cold pages"| node_lru
node_bufpool -->|"write-behind dirty pages"| node_flushing
node_mtrcommit -->|"appends redo records"| node_logwriter
node_flushing -->|"WAL-before-data wait"| node_logwriter
node_logwriter -->|"advances checkpoint age"| node_chkp
node_trxcommit -->|"writes commit record"| node_mtrcommit
node_lockrec -->|"victim selection"| node_deadlock
node_binlogcommit -->|"three-stage group commit"| node_orderedcommit
node_orderedcommit -->|"engine commit stage"| node_trxcommit
node_orderedcommit -->|"events visible after sync"| node_binlogsender
node_binlogsender -->|"streams events"| node_ioreplica
node_ioreplica -->|"queues relay events"| node_sqlreplica


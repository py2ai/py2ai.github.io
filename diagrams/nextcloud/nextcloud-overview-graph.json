{
  "owner": "nextcloud",
  "repo": "server",
  "branch": "master",
  "groups": [
    { "id": "entry", "name": "Entry", "label": "Entry points" },
    { "id": "dav", "name": "DAV", "label": "WebDAV endpoint (apps/dav)" },
    { "id": "appfw", "name": "AppFramework", "label": "App framework" },
    { "id": "fscore", "name": "FsCore", "label": "Filesystem core" },
    { "id": "storage", "name": "Storage", "label": "Storage factory & wrappers" },
    { "id": "runtime", "name": "Runtime", "label": "Background runtime" }
  ],
  "nodes": [
    {
      "id": "htaccess",
      "label": "Apache .htaccess rewrites",
      "file": ".htaccess",
      "path": ".htaccess",
      "group": "entry",
      "groupId": "entry",
      "desc": "Maps .well-known/carddav and caldav to /remote.php/dav/, forwards Authorization, blocks sensitive dirs."
    },
    {
      "id": "remote",
      "label": "remote.php v2 bootstrap",
      "file": "remote.php",
      "path": "apps/dav/appinfo/v2/remote.php",
      "group": "dav",
      "groupId": "dav",
      "desc": "Clears output buffering, disables the PHP time limit, builds the DAV Server and calls exec()."
    },
    {
      "id": "davserver",
      "label": "OCA\\DAV\\Server",
      "file": "Server.php",
      "path": "apps/dav/lib/Server.php",
      "group": "dav",
      "groupId": "dav",
      "desc": "Assembles the Sabre server: auth backends, tree, and dozens of plugins."
    },
    {
      "id": "objecttree",
      "label": "ObjectTree",
      "file": "ObjectTree.php",
      "path": "apps/dav/lib/Connector/Sabre/ObjectTree.php",
      "group": "dav",
      "groupId": "dav",
      "desc": "Bridges Sabre paths to the OC\\Files View, resolving File and Directory nodes."
    },
    {
      "id": "davfile",
      "label": "Sabre File node",
      "file": "File.php",
      "path": "apps/dav/lib/Connector/Sabre/File.php",
      "group": "dav",
      "groupId": "dav",
      "desc": "put() streams uploads through .ocTransferId*.part files before committing them."
    },
    {
      "id": "dispatcher",
      "label": "AppFramework Dispatcher",
      "file": "Dispatcher.php",
      "path": "lib/private/AppFramework/Http/Dispatcher.php",
      "group": "appfw",
      "groupId": "appfw",
      "desc": "dispatch() runs middleware before and after controller calls for web and OCS APIs."
    },
    {
      "id": "filesui",
      "label": "Files web UI controller",
      "file": "ViewController.php",
      "path": "apps/files/lib/Controller/ViewController.php",
      "group": "appfw",
      "groupId": "appfw",
      "desc": "index() renders the Files app view; showFile() deep-links to a fileid."
    },
    {
      "id": "rootfolder",
      "label": "Node Root / IUserFolder",
      "file": "Root.php",
      "path": "lib/private/Files/Node/Root.php",
      "group": "fscore",
      "groupId": "fscore",
      "desc": "getUserFolder() builds and caches a UserFolder per user id."
    },
    {
      "id": "setupmgr",
      "label": "SetupManager",
      "file": "SetupManager.php",
      "path": "lib/private/Files/SetupManager.php",
      "group": "fscore",
      "groupId": "fscore",
      "desc": "Loads mounts for the user and registers the storage wrapper stack."
    },
    {
      "id": "storagefactory",
      "label": "StorageFactory",
      "file": "StorageFactory.php",
      "path": "lib/private/Files/Storage/StorageFactory.php",
      "group": "storage",
      "groupId": "storage",
      "desc": "wrap() stacks registered wrappers around each mount storage by priority."
    },
    {
      "id": "cron",
      "label": "cron.php",
      "file": "cron.php",
      "path": "cron.php",
      "group": "runtime",
      "groupId": "runtime",
      "desc": "CLI entry that boots lib/base.php and starts CronService."
    },
    {
      "id": "joblist",
      "label": "JobList",
      "file": "JobList.php",
      "path": "lib/private/BackgroundJob/JobList.php",
      "group": "runtime",
      "groupId": "runtime",
      "desc": "getNext() pulls queued jobs from the jobs table for execution."
    }
  ],
  "edges": [
    { "from": "htaccess", "to": "remote", "label": "RewriteRule to /remote.php/dav/" },
    { "from": "remote", "to": "davserver", "label": "new Server($request, $baseuri)" },
    { "from": "davserver", "to": "objecttree", "label": "new CachingTree($root)" },
    { "from": "objecttree", "to": "davfile", "label": "getNodeForPath" },
    { "from": "davserver", "to": "rootfolder", "label": "IRootFolder::getUserFolder" },
    { "from": "rootfolder", "to": "setupmgr", "label": "trigger mount setup" },
    { "from": "setupmgr", "to": "storagefactory", "label": "register wrapper stack" },
    { "from": "davfile", "to": "storagefactory", "label": "resolve + wrap target storage" },
    { "from": "filesui", "to": "dispatcher", "label": "index() via middleware" },
    { "from": "dispatcher", "to": "rootfolder", "label": "controllers read Folder API" },
    { "from": "cron", "to": "joblist", "label": "CronService getNext()" }
  ]
}

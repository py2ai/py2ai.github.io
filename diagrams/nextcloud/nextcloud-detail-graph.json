{
  "owner": "nextcloud",
  "repo": "server",
  "branch": "master",
  "groups": [
    { "id": "entry", "name": "Entry", "label": "Entry points" },
    { "id": "davcore", "name": "DavCore", "label": "WebDAV core (apps/dav)" },
    { "id": "davplugins", "name": "DavPlugins", "label": "Sabre plugins & uploads" },
    { "id": "appfw", "name": "AppFramework", "label": "App framework" },
    { "id": "fsapi", "name": "FsApi", "label": "Filesystem API" },
    { "id": "mounts", "name": "Mounts", "label": "Mounts & providers" },
    { "id": "wrappers", "name": "Wrappers", "label": "Storage backends & wrappers" },
    { "id": "jobs", "name": "Jobs", "label": "Background jobs" }
  ],
  "nodes": [
    {
      "id": "htaccess",
      "label": ".htaccess",
      "file": ".htaccess",
      "path": ".htaccess",
      "group": "entry",
      "groupId": "entry",
      "desc": "Rewrites well-known DAV URIs to /remote.php/dav/, forwards Authorization headers, 404s lib/tests/config."
    },
    {
      "id": "cronphp",
      "label": "cron.php",
      "file": "cron.php",
      "path": "cron.php",
      "group": "entry",
      "groupId": "entry",
      "desc": "CLI entry that requires lib/base.php and runs CronService with optional job classes."
    },
    {
      "id": "remote",
      "label": "remote.php v2 bootstrap",
      "file": "remote.php",
      "path": "apps/dav/appinfo/v2/remote.php",
      "group": "davcore",
      "groupId": "davcore",
      "desc": "set_time_limit(0), ignore_user_abort(true), clears output buffers, then new Server($request, $baseuri) + exec()."
    },
    {
      "id": "davserver",
      "label": "OCA\\DAV\\Server",
      "file": "Server.php",
      "path": "apps/dav/lib/Server.php",
      "group": "davcore",
      "groupId": "davcore",
      "desc": "Builds the Sabre server, registers auth and protocol plugins, defers file plugins to beforeMethod:*."
    },
    {
      "id": "rootcoll",
      "label": "RootCollection",
      "file": "RootCollection.php",
      "path": "apps/dav/lib/RootCollection.php",
      "group": "davcore",
      "groupId": "davcore",
      "desc": "DAV root exposing files, principals, calendars and addressbooks."
    },
    {
      "id": "davauth",
      "label": "Sabre Auth backend",
      "file": "Auth.php",
      "path": "apps/dav/lib/Connector/Sabre/Auth.php",
      "group": "davcore",
      "groupId": "davcore",
      "desc": "class Auth extends AbstractBasic; validateUserPass() checks against the Nextcloud user backend."
    },
    {
      "id": "objecttree",
      "label": "ObjectTree",
      "file": "ObjectTree.php",
      "path": "apps/dav/lib/Connector/Sabre/ObjectTree.php",
      "group": "davcore",
      "groupId": "davcore",
      "desc": "init(rootNode, View, IMountManager); getNodeForPath() returns Sabre File/Directory nodes."
    },
    {
      "id": "davfile",
      "label": "Sabre File node",
      "file": "File.php",
      "path": "apps/dav/lib/Connector/Sabre/File.php",
      "group": "davcore",
      "groupId": "davcore",
      "desc": "put()/get() with part files named .ocTransferId<id>.part, exclusive locks, and hash checks."
    },
    {
      "id": "filesplugin",
      "label": "FilesPlugin",
      "file": "FilesPlugin.php",
      "path": "apps/dav/lib/Connector/Sabre/FilesPlugin.php",
      "group": "davplugins",
      "groupId": "davplugins",
      "desc": "Exposes Nextcloud file properties, checksums and headers over PROPFIND/GET."
    },
    {
      "id": "quota_plugin",
      "label": "QuotaPlugin (Sabre)",
      "file": "QuotaPlugin.php",
      "path": "apps/dav/lib/Connector/Sabre/QuotaPlugin.php",
      "group": "davplugins",
      "groupId": "davplugins",
      "desc": "Checks free_space() through the view before accepting uploads."
    },
    {
      "id": "chunkv2",
      "label": "ChunkingV2Plugin",
      "file": "ChunkingV2Plugin.php",
      "path": "apps/dav/lib/Upload/ChunkingV2Plugin.php",
      "group": "davplugins",
      "groupId": "davplugins",
      "desc": "Hooks beforeMethod:PUT/DELETE and MKCOL for cache-backed chunked upload sessions."
    },
    {
      "id": "bulkupload",
      "label": "BulkUploadPlugin",
      "file": "BulkUploadPlugin.php",
      "path": "apps/dav/lib/BulkUpload/BulkUploadPlugin.php",
      "group": "davplugins",
      "groupId": "davplugins",
      "desc": "Parses multipart bulk uploads straight into the user folder."
    },
    {
      "id": "dispatcher",
      "label": "Dispatcher",
      "file": "Dispatcher.php",
      "path": "lib/private/AppFramework/Http/Dispatcher.php",
      "group": "appfw",
      "groupId": "appfw",
      "desc": "dispatch(): reflect, beforeController, executeController, afterController, beforeOutput."
    },
    {
      "id": "middledisp",
      "label": "MiddlewareDispatcher",
      "file": "MiddlewareDispatcher.php",
      "path": "lib/private/AppFramework/Middleware/MiddlewareDispatcher.php",
      "group": "appfw",
      "groupId": "appfw",
      "desc": "Chains middleware around controller execution and exception handling."
    },
    {
      "id": "securitymw",
      "label": "SecurityMiddleware",
      "file": "SecurityMiddleware.php",
      "path": "lib/private/AppFramework/Middleware/Security/SecurityMiddleware.php",
      "group": "appfw",
      "groupId": "appfw",
      "desc": "CSRF, brute-force throttling and permission enforcement for controller calls."
    },
    {
      "id": "bootcoord",
      "label": "Bootstrap Coordinator",
      "file": "Coordinator.php",
      "path": "lib/private/AppFramework/Bootstrap/Coordinator.php",
      "group": "appfw",
      "groupId": "appfw",
      "desc": "registerApps()/bootApp() run each app's registration and boot steps."
    },
    {
      "id": "appmanager",
      "label": "AppManager",
      "file": "AppManager.php",
      "path": "lib/private/App/AppManager.php",
      "group": "appfw",
      "groupId": "appfw",
      "desc": "loadApps() resolves installed and enabled apps by type."
    },
    {
      "id": "filesui",
      "label": "Files ViewController",
      "file": "ViewController.php",
      "path": "apps/files/lib/Controller/ViewController.php",
      "group": "appfw",
      "groupId": "appfw",
      "desc": "index($dir, $view, $fileid) and showFile() drive the Files web UI."
    },
    {
      "id": "rootnode",
      "label": "Node Root",
      "file": "Root.php",
      "path": "lib/private/Files/Node/Root.php",
      "group": "fsapi",
      "groupId": "fsapi",
      "desc": "getUserFolder($userId) resolves /uid/files and wraps it in a UserFolder."
    },
    {
      "id": "userfolder",
      "label": "UserFolder",
      "file": "UserFolder.php",
      "path": "lib/private/Files/Node/UserFolder.php",
      "group": "fsapi",
      "groupId": "fsapi",
      "desc": "User-facing Folder implementation used by apps and plugins."
    },
    {
      "id": "view",
      "label": "View (path API)",
      "file": "View.php",
      "path": "lib/private/Files/View.php",
      "group": "fsapi",
      "groupId": "fsapi",
      "desc": "Path-based filesystem API that resolves the owning mount for every operation."
    },
    {
      "id": "filesystem",
      "label": "Filesystem facade",
      "file": "Filesystem.php",
      "path": "lib/private/Files/Filesystem.php",
      "group": "fsapi",
      "groupId": "fsapi",
      "desc": "Static facade: getMountManager(), getView(), initMountManager()."
    },
    {
      "id": "setupmgr",
      "label": "SetupManager",
      "file": "SetupManager.php",
      "path": "lib/private/Files/SetupManager.php",
      "group": "mounts",
      "groupId": "mounts",
      "desc": "setupForUser() loads filesystem-type apps, aggregates mounts, registers wrappers."
    },
    {
      "id": "mpc",
      "label": "MountProviderCollection",
      "file": "MountProviderCollection.php",
      "path": "lib/private/Files/Config/MountProviderCollection.php",
      "group": "mounts",
      "groupId": "mounts",
      "desc": "Aggregates IMountProviders via getMountsForUser(); home providers run in reverse order."
    },
    {
      "id": "homeprovider",
      "label": "LocalHomeMountProvider",
      "file": "LocalHomeMountProvider.php",
      "path": "lib/private/Files/Mount/LocalHomeMountProvider.php",
      "group": "mounts",
      "groupId": "mounts",
      "desc": "Mounts 'OC\\Files\\Storage\\Home' at /uid for each user."
    },
    {
      "id": "mountpoint",
      "label": "MountPoint",
      "file": "MountPoint.php",
      "path": "lib/private/Files/Mount/MountPoint.php",
      "group": "mounts",
      "groupId": "mounts",
      "desc": "Lazily createStorage() wraps the backend via the loader; storage ids over 64 chars are md5'd."
    },
    {
      "id": "storagefactory",
      "label": "StorageFactory",
      "file": "StorageFactory.php",
      "path": "lib/private/Files/Storage/StorageFactory.php",
      "group": "wrappers",
      "groupId": "wrappers",
      "desc": "addStorageWrapper()/wrap() apply wrappers sorted by descending priority."
    },
    {
      "id": "common",
      "label": "Common (base storage)",
      "file": "Common.php",
      "path": "lib/private/Files/Storage/Common.php",
      "group": "wrappers",
      "groupId": "wrappers",
      "desc": "Base implementation shared by all storage backends."
    },
    {
      "id": "local",
      "label": "Local storage",
      "file": "Local.php",
      "path": "lib/private/Files/Storage/Local.php",
      "group": "wrappers",
      "groupId": "wrappers",
      "desc": "Plain disk backend; class Local extends Common."
    },
    {
      "id": "quotawrap",
      "label": "Quota wrapper",
      "file": "Quota.php",
      "path": "lib/private/Files/Storage/Wrapper/Quota.php",
      "group": "wrappers",
      "groupId": "wrappers",
      "desc": "free_space()/fopen() enforce the user quota on home mounts via quotaCallback."
    },
    {
      "id": "permsmask",
      "label": "PermissionsMask wrapper",
      "file": "PermissionsMask.php",
      "path": "lib/private/Files/Storage/Wrapper/PermissionsMask.php",
      "group": "wrappers",
      "groupId": "wrappers",
      "desc": "Implements readonly mounts and sharing masks layered over storage."
    },
    {
      "id": "joblist",
      "label": "JobList",
      "file": "JobList.php",
      "path": "lib/private/BackgroundJob/JobList.php",
      "group": "jobs",
      "groupId": "jobs",
      "desc": "add()/scheduleAfter()/getNext() over the queued background jobs."
    }
  ],
  "edges": [
    { "from": "htaccess", "to": "remote", "label": "RewriteRule to /remote.php/dav/" },
    { "from": "cronphp", "to": "joblist", "label": "CronService pulls jobs" },
    { "from": "remote", "to": "davserver", "label": "new Server($request, $baseuri)" },
    { "from": "davserver", "to": "rootcoll", "label": "$root = new RootCollection()" },
    { "from": "davserver", "to": "objecttree", "label": "new CachingTree($root)" },
    { "from": "davserver", "to": "davauth", "label": "auth backend added" },
    { "from": "davserver", "to": "filesplugin", "label": "registered after auth" },
    { "from": "davserver", "to": "quota_plugin", "label": "QuotaPlugin($view)" },
    { "from": "davserver", "to": "chunkv2", "label": "ChunkingV2Plugin PUT hooks" },
    { "from": "davserver", "to": "bulkupload", "label": "BulkUploadPlugin($userFolder)" },
    { "from": "davserver", "to": "rootnode", "label": "IRootFolder::getUserFolder" },
    { "from": "objecttree", "to": "davfile", "label": "getNodeForPath()" },
    { "from": "objecttree", "to": "view", "label": "fileView = OC\\Files\\View" },
    { "from": "davfile", "to": "view", "label": "resolvePath + file_exists" },
    { "from": "davfile", "to": "mountpoint", "label": "finds owning mount" },
    { "from": "filesui", "to": "dispatcher", "label": "dispatch(index)" },
    { "from": "dispatcher", "to": "middledisp", "label": "before/after/exception" },
    { "from": "middledisp", "to": "securitymw", "label": "runs SecurityMiddleware" },
    { "from": "bootcoord", "to": "filesui", "label": "bootApp('files')" },
    { "from": "filesui", "to": "rootnode", "label": "index() reads user folder" },
    { "from": "rootnode", "to": "userfolder", "label": "new UserFolder(...)" },
    { "from": "rootnode", "to": "setupmgr", "label": "setupForUser when needed" },
    { "from": "userfolder", "to": "view", "label": "Node ops delegate to View" },
    { "from": "filesystem", "to": "view", "label": "Filesystem::getView()" },
    { "from": "view", "to": "mountpoint", "label": "resolvePath to MountPoint" },
    { "from": "filesystem", "to": "setupmgr", "label": "initMountManager wiring" },
    { "from": "setupmgr", "to": "appmanager", "label": "loadApps(['filesystem'])" },
    { "from": "setupmgr", "to": "mpc", "label": "pull providers' mounts" },
    { "from": "mpc", "to": "homeprovider", "label": "homeProviders" },
    { "from": "homeprovider", "to": "mountpoint", "label": "HomeMountPoint at /uid" },
    { "from": "mpc", "to": "mountpoint", "label": "IMountPoint list" },
    { "from": "mountpoint", "to": "storagefactory", "label": "loader->wrap()" },
    { "from": "setupmgr", "to": "storagefactory", "label": "addStorageWrapper stack" },
    { "from": "storagefactory", "to": "quotawrap", "label": "priority-sorted wrappers" },
    { "from": "storagefactory", "to": "permsmask", "label": "readonly/sharing masks" },
    { "from": "quotawrap", "to": "common", "label": "wraps IStorage" },
    { "from": "local", "to": "common", "label": "class Local extends Common" }
  ]
}

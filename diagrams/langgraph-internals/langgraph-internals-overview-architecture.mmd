node_stategraph -->|"add_node / add_conditional_edges"| node_compile
node_compile -->|"returns CompiledStateGraph &#40;a Pregel&#41;"| node_pregel
node_compile -->|"checkpointer= argument"| node_checkpointer
node_pregel -->|"drives supersteps"| node_loop
node_loop -->|"plan tasks / apply writes"| node_algo
node_loop -->|"submit node tasks"| node_runner
node_runner -->|"reads inputs, returns writes"| node_channels
node_algo -->|"updates + version bumps"| node_channels
node_channels -->|"messages state reducer"| node_add_messages
node_loop -->|"checkpoint per superstep"| node_checkpointer
node_checkpointer -->|"development default"| node_memory
node_loop -->|"pause on GraphInterrupt"| node_interrupt
node_interrupt -->|"Command resume restarts loop"| node_pregel
node_react_agent -->|"agent = graph pattern"| node_stategraph


    { "id": "index_mapper", "label": "IndexMapper", "file": "mod.rs", "path": "crates/index-scheduler/src/index_mapper/mod.rs", "group": "Scheduler", "groupId": "scheduler", "desc": "Maps index uids to on-disk LMDB environments with a bounded cache." },
    { "id": "milli_index", "label": "Index (milli)", "file": "index.rs", "path": "crates/milli/src/index.rs", "group": "Search Core", "groupId": "search_core", "desc": "Schema + LMDB databases: word_docids, facets, synonyms, prefix dbs, vectors." },
    { "id": "execute_search", "label": "execute_search", "file": "mod.rs", "path": "crates/milli/src/search/new/mod.rs", "group": "Search Core", "groupId": "search_core", "desc": "Resolves universe, builds ranking rules, runs bucket_sort to PartialSearchResult." },
    { "id": "execute_vector_search", "label": "execute_vector_search", "file": "mod.rs", "path": "crates/milli/src/search/new/mod.rs", "group": "Search Core", "groupId": "search_core", "desc": "ANN path for semantic and hybrid queries over the vector store." },
    { "id": "ranking_rules", "label": "ranking rules builder", "file": "mod.rs", "path": "crates/milli/src/search/new/mod.rs", "group": "Search Core", "groupId": "search_core", "desc": "get_ranking_rules_for_query_graph_search: words, typo, proximity, sort, exactness." },
    { "id": "resolve_sort_criteria", "label": "resolve_sort_criteria", "file": "mod.rs", "path": "crates/milli/src/search/new/mod.rs", "group": "Search Core", "groupId": "search_core", "desc": "Injects sort and geosort rules before relevance rules." },
    { "id": "extract_tokens", "label": "extract_tokens", "file": "mod.rs", "path": "crates/milli/src/search/new/mod.rs", "group": "Search Core", "groupId": "search_core", "desc": "Tokenizes user query via charabia into query graph terms." },
    { "id": "facet_distribution", "label": "FacetDistribution", "file": "facet_distribution.rs", "path": "crates/milli/src/search/facet/facet_distribution.rs", "group": "Search Core", "groupId": "search_core", "desc": "Computes facet counts from facet_id_* databases, respecting filters." },
    { "id": "indexer_extract", "label": "extract (indexer)", "file": "document_changes.rs", "path": "crates/milli/src/update/new/indexer/document_changes.rs", "group": "Indexing", "groupId": "indexing", "desc": "Parallel extraction of docids, words, facets, vectors from changed documents." },
    { "id": "document_operation", "label": "document operations", "file": "document_operation.rs", "path": "crates/milli/src/update/new/indexer/document_operation.rs", "group": "Indexing", "groupId": "indexing", "desc": "Merges additions, updates and deletions into a document change set." },
    { "id": "vector_db", "label": "vector store", "file": "db.rs", "path": "crates/milli/src/vector/db.rs", "group": "Indexing", "groupId": "indexing", "desc": "Stores embeddings, manages embedder configs and ANN queries." }

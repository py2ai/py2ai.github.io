{
  "owner": "meilisearch",
  "repo": "meilisearch",
  "branch": "main",
  "groups": [
    { "id": "api", "name": "HTTP API", "label": "Actix-web handlers" },
    { "id": "scheduler", "name": "Scheduler", "label": "index-scheduler crate" },
    { "id": "search_core", "name": "Search Core", "label": "milli query execution" },
    { "id": "indexing", "name": "Indexing", "label": "milli write side" }
  ],
  "nodes": [
    { "id": "entry_main", "label": "main.rs setup", "file": "main.rs", "path": "crates/meilisearch/src/main.rs", "group": "HTTP API", "groupId": "api", "desc": "Parses Opt, builds the IndexScheduler and AuthController, then starts actix HttpServer." },
    { "id": "create_app", "label": "create_app", "file": "lib.rs", "path": "crates/meilisearch/src/lib.rs", "group": "HTTP API", "groupId": "api", "desc": "Assembles routes, middleware and shared ServicesData into the actix app." },
    { "id": "setup_meilisearch", "label": "setup_meilisearch", "file": "lib.rs", "path": "crates/meilisearch/src/lib.rs", "group": "HTTP API", "groupId": "api", "desc": "Initializes scheduler, auth and analytics behind a single Opt configuration." },
    { "id": "configure_data", "label": "configure_data", "file": "lib.rs", "path": "crates/meilisearch/src/lib.rs", "group": "HTTP API", "groupId": "api", "desc": "Attaches scheduler, auth controller and analyzers as actix web data." },
    { "id": "create_index", "label": "create_index", "file": "mod.rs", "path": "crates/meilisearch/src/routes/indexes/mod.rs", "group": "HTTP API", "groupId": "api", "desc": "POST /indexes; validates uid and enqueues IndexCreation." },

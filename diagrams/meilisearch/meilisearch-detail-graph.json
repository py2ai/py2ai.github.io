    { "id": "delete_index", "label": "delete_index", "file": "mod.rs", "path": "crates/meilisearch/src/routes/indexes/mod.rs", "group": "HTTP API", "groupId": "api", "desc": "DELETE /indexes/{uid}; enqueues IndexDeletion." },

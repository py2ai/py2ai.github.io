    { "id": "document_addition", "label": "document_addition", "file": "documents.rs", "path": "crates/meilisearch/src/routes/indexes/documents.rs", "group": "HTTP API", "groupId": "api", "desc": "Shared helper: writes payload to file-store and registers a DocumentAddition task." },
    { "id": "search_with_post", "label": "search_with_post", "file": "search.rs", "path": "crates/meilisearch/src/routes/indexes/search.rs", "group": "HTTP API", "groupId": "api", "desc": "POST /indexes/{uid}/search; deserializes SearchQuery and runs synchronously." },
    { "id": "settings_update_all", "label": "update_all (settings)", "file": "settings.rs", "path": "crates/meilisearch/src/routes/indexes/settings.rs", "group": "HTTP API", "groupId": "api", "desc": "PATCH /indexes/{uid}/settings; enqueues SettingsUpdate task." },
    { "id": "search_query", "label": "SearchQuery", "file": "mod.rs", "path": "crates/meilisearch/src/search/mod.rs", "group": "HTTP API", "groupId": "api", "desc": "Deserr-validated request body: q, filters, sort, facets, hybrid, embedder." },
    { "id": "perform_search", "label": "perform_search", "file": "mod.rs", "path": "crates/meilisearch/src/search/mod.rs", "group": "HTTP API", "groupId": "api", "desc": "Adapts HTTP query into milli SearchContext and executes it." },
    { "id": "index_scheduler", "label": "IndexScheduler", "file": "lib.rs", "path": "crates/index-scheduler/src/lib.rs", "group": "Scheduler", "groupId": "scheduler", "desc": "Owns LMDB env, task Queue, IndexMapper, features and embedder cache." },
    { "id": "sched_run", "label": "run loop", "file": "lib.rs", "path": "crates/index-scheduler/src/lib.rs", "group": "Scheduler", "groupId": "scheduler", "desc": "Dedicated background thread looping over tick until shutdown." },

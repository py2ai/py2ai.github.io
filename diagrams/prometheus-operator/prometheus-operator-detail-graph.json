    {
      "id": "alertmanager_type",
      "label": "Alertmanager",
      "file": "alertmanager_types.go",
      "path": "pkg/apis/monitoring/v1/alertmanager_types.go",
      "group": "crd_types",
      "groupId": "crd_types",
      "shape": "document",
      "desc": "Alertmanager cluster spec consumed by its controller"
    },
    {
      "id": "agent_ctrl",
      "label": "Agent controller",
      "file": "operator.go",
      "path": "pkg/prometheus/agent/operator.go",
      "group": "agent_alertmanager",
      "groupId": "agent_alertmanager",
      "shape": "box",
      "desc": "New, Run and Sync mirror the server loop for PrometheusAgent CRs"
    },
    {
      "id": "am_ctrl",
      "label": "Alertmanager controller",
      "file": "operator.go",
      "path": "pkg/alertmanager/operator.go",
      "group": "agent_alertmanager",
      "groupId": "agent_alertmanager",
      "shape": "box",
      "desc": "Same pattern: New L134, Run L507, Sync L602"
    }

    },
    {
      "id": "k8s_objects",
      "name": "Kubernetes Objects",
      "label": "what lands in the cluster"
    },
    {
      "id": "crd_types",
      "name": "CRD Types",
      "label": "pkg/apis/monitoring/v1"
    }

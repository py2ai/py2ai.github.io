{
  "owner": "prometheus-operator",
  "repo": "prometheus-operator",
  "branch": "main",
  "groups": [
    {
      "id": "entrypoint",
      "name": "Operator Entry",
      "label": "cmd/operator"
    },
    {
      "id": "controllers",
      "name": "CRD Controllers",
      "label": "one loop per kind"
    },
    {
      "id": "shared",
      "name": "Shared Operator Kit",
      "label": "pkg/operator"
    },
    {
      "id": "generators",
      "name": "Generators & Builders",
      "label": "config, rules, StatefulSets"
    },
    {
      "id": "api",
      "name": "CRD Types",
      "label": "pkg/apis/monitoring/v1"
    }
  ],
  "nodes": [
    {
      "id": "main",
      "label": "cmd/operator/main.go",
      "file": "main.go",
      "path": "cmd/operator/main.go",
      "group": "entrypoint",
      "groupId": "entrypoint",
      "shape": "hexagon",
      "desc": "start() discovers which CRDs and RBAC verbs the cluster grants, then launches the four controllers plus the web server"
    },
    {
      "id": "prom_server_ctrl",
      "label": "Prometheus controller",
      "file": "operator.go",
      "path": "pkg/prometheus/server/operator.go",
      "group": "controllers",
      "groupId": "controllers",
      "shape": "box",
      "desc": "Watches Prometheus CRs; New, Run, addHandlers and Sync drive every reconcile pass"
    },
    {
      "id": "prom_agent_ctrl",
      "label": "PrometheusAgent controller",
      "file": "operator.go",
      "path": "pkg/prometheus/agent/operator.go",
      "group": "controllers",
      "groupId": "controllers",
      "shape": "box",
      "desc": "Agent mode: StatefulSets or DaemonSets without local TSDB compaction"
    },
    {
      "id": "alertmanager_ctrl",
      "label": "Alertmanager controller",
      "file": "operator.go",
      "path": "pkg/alertmanager/operator.go",
      "group": "controllers",
      "groupId": "controllers",
      "shape": "box",
      "desc": "Same loop pattern for Alertmanager and AlertmanagerConfig CRs"
    },
    {
      "id": "crd_types",
      "label": "Prometheus CRD type",
      "file": "prometheus_types.go",
      "path": "pkg/apis/monitoring/v1/prometheus_types.go",
      "group": "api",
      "groupId": "api",
      "shape": "document",
      "desc": "Prometheus struct and PrometheusSpec define the whole declarative surface"
    },
    {
      "id": "event_handler",
      "label": "EventHandler filters",
      "file": "event_handler.go",
      "path": "pkg/operator/event_handler.go",
      "group": "shared",
      "groupId": "shared",
      "shape": "box",
      "desc": "GenerationChanged / LabelsChanged filters drop no-op informer events"
    },
    {
      "id": "resource_reconciler",
      "label": "ResourceReconciler",
      "file": "resource_reconciler.go",
      "path": "pkg/operator/resource_reconciler.go",
      "group": "shared",
      "groupId": "shared",
      "shape": "box",
      "desc": "Workqueue that maps child StatefulSet events back to owning CR keys"
    },
    {
      "id": "config_generator",
      "label": "ConfigGenerator",
      "file": "promcfg.go",
      "path": "pkg/prometheus/promcfg.go",
      "group": "generators",
      "groupId": "generators",
      "shape": "box",
      "desc": "Renders prometheus.yml YAML from ServiceMonitors, PodMonitors and ScrapeConfigs"
    },
    {
      "id": "sset_builder",
      "label": "makeStatefulSet",
      "file": "statefulset.go",
      "path": "pkg/prometheus/server/statefulset.go",
      "group": "generators",
      "groupId": "generators",
      "shape": "box",
      "desc": "Builds the appsv1.StatefulSet object: containers, args, volumes, probes"
    },
    {
      "id": "rules_builder",
      "label": "Rule ConfigMaps",
      "file": "rules.go",
      "path": "pkg/prometheus/server/rules.go",
      "group": "generators",
      "groupId": "generators",
      "shape": "box",
      "desc": "selectPrometheusRules gathers PrometheusRule content into shared ConfigMaps"
    }
  ],
  "edges": [
    {
      "from": "main",
      "to": "prom_server_ctrl",
      "label": "prometheuscontroller.New"
    },
    {
      "from": "main",
      "to": "prom_agent_ctrl",
      "label": "prometheusagentcontroller.New"
    },
    {
      "from": "main",
      "to": "alertmanager_ctrl",
      "label": "alertmanagercontroller.New"
    },
    {
      "from": "prom_server_ctrl",
      "to": "crd_types",
      "label": "watches Prometheus CRs"
    },
    {
      "from": "prom_server_ctrl",
      "to": "event_handler",
      "label": "addHandlers"
    },
    {
      "from": "prom_server_ctrl",
      "to": "resource_reconciler",
      "label": "rr.Run"
    },
    {
      "from": "event_handler",
      "to": "resource_reconciler",
      "label": "enqueue owner key"
    },
    {
      "from": "resource_reconciler",
      "to": "prom_server_ctrl",
      "label": "Sync(key)"
    },
    {
      "from": "prom_server_ctrl",
      "to": "rules_builder",
      "label": "createOrUpdateRuleConfigMaps"
    },
    {
      "from": "prom_server_ctrl",
      "to": "config_generator",
      "label": "NewConfigGenerator"
    },
    {
      "from": "prom_server_ctrl",
      "to": "sset_builder",
      "label": "makeStatefulSet per shard"
    },
    {
      "from": "config_generator",
      "to": "sset_builder",
      "label": "buildServerArgs(cg, p)"
    }
  ]
}

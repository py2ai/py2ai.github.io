node_main_entry -->|"returns node::Start&#40;argc, argv&#41;"| node_node_start
node_node_start -->|"StartInternal&#40;&#41;: uv_loop_configure + NodeMainInstance"| node_main_instance_run
node_main_instance_run -->|"CreateMainEnvironment + LoadEnvironment"| node_load_env
node_load_env -->|"Realm::RunBootstrapping"| node_bootstrap_realm
node_bootstrap_realm -->|"main script under lib/internal/main"| node_prepare_main
node_prepare_main -->|"Module.runMain&#40;mainEntry&#41;"| node_run_entry
node_run_entry -->|"wrapModuleLoad&#40;&#41; tries CommonJS first"| node_cjs_load
node_run_entry -->|"shouldUseESMLoader -&gt; importForEntryPoint&#40;&#41;"| node_esm_import
node_cjs_load -->|"entry executed synchronously; loop keeps process alive"| node_spin_loop
node_esm_import -->|"top-level await yields via entry-point promise"| node_spin_loop
node_spin_loop -->|"uv_run&#40;env-&gt;event_loop&#40;&#41;, UV_RUN_DEFAULT&#41;"| node_uv_run
node_uv_run -->|"uv_loop_alive / beforeExit re-check"| node_spin_loop
node_uv_threadpool -->|"uv__work_submit completions wake the loop"| node_uv_run


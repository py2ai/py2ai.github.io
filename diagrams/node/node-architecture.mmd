node_main_instance_run -->|"CreateMainEnvironment&#40;&#41;"| node_create_main_env
node_create_main_env -->|"NewContext + CreateEnvironment&#40;&#41;"| node_create_environment
node_create_environment -->|"Environment ready"| node_load_env
node_load_env -->|"bootstrap before main scripts"| node_run_bootstrapping
node_run_bootstrapping -->|"ExecuteBootstrapper&#40;'internal/bootstrap/realm'&#41;"| node_realm_js
node_realm_js -->|"per-context global/process setup"| node_bootstrap_node
node_realm_js -->|"internalBinding&#40;&#41; fetches native exports"| node_get_internal_binding
node_bootstrap_node -->|"switches/ wire stdio and streams"| node_switches_main
node_switches_main -->|"lib/internal/main script chosen"| node_pre_execution
node_pre_execution -->|"run_main_module.js"| node_run_main_module
node_run_main_module -->|"Module.runMain&#40;mainEntry&#41;"| node_module_runmain
node_module_runmain -->|"delegates to executeUserEntryPoint"| node_execute_entry
node_execute_entry -->|"resolveMainPath + loader decision"| node_should_use_esm
node_execute_entry -->|"wrapModuleLoad&#40;main, null, true&#41; CommonJS first"| node_cjs_load
node_should_use_esm -->|"ESM entry point"| node_esm_entry
node_esm_entry -->|"load graph"| node_esm_import
node_esm_import -->|"evaluation done or deferred by top-level await"| node_spin_loop
node_cjs_load -->|"sync execution returns; loop drives callbacks"| node_spin_loop
node_spin_loop -->|"uv_run&#40;env-&gt;event_loop&#40;&#41;, UV_RUN_DEFAULT&#41;"| node_uv_run_call
node_spin_loop -->|"platform-&gt;DrainTasks&#40;isolate&#41;"| node_drain_tasks
node_drain_tasks -->|"re-check uv_loop_alive for another iteration"| node_uv_run_call
node_uv_run_call -->|"poll phase"| node_io_poll
node_uv_run_call -->|"timers phase"| node_run_timers_uv
node_run_timers_uv -->|"Environment::RunTimers handle callback"| node_run_timers_cpp
node_run_timers_cpp -->|"invokes stored JS timer callback"| node_process_timers
node_process_timers -->|"re-schedules via internalBinding&#40;'timers'&#41;"| node_run_timers_cpp
node_threadpool_init -->|"4 default workers; UV_THREADPOOL_SIZE override"| node_queue_work
node_fs_read -->|"Dispatch&#40;uv_fs_read&#41;"| node_uv_fs_work
node_uv_fs_work -->|"uv__work_submit"| node_queue_work
node_queue_work -->|"completion wakes the loop via async handle"| node_io_poll
node_io_poll -->|"handle callbacks push chunks into streams"| node_readable
node_main_instance_run -->|"worker_threads: each Worker gets its own thread"| node_worker_create
node_worker_create -->|"w-&gt;Run&#40;&#41;"| node_worker_spin
node_worker_spin -->|"own loop per worker"| node_spin_loop


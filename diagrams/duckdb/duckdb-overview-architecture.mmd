subgraph group_g2["Front End"]
  node_parser["Parser::ParseQuery<br/>[parser.cpp]"]
  node_binder["Binder::Bind<br/>[binder.cpp]"]
  node_planner["Planner::CreatePlan<br/>[planner.cpp]"]
end

subgraph group_g3["Rule-Based Optimizer"]
  node_optimizer["Optimizer::Optimize<br/>[optimizer.cpp]"]
end

subgraph group_g4["Execution Engine"]
  node_plan_generator["PhysicalPlanGenerator::CreatePlan"]
  node_physical_operator["PhysicalOperator"]
end

subgraph group_g5["Parallel Scheduler"]
  node_executor["Executor<br/>[executor.cpp]"]
  node_task_scheduler["TaskScheduler<br/>[task_scheduler.cpp]"]
end

subgraph group_g6["Storage Engine"]
  node_data_table["DataTable<br/>[data_table.cpp]"]
end

node_connection -->|"delegates SQL text"| node_client_context
node_duckdb_ctor -->|"issues sessions"| node_client_context
node_client_context -->|"tokenize SQL"| node_parser
node_parser -->|"parse tree"| node_binder
node_binder -->|"bound statement"| node_planner
node_planner -->|"Planner::Optimize"| node_optimizer
node_optimizer -->|"optimized logical plan"| node_plan_generator
node_plan_generator -->|"instantiates operators"| node_physical_operator
node_physical_operator -->|"work units"| node_executor
node_executor -->|"dispatches tasks"| node_task_scheduler
node_physical_operator -->|"reads row groups"| node_data_table


node_app_main -->|"starts loopback server"| node_control_server
node_app_main -->|"hosts egui shell"| node_ui_canvas
node_control_server -.->|"shared protocol and auth"| node_automation_lib
node_ui_canvas -->|"Session::execute"| node_engine_lib
node_cli_lib -->|"drives session"| node_automation_headless
node_web_app -->|"wasm facade calls"| node_engine_lib
node_engine_lib -->|"registers"| node_engine_commands
node_engine_commands -->|"dispatch by id"| node_engine_file_cmds
node_engine_commands -->|"dispatch by id"| node_engine_layer_cmds
node_engine_commands -->|"dispatch by id"| node_engine_adjust_cmds
node_engine_lib -->|"undo stack"| node_engine_history
node_engine_history -.->|"COW snapshots"| node_doc_lib
node_engine_lib -->|"owns Document"| node_doc_lib
node_engine_layer_cmds -->|"edit layer tree"| node_doc_lib
node_engine_adjust_cmds -->|"params in model"| node_doc_adjust
node_doc_adjust -.->|"layer kinds"| node_doc_lib
node_doc_text -.->|"layer kinds"| node_doc_lib
node_doc_vector -.->|"layer kinds"| node_doc_lib
node_doc_effects -.->|"layer styles"| node_doc_lib
node_engine_adjust_cmds -->|"apply adjustment"| node_compose_adjust
node_compose_lib -->|"masks and clipping"| node_compose_masks
node_compose_lib -->|"adjustments"| node_compose_adjust
node_compose_lib -->|"reads tiles"| node_raster_lib
node_gpu_lib -->|"plan passes"| node_gpu_plan
node_gpu_lib -->|"effect maps"| node_gpu_fx
node_gpu_lib -->|"uploads pages"| node_raster_lib
node_gpu_lib -.->|"match within 1/255"| node_compose_lib
node_engine_lib -->|"brush commands"| node_paint_lib
node_paint_lib -->|"points to dabs"| node_paint_dynamics
node_paint_lib -->|"writes dabs"| node_raster_lib
node_engine_file_cmds -->|"layered open/save"| node_psd_lib
node_engine_file_cmds -->|"export formats"| node_io_lib
node_io_lib -->|"standard codecs"| node_codecs_lib
node_io_lib -->|"camera RAW"| node_raw_lib
node_psd_lib -.->|"maps to model"| node_doc_lib
node_automation_lib -->|"exposes MCP tools"| node_automation_server
node_automation_lib -->|"envelope"| node_automation_rpc
node_automation_server -->|"tools call session"| node_automation_headless
node_automation_rpc -->|"requests"| node_automation_headless
node_automation_headless -->|"Session::execute"| node_engine_lib
node_automation_bridge -.->|"control protocol"| node_control_server


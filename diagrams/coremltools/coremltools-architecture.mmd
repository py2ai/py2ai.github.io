end

node_convert -->|"validate args, dispatch"| node_mil_convert
node_mil_convert -->|"convert_from=pytorch"| node_torch_load
node_mil_convert -->|"convert_from=tensorflow2"| node_tf2_load
node_mil_convert -->|"convert_to=mlprogram"| node_backend_load
node_mil_convert -->|"convert_to=neuralnetwork"| node_nn_backend
node_torch_load -->|"hand over internal graph"| node_torch_ops
node_torch_ops -->|"get_func&#40;node.kind&#41;"| node_torch_registry
node_torch_ops -->|"emit via mb.*"| node_mil_builder
node_torch_registry -->|"handlers + aliases"| node_torch_ops
node_mil_builder -->|"resolve versioned class"| node_op_registry
node_op_registry -->|"register_op&#40;ios17&#41;"| node_op_conv
node_op_registry -->|"register_op&#40;ios18&#41;"| node_op_sdpa
node_mil_builder -->|"append ops to blocks"| node_mil_program
node_mil_program -->|"run optimization passes"| node_graph_pass
node_graph_pass -->|"fuse activations"| node_silu_fuse
node_graph_pass -->|"fp16-capable IO"| node_adjust_io
node_graph_pass -->|"bake image transforms"| node_insert_preproc
node_graph_pass -->|"finalized program"| node_backend_load
node_backend_load -->|"proto + weights to .mlpackage"| node_mlmodel
node_nn_backend -->|"legacy spec model"| node_mlmodel
node_convert -->|"returns MLModel"| node_mlmodel
node_mlmodel -->|"post-training input"| node_opt_api
node_opt_api -->|"reads configs"| node_opt_config
node_opt_api -->|"runs compression passes"| node_opt_passes
node_opt_passes -->|"insert constexpr_* ops"| node_op_registry


node_hb_api -->|"hb_get_state polling"| node_state_machine
node_hb_api -->|"hb_start -&gt; hb_work_init"| node_work_engine
node_work_engine -->|"adds WORK_READER"| node_reader
node_work_engine -->|"hb_fifo_init sizing"| node_fifo_queues
node_reader -->|"hb_fifo_push"| node_fifo_queues
node_fifo_queues -->|"packet fifos"| node_decoders
node_scan_thread -->|"preview decode via libavcodec"| node_decoders
node_decoders -->|"decoded frames"| node_sync
node_sync -->|"fifo_sync"| node_filters
node_filters -->|"fifo_render"| node_encoders
node_encoders -->|"fifo_out"| node_muxer
node_sync -->|"progress + ETA"| node_state_machine
node_muxer -->|"HB_STATE_WORKDONE"| node_state_machine


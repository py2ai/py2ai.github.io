      "style": "solid"
    },
    {
      "from": "index",
      "to": "index_reader",
      "label": "index.reader() -> IndexReader",
      "style": "solid"
    },
    {
      "from": "index_writer",
      "to": "segment_writer",
      "label": "routes docs to per-thread writers",
      "style": "solid"
    },
    {
      "from": "segment_writer",
      "to": "segment_updater",
      "label": "commit: sealed segment",
      "style": "solid"
    },
    {
      "from": "segment_updater",
      "to": "segments",
      "label": "writes files + meta.json",
      "style": "solid"
    },
    {
      "from": "index_writer",
      "to": "merger",
      "label": "background merge tasks",
      "style": "solid"
    },
    {
      "from": "merger",
      "to": "segments",
      "label": "compacts, purges deletes",
      "style": "solid"
    },
    {
      "from": "segments",
      "to": "directory",
      "label": "stored through Directory",
      "style": "solid"
    },
    {
      "from": "index_reader",
      "to": "segments",
      "label": "reload picks up new files",
      "style": "dashed"
    },
    {
      "from": "index_reader",
      "to": "searcher",
      "label": "searcher() snapshot",
      "style": "solid"
    },
    {
      "from": "searcher",
      "to": "segments",
      "label": "reads via SegmentReader",
      "style": "dashed"
    },
    {
      "from": "query_parser",
      "to": "searcher",
      "label": "Query -> search(query, collector)",
      "style": "solid"
    },
    {
      "from": "searcher",
      "to": "collector",
      "label": "collect(doc, score) per match",
      "style": "solid"
    }
  ]
}

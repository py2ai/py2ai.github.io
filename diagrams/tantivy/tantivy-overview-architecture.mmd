node_schema_builder -->|"build&#40;&#41; then Index::create_in_ram / open"| node_index
node_index -->|"index.writer&#40;mem&#41; -&gt; IndexWriter"| node_index_writer
node_index -->|"index.reader&#40;&#41; -&gt; IndexReader"| node_index_reader
node_index_writer -->|"routes docs to per-thread writers"| node_segment_writer
node_segment_writer -->|"commit: sealed segment"| node_segment_updater
node_segment_updater -->|"writes files + meta.json"| node_segments
node_index_writer -->|"background merge tasks"| node_merger
node_merger -->|"compacts, purges deletes"| node_segments
node_segments -->|"stored through Directory"| node_directory
node_index_reader -.->|"reload picks up new files"| node_segments
node_index_reader -->|"searcher&#40;&#41; snapshot"| node_searcher
node_searcher -.->|"reads via SegmentReader"| node_segments
node_query_parser -->|"Query -&gt; search&#40;query, collector&#41;"| node_searcher
node_searcher -->|"collect&#40;doc, score&#41; per match"| node_collector


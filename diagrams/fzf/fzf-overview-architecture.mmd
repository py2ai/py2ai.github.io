node_core -->|"spawns ReadSource goroutine"| node_reader
node_reader -->|"pusher&#40;line&#41; via ChunkList.Push"| node_chunklist
node_reader -->|"EvtReadNew / EvtReadFin"| node_core
node_core -->|"Snapshot&#40;tail&#41; on data events"| node_chunklist
node_chunklist -->|"retire evicted chunks"| node_chunkcache
node_core -->|"Reset&#40;snapshot, query&#41;"| node_matcher
node_matcher -->|"build and cache Pattern"| node_pattern
node_pattern -->|"bitmap Lookup/Search"| node_chunkcache
node_pattern -->|"run Algo per item"| node_algo
node_matcher -->|"partial results per worker"| node_merger
node_merger -->|"k-way merge by rank"| node_result
node_result -->|"score and offsets feed rank"| node_algo
node_matcher -->|"EvtSearchProgress / EvtSearchFin"| node_core
node_core -->|"UpdateList&#40;MatchResult&#41;"| node_terminal
node_terminal -->|"EvtSearchNew on keystroke"| node_core


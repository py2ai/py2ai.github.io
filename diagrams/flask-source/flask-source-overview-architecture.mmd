node_wsgi_app -->|"environ -&gt; AppContext"| node_request_context
node_request_context -->|"from_environ"| node_appcontext
node_appcontext -->|"push&#40;&#41; on entry"| node_ctx_push
node_ctx_push -->|"context active"| node_full_dispatch
node_ctx_push -->|"match_request binds adapter"| node_url_map
node_full_dispatch -->|"before_request phase"| node_preprocess
node_preprocess -->|"no handler short-circuit"| node_dispatch_request
node_dispatch_request -->|"req.url_rule.endpoint"| node_url_map
node_dispatch_request -->|"view return value"| node_finalize
node_full_dispatch -->|"rv from view or error handler"| node_finalize
node_url_map -->|"dotted endpoints registered at setup"| node_bp_register
node_finalize -->|"response&#40;environ, start_response&#41;"| node_ctx_pop
node_ctx_pop -->|"Iterable&#91;bytes&#93; back to server"| node_wsgi_app


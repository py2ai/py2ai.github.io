  node_metrics_base["Metrics<br/>[Metrics.java]"]
  node_metrics_stream["MetricsStreamProcessor"]
  node_ai_flow["AIAgentSessionFlowRecord"]
  node_genai_eval["GenAIEvaluationRecord"]
end

subgraph group_aggregation["L1 Aggregation Workers"]
  node_agg_worker["MetricsAggregateWorker &#40;L1&#41;"]
  node_merge_cache["MergableBufferedData"]
  node_remote_worker["MetricsRemoteWorker"]
  node_trans_worker["MetricsTransWorker"]
end

subgraph group_persistence["L2 Persistence &amp; Storage"]
  node_persist_worker["MetricsPersistentWorker &#40;L2&#41;"]
  node_min_worker["MetricsPersistentMinWorker"]
  node_record_persist["RecordPersistentWorker"]
  node_batch_dao["IBatchDAO<br/>[IBatchDAO.java]"]
  node_model_registry["ModelRegistry<br/>[ModelRegistry.java]"]
end

subgraph group_query["Query Module &amp; GraphQL"]
  node_query_module["QueryModule<br/>[QueryModule.java]"]
  node_trace_query["TraceQueryService"]
  node_topo_query["TopologyQueryService"]
  node_metrics_query["MetricsQueryService"]
  node_graphql_provider["GraphQLQueryProvider"]
  node_graphql_handler["GraphQLQueryHandler"]
  node_mqe_exec["MQEExecutor<br/>[MQEExecutor.java]"]
end

node_trace_provider -->|"start&#40;&#41; registers gRPC handlers"| node_grpc_register
node_trace_provider -->|"creates the streaming collector"| node_trace_grpc
node_trace_provider -->|"binds REST collector"| node_http_register
node_trace_grpc -->|"parsed Segment sources forwarded"| node_dispatcher
node_trace_rest -->|"REST segments forwarded"| node_dispatcher
node_otel_provider -->|"activates otlp-metrics handler"| node_otel_handler
node_otel_handler -->|"addHandler on shared server"| node_grpc_register
node_otel_handler -->|"export calls processMetricsRequest"| node_otel_processor
node_otel_processor -->|"converted meters enter MAL streams"| node_metrics_stream
node_dispatcher -->|"SEGMENT scope routing"| node_segment_dispatcher
node_segment_dispatcher -->|"forwards to RecordStreamProcessor"| node_segment_record
node_segment_record -->|"segments persisted as records"| node_record_persist
node_dispatcher -->|"OAL dispatchers emit Metrics"| node_metrics_stream
node_dispatcher -->|"AI_AGENT_SESSION_FLOW scope"| node_ai_flow
node_ai_flow -->|"session flows persisted"| node_record_persist
node_genai_eval -->|"evaluation records persisted"| node_record_persist
node_metrics_stream -->|"entryWorkers.get&#40;class&#41;.in&#40;&#41;"| node_agg_worker
node_agg_worker -->|"MergableBufferedData.accept"| node_merge_cache
node_agg_worker -->|"flush pushes to next worker"| node_remote_worker
node_remote_worker -->|"remote _rec channel to L2"| node_min_worker
node_min_worker -->|"extends the L2 worker"| node_persist_worker
node_metrics_base -->|"toHour&#40;&#41;/toDay&#40;&#41; clones"| node_trans_worker
node_trans_worker -->|"hour/day workers persist"| node_persist_worker
node_persist_worker -->|"buildBatchRequests then flush"| node_batch_dao
node_persist_worker -->|"Model registered per stream"| node_model_registry
node_query_module -->|"'query' module provider"| node_graphql_provider
node_graphql_provider -->|"POST /graphql handler"| node_http_register
node_graphql_provider -->|"builds executable schema"| node_graphql_handler
node_graphql_handler -->|"resolvers call services"| node_trace_query
node_graphql_handler -->|"resolvers call services"| node_topo_query
node_graphql_handler -->|"resolvers call services"| node_metrics_query
node_metrics_query -->|"MQE expressions evaluated"| node_mqe_exec


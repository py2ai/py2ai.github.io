flowchart TD

subgraph group_cli["CLI &amp; Quantization"]
  node_cli["lmdeploy CLI<br/>entry"]
  node_lite["lite toolkit"]
end

subgraph group_serve["Serving Layer"]
  node_proxy["model proxy<br/>[proxy.py]"]
  node_api_server["OpenAI API server<br/>entry"]
  node_protocol["API protocol<br/>[protocol.py]"]
  node_async_engine{{"async engine<br/>core"}}
end

subgraph group_engines["Dual Inference Engines"]
  node_pt_engine{{"PyTorch engine<br/>core"}}
  node_agent["model agent<br/>[agent.py]"]
  node_kernels[("PyTorch CUDA kernels")]
  node_tm_engine{{"TurboMind wrapper<br/>core"}}
end

subgraph group_native["TurboMind Native Core"]
  node_scheduler{{"C++ scheduler<br/>core"}}
  node_tm_kernels[("TurboMind CUDA kernels")]
end

node_cli -->|"starts"| node_async_engine
node_cli -->|"invokes"| node_lite
node_proxy -->|"routes to"| node_api_server
node_api_server -->|"validates with"| node_protocol
node_api_server -->|"drives"| node_async_engine
node_async_engine -->|"delegates"| node_pt_engine
node_async_engine -->|"delegates"| node_tm_engine
node_tm_engine -->|"binds via pybind"| node_scheduler
node_scheduler -->|"launches"| node_tm_kernels
node_pt_engine -->|"orchestrates via"| node_agent
node_agent -->|"calls"| node_kernels
node_lite -.->|"quantized weights feed"| node_pt_engine


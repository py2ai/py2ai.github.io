node_cli_cli -->|"dispatches"| node_cli_serve
node_cli_cli -->|"dispatches"| node_cli_chat
node_cli_cli -->|"dispatches"| node_cli_lite
node_cli_serve -->|"launches"| node_api_server
node_cli_chat -->|"streams from"| node_async_engine
node_api_server -->|"validates with"| node_protocol
node_api_server -->|"feeds"| node_async_engine
node_anthropic_router -->|"adapts to"| node_async_engine
node_proxy -.->|"targets"| node_api_server
node_session_mgr -.->|"tracks history for"| node_async_engine
node_vl_engine -.->|"extends"| node_async_engine
node_async_engine -->|"engine=pytorch"| node_pt_engine
node_async_engine -->|"engine=turbomind"| node_tm_wrapper
node_pt_engine -->|"runs"| node_engine_loop
node_engine_loop -->|"serves"| node_engine_instance
node_engine_loop -->|"steps via"| node_agent
node_agent -->|"builds tensors with"| node_inputs_maker
node_agent -->|"attends via"| node_paged
node_agent -->|"updates cache with"| node_fill_kv
node_agent -.->|"routes MLA to"| node_mla
node_dsv2_model -->|"experts via"| node_fused_moe
node_dsv2_model -->|"attention via"| node_mla
node_prefill_sched -->|"admits batches to"| node_agent
node_request -.->|"scheduled by"| node_prefill_sched
node_inputs_maker -.->|"reads state of"| node_request
node_tm_wrapper -->|"converts via"| node_converter
node_tm_wrapper -->|"imported through"| node_bind
node_bind -->|"exposes"| node_engine_cc
node_engine_cc -->|"schedules with"| node_scheduler
node_scheduler -->|"reuses prompts via"| node_prefix_trie
node_scheduler -->|"runs experts with"| node_moe_cu
node_engine_cc -->|"runs recurrent attn"| node_linear_attn
node_cli_lite -->|"runs"| node_lite_calibrate
node_lite_calibrate -->|"statistics feed"| node_lite_awq
node_lite_awq -.->|"quantized checkpoint for"| node_tm_wrapper
node_lite_awq -.->|"quantized checkpoint for"| node_pt_engine


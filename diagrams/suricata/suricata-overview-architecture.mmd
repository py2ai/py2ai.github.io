node_main_loop -->|"dispatch"| node_runmode_dispatch
node_runmode_dispatch -->|"workers mode handler"| node_workers_setup
node_workers_setup -->|"slot 1: ReceiveAFP"| node_afp_recv_loop
node_afp_recv_loop -->|"same thread slot"| node_afp_decode
node_afp_decode -->|"DecodeLinkLayer"| node_decode_eth
node_decode_eth -->|"slot: FlowWorker"| node_flow_worker
node_flow_worker -->|"hash lookup"| node_flow_from_hash
node_flow_worker -->|"Detect&#40;&#41;"| node_detect_fn
node_flow_worker -->|"OutputLoggerLog"| node_output_logger
node_detect_fn -->|"mask + engine list"| node_prefilter_fn
node_prefilter_fn -->|"mpm-algo hs"| node_hs_search
node_hs_search -->|"candidate sids back"| node_detect_fn


subgraph group_author["Authoring Layer"]
  node_stategraph["StateGraph builder<br/>graph authoring"]
  node_func_api["Functional API<br/>entrypoint tasks"]
  node_prebuilt["create_react_agent<br/>ready agent"]
end

subgraph group_engine["Pregel Engine"]
  node_pregel{{"Pregel loop<br/>superstep runtime"}}
  node_loop["Loop driver<br/>plan and execute"]
  node_algo["Applier algorithm<br/>task application"]
  node_tool_node["ToolNode<br/>tool execution"]
  node_interrupt["Interrupts<br/>human in the loop"]
end

subgraph group_state["Channels &amp; State"]
  node_channels[("Channels<br/>state edges")]
end

subgraph group_persist["Persistence"]
  node_checkpoint[("Checkpoint saver<br/>state snapshots")]
  node_store[("Base store<br/>long-term memory")]
  node_sdk["Python and JS SDKs<br/>remote clients"]
end

node_stategraph -->|"reduces state into"| node_channels
node_stategraph -->|"compiles to"| node_pregel
node_func_api -.->|"compiles to"| node_pregel
node_prebuilt -.->|"builds"| node_stategraph
node_pregel -->|"step driver"| node_loop
node_loop -->|"apply writes"| node_algo
node_channels -->|"read values"| node_algo
node_algo -->|"write updates"| node_channels
node_loop -.->|"runs nodes"| node_tool_node
node_loop -.->|"pause points"| node_interrupt
node_loop -->|"save superstep"| node_checkpoint
node_checkpoint -.->|"separate memory"| node_store
node_sdk -.->|"remote runs"| node_pregel


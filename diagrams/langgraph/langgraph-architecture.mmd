node_channels_base -.->|"variants"| node_ephemeral
node_managed -.->|"inject values"| node_loop
node_loop -->|"emit events"| node_stream_mod
node_runtime_mod -.->|"exposes"| node_store_base
node_store_base -.->|"implements"| node_store_memory
node_cache_base -.->|"cached nodes"| node_loop
node_tool_node -.->|"human approval"| node_interrupt_mod
node_cli -.->|"serves"| node_pregel
node_sdk_py -.->|"talks to"| node_cli


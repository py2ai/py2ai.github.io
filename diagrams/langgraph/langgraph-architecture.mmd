flowchart TD

subgraph group_author["Authoring Layer"]
  node_stategraph{{"StateGraph<br/>graph builder"}}
  node_msg_graph["MessagesState<br/>chat state preset"]
  node_node_cls["Node builder<br/>wrapped callables"]
  node_branch_cls["Branch routing<br/>conditional edges"]
  node_func_api["Functional API<br/>entrypoint / tasks"]
  node_types_mod["Command and interrupt<br/>control types"]
  node_prebuilt["create_react_agent<br/>canned agent"]
  node_tool_node["ToolNode<br/>tool dispatch"]
  node_interrupt_mod["interrupt helper<br/>pause and resume"]
end

subgraph group_engine["Pregel Engine"]
  node_pregel{{"Pregel class<br/>compiled runnable"}}
  node_loop["Loop driver<br/>superstep orchestration"]
  node_algo["Applier algorithm<br/>task graph apply"]
  node_io_mod["Pregel IO<br/>input mapping"]
  node_runner["Task runner<br/>executor pool"]
  node_retry["Retry policy<br/>node retries"]
  node_checkpoint_hook["Checkpoint hook<br/>saver calls"]
end

subgraph group_state["Channels &amp; Streaming"]
  node_channels_base["Channel base<br/>update protocol"]
  node_last_value[("LastValue channel<br/>overwrite semantics")]
  node_topic[("Topic channel<br/>accumulate lists")]
  node_binop[("BinaryOperatorAggregate<br/>reducers")]
  node_ephemeral[("EphemeralValue<br/>single-step state")]
  node_managed["Managed values<br/>runtime injected"]
  node_stream_mod["Stream muxer<br/>modes to taps"]
  node_runtime_mod["Runtime context<br/>store and config"]
end

subgraph group_persist["Persistence Layer"]
  node_checkpoint_base{{"BaseCheckpointSaver<br/>saver interface"}}
  node_memory_saver[("InMemorySaver<br/>dev persistence")]
  node_postgres_saver[("PostgresSaver<br/>production saver")]
  node_sqlite_saver[("SqliteSaver<br/>light saver")]
  node_serde["JsonPlusSerializer<br/>type-aware serde"]
  node_store_base[("BaseStore<br/>long-term memory")]
  node_store_memory[("InMemoryStore<br/>dev store")]
  node_cache_base["BaseCache<br/>node output cache"]
end

subgraph group_dist["Distribution"]
  node_cli["langgraph CLI<br/>dev server"]
  node_sdk_py["Python SDK<br/>remote client"]
end

node_msg_graph -.->|"preset state"| node_stategraph

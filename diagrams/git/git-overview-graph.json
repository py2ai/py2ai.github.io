  ],
  "nodes": [
    { "id": "cmd_commit", "label": "cmd_commit", "file": "builtin/commit.c", "path": "builtin/commit.c", "group": "Entry points", "groupId": "g_cli", "desc": "git commit entry point: assembles the new commit object" },
    { "id": "do_read_index", "label": "do_read_index", "file": "read-cache.c", "path": "read-cache.c", "group": "The index", "groupId": "g_index", "desc": "mmaps .git/index (DIRC format) into cache entries" },
    { "id": "odb_write_object_ext", "label": "odb_write_object_ext", "file": "odb.c", "path": "odb.c", "group": "Object database", "groupId": "g_objects", "desc": "hashes content with the repo hash algo and dispatches the write" },
    { "id": "odb_loose_path", "label": "odb_loose_path", "file": "object-file.c", "path": "object-file.c", "group": "Object database", "groupId": "g_objects", "desc": "maps an object id to its loose path objects/ab/cdef..." },
    { "id": "parse_object", "label": "parse_object", "file": "object.c", "path": "object.c", "group": "Object database", "groupId": "g_objects", "desc": "loads and type-checks an object, caching the parsed result" },
    { "id": "repo_get_oid", "label": "repo_get_oid", "file": "object-name.c", "path": "object-name.c", "group": "Object naming", "groupId": "g_names", "desc": "turns rev syntax into an oid with unique-prefix disambiguation" },
    { "id": "refs_resolve_ref_unsafe", "label": "refs_resolve_ref_unsafe", "file": "refs.c", "path": "refs.c", "group": "Refs", "groupId": "g_refs", "desc": "follows symref chains (HEAD to branch) down to a final oid" },
    { "id": "use_pack", "label": "use_pack", "file": "packfile.c", "path": "packfile.c", "group": "Packfiles", "groupId": "g_packs", "desc": "hands out sliding mmap windows over .pack files" },
    { "id": "unpack_entry", "label": "unpack_entry", "file": "packfile.c", "path": "packfile.c", "group": "Packfiles", "groupId": "g_packs", "desc": "inflates packed objects and replays delta chains" },
    { "id": "try_delta", "label": "try_delta", "file": "builtin/pack-objects.c", "path": "builtin/pack-objects.c", "group": "Packfiles", "groupId": "g_packs", "desc": "window/depth-bounded delta search during packing" },
    { "id": "prepare_revision_walk", "label": "prepare_revision_walk", "file": "revision.c", "path": "revision.c", "group": "History walk", "groupId": "g_walk", "desc": "turns pending tips into a bounded commit traversal" },
    { "id": "parse_commit_buffer", "label": "parse_commit_buffer", "file": "commit.c", "path": "commit.c", "group": "History walk", "groupId": "g_walk", "desc": "parses tree and parent lines into commit structs" }
  ],
  "edges": [
    { "from": "cmd_commit", "to": "do_read_index", "label": "index holds the staged tree" },

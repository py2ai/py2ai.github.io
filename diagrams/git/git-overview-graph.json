    { "from": "refs_resolve_ref_unsafe", "to": "parse_object", "label": "tip oid loads its object" },
    { "from": "parse_object", "to": "unpack_entry", "label": "packed objects decoded on demand" },
    { "from": "unpack_entry", "to": "use_pack", "label": "mmap windows over the pack" },

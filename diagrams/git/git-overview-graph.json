    { "id": "g_objects", "name": "Object database", "label": "Content-addressed store" },
    { "id": "g_names", "name": "Object naming", "label": "Rev syntax to oid" },
    { "id": "g_refs", "name": "Refs", "label": "Branches, tags, HEAD" },

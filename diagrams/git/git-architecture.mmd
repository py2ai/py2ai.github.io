node_cmd_commit -->|"hooks, message, index snapshot"| node_prepare_to_commit
node_prepare_to_commit -->|"read staged changes"| node_do_read_index
node_cmd_commit -->|"atomically persist new index"| node_write_locked_index
node_cmd_commit -->|"store blobs, trees, the commit"| node_odb_write_object_ext
node_cmd_commit -->|"advance branch/HEAD ref"| node_refs_update_ref
node_do_read_index -->|"DIRC magic and version bounds"| node_verify_hdr
node_write_locked_index -->|"serialize cache entries"| node_ce_write_entry
node_odb_write_object_ext -->|"loose write under objects/"| node_odb_loose_path
node_odb_loose_path -->|"first hash byte is the dir"| node_fill_loose_path
node_parse_object -->|"re-hash, compare to name"| node_check_object_signature
node_parse_object -->|"dispatch by object type"| node_parse_object_buffer
node_repo_get_oid -->|"hex, refs, @-expressions"| node_get_oid_basic
node_get_oid_basic -->|"ref names become oids"| node_refs_resolve_ref_unsafe
node_repo_get_oid -->|"load and type-check"| node_parse_object
node_repo_get_oid -->|"short hashes stay unambiguous"| node_repo_find_unique_abbrev_r
node_refs_resolve_ref_unsafe -->|"files backend read"| node_files_read_raw_ref
node_refs_resolve_ref_unsafe -->|"reftable backend read"| node_reftable_be_read_raw_ref
node_files_read_raw_ref -->|"loose miss falls to packed-refs"| node_packed_read_raw_ref
node_refs_update_ref -->|"verify old value first"| node_refs_resolve_ref_unsafe
node_parse_object -->|"packed object inflated on demand"| node_unpack_entry
node_unpack_entry -->|"delta base oid to offset"| node_find_pack_entry_one
node_unpack_entry -->|"sliding mmap windows"| node_use_pack
node_cmd_pack_objects -->|"window x depth delta search"| node_try_delta
node_cmd_pack_objects -->|"reuse valid deltas"| node_write_reuse_object
node_try_delta -->|"fresh delta encoded"| node_write_no_reuse_object
node_write_reuse_object -->|"fallback when reuse fails"| node_write_no_reuse_object
node_setup_revisions -->|"args parsed, walk begins"| node_prepare_revision_walk
node_prepare_revision_walk -->|"prune when revs-&gt;limited"| node_limit_list
node_limit_list -->|"excluded ancestors flood"| node_mark_parents_uninteresting
node_prepare_revision_walk -->|"tips parsed via handle_commit"| node_parse_commit_buffer
node_prepare_revision_walk -->|"parents without inflating"| node_parse_commit_in_graph
node_prepare_revision_walk -->|"when topo_order requested"| node_sort_in_topological_order
node_limit_list -->|"each popped commit parsed"| node_parse_commit_buffer
node_parse_commit_buffer -->|"parents looked up for parsing"| node_parse_object


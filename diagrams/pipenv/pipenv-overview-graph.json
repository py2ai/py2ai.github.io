{
  "owner": "pypa",
  "repo": "pipenv",
  "branch": "main",
  "groups": [
    {"id": "cli", "name": "CLI Layer", "label": "Command Surface"},
    {"id": "routines", "name": "Routines", "label": "Install & Lock Routines"},
    {"id": "manifest", "name": "Manifest Layer", "label": "Pipfile & Lockfile"},
    {"id": "resolver", "name": "Resolver", "label": "Resolution Engine"},
    {"id": "env", "name": "Environment", "label": "Virtualenv Management"}
  ],
  "nodes": [

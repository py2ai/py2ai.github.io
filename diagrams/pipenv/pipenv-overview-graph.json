    {"id": "project", "label": "Project Facade", "file": "project.py", "path": "pipenv/project.py", "group": "Manifest Layer", "groupId": "manifest", "desc": "Single Project object owning Pipfile, lockfile, sources and venv", "shape": "box"},
    {"id": "routines_install", "label": "do_install", "file": "install.py", "path": "pipenv/routines/install.py", "group": "Routines", "groupId": "routines", "desc": "Install routine: validates, inits, applies Pipfile, snapshot-restore on failure", "shape": "box"},
    {"id": "routines_lock", "label": "do_lock", "file": "lock.py", "path": "pipenv/routines/lock.py", "group": "Routines", "groupId": "routines", "desc": "Lock routine: per-category resolution with default-constraint chaining", "shape": "box"},
    {"id": "routine_ctx", "label": "RoutineContext", "file": "context.py", "path": "pipenv/routines/context.py", "group": "Routines", "groupId": "routines", "desc": "Typed dataclasses: TargetEnv, InstallPolicy, PackageSelection", "shape": "box"},
    {"id": "pipfile", "label": "Pipfile Loader", "file": "pipfile.py", "path": "pipenv/utils/pipfile.py", "group": "Manifest Layer", "groupId": "manifest", "desc": "Vendored plette-based Pipfile parsing and creation", "shape": "document"},
    {"id": "lockfile", "label": "Lockfile", "file": "lockfile.py", "path": "pipenv/utils/lockfile.py", "group": "Manifest Layer", "groupId": "manifest", "desc": "Pipfile.lock subsystem with atomic writes and pylock.toml seams", "shape": "database"},
    {"id": "resolver_parent", "label": "Resolver (parent)", "file": "resolver.py", "path": "pipenv/utils/resolver.py", "group": "Resolver", "groupId": "resolver", "desc": "Builds requests, spawns the resolver subprocess, mutates lockfile", "shape": "box"},
    {"id": "resolver_main", "label": "Resolver Subprocess", "file": "main.py", "path": "pipenv/resolver/main.py", "group": "Resolver", "groupId": "resolver", "desc": "JSON-file IPC adapter: read request, resolve, write typed response", "shape": "hexagon"},
    {"id": "backend_pip", "label": "PipBackend", "file": "pip.py", "path": "pipenv/resolver/backends/pip.py", "group": "Resolver", "groupId": "resolver", "desc": "Default backend driving vendored pip internals", "shape": "box"},
    {"id": "backend_uv", "label": "UvBackend", "file": "uv.py", "path": "pipenv/resolver/backends/uv.py", "group": "Resolver", "groupId": "resolver", "desc": "Experimental backend that compiles specs for uv", "shape": "box"},
    {"id": "venv", "label": "VenvLocator", "file": "venv_locator.py", "path": "pipenv/utils/venv_locator.py", "group": "Environment", "groupId": "env", "desc": "Slug-and-hash virtualenv naming and discovery", "shape": "database"}

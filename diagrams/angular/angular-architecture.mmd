node_ng_compiler -->|"NgModule codegen"| node_module_compiler
node_ng_compiler -->|"pipe codegen"| node_pipe_compiler
node_compile_component -->|"emits partial declaration"| node_define_component
node_compile_component -->|"standalone providers def"| node_injector_compiler
node_compile_directive -->|"same def format"| node_define_component
node_define_component -->|"partial declaration input"| node_jit_compile
node_jit_compile -->|"linked def boots component"| node_component_ref
node_create_injector -->|"constructs R3Injector"| node_r3_injector
node_inject_fn -->|"standalone token lookup"| node_r3_injector
node_directive_inject -->|"element injector first"| node_node_injector
node_directive_inject -->|"environment fallback"| node_r3_injector
node_node_injector -->|"parent chain terminates"| node_r3_injector
node_define_component -->|"creation block declares views"| node_template_instr
node_define_component -->|"update block steps index"| node_advance_instr
node_define_component -->|"update block binds inputs"| node_property_instr
node_template_instr -->|"instantiates directives"| node_directive_inject
node_property_instr -->|"mutates DOM via Renderer"| node_dom_renderer
node_component_ref -->|"setInput marks host view"| node_mark_dirty
node_detect_changes -->|"refresh per dirty view"| node_refresh_view
node_refresh_view -->|"executes update block"| node_advance_instr
node_refresh_view -->|"executes update block"| node_property_instr
node_mark_dirty -->|"notify&#40;NotificationSource&#41;"| node_cd_scheduler
node_cd_scheduler -->|"tick triggers global check"| node_detect_changes
node_signal_fn -->|"producer writes schedule"| node_cd_scheduler
node_computed_fn -->|"derived signal"| node_signal_fn
node_effect_fn -->|"flushed with refresh"| node_cd_scheduler
node_create_application -->|"spawns root injector"| node_r3_injector
node_create_application -->|"creates ApplicationRef"| node_app_ref
node_app_ref -->|"tick&#40;&#41; consumes notifications"| node_cd_scheduler


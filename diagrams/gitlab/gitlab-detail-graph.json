{
  "owner": "gitlab-org",
  "repo": "gitlab",
  "branch": "master",
  "groups": [
    { "id": "workhorse", "name": "workhorse", "label": "Workhorse (Go front door)" },
    { "id": "railsweb", "name": "railsweb", "label": "Rails web tier" },
    { "id": "policy", "name": "policy", "label": "Authorization policy" },
    { "id": "gitdata", "name": "gitdata", "label": "Git data tier" },
    { "id": "jobs", "name": "jobs", "label": "Sidekiq background jobs" }
  ],
  "nodes": [
    {
      "id": "w_main",
      "label": "workhorse main()",
      "file": "main.go",
      "path": "workhorse/cmd/gitlab-workhorse/main.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "Package main: flag parsing into bootConfig, then run() starts serving"
    },
    {
      "id": "w_upstream",
      "label": "upstream router",
      "file": "upstream.go",
      "path": "workhorse/internal/upstream/upstream.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "upstream struct: routes, round trippers, load shedder; DefaultBackend http://localhost:8080"
    },
    {
      "id": "w_urlprefix",
      "label": "URL prefix stripper",
      "file": "urlprefix.go",
      "path": "workhorse/internal/urlprefix/urlprefix.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "Strips the relative URL root before route matching"
    },
    {
      "id": "w_routes",
      "label": "configureRoutes",
      "file": "routes.go",
      "path": "workhorse/internal/upstream/routes.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "Routing table: git smart HTTP routes, senddata injecters, signing tripper"
    },
    {
      "id": "w_githttp",
      "label": "smart HTTP handlers",
      "file": "git-http.go",
      "path": "workhorse/internal/git/git-http.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "ReceivePack / UploadPack handlers plus repoPreAuthorizeHandler gate"
    },
    {
      "id": "w_archive",
      "label": "archive sender",
      "file": "archive.go",
      "path": "workhorse/internal/git/archive.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "SendArchive streams repository archives, using the local disk cache"
    },
    {
      "id": "w_apiclient",
      "label": "internal API client",
      "file": "api.go",
      "path": "workhorse/internal/api/api.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "PreAuthorizeHandler + failureResponseLimit 32768; Prometheus counter for internal calls"
    },
    {
      "id": "w_proxy",
      "label": "Rails reverse proxy",
      "file": "proxy.go",
      "path": "workhorse/internal/proxy/proxy.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "httputil.ReverseProxy with 32 KiB buffer pool, Gitlab-Workhorse-Proxy-Start stamp"
    },
    {
      "id": "w_secret",
      "label": "signing round tripper",
      "file": "roundtripper.go",
      "path": "workhorse/internal/secret/roundtripper.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "Signs calls to Rails with an HMAC-SHA256 JWT in Gitlab-Workhorse-Api-Request"
    },
    {
      "id": "w_sendfile",
      "label": "send-data honors",
      "file": "sendfile.go",
      "path": "workhorse/internal/sendfile/sendfile.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "Honors the send-data headers Rails emits instead of rendering a body"
    },
    {
      "id": "w_gitaly",
      "label": "Gitaly smart HTTP client",
      "file": "smarthttp.go",
      "path": "workhorse/internal/gitaly/smarthttp.go",
      "group": "workhorse",
      "groupId": "workhorse",
      "desc": "SmartHTTPClient: InfoRefsResponseReader and ReceivePack over gRPC streams"
    },
    {
      "id": "r_ctl",
      "label": "GitHttpController",
      "file": "git_http_controller.rb",
      "path": "app/controllers/repositories/git_http_controller.rb",
      "group": "railsweb",
      "groupId": "railsweb",
      "desc": "info_refs / git_upload_pack / git_receive_pack; SSH_ACTIONS ssh-over-HTTP twins"
    },
    {
      "id": "r_ctlclient",
      "label": "GitHttpClientController",
      "file": "git_http_client_controller.rb",
      "path": "app/controllers/repositories/git_http_client_controller.rb",
      "group": "railsweb",
      "groupId": "railsweb",
      "desc": "Base class: basic auth, parse_repo_path, skip CSRF for git clients"
    },
    {
      "id": "r_request",
      "label": "WorkhorseRequest concern",
      "file": "workhorse_request.rb",
      "path": "app/controllers/concerns/workhorse_request.rb",
      "group": "railsweb",
      "groupId": "railsweb",
      "desc": "Adds before_action verify_workhorse_api! to controllers"
    },
    {
      "id": "r_jwt",
      "label": "WorkhorseAuthenticatable",
      "file": "workhorse_authenticatable.rb",
      "path": "app/controllers/concerns/workhorse_authenticatable.rb",
      "group": "railsweb",
      "groupId": "railsweb",
      "desc": "verify_workhorse_api! delegates to Gitlab::Workhorse.verify_api_request!"
    },
    {
      "id": "r_helper",
      "label": "workhorse helper",
      "file": "workhorse_helper.rb",
      "path": "app/helpers/workhorse_helper.rb",
      "group": "railsweb",
      "groupId": "railsweb",
      "desc": "send_git_blob / send_git_diff / send_git_patch / send_git_archive helpers"
    },
    {
      "id": "r_shell",
      "label": "Gitlab::Shell",
      "file": "shell.rb",
      "path": "lib/gitlab/shell.rb",
      "group": "railsweb",
      "groupId": "railsweb",
      "desc": "Gitlab-Shell-Api-Request JWT, issuer gitlab-shell; header_set? probe"
    },
    {
      "id": "r_project",
      "label": "Project model",
      "file": "project.rb",
      "path": "app/models/project.rb",
      "group": "railsweb",
      "groupId": "railsweb",
      "desc": "Central model; def repository exposes the project's repository"
    },
    {
      "id": "r_repository",
      "label": "Repository model",
      "file": "repository.rb",
      "path": "app/models/repository.rb",
      "group": "railsweb",
      "groupId": "railsweb",
      "desc": "Repository facade; GitalyClient.allow_n_plus_1_calls for hot loops"
    },
    {
      "id": "a_gate",
      "label": "GitAccess#check",
      "file": "git_access.rb",
      "path": "lib/gitlab/git_access.rb",
      "group": "policy",
      "groupId": "policy",
      "desc": "check(cmd, changes) chain; DOWNLOAD/PUSH command lists; INTERNAL_TIMEOUT 50s"
    },
    {
      "id": "a_project",
      "label": "GitAccessProject",
      "file": "git_access_project.rb",
      "path": "lib/gitlab/git_access_project.rb",
      "group": "policy",
      "groupId": "policy",
      "desc": "Project-scoped push and pull rules, subclass of GitAccess"
    },
    {
      "id": "a_wiki",
      "label": "GitAccessWiki",
      "file": "git_access_wiki.rb",
      "path": "lib/gitlab/git_access_wiki.rb",
      "group": "policy",
      "groupId": "policy",
      "desc": "Wiki container rules, subclass of GitAccess"
    },
    {
      "id": "a_design",
      "label": "GitAccessDesign",
      "file": "git_access_design.rb",
      "path": "lib/gitlab/git_access_design.rb",
      "group": "policy",
      "groupId": "policy",
      "desc": "Design Management repository rules, subclass of GitAccess"
    },
    {
      "id": "g_client",
      "label": "GitalyClient",
      "file": "gitaly_client.rb",
      "path": "lib/gitlab/gitaly_client.rb",
      "group": "gitdata",
      "groupId": "gitdata",
      "desc": "Stub cache keyed by storage+address; MAXIMUM_GITALY_CALLS = 30; retry policy capped at 5"
    },
    {
      "id": "g_call",
      "label": "GitalyClient::Call",
      "file": "call.rb",
      "path": "lib/gitlab/gitaly_client/call.rb",
      "group": "gitdata",
      "groupId": "gitdata",
      "desc": "Per-RPC wrapper: circuit_breaker.check! before each Gitaly request"
    },
    {
      "id": "g_gitrepo",
      "label": "Git::Repository facade",
      "file": "repository.rb",
      "path": "lib/gitlab/git/repository.rb",
      "group": "gitdata",
      "groupId": "gitdata",
      "desc": "Instantiates RefService, CommitService, RepositoryService, BlobService clients"
    },
    {
      "id": "g_blob",
      "label": "BlobService",
      "file": "blob_service.rb",
      "path": "lib/gitlab/gitaly_client/blob_service.rb",
      "group": "gitdata",
      "groupId": "gitdata",
      "desc": "Blob RPCs used for raw blob reads"
    },
    {
      "id": "g_pin",
      "label": "pinned Gitaly build",
      "file": "GITALY_SERVER_VERSION",
      "path": "GITALY_SERVER_VERSION",
      "group": "gitdata",
      "groupId": "gitdata",
      "desc": "Root file pinning the exact external Gitaly commit (a 40-char SHA)"
    },
    {
      "id": "s_appworker",
      "label": "ApplicationWorker",
      "file": "application_worker.rb",
      "path": "app/workers/concerns/application_worker.rb",
      "group": "jobs",
      "groupId": "jobs",
      "desc": "Sidekiq base concern; SAFE_PUSH_BULK_LIMIT = 1000"
    },
    {
      "id": "s_postreceive",
      "label": "PostReceive",
      "file": "post_receive.rb",
      "path": "app/workers/post_receive.rb",
      "group": "jobs",
      "groupId": "jobs",
      "desc": "Legacy wrapper: urgency high, retry 3, delegates to Repositories::PostReceiveWorker"
    },
    {
      "id": "s_postrecv",
      "label": "Repositories::PostReceiveWorker",
      "file": "post_receive_worker.rb",
      "path": "app/workers/repositories/post_receive_worker.rb",
      "group": "jobs",
      "groupId": "jobs",
      "desc": "Parses pushed changes and routes wiki, project, snippet or design follow-ups"
    }
  ],
  "edges": [

    { "from": "w_routes", "to": "w_secret", "label": "signing tripper" },
    { "from": "w_routes", "to": "w_archive", "label": "SendArchive injecter" },
    { "from": "w_githttp", "to": "w_apiclient", "label": "repoPreAuthorizeHandler" },
    { "from": "w_githttp", "to": "w_gitaly", "label": "gRPC pack streams" },
    { "from": "w_apiclient", "to": "r_ctl", "label": "auth verdict JSON" },

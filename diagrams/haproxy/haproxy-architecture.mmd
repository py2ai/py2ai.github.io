node_main -->|"loads config"| node_read_cfg
node_read_cfg -->|"per cfg file"| node_parse_cfg
node_parse_cfg -->|"listen sections"| node_cfg_parse_listen
node_cfg_parse_listen -->|"'bind' keyword"| node_proxy_parse_bind
node_cfg_parse_listen -->|"'stick-table' keyword"| node_proxy_parse_stick_table
node_main -->|"binds listeners"| node_protocol_bind_all
node_main -->|"starts threads"| node_run_thread_poll_loop
node_run_thread_poll_loop -->|"runs"| node_run_poll_loop
node_run_poll_loop -->|"drains run queue"| node_process_runnable_tasks
node_process_runnable_tasks -->|"budgeted execution"| node_run_tasks_from_lists
node_run_poll_loop -->|"cur_poller.poll"| node_do_poll
node_do_poll -->|"reports readiness"| node_fd_update_events
node_do_poll -->|"ready listener"| node_listener_accept
node_fd_update_events -->|"wakes tasks"| node_process_stream
node_dequeue_all_listeners -->|"resumes listeners"| node_listener_accept
node_listener_accept -->|"bind_conf-&gt;accept"| node_session_accept_fd
node_session_accept_fd -->|"allocates"| node_session_new
node_session_accept_fd -->|"frontend setup"| node_frontend_accept
node_session_accept_fd -->|"wakes stream"| node_process_stream
node_process_stream -->|"mux rx/tx"| node_h1_process
node_h1_process -->|"parse input"| node_h1_process_demux
node_h1_process -->|"flush output"| node_h1_process_mux
node_process_stream -->|"needs upstream"| node_assign_server_and_queue
node_assign_server_and_queue -->|"resolve server"| node_assign_server
node_assign_server -->|"roundrobin"| node_fwrr_get_next_server
node_assign_server -->|"first available"| node_fas_get_next_server
node_assign_server -->|"leastconn"| node_fwlc_get_next_server
node_assign_server -->|"consistent hash"| node_chash_get_next_server
node_assign_server -->|"map hash"| node_map_get_server_hash
node_assign_server_and_queue -->|"open conn"| node_connect_server
node_connect_server -->|"per-conn dial"| node_do_connect_server
node_do_connect_server -->|"conn ready feeds mux"| node_h1_process
node_proxy_parse_stick_table -->|"create table"| node_stktable_init
node_proxy_parse_stick_table -->|"resolve names"| node_stktable_find_by_name
node_stktable_init -->|"runtime upserts"| node_stktable_store


subgraph group_event["Event Engine"]
  node_run_thread_poll_loop["run_thread_poll_loop<br/>[haproxy.c]"]
  node_run_poll_loop["run_poll_loop<br/>[haproxy.c]"]
  node_do_poll["_do_poll<br/>[ev_epoll.c]"]
end

subgraph group_listeners["Listeners &amp; Sessions"]
  node_listener_accept["listener_accept<br/>[listener.c]"]
  node_session_accept_fd["session_accept_fd<br/>[session.c]"]
end

subgraph group_streams["Streams &amp; H1 Mux"]
  node_process_stream["process_stream<br/>[stream.c]"]
  node_h1_process["h1_process<br/>[mux_h1.c]"]
end

subgraph group_backends["Backend Selection"]
  node_assign_server_and_queue["assign_server_and_queue<br/>[backend.c]"]
  node_connect_server["connect_server<br/>[backend.c]"]
end

node_main -->|"loads config"| node_read_cfg
node_read_cfg -->|"per cfg file"| node_parse_cfg
node_main -->|"starts threads"| node_run_thread_poll_loop
node_run_thread_poll_loop -->|"runs"| node_run_poll_loop
node_run_poll_loop -->|"cur_poller.poll"| node_do_poll
node_do_poll -->|"readiness wakes"| node_listener_accept
node_listener_accept -->|"bind_conf-&gt;accept"| node_session_accept_fd
node_session_accept_fd -->|"wakes stream task"| node_process_stream
node_do_poll -->|"fd events wake tasks"| node_process_stream
node_process_stream -->|"needs upstream"| node_assign_server_and_queue
node_assign_server_and_queue -->|"dials server"| node_connect_server
node_process_stream -->|"drives mux"| node_h1_process
node_connect_server -->|"backend conn I/O"| node_h1_process


{
  "owner": "caddyserver",
  "repo": "caddy",
  "branch": "master",
  "groups": [
    { "id": "cli", "name": "cli", "label": "Entry & CLI" },
    { "id": "core", "name": "core", "label": "Config Core" },
    { "id": "admin", "name": "admin", "label": "Admin API" },
    { "id": "http", "name": "http", "label": "HTTP App" },
    { "id": "tls", "name": "tls", "label": "TLS App" },
    { "id": "handlers", "name": "handlers", "label": "Handlers" }
  ],
  "nodes": [
    {
      "id": "main",
      "label": "cmd.Main",
      "file": "main.go",
      "path": "cmd/main.go",
      "group": "cli",
      "groupId": "cli",
      "desc": "Parses OS args and executes the requested caddy command"
    },
    {
      "id": "cmd_run",
      "label": "cmdRun",
      "file": "commandfuncs.go",
      "path": "cmd/commandfuncs.go",
      "group": "cli",
      "groupId": "cli",
      "desc": "caddy run: loads config, applies it, blocks serving"
    },
    {
      "id": "adapt",
      "label": "Adapter.Adapt",
      "file": "adapter.go",
      "path": "caddyconfig/caddyfile/adapter.go",
      "group": "core",
      "groupId": "core",
      "desc": "Converts a Caddyfile into Caddy's native JSON config"
    },
    {
      "id": "caddy_run",
      "label": "caddy.Run",
      "file": "caddy.go",
      "path": "caddy.go",
      "group": "core",
      "groupId": "core",
      "desc": "Entry point that marshals a Config and loads it"
    },
    {
      "id": "caddy_load",
      "label": "caddy.Load",
      "file": "caddy.go",
      "path": "caddy.go",
      "group": "core",
      "groupId": "core",
      "desc": "Applies JSON config via changeConfig, skipping no-op reloads"
    },
    {
      "id": "admin_listen",
      "label": "DefaultAdminListen",
      "file": "admin.go",
      "path": "admin.go",
      "group": "admin",
      "groupId": "admin",
      "desc": "Local admin endpoint on localhost:2019 for REST config changes"
    },
    {
      "id": "http_app",
      "label": "App.Start",
      "file": "app.go",
      "path": "modules/caddyhttp/app.go",
      "group": "http",
      "groupId": "http",
      "desc": "Builds http.Server per server block, binds listeners"
    },
    {
      "id": "server",
      "label": "Server.ServeHTTP",
      "file": "server.go",
      "path": "modules/caddyhttp/server.go",
      "group": "http",
      "groupId": "http",
      "desc": "Per-request entry: timeouts, logging, ACME challenges"
    },
    {
      "id": "routes",
      "label": "RouteList.Compile",
      "file": "routes.go",
      "path": "modules/caddyhttp/routes.go",
      "group": "handlers",
      "groupId": "handlers",
      "desc": "Compiles routes with match and handle into a middleware chain"
    },
    {
      "id": "matchers",
      "label": "MatchHost / MatchPath",
      "file": "matchers.go",
      "path": "modules/caddyhttp/matchers.go",
      "group": "handlers",
      "groupId": "handlers",
      "desc": "Request matchers that gate which routes run"
    },
    {
      "id": "proxy",
      "label": "reverse_proxy Handler",
      "file": "reverseproxy.go",
      "path": "modules/caddyhttp/reverseproxy/reverseproxy.go",
      "group": "handlers",
      "groupId": "handlers",
      "desc": "Load-balanced proxy loop with retries and health checks"
    },
    {
      "id": "tls_app",
      "label": "TLS.Start",
      "file": "tls.go",
      "path": "modules/caddytls/tls.go",
      "group": "tls",
      "groupId": "tls",
      "desc": "Manages certificates via certmagic: issue, renew, store"
    }
  ],
  "edges": [
    { "from": "main", "to": "cmd_run", "label": "dispatch command" },
    { "from": "cmd_run", "to": "adapt", "label": "LoadConfig adapts Caddyfile" },
    { "from": "cmd_run", "to": "caddy_load", "label": "caddy.Load initial config" },
    { "from": "caddy_run", "to": "caddy_load", "label": "Run delegates to Load" },
    { "from": "caddy_load", "to": "admin_listen", "label": "serve admin API" },
    { "from": "caddy_load", "to": "http_app", "label": "start apps" },
    { "from": "caddy_load", "to": "tls_app", "label": "start apps" },
    { "from": "http_app", "to": "server", "label": "serve listeners" },
    { "from": "server", "to": "routes", "label": "run primary chain" },
    { "from": "routes", "to": "matchers", "label": "anyMatch per route" },
    { "from": "routes", "to": "proxy", "label": "reverse_proxy handler" },
    { "from": "server", "to": "tls_app", "label": "HandleHTTPChallenge" }
  ]
}

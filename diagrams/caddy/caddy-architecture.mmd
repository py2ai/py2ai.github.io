node_main -->|"dispatch 'run'"| node_cmd_run
node_main -->|"dispatch 'start'"| node_cmd_start
node_cmd_start -->|"spawn child process"| node_cmd_run
node_cmd_run -->|"read config file"| node_load_config
node_load_config -->|"adapter 'caddyfile'"| node_adapt
node_adapt -->|"convert directives"| node_httptype
node_cmd_run -->|"caddy.Load&#40;config, true&#41;"| node_caddy_load
node_caddy_run -->|"Run delegates"| node_caddy_load
node_caddy_load -->|"POST /id/config"| node_change_config
node_change_config -->|"unsyncedConfigAccess reload"| node_provision_ctx
node_provision_ctx -->|"swap admin endpoint"| node_admin_replace
node_admin_replace -->|"serve localhost:2019"| node_admin_listen
node_admin_listen -->|"handle API call"| node_admin_access
node_admin_access -->|"mutate config"| node_change_config
node_provision_ctx -->|"start each app"| node_app_start_loop
node_app_start_loop -->|"provision http app"| node_http_app_provision
node_http_app_provision -->|"provision then start"| node_http_app_start
node_app_start_loop -->|"start tls app"| node_tls_start
node_http_app_start -->|"parse listen addrs"| node_parse_addr
node_parse_addr -->|"bind sockets"| node_listen_all
node_http_app_start -->|"Server is the Handler"| node_server_serve
node_server_serve -->|"primary chain"| node_serve_http_inner
node_serve_http_inner -->|"wrapped stack"| node_enforcement
node_enforcement -->|"compiled RouteList"| node_routes_compile
node_routes_compile -->|"one wrap per route"| node_wrap_route
node_wrap_route -->|"anyMatch matchers"| node_match_host
node_wrap_route -->|"anyMatch matchers"| node_match_path
node_wrap_route -->|"reverse_proxy handler"| node_rp_handler
node_wrap_route -->|"file_server handler"| node_fs_serve
node_fileserver_cmd -->|"builds FileServer"| node_fs_serve
node_rp_handler -->|"retry loop"| node_rp_loop
node_rp_loop -->|"send upstream"| node_rp_roundtrip
node_server_serve -->|"conn policies"| node_tls_provision
node_server_serve -->|"HandleHTTPChallenge"| node_tls_start
node_tls_provision -->|"build certmagic config"| node_auto_policy
node_tls_provision -->|"ACME issuers"| node_default_issuers
node_tls_start -->|"t.Manage automate names"| node_auto_policy
node_http_app_start -->|"listenAddr.Listen"| node_listen_all


node_main -->|"dispatch command"| node_cmd_run
node_cmd_run -->|"LoadConfig adapts Caddyfile"| node_adapt
node_cmd_run -->|"caddy.Load initial config"| node_caddy_load
node_caddy_run -->|"Run delegates to Load"| node_caddy_load
node_caddy_load -->|"serve admin API"| node_admin_listen
node_caddy_load -->|"start apps"| node_http_app
node_caddy_load -->|"start apps"| node_tls_app
node_http_app -->|"serve listeners"| node_server
node_server -->|"run primary chain"| node_routes
node_routes -->|"anyMatch per route"| node_matchers
node_routes -->|"reverse_proxy handler"| node_proxy
node_server -->|"HandleHTTPChallenge"| node_tls_app


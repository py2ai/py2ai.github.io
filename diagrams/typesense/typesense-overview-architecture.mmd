flowchart TD

subgraph group_api["HTTP API"]
  node_routes{{"master_server_routes"}}
  node_http_server["HttpServer<br/>[http_server.cpp]"]
  node_core_api["REST handlers<br/>[core_api.cpp]"]
end

subgraph group_cluster["Cluster &amp; Write Path"]
  node_batched_indexer["BatchedIndexer"]
  node_raft_state{{"ReplicationState<br/>[raft_server.cpp]"}}
  node_tsconfig["Config<br/>[tsconfig.h]"]
end

subgraph group_collections["Collections"]
  node_collection_manager["CollectionManager"]
  node_collection["Collection<br/>[collection.cpp]"]
end

subgraph group_engine["Index &amp; Search"]
  node_index{{"Index<br/>[index.cpp]"}}
  node_art["ART trie<br/>[art.h]"]
  node_store[("Store &#40;RocksDB&#41;<br/>[store.h]")]
end

node_routes -->|"registers endpoints"| node_http_server
node_http_server -->|"dispatches requests"| node_core_api
node_core_api -->|"writes via enqueue"| node_batched_indexer
node_batched_indexer -->|"RAFT log"| node_raft_state
node_raft_state -->|"on_apply applies entries"| node_collection
node_core_api -->|"search requests"| node_collection_manager
node_tsconfig -->|"listen address &amp; ports"| node_http_server
node_tsconfig -->|"nodes &amp; data dir"| node_raft_state
node_collection_manager -->|"resolves by name"| node_collection
node_collection -->|"search under read lock"| node_index
node_collection -->|"persist raw documents"| node_store
node_index -->|"token lookup"| node_art
node_index -->|"fetch stored docs"| node_store


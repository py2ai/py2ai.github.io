node_cli_chat -->|"drives"| node_engine
node_cli_serve -->|"exposes"| node_protocol
node_cli_compile -->|"runs"| node_passes
node_cli_compile -->|"compiles"| node_models
node_passes -->|"applies"| node_quant
node_quant -.->|"transforms weights of"| node_models
node_loader -->|"streams weights into"| node_models
node_loader -->|"feeds"| node_engine
node_protocol -->|"validated by"| node_engine_base
node_engine -.->|"extends"| node_engine_base
node_engine -->|"invokes via FFI"| node_cpp_engine
node_cpp_engine -->|"packaged into"| node_mobile


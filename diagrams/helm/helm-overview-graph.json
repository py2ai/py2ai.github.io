{
  "owner": "helm",
  "repo": "helm",
  "branch": "main",
  "groups": [
    { "id": "cli", "name": "CLI", "label": "CLI" },
    { "id": "chart", "name": "Charts", "label": "Charts" },
    { "id": "engine", "name": "Templating Engine", "label": "Templating Engine" },
    { "id": "action", "name": "Actions", "label": "Actions" },
    { "id": "storage", "name": "Release Storage", "label": "Release Storage" },
    { "id": "kube", "name": "Kubernetes Client", "label": "Kubernetes Client" }
  ],
  "nodes": [
    { "id": "main", "label": "main()", "file": "helm.go", "path": "cmd/helm/helm.go", "group": "cli", "groupId": "cli", "desc": "Entry point that builds the root command and executes it" },
    { "id": "root", "label": "NewRootCmd", "file": "root.go", "path": "pkg/cmd/root.go", "group": "cli", "groupId": "cli", "desc": "Assembles every helm subcommand and wires an action.Configuration" },
    { "id": "loader", "label": "loader.LoadDir", "file": "load.go", "path": "pkg/chart/loader/load.go", "group": "chart", "groupId": "chart", "desc": "Reads a chart directory from disk into a Chart object" },
    { "id": "chart_struct", "label": "chart.Chart", "file": "chart.go", "path": "pkg/chart/v2/chart.go", "group": "chart", "groupId": "chart", "desc": "In-memory chart model: metadata, templates, values, dependencies" },
    { "id": "downloader", "label": "ChartDownloader", "file": "chart_downloader.go", "path": "pkg/downloader/chart_downloader.go", "group": "chart", "groupId": "chart", "desc": "Resolves a chart reference and downloads the archive" },
    { "id": "engine", "label": "engine.Render", "file": "engine.go", "path": "pkg/engine/engine.go", "group": "engine", "groupId": "engine", "desc": "Executes Go templates over values to produce manifests" },
    { "id": "install", "label": "Install.Run", "file": "install.go", "path": "pkg/action/install.go", "group": "action", "groupId": "action", "desc": "First-install action: render, build resources, apply, record" },
    { "id": "upgrade", "label": "Upgrade.Run", "file": "upgrade.go", "path": "pkg/action/upgrade.go", "group": "action", "groupId": "action", "desc": "Diff-and-apply action between two release revisions" },
    { "id": "config", "label": "action.Configuration", "file": "action.go", "path": "pkg/action/action.go", "group": "action", "groupId": "action", "desc": "Shared dependency bag: KubeClient, Releases storage, capabilities" },
    { "id": "storage", "label": "storage.Storage", "file": "storage.go", "path": "pkg/storage/storage.go", "group": "storage", "groupId": "storage", "desc": "Release log abstraction over pluggable drivers" },
    { "id": "secrets", "label": "driver.Secrets", "file": "secrets.go", "path": "pkg/storage/driver/secrets.go", "group": "storage", "groupId": "storage", "desc": "Driver that persists each release revision as a Kubernetes Secret" },
    { "id": "kube", "label": "kube.Client", "file": "client.go", "path": "pkg/kube/client.go", "group": "kube", "groupId": "kube", "desc": "Builds and applies resource lists against the API server" }
  ],
  "edges": [
    { "from": "main", "to": "root", "label": "invokes" },
    { "from": "root", "to": "install", "label": "registers install cmd" },
    { "from": "root", "to": "upgrade", "label": "registers upgrade cmd" },
    { "from": "install", "to": "config", "label": "uses" },
    { "from": "upgrade", "to": "config", "label": "uses" },
    { "from": "config", "to": "engine", "label": "renderResources drives" },
    { "from": "config", "to": "storage", "label": "Releases backend" },
    { "from": "config", "to": "kube", "label": "KubeClient" },
    { "from": "storage", "to": "secrets", "label": "default driver" },
    { "from": "install", "to": "loader", "label": "loads chart" },
    { "from": "loader", "to": "chart_struct", "label": "produces" },
    { "from": "downloader", "to": "chart_struct", "label": "fetches remote charts" },
    { "from": "engine", "to": "chart_struct", "label": "renders templates" },
    { "from": "install", "to": "kube", "label": "Build + Create" },
    { "from": "upgrade", "to": "kube", "label": "Build + Update" },
    { "from": "install", "to": "storage", "label": "recordRelease" }
  ]
}

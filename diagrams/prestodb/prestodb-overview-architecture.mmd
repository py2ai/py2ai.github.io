  node_dispatchmanager["DispatchManager"]
  node_sqlparser["SqlParser<br/>[SqlParser.java]"]
  node_analyzer["Analyzer<br/>[Analyzer.java]"]
  node_logicalplanner["LogicalPlanner"]
  node_planfragmenter["PlanFragmenter"]
end

subgraph group_g3["Distributed Execution"]
  node_sqlqueryexecution["SqlQueryExecution"]
  node_sqlqueryscheduler["SqlQueryScheduler"]
  node_remotetask["HttpRemoteTaskFactory"]

  node_exchangeclient["ExchangeClient"]
end

subgraph group_g5["Connector SPI"]
  node_pagesource["ConnectorPageSourceProvider"]
end

node_queuedstatement -->|"submit SQL"| node_dispatchmanager
node_dispatchmanager -->|"dispatch query"| node_sqlqueryexecution
node_sqlqueryexecution -->|"parse SQL"| node_sqlparser
node_sqlqueryexecution -->|"semantic analysis"| node_analyzer
node_sqlqueryexecution -->|"plan + optimize"| node_logicalplanner
node_sqlqueryexecution -->|"fragment into stages"| node_planfragmenter
node_sqlqueryexecution -->|"start scheduling"| node_sqlqueryscheduler
node_sqlqueryscheduler -->|"create remote tasks"| node_remotetask
node_sqlqueryscheduler -->|"read splits via SPI"| node_pagesource
node_remotetask -->|"HTTP page exchange"| node_exchangeclient
node_exchangeclient -->|"stream results"| node_executingstatement


node_cli_main -->|"compile_files feeds source"| node_comp_add_string
node_comp_add_string -->|"yr_lex_parse_rules_string"| node_lexer_entry
node_lexer_entry -->|"tokens: _RULE_, _CONDITION_"| node_grammar_rule
node_grammar_rule -->|"action after identifier"| node_phase_1
node_grammar_rule -->|"action on closing brace"| node_phase_2
node_grammar_rule -->|"strings section"| node_string_decl
node_string_decl -->|"store + index string"| node_write_string
node_grammar_rule -->|"import action"| node_reduce_import
node_write_string -->|"forward + backward code"| node_re_emit
node_write_string -->|"extract atoms"| node_atoms_entry
node_atoms_entry -->|"walk RE AST"| node_atoms_from_re
node_atoms_from_re -->|"score candidates"| node_atoms_quality
node_write_string -->|"atoms join trie"| node_ac_add_string
node_ac_add_string -->|"trie finalized on get_rules"| node_ac_compile
node_ac_compile -->|"step 1: BFS fail links"| node_ac_failure_links
node_ac_compile -->|"step 2: prune links"| node_ac_optimize
node_ac_compile -->|"step 3: flatten table"| node_ac_build_table
node_comp_get_rules -->|"first call compiles"| node_comp_compile_rules
node_comp_compile_rules -->|"automaton into arena"| node_ac_compile
node_comp_get_rules -->|"YR_RULES handed over"| node_cli_scanner
node_rules_scan_mem -->|"legacy wrapper"| node_scan_blocks
node_cli_scanner -->|"scan each target"| node_scan_blocks
node_scan_blocks -->|"per block"| node_ac_loop
node_ac_loop -->|"match_table&#91;state&#93; hit"| node_verify_match
node_verify_match -->|"literal path"| node_verify_literal
node_verify_match -->|"regexp path"| node_verify_re
node_verify_re -->|"STRING_IS_FAST_REGEXP"| node_re_fast
node_verify_re -->|"full fiber engine"| node_re_exec
node_scan_blocks -->|"yr_execute_code after pass"| node_vm_exec
node_vm_exec -->|"enter rule body"| node_op_init_rule
node_op_init_rule -->|"condition bytecode"| node_op_match_rule
node_verify_match -.->|"sets required_eval bitmask"| node_op_init_rule
node_vm_exec -->|"module import"| node_op_import
node_op_import -->|"yr_modules_load"| node_modules_load
node_op_match_rule -->|"CALLBACK_MSG_RULE_MATCHING"| node_cli_scanner


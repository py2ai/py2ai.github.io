end

subgraph group_frontend["Rule Frontend"]
  node_lexer["lexer.l tokens<br/>[lexer.l]"]
  node_grammar["grammar.y actions<br/>[grammar.y]"]
  node_parser["parser.c reductions<br/>[parser.c]"]
end

subgraph group_indexing["Atom Indexing"]
  node_atoms["atoms.c extraction<br/>[atoms.c]"]
  node_automaton["ahocorasick.c<br/>[ahocorasick.c]"]
end

subgraph group_runtime["Scan Runtime"]
  node_compiler["compiler.c get_rules<br/>[compiler.c]"]
  node_rules["rules.c YR_RULES<br/>[rules.c]"]
  node_scanner["scanner.c AC loop<br/>[scanner.c]"]
end

subgraph group_matching["Match Verification &amp; VM"]
  node_scan_verify["scan.c verify<br/>[scan.c]"]
  node_re["re.c regexp engine<br/>[re.c]"]
  node_exec["exec.c VM<br/>[exec.c]"]
end

node_cli -->|"compile_files -&gt; yr_lex_parse_rules_*"| node_lexer
node_lexer -->|"tokens feed bison"| node_grammar
node_grammar -->|"reduction actions"| node_parser
node_parser -->|"yr_atoms_extract_from_re"| node_atoms
node_parser -->|"yr_re_ast_emit_code"| node_re
node_atoms -->|"yr_ac_add_string"| node_automaton
node_automaton -->|"yr_ac_compile into arena"| node_compiler
node_compiler -->|"YR_RULES from arena"| node_rules
node_rules -->|"ac_transition_table + ac_match_table"| node_scanner
node_scanner -->|"match_table hit -&gt; verify"| node_scan_verify
node_scan_verify -->|"regexps via yr_re_exec"| node_re
node_scanner -->|"yr_execute_code after pass"| node_exec
node_exec -->|"CALLBACK_MSG_RULE_MATCHING"| node_cli


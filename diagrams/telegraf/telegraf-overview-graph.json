{
  "owner": "influxdata",
  "repo": "telegraf",
  "branch": "master",
  "groups": [
    { "id": "g1", "name": "inputs", "label": "Inputs" },
    { "id": "g2", "name": "agent", "label": "Agent Core" },
    { "id": "g3", "name": "processing", "label": "Processing" },
    { "id": "g4", "name": "outputs", "label": "Outputs" },
    { "id": "g5", "name": "config", "label": "Configuration" }
  ],
  "nodes": [
    { "id": "main", "label": "telegraf CLI", "file": "main.go", "path": "cmd/telegraf/main.go", "group": "config", "groupId": "g5", "desc": "main() parses global flags and starts the reload loop" },
    { "id": "config", "label": "Config loader", "file": "config.go", "path": "config/config.go", "group": "config", "groupId": "g5", "desc": "Parses TOML files and instantiates every configured plugin" },
    { "id": "cpu", "label": "inputs.cpu", "file": "cpu.go", "path": "plugins/inputs/cpu/cpu.go", "group": "inputs", "groupId": "g1", "desc": "Polled input sampling CPU utilization every interval" },
    { "id": "listener", "label": "inputs.http_listener_v2", "file": "http_listener_v2.go", "path": "plugins/inputs/http_listener_v2/http_listener_v2.go", "group": "inputs", "groupId": "g1", "desc": "Service input that receives pushed metrics over HTTP" },
    { "id": "nvidia", "label": "inputs.nvidia_smi", "file": "nvidia_smi.go", "path": "plugins/inputs/nvidia_smi/nvidia_smi.go", "group": "inputs", "groupId": "g1", "desc": "GPU telemetry from nvidia-smi for AI training hosts" },
    { "id": "agent", "label": "Agent.Run", "file": "agent.go", "path": "agent/agent.go", "group": "agent", "groupId": "g2", "desc": "Wires channels between plugin stages and runs all loops" },
    { "id": "accumulator", "label": "Accumulator", "file": "accumulator.go", "path": "agent/accumulator.go", "group": "agent", "groupId": "g2", "desc": "Turns plugin samples into typed Metrics on the channel" },
    { "id": "processors", "label": "Processors", "file": "running_processor.go", "path": "models/running_processor.go", "group": "processing", "groupId": "g3", "desc": "Apply transforms and filters to in-flight metrics" },
    { "id": "aggregators", "label": "Aggregators", "file": "running_aggregator.go", "path": "models/running_aggregator.go", "group": "processing", "groupId": "g3", "desc": "Collect metrics into period windows and push aggregates" },
    { "id": "running_output", "label": "RunningOutput", "file": "running_output.go", "path": "models/running_output.go", "group": "outputs", "groupId": "g4", "desc": "Buffers metrics per output and writes batches" },
    { "id": "buffer", "label": "Buffer", "file": "buffer.go", "path": "models/buffer.go", "group": "outputs", "groupId": "g4", "desc": "Requeues failed writes; memory or disk-backed" },
    { "id": "outputs", "label": "outputs.*", "file": "influxdb_v2.go", "path": "plugins/outputs/influxdb_v2/influxdb_v2.go", "group": "outputs", "groupId": "g4", "desc": "Serialize and ship metrics to backends" }
  ],
  "edges": [
    { "from": "main", "to": "config", "label": "load config" },
    { "from": "main", "to": "agent", "label": "Run()" },
    { "from": "config", "to": "agent", "label": "AgentConfig" },
    { "from": "cpu", "to": "accumulator", "label": "AddFields" },
    { "from": "nvidia", "to": "accumulator", "label": "AddFields" },
    { "from": "listener", "to": "accumulator", "label": "AddMetric" },
    { "from": "accumulator", "to": "processors", "label": "metrics channel" },
    { "from": "processors", "to": "aggregators", "label": "optional chain" },
    { "from": "aggregators", "to": "running_output", "label": "outputC" },
    { "from": "running_output", "to": "buffer", "label": "batch / requeue" },
    { "from": "buffer", "to": "outputs", "label": "flush batch" },
    { "from": "agent", "to": "outputs", "label": "startOutputs / Connect" }
  ]
}

node_send_message -->|"enqueue SendMessageEnvelope"| node_msg_queue
node_publish_message -->|"enqueue PublishMessageEnvelope"| node_msg_queue
node_msg_queue -->|"await get&#40;&#41;"| node_process_next
node_process_next -->|"intercept before delivery"| node_intervention
node_intervention -.->|"DropMessage aborts fan-out"| node_process_publish
node_process_next -->|"create_task &#40;RPC&#41;"| node_process_send
node_process_next -->|"create_task &#40;event&#41;"| node_process_publish
node_process_next -->|"create_task &#40;ack&#41;"| node_process_response
node_register_factory -->|"lazy factory call"| node_invoke_factory
node_process_send -->|"instantiate on first message"| node_invoke_factory
node_process_send -->|"sender + is_rpc=True"| node_message_ctx
node_process_publish -->|"get_subscribed_recipients"| node_type_subscription
node_type_subscription -->|"is_match&#40;&#41; filter"| node_topic_id
node_type_subscription -->|"map_to_agent&#40;&#41; AgentId"| node_container
node_process_publish -->|"sender + topic_id"| node_message_ctx
node_process_send -->|"await on_message&#40;&#41;"| node_container
node_process_publish -->|"await on_message&#40;&#41;"| node_container
node_process_response -->|"future.set_result resolves"| node_run_stream
node_base_group_chat -->|"run&#40;&#41; drains stream"| node_run_stream
node_run_stream -->|"send_message to manager"| node_group_start
node_run_stream -->|"shutdown after stream"| node_stop_idle
node_group_start -->|"@rpc handle_start"| node_manager
node_manager -->|"next speaker request"| node_request_publish
node_request_publish -->|"@event handle_request"| node_container
node_container -->|"buffered thread"| node_assistant
node_assistant -->|"create / create_stream"| node_chat_client
node_chat_client -->|"concrete client"| node_openai
node_assistant -->|"CreateResult"| node_process_result
node_process_result -->|"FunctionCall batch"| node_tool_exec
node_tool_exec -->|"run_json&#40;&#41;"| node_base_tool
node_tool_exec -->|"execute&#40;&#41; via MCP"| node_workbench
node_container -->|"publish to group topic"| node_agent_response
node_agent_response -->|"@event handle_agent_response"| node_manager
node_manager -->|"check after every turn"| node_termination
node_round_robin_mgr -->|"cyclic next speaker"| node_manager
node_selector_mgr -->|"model-based selection"| node_manager
node_selector_mgr -->|"selector prompt + vote"| node_chat_client
node_swarm_mgr -->|"follows HandoffMessage"| node_manager
node_magentic_one -->|"ledger + progress loop"| node_manager
node_magentic_one -->|"progress ledger check"| node_chat_client


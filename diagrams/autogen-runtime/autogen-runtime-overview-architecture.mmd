node_round_robin -->|"register factories + subscriptions"| node_agent_runtime
node_round_robin -->|"manager factory"| node_group_manager
node_round_robin -->|"participant factory"| node_chat_container
node_agent_runtime -->|"RPC envelope"| node_group_manager
node_agent_runtime -->|"match topic to agent"| node_type_subscription
node_agent_runtime -->|"topic fan-out"| node_chat_container
node_group_manager -->|"publish request"| node_agent_runtime
node_group_manager -->|"check after each turn"| node_termination
node_chat_container -->|"on_messages_stream"| node_assistant
node_assistant -->|"create / create_stream"| node_model_client
node_model_client -->|"implemented by"| node_openai_client
node_assistant -->|"execute FunctionCalls"| node_tools
node_assistant -->|"update_context"| node_memory
node_chat_container -->|"publish response"| node_agent_runtime
node_termination -->|"TaskResult + stop_reason"| node_task_input


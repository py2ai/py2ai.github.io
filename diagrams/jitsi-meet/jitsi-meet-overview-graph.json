{
  "owner": "jitsi",
  "repo": "jitsi-meet",
  "branch": "master",
  "groups": [
    {
      "id": "entry",
      "name": "Bootstrap",
      "label": "Browser entry"
    },
    {
      "id": "shell",
      "name": "React shell",
      "label": "React app shell"
    },
    {
      "id": "state",
      "name": "Redux state",
      "label": "Redux store"
    },
    {
      "id": "bridge",
      "name": "Media and XMPP bridge",
      "label": "lib-jitsi-meet bridge"
    },
    {
      "id": "quality",
      "name": "Quality and LastN",
      "label": "Quality control"
    },
    {
      "id": "embed",
      "name": "External API",
      "label": "Embedding API"
    }
  ],
  "nodes": [
    {
      "id": "index_html",
      "label": "index.html",
      "file": "index.html",
      "path": "index.html",
      "group": "Browser entry",
      "groupId": "entry",
      "desc": "SSI-injects config.js and requires lib-jitsi-meet.min.js plus app.bundle.min.js"
    },
    {
      "id": "app_js",
      "label": "app.js",
      "file": "app.js",
      "path": "app.js",
      "group": "Browser entry",
      "groupId": "entry",
      "desc": "Installs window.APP = {API, conference, UI} and imports the React tree"
    },
    {
      "id": "react_index",
      "label": "react/index.web.js",
      "file": "index.web.js",
      "path": "react/index.web.js",
      "group": "Browser entry",
      "groupId": "entry",
      "desc": "globalNS.entryPoints + renderEntryPoint create a React root and mount App"
    },
    {
      "id": "base_app",
      "label": "BaseApp.tsx",
      "file": "BaseApp.tsx",
      "path": "react/features/base/app/components/BaseApp.tsx",
      "group": "React shell",
      "groupId": "shell",
      "desc": "componentDidMount creates the Redux store and dispatches appWillMount"
    },
    {
      "id": "app_navigate",
      "label": "appNavigate",
      "file": "actions.web.ts",
      "path": "react/features/app/actions.web.ts",
      "group": "Redux store",
      "groupId": "state",
      "desc": "Parses the room URL, loadConfig, then setConfig + setRoom"
    },
    {
      "id": "conference_js",
      "label": "conference.js",
      "file": "conference.js",
      "path": "conference.js",
      "group": "lib-jitsi-meet bridge",
      "groupId": "bridge",
      "desc": "Web glue: conference.init, joinRoom, _createRoom, ConferenceConnector"
    },
    {
      "id": "conn_actions",
      "label": "_connectInternal",
      "file": "actions.any.ts",
      "path": "react/features/base/connection/actions.any.ts",
      "group": "lib-jitsi-meet bridge",
      "groupId": "bridge",
      "desc": "news JitsiMeetJS.JitsiConnection and waits for CONNECTION_ESTABLISHED"
    },
    {
      "id": "conf_actions",
      "label": "createConference",
      "file": "actions.any.ts",
      "path": "react/features/base/conference/actions.any.ts",
      "group": "lib-jitsi-meet bridge",
      "groupId": "bridge",
      "desc": "connection.initJitsiConference + conference.join(password)"
    },
    {
      "id": "tracks_actions",
      "label": "createLocalTracksA",
      "file": "actions.any.ts",
      "path": "react/features/base/tracks/actions.any.ts",
      "group": "Redux store",
      "groupId": "state",
      "desc": "getUserMedia results land in base/tracks via trackAdded"
    },
    {
      "id": "lastn_middleware",
      "label": "LastN middleware",
      "file": "middleware.ts",
      "path": "react/features/base/lastn/middleware.ts",
      "group": "Quality control",
      "groupId": "quality",
      "desc": "Debounced _updateLastN: startLastN, channelLastN, audioOnly or filmstrip overrides"
    },
    {
      "id": "vidqual_subscriber",
      "label": "receiver constraints",
      "file": "subscriber.ts",
      "path": "react/features/video-quality/subscriber.ts",
      "group": "Quality control",
      "groupId": "quality",
      "desc": "Builds lastN + per-source maxHeight and calls conference.setReceiverConstraints"
    },
    {
      "id": "ext_api",
      "label": "JitsiMeetExternalAPI",
      "file": "external_api.js",
      "path": "modules/API/external/external_api.js",
      "group": "External API",
      "groupId": "embed",
      "desc": "iframe embedding: executeCommand, addEventListener, dispose"
    }
  ],
  "edges": [
    {
      "from": "index_html",
      "to": "app_js",
      "label": "loads app.bundle.min.js"
    },
    {
      "from": "app_js",
      "to": "react_index",
      "label": "import './react'"
    },
    {
      "from": "react_index",
      "to": "base_app",
      "label": "renderEntryPoint(App)"
    },
    {
      "from": "base_app",
      "to": "app_navigate",
      "label": "componentDidMount dispatches appNavigate"
    },
    {
      "from": "app_navigate",
      "to": "conference_js",
      "label": "setRoom triggers conference.init"
    },
    {
      "from": "conference_js",
      "to": "tracks_actions",
      "label": "createInitialLocalTracks"
    },
    {
      "from": "conference_js",
      "to": "conn_actions",
      "label": "dispatch(connect())"
    },
    {
      "from": "conn_actions",
      "to": "conf_actions",
      "label": "CONNECTION_ESTABLISHED"
    },
    {
      "from": "conf_actions",
      "to": "lastn_middleware",
      "label": "CONFERENCE_JOINED"
    },
    {
      "from": "tracks_actions",
      "to": "vidqual_subscriber",
      "label": "base/tracks listeners"
    },
    {
      "from": "lastn_middleware",
      "to": "vidqual_subscriber",
      "label": "lastN feeds constraints"
    },
    {
      "from": "vidqual_subscriber",
      "to": "conf_actions",
      "label": "setReceiverConstraints"
    },
    {
      "from": "ext_api",
      "to": "index_html",
      "label": "wraps the page in an iframe"
    },
    {
      "from": "ext_api",
      "to": "conference_js",
      "label": "executeCommand reaches redux"
    }
  ]
}

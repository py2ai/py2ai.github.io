node_index_html -->|"loads app.bundle.min.js"| node_app_js
node_index_html -->|"provides the JitsiMeetJS global"| node_lib_index
node_app_js -->|"import './react'"| node_react_index
node_react_index -->|"renderEntryPoint&#40;App&#41;"| node_base_app
node_base_app -->|"createStore with feature middlewares"| node_middleware_registry
node_base_app -->|"dispatch&#40;appWillMount&#41;"| node_app_willmount
node_app_willmount -->|"APP.API.init&#40;&#41;"| node_api_js
node_base_app -->|"componentDidMount opens the URL"| node_app_navigate
node_app_navigate -->|"loadConfig&#40;url&#41;"| node_load_config
node_app_navigate -->|"setConfig + setRoom"| node_conference_js
node_lib_actions -->|"JitsiMeetJS.init&#40;config&#41;"| node_lib_index
node_conference_js -->|"dispatch&#40;connect&#40;&#41;&#41;"| node_conn_web
node_conn_web -->|"delegates to _connectInternal"| node_conn_actions
node_conn_actions -->|"JitsiConnectionEvents"| node_lib_index
node_conn_actions -->|"CONNECTION_ESTABLISHED"| node_conf_middleware
node_conn_middleware -->|"APP.connection set for _createRoom"| node_conference_js
node_conference_js -->|"createInitialLocalTracks"| node_tracks_actions
node_tracks_actions -->|"trackAdded, TRACK_ADDED"| node_tracks_reducer
node_conference_js -->|"_createRoom joins via room.join"| node_conf_actions
node_conf_actions -->|"getConferenceOptions + sendLocalParticipant"| node_conf_functions
node_conf_actions -->|"_conferenceWillJoin sets joining"| node_conf_reducer
node_conf_middleware -->|"CONFERENCE_JOINED sets conference"| node_conf_reducer
node_conf_middleware -->|"web join is driven by conference.js"| node_conference_js
node_conf_middleware -->|"CONFERENCE_JOINED seen by every middleware"| node_lastn_middleware
node_conf_middleware -->|"conference events surface to the API"| node_extapi_middleware
node_lastn_middleware -->|"dispatch&#40;setLastN&#41;"| node_lastn_actions
node_lastn_actions -->|"lastN state listener"| node_vidqual_subscriber
node_vidqual_actions -->|"maxReceiverVideoQuality state"| node_vidqual_subscriber
node_tracks_actions -->|"base/tracks listeners"| node_vidqual_subscriber
node_vidqual_subscriber -->|"setReceiverConstraints / setSenderVideoConstraint"| node_conf_actions
node_lib_index -->|"JitsiMediaConnectivityStatus"| node_media_connectivity
node_tracks_actions -->|"participant and track state listeners"| node_largevideo_sub
node_largevideo_actions -->|"on-stage participant id"| node_largevideo_sub
node_largevideo_sub -->|"VideoLayout.updateLargeVideo"| node_videolayout
node_videolayout -->|"largeVideo = new LargeVideoManager&#40;&#41;"| node_largevideo_mgr
node_external_api -->|"wraps the page in an iframe"| node_index_html
node_external_api -->|"_setupListeners via transport"| node_transport
node_external_api -->|"executeCommand reaches API.js"| node_api_js
node_api_js -->|"APP.store.dispatch&#40;commands&#41;"| node_middleware_registry
node_api_js -->|"setAssumedBandwidthBps"| node_conf_middleware
node_extapi_middleware -->|"APP.API.notify* out to the parent"| node_api_js


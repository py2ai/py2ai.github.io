    {"from": "app", "to": "running", "label": "start_init_validated"},
    {"from": "file", "to": "remap", "label": "log lines"},
    {"from": "demo_logs", "to": "remap", "label": "syslog events"},
    {"from": "otel", "to": "remap", "label": "OTLP events"},
    {"from": "remap", "to": "console", "label": "parsed events"},
    {"from": "remap", "to": "kafka", "label": "routed events"}

{
  "owner": "vectordotdev",
  "repo": "vector",
  "branch": "master",
  "groups": [
    {"id": "g_config", "name": "configuration", "label": "Configuration"},
    {"id": "g_runtime", "name": "runtime", "label": "Runtime"},
    {"id": "g_sources", "name": "sources", "label": "Sources"},
    {"id": "g_transforms", "name": "transforms", "label": "Transforms"},
    {"id": "g_sinks", "name": "sinks", "label": "Sinks"}
  ],
  "nodes": [
    {"id": "loader", "label": "Config Loader", "file": "loader", "path": "src/config/loading/mod.rs", "group": "configuration", "groupId": "g_config", "desc": "Discovers config paths and turns files into a parsed Config."},
    {"id": "config", "label": "Config", "file": "config", "path": "src/config/mod.rs", "group": "configuration", "groupId": "g_config", "desc": "The whole topology as data: sources, transforms, sinks, and globals."},
    {"id": "validation", "label": "Validation", "file": "validation", "path": "src/config/validation.rs", "group": "configuration", "groupId": "g_config", "desc": "Checks names, shape, resources, and outputs before anything starts."},
    {"id": "builder", "label": "Topology Builder", "file": "builder", "path": "src/topology/builder.rs", "group": "runtime", "groupId": "g_runtime", "desc": "Assembles a validated Config into runnable topology pieces."},
    {"id": "running", "label": "Running Topology", "file": "running", "path": "src/topology/running.rs", "group": "runtime", "groupId": "g_runtime", "desc": "Owns live components and drives reload and shutdown."},
    {"id": "app", "label": "Application", "file": "app", "path": "src/app.rs", "group": "runtime", "groupId": "g_runtime", "desc": "Bootstraps the process from CLI options to a running topology."},
    {"id": "file", "label": "File Source", "file": "file", "path": "src/sources/file.rs", "group": "sources", "groupId": "g_sources", "desc": "Tails files and emits raw log lines."},
    {"id": "otel", "label": "OpenTelemetry Source", "file": "config", "path": "src/sources/opentelemetry/config.rs", "group": "sources", "groupId": "g_sources", "desc": "Receives OTLP logs, metrics, and traces over gRPC or HTTP."},
    {"id": "demo_logs", "label": "Demo Logs Source", "file": "demo_logs", "path": "src/sources/demo_logs.rs", "group": "sources", "groupId": "g_sources", "desc": "Generates sample syslog events for quickstarts."},
    {"id": "remap", "label": "Remap Transform", "file": "remap", "path": "src/transforms/remap.rs", "group": "transforms", "groupId": "g_transforms", "desc": "Runs VRL programs to parse, shape, and enrich events."},
    {"id": "console", "label": "Console Sink", "file": "config", "path": "src/sinks/console/config.rs", "group": "sinks", "groupId": "g_sinks", "desc": "Prints events to stdout or a file."},
    {"id": "kafka", "label": "Kafka Sink", "file": "config", "path": "src/sinks/kafka/config.rs", "group": "sinks", "groupId": "g_sinks", "desc": "Streams events to Kafka topics."}

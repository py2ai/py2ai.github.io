    { "id": "osscan", "label": "OSScan::os_scan", "file": "osscan2.cc", "path": "osscan2.cc", "group": "detection", "groupId": "detection", "desc": "Chunks hosts and fingerprints TCP/IP stacks" },
    { "id": "open_nse", "label": "open_nse", "file": "nse_main.cc", "path": "nse_main.cc", "group": "nse", "groupId": "nse", "desc": "Boots the embedded Lua 5.4 VM for NSE" },
    { "id": "nse_main_lua", "label": "main(hosts)", "file": "nse_main.lua", "path": "nse_main.lua", "group": "nse", "groupId": "nse", "desc": "Generates prerule/hostrule/portrule/postrule script threads" }

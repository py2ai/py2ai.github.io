node_runner -->|"registers settings"| node_settings
node_runner -->|"boots"| node_agent
node_agent -->|"resolves configs"| node_compiler
node_agent -->|"converge diff"| node_state_resolver
node_agent -->|"spawns chain thread"| node_worker_loop_thread
node_agent -->|"scopes metrics"| node_collector
node_agent -->|"starts HTTP API"| node_webserver
node_lscl_grammar -->|"generates parser"| node_lscl_parser
node_compiler -->|"parses DSL via"| node_lscl_parser
node_config_compiler_java -->|"supplies compiled IR"| node_worker_loop
node_worker_loop_thread -->|"drives run&#40;&#41;"| node_worker_loop
node_worker_loop -->|"pulls batches"| node_queue_read_client
node_jruby_acked_read -->|"extends base"| node_queue_read_client
node_queue_read_client -->|"yields QueueBatch"| node_memory_read_batch
node_periodic_flush -->|"requests flush"| node_worker_loop
node_settings -->|"selects queue.type"| node_queue_factory
node_queue_factory -->|"returns memory queue"| node_jruby_sync_queue
node_queue_factory -->|"builds persisted queue"| node_queue
node_queue -->|"checkpoints pages"| node_checkpoint
node_queue -->|"backs reads"| node_jruby_acked_read
node_worker_loop -->|"invokes filter&#40;event&#41;"| node_filters_base
node_worker_loop -->|"executes outputs"| node_outputs_base
node_inputs_base -->|"writes through queue clients"| node_queue_factory
node_outputs_base -->|"persists failures"| node_dlq_writer
node_dlq_factory -->|"getWriter&#40;&#41;"| node_dlq_writer
node_dlq_writer -->|"usage polled"| node_dlq_poller
node_collector -->|"stores counters"| node_metric_store
node_pq_poller -->|"samples disk stats"| node_queue
node_webserver -->|"mounts API modules"| node_node_stats
node_node_stats -->|"reads metrics"| node_metric_store
node_worker_loop -->|"increments counters"| node_collector


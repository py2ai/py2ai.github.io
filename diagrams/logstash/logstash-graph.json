{
  "owner": "elastic",
  "repo": "logstash",
  "branch": "main",
  "groups": [
    {"id": "g_boot", "name": "bootstrap", "label": "Bootstrap"},
    {"id": "g_conf", "name": "config", "label": "Config Compilation"},
    {"id": "g_sched", "name": "convergence", "label": "Convergence"},
    {"id": "g_exec", "name": "execution", "label": "Java Execution"},
    {"id": "g_queue", "name": "queues", "label": "Queues"},
    {"id": "g_plugin", "name": "plugins", "label": "Plugin DSL"},
    {"id": "g_dlq", "name": "dlq", "label": "Dead Letter Queue"},
    {"id": "g_obs", "name": "observability", "label": "Observability"}
  ],
  "nodes": [
    {"id": "runner", "label": "Runner", "file": "runner", "path": "logstash-core/lib/logstash/runner.rb", "group": "bootstrap", "groupId": "g_boot", "shape": "box", "desc": "Clamp command-line entry point (LogStash::Runner) that validates flags and boots the agent."},
    {"id": "settings", "label": "Settings", "file": "settings", "path": "logstash-core/lib/logstash/settings.rb", "group": "bootstrap", "groupId": "g_boot", "shape": "box", "desc": "Typed settings registry with strict whitelisting of per-chain overrides."},
    {"id": "agent", "label": "Agent", "file": "agent", "path": "logstash-core/lib/logstash/agent.rb", "group": "convergence", "groupId": "g_sched", "shape": "hexagon", "desc": "Converges running state toward desired configs, spawning and stopping event chains."},
    {"id": "state_resolver", "label": "State Resolver", "file": "state_resolver", "path": "logstash-core/lib/logstash/state_resolver.rb", "group": "convergence", "groupId": "g_sched", "shape": "box", "desc": "Computes the diff between running and desired chain states on every convergence."},
    {"id": "worker_loop_thread", "label": "Worker Thread", "file": "worker_loop_thread", "path": "logstash-core/lib/logstash/worker_loop_thread.rb", "group": "convergence", "groupId": "g_sched", "shape": "box", "desc": "Ruby Thread subclass that hosts one Java WorkerLoop per worker."},
    {"id": "compiler", "label": "LSCL Compiler", "file": "compiler", "path": "logstash-core/lib/logstash/compiler.rb", "group": "config", "groupId": "g_conf", "shape": "box", "desc": "Ruby compiler: parses the Logstash DSL through the LSCL treetop grammar."},
    {"id": "lscl_grammar", "label": "LSCL Grammar", "file": "lscl_grammar", "path": "logstash-core/lib/logstash/compiler/lscl/lscl_grammar.treetop", "group": "config", "groupId": "g_conf", "shape": "document", "desc": "Treetop grammar defining the Logstash config syntax."},
    {"id": "lscl_parser", "label": "LSCL Parser", "file": "lscl_parser", "path": "logstash-core/lib/logstash/compiler/lscl/lscl_grammar.rb", "group": "config", "groupId": "g_conf", "shape": "box", "desc": "Generated parser class LogStashCompilerLSCLGrammarParser."},
    {"id": "config_compiler_java", "label": "Java IR Compiler", "file": "config_compiler_java", "path": "logstash-core/src/main/java/org/logstash/config/ir/ConfigCompiler.java", "group": "config", "groupId": "g_conf", "shape": "box", "desc": "Java-side compiler (compileSources) turning config sources into executable IR."},
    {"id": "worker_loop", "label": "Worker Loop", "file": "worker_loop", "path": "logstash-core/src/main/java/org/logstash/execution/WorkerLoop.java", "group": "execution", "groupId": "g_exec", "shape": "hexagon", "desc": "Java worker: reads batches, runs compute iteration, closes batches until shutdown."},
    {"id": "queue_read_client", "label": "Queue Read Client", "file": "queue_read_client", "path": "logstash-core/src/main/java/org/logstash/execution/QueueReadClientBase.java", "group": "execution", "groupId": "g_exec", "shape": "box", "desc": "Base JRuby queue client implementing readBatch and closeBatch."},
    {"id": "jruby_acked_read", "label": "Acked Read Client", "file": "jruby_acked_read", "path": "logstash-core/src/main/java/org/logstash/ext/JrubyAckedReadClientExt.java", "group": "execution", "groupId": "g_exec", "shape": "box", "desc": "Read client for the persisted queue extending QueueReadClientBase."},
    {"id": "memory_read_batch", "label": "Memory Read Batch", "file": "memory_read_batch", "path": "logstash-core/src/main/java/org/logstash/execution/MemoryReadBatch.java", "group": "execution", "groupId": "g_exec", "shape": "box", "desc": "In-memory QueueBatch implementation handed to workers."},
    {"id": "periodic_flush", "label": "Periodic Flush", "file": "periodic_flush", "path": "logstash-core/src/main/java/org/logstash/execution/PeriodicFlush.java", "group": "execution", "groupId": "g_exec", "shape": "box", "desc": "Background timer that requests periodic flush ticks via an AtomicBoolean."},
    {"id": "jruby_sync_queue", "label": "In-Memory Queue", "file": "jruby_sync_queue", "path": "logstash-core/src/main/java/org/logstash/ext/JrubyWrappedSynchronousQueueExt.java", "group": "execution", "groupId": "g_exec", "shape": "database", "desc": "In-memory queue wrapper backed by an ArrayBlockingQueue."},
    {"id": "queue_factory", "label": "Queue Factory", "file": "queue_factory", "path": "logstash-core/src/main/java/org/logstash/ackedqueue/QueueFactoryExt.java", "group": "queues", "groupId": "g_queue", "shape": "box", "desc": "Creates memory or persisted queues based on the queue.type setting."},
    {"id": "queue", "label": "Persisted Queue", "file": "queue", "path": "logstash-core/src/main/java/org/logstash/ackedqueue/Queue.java", "group": "queues", "groupId": "g_queue", "shape": "database", "desc": "Page-based disk log with checkpoints: the persisted queue engine."},
    {"id": "checkpoint", "label": "Checkpoint", "file": "checkpoint", "path": "logstash-core/src/main/java/org/logstash/ackedqueue/Checkpoint.java", "group": "queues", "groupId": "g_queue", "shape": "database", "desc": "Persisted head page state: sequence numbers and element counts."},
    {"id": "inputs_base", "label": "Inputs Base", "file": "inputs_base", "path": "logstash-core/lib/logstash/inputs/base.rb", "group": "plugins", "groupId": "g_plugin", "shape": "box", "desc": "Base class for input plugins (register/stop lifecycle hooks)."},
    {"id": "filters_base", "label": "Filters Base", "file": "filters_base", "path": "logstash-core/lib/logstash/filters/base.rb", "group": "plugins", "groupId": "g_plugin", "shape": "box", "desc": "Base class for filter plugins: filter(event) and multi_filter(events)."},
    {"id": "outputs_base", "label": "Outputs Base", "file": "outputs_base", "path": "logstash-core/lib/logstash/outputs/base.rb", "group": "plugins", "groupId": "g_plugin", "shape": "box", "desc": "Base class for output plugins delivering batches via multi_receive(events)."},
    {"id": "dlq_writer", "label": "DLQ Writer", "file": "dlq_writer", "path": "logstash-core/src/main/java/org/logstash/common/io/DeadLetterQueueWriter.java", "group": "dlq", "groupId": "g_dlq", "shape": "database", "desc": "Segmented record log (writeEntry) storing events that failed processing."},
    {"id": "dlq_factory", "label": "DLQ Factory", "file": "dlq_factory", "path": "logstash-core/src/main/java/org/logstash/common/DeadLetterQueueFactory.java", "group": "dlq", "groupId": "g_dlq", "shape": "box", "desc": "Per-key DLQ writer registry behind DeadLetterQueueFactory.getWriter."},
    {"id": "collector", "label": "Metrics Collector", "file": "collector", "path": "logstash-core/lib/logstash/instrument/collector.rb", "group": "observability", "groupId": "g_obs", "shape": "box", "desc": "Collects plugin metrics into a namespaced snapshot."},
    {"id": "metric_store", "label": "Metric Store", "file": "metric_store", "path": "logstash-core/lib/logstash/instrument/metric_store.rb", "group": "observability", "groupId": "g_obs", "shape": "database", "desc": "Tree store behind the collector, indexed by namespace paths."},
    {"id": "pq_poller", "label": "PQ Poller", "file": "pq_poller", "path": "logstash-core/lib/logstash/instrument/periodic_poller/pq.rb", "group": "observability", "groupId": "g_obs", "shape": "box", "desc": "Periodic poller sampling persisted-queue disk usage."},
    {"id": "dlq_poller", "label": "DLQ Poller", "file": "dlq_poller", "path": "logstash-core/lib/logstash/instrument/periodic_poller/dlq.rb", "group": "observability", "groupId": "g_obs", "shape": "box", "desc": "Periodic poller sampling DLQ size and storage."},
    {"id": "webserver", "label": "Web Server", "file": "webserver", "path": "logstash-core/lib/logstash/webserver.rb", "group": "observability", "groupId": "g_obs", "shape": "box", "desc": "Rack HTTP server hosting the monitoring API."},
    {"id": "node_stats", "label": "Node Stats API", "file": "node_stats", "path": "logstash-core/lib/logstash/api/modules/node_stats.rb", "group": "observability", "groupId": "g_obs", "shape": "box", "desc": "API module serving /_node/stats snapshots."}
  ],
  "edges": [
    {"from": "runner", "to": "settings", "label": "registers settings"},
    {"from": "runner", "to": "agent", "label": "boots"},
    {"from": "agent", "to": "compiler", "label": "resolves configs"},
    {"from": "agent", "to": "state_resolver", "label": "converge diff"},
    {"from": "agent", "to": "worker_loop_thread", "label": "spawns chain thread"},
    {"from": "agent", "to": "collector", "label": "scopes metrics"},
    {"from": "agent", "to": "webserver", "label": "starts HTTP API"},
    {"from": "lscl_grammar", "to": "lscl_parser", "label": "generates parser"},
    {"from": "compiler", "to": "lscl_parser", "label": "parses DSL via"},
    {"from": "config_compiler_java", "to": "worker_loop", "label": "supplies compiled IR"},
    {"from": "worker_loop_thread", "to": "worker_loop", "label": "drives run()"},
    {"from": "worker_loop", "to": "queue_read_client", "label": "pulls batches"},
    {"from": "jruby_acked_read", "to": "queue_read_client", "label": "extends base"},
    {"from": "queue_read_client", "to": "memory_read_batch", "label": "yields QueueBatch"},
    {"from": "periodic_flush", "to": "worker_loop", "label": "requests flush"},
    {"from": "settings", "to": "queue_factory", "label": "selects queue.type"},
    {"from": "queue_factory", "to": "jruby_sync_queue", "label": "returns memory queue"},
    {"from": "queue_factory", "to": "queue", "label": "builds persisted queue"},
    {"from": "queue", "to": "checkpoint", "label": "checkpoints pages"},
    {"from": "queue", "to": "jruby_acked_read", "label": "backs reads"},
    {"from": "worker_loop", "to": "filters_base", "label": "invokes filter(event)"},
    {"from": "worker_loop", "to": "outputs_base", "label": "executes outputs"},
    {"from": "inputs_base", "to": "queue_factory", "label": "writes through queue clients"},
    {"from": "outputs_base", "to": "dlq_writer", "label": "persists failures"},
    {"from": "dlq_factory", "to": "dlq_writer", "label": "getWriter()"},
    {"from": "dlq_writer", "to": "dlq_poller", "label": "usage polled"},
    {"from": "collector", "to": "metric_store", "label": "stores counters"},
    {"from": "pq_poller", "to": "queue", "label": "samples disk stats"},
    {"from": "webserver", "to": "node_stats", "label": "mounts API modules"},
    {"from": "node_stats", "to": "metric_store", "label": "reads metrics"},
    {"from": "worker_loop", "to": "collector", "label": "increments counters"}
  ]
}

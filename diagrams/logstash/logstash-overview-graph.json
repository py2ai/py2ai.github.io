{
  "owner": "elastic",
  "repo": "logstash",
  "branch": "main",
  "groups": [
    {"id": "g_cli", "name": "cli", "label": "CLI & Settings"},
    {"id": "g_agent", "name": "agent", "label": "Agent"},
    {"id": "g_input", "name": "inputs", "label": "Inputs"},
    {"id": "g_queue", "name": "queue", "label": "Queue"},
    {"id": "g_filter", "name": "filters", "label": "Filter Workers"},
    {"id": "g_output", "name": "outputs", "label": "Outputs"},
    {"id": "g_obs", "name": "ops", "label": "Ops & Observability"}
  ],
  "nodes": [
    {"id": "runner", "label": "Runner", "file": "runner", "path": "logstash-core/lib/logstash/runner.rb", "group": "cli", "groupId": "g_cli", "shape": "box", "desc": "Clamp command-line entry point that validates flags and boots the agent."},
    {"id": "settings", "label": "Settings", "file": "settings", "path": "logstash-core/lib/logstash/settings.rb", "group": "cli", "groupId": "g_cli", "shape": "box", "desc": "Typed settings registry with strict whitelisting of per-chain overrides."},
    {"id": "agent", "label": "Agent", "file": "agent", "path": "logstash-core/lib/logstash/agent.rb", "group": "agent", "groupId": "g_agent", "shape": "hexagon", "desc": "Converges running state toward desired configs, spawning and stopping event chains."},
    {"id": "compiler", "label": "Compiler", "file": "compiler", "path": "logstash-core/lib/logstash/compiler.rb", "group": "agent", "groupId": "g_agent", "shape": "box", "desc": "Parses the Logstash DSL through the LSCL treetop grammar into executable IR."},
    {"id": "inputs", "label": "Inputs", "file": "inputs_base", "path": "logstash-core/lib/logstash/inputs/base.rb", "group": "inputs", "groupId": "g_input", "shape": "box", "desc": "Base class every input plugin extends to start ingestion."},
    {"id": "queue", "label": "Queue", "file": "queue", "path": "logstash-core/src/main/java/org/logstash/ackedqueue/Queue.java", "group": "queue", "groupId": "g_queue", "shape": "database", "desc": "Page-based disk log with checkpoints: the persisted queue engine."},
    {"id": "worker_loop", "label": "Worker Loop", "file": "worker_loop", "path": "logstash-core/src/main/java/org/logstash/execution/WorkerLoop.java", "group": "filters", "groupId": "g_filter", "shape": "hexagon", "desc": "Java worker: reads batches, runs compute, closes batches until shutdown."},
    {"id": "filters", "label": "Filters", "file": "filters_base", "path": "logstash-core/lib/logstash/filters/base.rb", "group": "filters", "groupId": "g_filter", "shape": "box", "desc": "Base class for filter plugins: filter(event) and multi_filter(events)."},
    {"id": "outputs", "label": "Outputs", "file": "outputs_base", "path": "logstash-core/lib/logstash/outputs/base.rb", "group": "outputs", "groupId": "g_output", "shape": "box", "desc": "Base class for output plugins delivering batches via multi_receive(events)."},
    {"id": "dlq", "label": "Dead Letter Queue", "file": "dlq_writer", "path": "logstash-core/src/main/java/org/logstash/common/io/DeadLetterQueueWriter.java", "group": "outputs", "groupId": "g_output", "shape": "database", "desc": "Segmented record log storing events that failed processing."},
    {"id": "metrics", "label": "Metrics", "file": "collector", "path": "logstash-core/lib/logstash/instrument/collector.rb", "group": "ops", "groupId": "g_obs", "shape": "box", "desc": "Aggregates plugin counters into a namespaced snapshot."},
    {"id": "api", "label": "Monitoring API", "file": "webserver", "path": "logstash-core/lib/logstash/webserver.rb", "group": "ops", "groupId": "g_obs", "shape": "box", "desc": "Rack HTTP server exposing stats and health to operators."}
  ],
  "edges": [
    {"from": "runner", "to": "settings", "label": "loads"},
    {"from": "runner", "to": "agent", "label": "boots"},
    {"from": "agent", "to": "compiler", "label": "parses configs"},
    {"from": "agent", "to": "worker_loop", "label": "spawns workers"},
    {"from": "agent", "to": "inputs", "label": "instantiates plugins"},
    {"from": "inputs", "to": "queue", "label": "writes events"},
    {"from": "settings", "to": "queue", "label": "selects queue.type"},
    {"from": "queue", "to": "worker_loop", "label": "readBatch()"},
    {"from": "worker_loop", "to": "filters", "label": "runs filter(event)"},
    {"from": "filters", "to": "outputs", "label": "emits results"},
    {"from": "outputs", "to": "dlq", "label": "stores failures"},
    {"from": "agent", "to": "metrics", "label": "reports"},
    {"from": "metrics", "to": "api", "label": "served via HTTP"}
  ]
}

{
  "owner": "fluxcd",
  "repo": "flux2",
  "branch": "main",
  "groups": [
    {
      "id": "g_cli",
      "name": "Flux CLI",
      "label": "CLI"
    },
    {
      "id": "g_bootstrap",
      "name": "Bootstrap Orchestration",
      "label": "Bootstrap"
    },
    {
      "id": "g_manifest",
      "name": "Manifest Generation",
      "label": "Manifestgen"
    },
    {
      "id": "g_apply",
      "name": "Cluster Apply & Health",
      "label": "Apply"
    },
    {
      "id": "g_git",
      "name": "GitOps Repository",
      "label": "Git"
    }
  ],
  "nodes": [
    {
      "id": "main",
      "label": "flux binary",
      "file": "main.go",
      "path": "cmd/flux/main.go",
      "group": "g_cli",
      "groupId": "g_cli",
      "desc": "main() wires the cobra command tree for every flux subcommand"
    },
    {
      "id": "bootstrap_cmd",
      "label": "flux bootstrap",
      "file": "bootstrap.go",
      "path": "cmd/flux/bootstrap.go",
      "group": "g_cli",
      "groupId": "g_cli",
      "desc": "installs Flux and wires Git sync in one command"
    },
    {
      "id": "bootstrap_run",
      "label": "bootstrap.Run()",
      "file": "bootstrap.go",
      "path": "pkg/bootstrap/bootstrap.go",
      "group": "g_bootstrap",
      "groupId": "g_bootstrap",
      "desc": "Run() drives repository, components, secret, sync config and health checks"
    },
    {
      "id": "git_provider",
      "label": "GitProviderBootstrapper",
      "file": "bootstrap_provider.go",
      "path": "pkg/bootstrap/bootstrap_provider.go",
      "group": "g_bootstrap",
      "groupId": "g_bootstrap",
      "desc": "creates the GitOps repo and reconciles deploy keys via gitprovider"
    },
    {
      "id": "plain_git",
      "label": "PlainGitBootstrapper",
      "file": "bootstrap_plain_git.go",
      "path": "pkg/bootstrap/bootstrap_plain_git.go",
      "group": "g_bootstrap",
      "groupId": "g_bootstrap",
      "desc": "commits generated manifests, pushes, then applies and waits"
    },
    {
      "id": "install_gen",
      "label": "install.Generate()",
      "file": "install.go",
      "path": "pkg/manifestgen/install/install.go",
      "group": "g_manifest",
      "groupId": "g_manifest",
      "desc": "renders the Flux component manifests from embedded bases"
    },
    {
      "id": "sync_gen",
      "label": "sync.Generate()",
      "file": "sync.go",
      "path": "pkg/manifestgen/sync/sync.go",
      "group": "g_manifest",
      "groupId": "g_manifest",
      "desc": "renders the GitRepository + Kustomization that make Flux sync itself"
    },
    {
      "id": "secret_gen",
      "label": "sourcesecret.GenerateGit()",
      "file": "sourcesecret.go",
      "path": "pkg/manifestgen/sourcesecret/sourcesecret.go",
      "group": "g_manifest",
      "groupId": "g_manifest",
      "desc": "generates the deploy-key Secret for read/write Git access"
    },
    {
      "id": "ssa",
      "label": "utils.Apply()",
      "file": "apply.go",
      "path": "internal/utils/apply.go",
      "group": "g_apply",
      "groupId": "g_apply",
      "desc": "server-side apply in two stages: CRDs/namespaces first, then the rest"
    },
    {
      "id": "controllers",
      "label": "flux-system controllers",
      "file": "kustomization.yaml",
      "path": "manifests/install/kustomization.yaml",
      "group": "g_apply",
      "groupId": "g_apply",
      "desc": "aggregate overlay pulling all seven controller bases into flux-system"
    },
    {
      "id": "status",
      "label": "StatusChecker",
      "file": "status.go",
      "path": "pkg/status/status.go",
      "group": "g_apply",
      "groupId": "g_apply",
      "desc": "polls Ready conditions with kstatus until components are healthy"
    },
    {
      "id": "git_repo",
      "label": "GitOps repo",
      "file": "README.md",
      "path": "README.md",
      "group": "g_git",
      "groupId": "g_git",
      "desc": "the Git repository that becomes the cluster's source of truth"
    }
  ],
  "edges": [
    {
      "from": "main",
      "to": "bootstrap_cmd",
      "label": "registers subcommand"
    },
    {
      "from": "bootstrap_cmd",
      "to": "bootstrap_run",
      "label": "invokes"
    },
    {
      "from": "bootstrap_run",
      "to": "git_provider",
      "label": "provider flow"
    },
    {
      "from": "bootstrap_run",
      "to": "plain_git",
      "label": "plain-git flow"
    },
    {
      "from": "bootstrap_run",
      "to": "install_gen",
      "label": "renders components"
    },
    {
      "from": "bootstrap_run",
      "to": "sync_gen",
      "label": "renders sync manifests"
    },
    {
      "from": "bootstrap_run",
      "to": "secret_gen",
      "label": "renders deploy key"
    },
    {
      "from": "bootstrap_run",
      "to": "ssa",
      "label": "applies manifests"
    },
    {
      "from": "install_gen",
      "to": "ssa",
      "label": "CRDs and namespaces first"
    },
    {
      "from": "git_provider",
      "to": "git_repo",
      "label": "creates repo + deploy key"
    },
    {
      "from": "plain_git",
      "to": "git_repo",
      "label": "commits & pushes"
    },
    {
      "from": "sync_gen",
      "to": "git_repo",
      "label": "committed to Git"
    },
    {
      "from": "ssa",
      "to": "controllers",
      "label": "installs into flux-system"
    },
    {
      "from": "controllers",
      "to": "git_repo",
      "label": "pulls its own manifests back"
    },
    {
      "from": "bootstrap_run",
      "to": "status",
      "label": "polls health"
    },
    {
      "from": "controllers",
      "to": "status",
      "label": "Ready conditions"
    }
  ]
}

    {"id": "query_scheduler", "label": "QueryScheduler", "file": "QueryScheduler.java", "path": "pinot-core/src/main/java/org/apache/pinot/core/query/scheduler/QueryScheduler.java", "group": "ServerQuery", "groupId": "g_server_query", "desc": "Queues and admits server queries (FCFS/priority/token bucket) via processQueryAndSerializeResponse"},

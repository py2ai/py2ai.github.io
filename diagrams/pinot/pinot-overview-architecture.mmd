node_broker_request_handler -->|"getRoutingTable&#40;&#41;"| node_routing_manager
node_broker_request_handler -->|"dispatch query"| node_worker_query_server
node_worker_query_server -->|"submit query"| node_query_scheduler
node_query_scheduler -->|"execute"| node_query_executor
node_query_executor -->|"scan + index lookup"| node_mutable_segment
node_realtime_table_dm -->|"spawn per-partition consumer"| node_realtime_segment_dm
node_realtime_segment_dm -->|"acquire/release partition"| node_consumer_coordinator
node_realtime_segment_dm -->|"index live rows"| node_mutable_segment
node_realtime_segment_dm -->|"commit sealed segment"| node_segment_committer_factory
node_segment_committer_factory -->|"upload segment"| node_segment_uploader
node_segment_uploader -->|"segment ONLINE, rebuild routing"| node_routing_manager
node_mutable_segment -->|"same index creators seal segment"| node_segment_creator


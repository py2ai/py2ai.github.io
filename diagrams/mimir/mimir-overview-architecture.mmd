node_cmd_main -->|"accepts remote-write"| node_dist_push
node_cmd_main -->|"runs in-process"| node_comp_svc
node_dist_push -->|"HA dedup middleware"| node_dist_ha
node_dist_ha -->|"hash-ring route"| node_ing_push
node_ing_push -->|"append to head"| node_ing_tsdb
node_ing_tsdb -->|"cut &amp; compact blocks"| node_ing_ship
node_ing_ship -->|"upload blocks"| node_blocks_bucket
node_blocks_bucket -->|"sync block metas"| node_sgw_gateway
node_sgw_gateway -->|"serve Series"| node_sgw_bucket
node_blocks_bucket -->|"sync block metas"| node_comp_svc
node_comp_svc -->|"plan compactions"| node_comp_job
node_comp_job -->|"upload merged blocks"| node_blocks_bucket
node_comp_svc -->|"prune obsolete"| node_comp_clean


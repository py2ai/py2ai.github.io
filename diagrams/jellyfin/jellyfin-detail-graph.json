{
  "owner": "jellyfin",
  "repo": "jellyfin",
  "branch": "master",
  "groups": [
    { "id": "host", "name": "host", "label": "Host & DI bootstrap" },
    { "id": "api", "name": "api", "label": "HTTP API layer" },
    { "id": "library", "name": "library", "label": "Library item graph" },
    { "id": "session", "name": "session", "label": "Session tracking" },
    { "id": "transcode", "name": "transcode", "label": "Transcoding engine" }
  ],
  "nodes": [
    { "id": "program", "label": "Program.Main", "file": "Program.cs", "path": "Jellyfin.Server/Program.cs", "group": "host", "groupId": "host", "desc": "Main -> StartApp: paths, logging, migrations, then StartServer loop" },
    { "id": "apphost", "label": "ApplicationHost", "file": "ApplicationHost.cs", "path": "Emby.Server.Implementations/ApplicationHost.cs", "group": "host", "groupId": "host", "desc": "Abstract base host: RegisterServices with ~100 singletons, ffmpeg validation" },
    { "id": "coreapphost", "label": "CoreAppHost", "file": "CoreAppHost.cs", "path": "Jellyfin.Server/CoreAppHost.cs", "group": "host", "groupId": "host", "desc": "Concrete host; overrides RegisterServices to add server-only parts" },
    { "id": "startup", "label": "Startup middleware", "file": "Startup.cs", "path": "Jellyfin.Server/Startup.cs", "group": "host", "groupId": "host", "desc": "ConfigureServices -> AddJellyfinApi; UseRouting, MapControllers" },
    { "id": "mediaencoder", "label": "MediaEncoder", "file": "MediaEncoder.cs", "path": "MediaBrowser.MediaEncoding/Encoder/MediaEncoder.cs", "group": "transcode", "groupId": "transcode", "desc": "SetFFmpegPath: CLI switch, encoding.xml, then system PATH; probes codec support" },
    { "id": "encodervalidator", "label": "EncoderValidator", "file": "EncoderValidator.cs", "path": "MediaBrowser.MediaEncoding/Encoder/EncoderValidator.cs", "group": "transcode", "groupId": "transcode", "desc": "Runs ffmpeg -encoders/-decoders/-filters and parses the capability lists" },
    { "id": "imediaencoder", "label": "IMediaEncoder", "file": "IMediaEncoder.cs", "path": "MediaBrowser.Controller/MediaEncoding/IMediaEncoder.cs", "group": "transcode", "groupId": "transcode", "desc": "Contract consumed by controllers and library code for ffmpeg facts" },
    { "id": "itemsctrl", "label": "ItemsController", "file": "ItemsController.cs", "path": "Jellyfin.Api/Controllers/ItemsController.cs", "group": "api", "groupId": "api", "desc": "Item browsing: GetItems applies user-access filtering via InternalItemsQuery" },
    { "id": "videosctrl", "label": "VideosController", "file": "VideosController.cs", "path": "Jellyfin.Api/Controllers/VideosController.cs", "group": "api", "groupId": "api", "desc": "GetVideoStream maps ~50 query params into VideoRequestDto" },
    { "id": "hlsctrl", "label": "DynamicHlsController", "file": "DynamicHlsController.cs", "path": "Jellyfin.Api/Controllers/DynamicHlsController.cs", "group": "api", "groupId": "api", "desc": "master.m3u8: locks on playlist path, starts ffmpeg, waits for min segments" },
    { "id": "hlsseg", "label": "HlsSegmentController", "file": "HlsSegmentController.cs", "path": "Jellyfin.Api/Controllers/HlsSegmentController.cs", "group": "api", "groupId": "api", "desc": "Streams live segments; asks TranscodeManager for the owning job" },
    { "id": "mediainfoctrl", "label": "MediaInfoController", "file": "MediaInfoController.cs", "path": "Jellyfin.Api/Controllers/MediaInfoController.cs", "group": "api", "groupId": "api", "desc": "POST /Items/{id}/PlaybackInfo: the client capability negotiation handshake" },
    { "id": "sessionctrl", "label": "SessionController", "file": "SessionController.cs", "path": "Jellyfin.Api/Controllers/SessionController.cs", "group": "api", "groupId": "api", "desc": "Remote-control surface: Sessions/{id}/Playing forwards SendPlayCommand" },
    { "id": "streaminghelpers", "label": "StreamingHelpers", "file": "StreamingHelpers.cs", "path": "Jellyfin.Api/Helpers/StreamingHelpers.cs", "group": "api", "groupId": "api", "desc": "GetStreamingState builds StreamState from request + media sources" },
    { "id": "librarymgr", "label": "LibraryManager", "file": "LibraryManager.cs", "path": "Emby.Server.Implementations/Library/LibraryManager.cs", "group": "library", "groupId": "library", "desc": "RegisterItem / DeleteItem / GetItemById / ValidateMediaLibrary" },
    { "id": "ilibrarymgr", "label": "ILibraryManager", "file": "ILibraryManager.cs", "path": "MediaBrowser.Controller/Library/ILibraryManager.cs", "group": "library", "groupId": "library", "desc": "Interface injected into controllers keeps the UI out of internals" },
    { "id": "baseitem", "label": "BaseItem", "file": "BaseItem.cs", "path": "MediaBrowser.Controller/Entities/BaseItem.cs", "group": "library", "groupId": "library", "desc": "~3000-line abstract entity: metadata, provider ids, play access" },
    { "id": "video", "label": "Video", "file": "Video.cs", "path": "MediaBrowser.Controller/Entities/Video.cs", "group": "library", "groupId": "library", "desc": "Movie/Episode layer; tracks PrimaryVersionId for alternate editions" },
    { "id": "folder", "label": "Folder", "file": "Folder.cs", "path": "MediaBrowser.Controller/Entities/Folder.cs", "group": "library", "groupId": "library", "desc": "GetChildren / GetRecursiveChildren drive collection browsing" },
    { "id": "librarymonitor", "label": "LibraryMonitor", "file": "LibraryMonitor.cs", "path": "Emby.Server.Implementations/IO/LibraryMonitor.cs", "group": "library", "groupId": "library", "desc": "Filesystem watcher that nudges LibraryManager on changes" },
    { "id": "sessionmgr", "label": "SessionManager", "file": "SessionManager.cs", "path": "Emby.Server.Implementations/Session/SessionManager.cs", "group": "session", "groupId": "session", "desc": "ConcurrentDictionary _activeConnections; OnPlaybackStart/Progress/Stopped fire events" },
    { "id": "sessioninfo", "label": "SessionInfo", "file": "SessionInfo.cs", "path": "MediaBrowser.Controller/Session/SessionInfo.cs", "group": "session", "groupId": "session", "desc": "Per-client state incl. NowPlayingItem and live TranscodingInfo" },
    { "id": "isessionmgr", "label": "ISessionManager", "file": "ISessionManager.cs", "path": "MediaBrowser.Controller/Session/ISessionManager.cs", "group": "session", "groupId": "session", "desc": "Interface other subsystems hold instead of the concrete manager" },
    { "id": "transmgr", "label": "TranscodeManager", "file": "TranscodeManager.cs", "path": "MediaBrowser.MediaEncoding/Transcoding/TranscodeManager.cs", "group": "transcode", "groupId": "transcode", "desc": "StartFfMpeg: permission check, subtitle font extraction, Process spawn" },
    { "id": "itranscodemgr", "label": "ITranscodeManager", "file": "ITranscodeManager.cs", "path": "MediaBrowser.Controller/MediaEncoding/ITranscodeManager.cs", "group": "transcode", "groupId": "transcode", "desc": "Interface injected into controllers keeps job bookkeeping swappable" },
    { "id": "transjob", "label": "TranscodingJob", "file": "TranscodingJob.cs", "path": "MediaBrowser.Controller/MediaEncoding/TranscodingJob.cs", "group": "transcode", "groupId": "transcode", "desc": "One live ffmpeg worker: Process, ActiveRequestCount, PlaySessionId" },
    { "id": "transjobtype", "label": "TranscodingJobType", "file": "TranscodingJobType.cs", "path": "MediaBrowser.Controller/MediaEncoding/TranscodingJobType.cs", "group": "transcode", "groupId": "transcode", "desc": "Hls / Progressive / LiveOutput job flavors" },
    { "id": "encjobinfo", "label": "EncodingJobInfo", "file": "EncodingJobInfo.cs", "path": "MediaBrowser.Controller/MediaEncoding/EncodingJobInfo.cs", "group": "transcode", "groupId": "transcode", "desc": "Everything ffmpeg needs to know about the requested output" },
    { "id": "streamstate", "label": "StreamState", "file": "StreamState.cs", "path": "MediaBrowser.Controller/Streaming/StreamState.cs", "group": "transcode", "groupId": "transcode", "desc": "EncodingJobInfo subclass carrying per-request streaming context" },
    { "id": "videorequestdto", "label": "VideoRequestDto", "file": "VideoRequestDto.cs", "path": "MediaBrowser.Controller/Streaming/VideoRequestDto.cs", "group": "transcode", "groupId": "transcode", "desc": "Typed mirror of the /stream query string" },
    { "id": "encodinghelper", "label": "EncodingHelper", "file": "EncodingHelper.cs", "path": "MediaBrowser.Controller/MediaEncoding/EncodingHelper.cs", "group": "transcode", "groupId": "transcode", "desc": "Assembles the ffmpeg argument string: maps, filters, hwaccel args" },
    { "id": "baseencopts", "label": "BaseEncodingJobOptions", "file": "BaseEncodingJobOptions.cs", "path": "MediaBrowser.Controller/MediaEncoding/BaseEncodingJobOptions.cs", "group": "transcode", "groupId": "transcode", "desc": "Shared request knobs: bitrate, codec, width/height, subtitle method" },
    { "id": "throttler", "label": "TranscodingThrottler", "file": "TranscodingThrottler.cs", "path": "MediaBrowser.Controller/MediaEncoding/TranscodingThrottler.cs", "group": "transcode", "groupId": "transcode", "desc": "Pauses ffmpeg when the client buffer is comfortably ahead" },
    { "id": "segcleaner", "label": "TranscodingSegmentCleaner", "file": "TranscodingSegmentCleaner.cs", "path": "MediaBrowser.Controller/MediaEncoding/TranscodingSegmentCleaner.cs", "group": "transcode", "groupId": "transcode", "desc": "Deletes old HLS segments so the disk does not fill while you watch" }
  ],

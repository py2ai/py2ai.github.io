{
  "owner": "google",
  "repo": "cadvisor",
  "branch": "master",
  "groups": [
    { "id": "runtimes", "name": "runtimes", "label": "Container Runtimes" },
    { "id": "discovery", "name": "discovery", "label": "Discovery & Watchers" },
    { "id": "core", "name": "core", "label": "Manager Core" },
    { "id": "storage", "name": "storage", "label": "Stats Store" },
    { "id": "http", "name": "http", "label": "HTTP & Export" }
  ],
  "nodes": [
    {
      "id": "main",
      "label": "cadvisor main()",
      "file": "cadvisor.go",
      "path": "cmd/cadvisor.go",
      "group": "http",
      "groupId": "http",
      "desc": "Entry point: builds storage + manager, registers HTTP handlers and the Prometheus endpoint, serves :8080 (L108)"
    },
    {
      "id": "docker_handler",
      "label": "Docker handler",
      "file": "handler.go",
      "path": "container/docker/handler.go",
      "group": "runtimes",
      "groupId": "runtimes",
      "desc": "containerHandler maps Docker containers onto the common ContainerHandler interface (L58)"
    },
    {
      "id": "containerd_handler",
      "label": "containerd handler",
      "file": "handler.go",
      "path": "lib/container/containerd/handler.go",
      "group": "runtimes",
      "groupId": "runtimes",
      "desc": "containerdContainerHandler reads container tasks via the containerd gRPC client (L38)"
    },
    {
      "id": "crio_handler",
      "label": "CRI-O handler",
      "file": "handler.go",
      "path": "lib/container/crio/handler.go",
      "group": "runtimes",
      "groupId": "runtimes",
      "desc": "crioContainerHandler for CRI-O managed containers (L39)"
    },
    {
      "id": "podman_handler",
      "label": "Podman handler",
      "file": "handler.go",
      "path": "container/podman/handler.go",
      "group": "runtimes",
      "groupId": "runtimes",
      "desc": "containerHandler for Podman containers (L42)"
    },
    {
      "id": "factory",
      "label": "Handler factory",
      "file": "factory.go",
      "path": "lib/container/factory.go",
      "group": "discovery",
      "groupId": "discovery",
      "desc": "Registry that dispatches each cgroup path to the right runtime factory (NewContainerHandler L258)"
    },
    {
      "id": "raw_watcher",
      "label": "Raw cgroup watcher",
      "file": "watcher.go",
      "path": "lib/container/raw/watcher.go",
      "group": "discovery",
      "groupId": "discovery",
      "desc": "inotify watcher over cgroup dirs; reports container create/delete events (L48)"
    },
    {
      "id": "manager",
      "label": "Manager",
      "file": "manager.go",
      "path": "lib/manager/manager.go",
      "group": "core",
      "groupId": "core",
      "desc": "New (L168) + Start (L333): container recovery, watcher startup and global housekeeping loop"
    },
    {
      "id": "container_data",
      "label": "Container housekeeping",
      "file": "container.go",
      "path": "lib/manager/container.go",
      "group": "core",
      "groupId": "core",
      "desc": "containerData ticks per-container housekeeping and updateStats for every container (L306, L440)"
    },
    {
      "id": "memory_cache",
      "label": "In-memory cache",
      "file": "memory.go",
      "path": "lib/cache/memory/memory.go",
      "group": "storage",
      "groupId": "storage",
      "desc": "InMemoryCache keeps recent ContainerStats per container (L101)"
    },
    {
      "id": "http_api",
      "label": "REST API + UI",
      "file": "handler.go",
      "path": "cmd/internal/api/handler.go",
      "group": "http",
      "groupId": "http",
      "desc": "Versioned REST API v1/v2 and event streaming served from the manager (L51)"
    },
    {
      "id": "prometheus",
      "label": "Prometheus metrics",
      "file": "prometheus.go",
      "path": "lib/metrics/prometheus.go",
      "group": "http",
      "groupId": "http",
      "desc": "PrometheusCollector walks all containers into /metrics series (L100)"
    }
  ],
  "edges": [
    { "from": "main", "to": "manager", "label": "New + Start" },
    { "from": "main", "to": "http_api", "label": "registers handlers" },
    { "from": "main", "to": "prometheus", "label": "registers /metrics" },
    { "from": "manager", "to": "factory", "label": "InitializePlugins" },
    { "from": "manager", "to": "raw_watcher", "label": "starts watcher" },
    { "from": "factory", "to": "docker_handler", "label": "NewContainerHandler" },
    { "from": "factory", "to": "containerd_handler", "label": "NewContainerHandler" },
    { "from": "factory", "to": "crio_handler", "label": "NewContainerHandler" },
    { "from": "factory", "to": "podman_handler", "label": "NewContainerHandler" },
    { "from": "raw_watcher", "to": "manager", "label": "container events" },
    { "from": "manager", "to": "container_data", "label": "createContainer" },
    { "from": "container_data", "to": "memory_cache", "label": "AddStats" },
    { "from": "http_api", "to": "manager", "label": "info + event queries" },
    { "from": "prometheus", "to": "manager", "label": "scrapes container info" }
  ]
}

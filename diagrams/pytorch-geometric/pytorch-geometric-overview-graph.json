{
  "owner": "pyg-team",
  "repo": "pytorch_geometric",
  "branch": "master",
  "groups": [
    {"id": "data", "name": "data", "label": "Data Layer"},
    {"id": "loader", "name": "loader", "label": "Loading & Sampling"},
    {"id": "conv", "name": "conv", "label": "Message Passing"},
    {"id": "aggr", "name": "aggr", "label": "Aggregation & Pooling"},
    {"id": "models", "name": "models", "label": "Models"}
  ],
  "nodes": [
    {"id": "dataset", "label": "Dataset", "file": "torch_geometric/data/dataset.py", "path": "torch_geometric/data/dataset.py", "group": "data", "groupId": "data", "desc": "Base dataset yielding Data objects"},
    {"id": "data_obj", "label": "Data", "file": "torch_geometric/data/data.py", "path": "torch_geometric/data/data.py", "group": "data", "groupId": "data", "desc": "Single graph container: x, edge_index, y"},
    {"id": "dataloader", "label": "DataLoader", "file": "torch_geometric/loader/dataloader.py", "path": "torch_geometric/loader/dataloader.py", "group": "loader", "groupId": "loader", "desc": "Collates Data objects into mini-batches"},
    {"id": "neighborloader", "label": "NeighborLoader", "file": "torch_geometric/loader/neighbor_loader.py", "path": "torch_geometric/loader/neighbor_loader.py", "group": "loader", "groupId": "loader", "desc": "Mini-batch subgraph sampling for large graphs"},
    {"id": "base_sampler", "label": "BaseSampler", "file": "torch_geometric/sampler/base.py", "path": "torch_geometric/sampler/base.py", "group": "loader", "groupId": "loader", "desc": "Sampling engine behind NeighborLoader"},
    {"id": "messagepassing", "label": "MessagePassing", "file": "torch_geometric/nn/conv/message_passing.py", "path": "torch_geometric/nn/conv/message_passing.py", "group": "conv", "groupId": "conv", "desc": " propagate/message/aggregate machinery"},
    {"id": "gcnconv", "label": "GCNConv", "file": "torch_geometric/nn/conv/gcn_conv.py", "path": "torch_geometric/nn/conv/gcn_conv.py", "group": "conv", "groupId": "conv", "desc": "Kipf & Welling spectral-style convolution"},
    {"id": "sageconv", "label": "SAGEConv", "file": "torch_geometric/nn/conv/sage_conv.py", "path": "torch_geometric/nn/conv/sage_conv.py", "group": "conv", "groupId": "conv", "desc": "GraphSAGE neighbor aggregation"},
    {"id": "gatconv", "label": "GATConv", "file": "torch_geometric/nn/conv/gat_conv.py", "path": "torch_geometric/nn/conv/gat_conv.py", "group": "conv", "groupId": "conv", "desc": "Graph attention convolution"},
    {"id": "aggrbase", "label": "Aggregation", "file": "torch_geometric/nn/aggr/base.py", "path": "torch_geometric/nn/aggr/base.py", "group": "aggr", "groupId": "aggr", "desc": "Base class for scatter-based reduction"},
    {"id": "pool", "label": "global_mean_pool", "file": "torch_geometric/nn/pool/glob.py", "path": "torch_geometric/nn/pool/glob.py", "group": "aggr", "groupId": "aggr", "desc": "Per-graph readout of node features"},
    {"id": "basicgnn", "label": "GCN model", "file": "torch_geometric/nn/models/basic_gnn.py", "path": "torch_geometric/nn/models/basic_gnn.py", "group": "models", "groupId": "models", "desc": "Ready-made GCN classifier built on stacked convs"}
  ],
  "edges": [
    {"from": "dataset", "to": "data_obj", "label": "yields"},
    {"from": "data_obj", "to": "dataloader", "label": "collated into batches"},
    {"from": "dataloader", "to": "gcnconv", "label": "full-batch feed"},
    {"from": "neighborloader", "to": "base_sampler", "label": "delegates sampling"},
    {"from": "base_sampler", "to": "data_obj", "label": "returns subgraphs"},
    {"from": "neighborloader", "to": "data_obj", "label": "mini-batch subgraphs"},
    {"from": "messagepassing", "to": "gcnconv", "label": "extends"},
    {"from": "messagepassing", "to": "sageconv", "label": "extends"},
    {"from": "messagepassing", "to": "gatconv", "label": "extends"},
    {"from": "gcnconv", "to": "aggrbase", "label": "neighbor aggregation"},
    {"from": "sageconv", "to": "aggrbase", "label": "neighbor aggregation"},
    {"from": "gatconv", "to": "aggrbase", "label": "attention aggregation"},
    {"from": "gcnconv", "to": "pool", "label": "then read out"},
    {"from": "pool", "to": "basicgnn", "label": "graph readout"},
    {"from": "gcnconv", "to": "basicgnn", "label": "stacked layers"}
  ]

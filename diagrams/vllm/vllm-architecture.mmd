flowchart TD

subgraph group_api["API Layer"]
  node_entry["Server launcher<br/>build and serve"]
  node_openai_routes["OpenAI-compatible routes<br/>chat and completions"]
  node_anthropic_api["Anthropic Messages API<br/>protocol adapter"]
  node_grpc["gRPC server<br/>RPC surface"]
  node_mcp["MCP tool integration<br/>tool serving"]
  node_cli["vllm CLI<br/>argparse entry"]
end

subgraph group_engine["Engine Front-End"]
  node_llm_offline["LLM offline API<br/>batch class"]
  node_async_llm["AsyncLLM<br/>asyncio engine"]
  node_input_proc["Input processor<br/>prompt normalization"]
  node_output_proc["Output processor<br/>delta assembly"]
  node_detok["Incremental detokenizer<br/>text decode"]
  node_admission["Admission control<br/>queue limits"]
  node_core_client["EngineCore client<br/>ZMQ messaging"]
end

subgraph group_core["Scheduling &amp; KV"]
  node_core{{"EngineCore loop<br/>step driver"}}
  node_scheduler["Scheduler<br/>continuous batching"]
  node_req_queue["Priority request queues<br/>scheduling policies"]
  node_kv_cache[("KVCacheManager<br/>block allocation")]
  node_block_pool[("Block pool<br/>free list")]
  node_kv_utils["Prefix caching and eviction<br/>block hashing"]
  node_struct_out["Structured output<br/>xgrammar / guidance"]
  node_spec_decode["Speculative decoding<br/>EAGLE / n-gram"]
end

subgraph group_exec["Execution Layer"]
  node_executor{{"Uniproc executor<br/>in-process path"}}
  node_multiproc["Multiproc executor<br/>spawn per GPU"]
  node_ray_exec["Ray executor<br/>multi-node"]
  node_gpu_worker["GPU worker<br/>device process"]
  node_model_runner{{"GPUModelRunner<br/>batched forward"}}
  node_cudagraph["CUDA graph capture<br/>graph replay"]
  node_model_loader["Weight loader<br/>checkpoint to device"]
  node_models_reg["Model registry<br/>architecture map"]
  node_layers["Quantized and fused layers<br/>linear / moe"]
  node_kernels[("Attention and GEMM kernels<br/>CUDA C++ sources")]
  node_platforms["Platform backends"]
end

subgraph group_feat["Feature Packs"]
  node_lora["Multi-LoRA serving<br/>adapter swapping"]
  node_multimodal["Multimodal pipeline<br/>image / audio inputs"]
end

node_entry -->|"mounts"| node_openai_routes
node_entry -->|"mounts"| node_anthropic_api
node_entry -.->|"alternative"| node_grpc
node_cli -->|"vllm serve"| node_entry
node_openai_routes -.->|"tool listing"| node_mcp
node_llm_offline -.->|"sync wrapper"| node_core_client
node_openai_routes -->|"generate"| node_async_llm
node_async_llm -->|"gate adds"| node_admission
node_async_llm -->|"process"| node_input_proc
node_input_proc -->|"EngineCoreRequest"| node_core_client
node_core_client -->|"ZMQ"| node_core
node_core -->|"step"| node_scheduler
node_scheduler -->|"pop requests"| node_req_queue
node_scheduler -->|"allocate"| node_kv_cache
node_kv_cache -->|"blocks"| node_block_pool
node_kv_utils -.->|"prefix reuse"| node_kv_cache
node_scheduler -.->|"grammar bitmask"| node_struct_out
node_scheduler -.->|"draft tokens"| node_spec_decode
node_core -->|"execute"| node_executor
node_executor -.->|"variant"| node_multiproc
node_executor -.->|"variant"| node_ray_exec
node_multiproc -->|"spawn"| node_gpu_worker
node_gpu_worker -->|"owns"| node_model_runner
node_model_runner -->|"capture / replay"| node_cudagraph
node_model_runner -->|"instantiate"| node_models_reg
node_model_loader -->|"weights"| node_models_reg
node_models_reg -->|"build model"| node_layers
node_layers -->|"device kernels"| node_kernels
node_platforms -.->|"device config"| node_model_runner
node_model_runner -.->|"results"| node_gpu_worker
node_core -->|"EngineCoreOutputs"| node_output_proc
node_output_proc -->|"token ids"| node_detok
node_output_proc -->|"RequestOutput"| node_async_llm
node_lora -.->|"adapter mapping"| node_model_runner
node_multimodal -.->|"mm features"| node_input_proc


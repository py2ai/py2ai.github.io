flowchart TD

subgraph group_api["API Layer"]
  node_entry["Server launcher<br/>uvicorn app bootstrap"]
  node_routes["OpenAI-compatible routes<br/>REST routers"]
end

subgraph group_engine["Async Engine"]
  node_async_llm["AsyncLLM engine front-end<br/>asyncio entry class"]
  node_output_proc["Output processor<br/>detokenize and stream"]
end

subgraph group_core["Engine Core &amp; Scheduling"]
  node_engine_core{{"EngineCore process<br/>stepping loop"}}
  node_scheduler["Continuous batching scheduler<br/>request scheduling"]
  node_kv_cache[("PagedAttention KV cache<br/>block manager")]
end

subgraph group_exec["Execution"]
  node_executor{{"Worker executor<br/>process spawn"}}
  node_worker["GPU worker + model runner<br/>device loop"]
  node_models["200+ model architectures<br/>model registry"]
  node_kernels[("Attention and GEMM kernels<br/>CUDA and Triton code")]
  node_dist["TP / PP / DP / EP collectives<br/>distributed groups"]
end

node_entry -->|"mounts"| node_routes
node_routes -->|"submit prompt"| node_async_llm
node_async_llm -->|"EngineCoreRequest"| node_engine_core
node_engine_core -->|"schedule step"| node_scheduler
node_scheduler -->|"allocate blocks"| node_kv_cache
node_engine_core -->|"broadcast batch"| node_executor
node_executor -->|"execute step"| node_worker
node_worker -->|"forward pass"| node_models
node_models -->|"invoke kernels"| node_kernels
node_worker -->|"collective ops"| node_dist
node_engine_core -.->|"EngineCoreOutputs"| node_output_proc
node_output_proc -.->|"streamed deltas"| node_async_llm


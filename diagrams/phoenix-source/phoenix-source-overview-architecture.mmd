flowchart TD

subgraph group_boot["boot"]
  node_ep_supervisor["Phoenix.Endpoint.Supervisor init/1<br/>[supervisor.ex]"]
  node_adapter["Cowboy2Adapter child_specs<br/>[cowboy2_adapter.ex]"]
end

subgraph group_http_entry["entry"]
  node_endpoint_call["Endpoint call/2<br/>[endpoint.ex]"]
  node_socket_dispatch["socket_dispatch/2<br/>[endpoint.ex]"]
end

subgraph group_routing["route"]
  node_router_call["Router call/2<br/>[router.ex]"]
  node_match_route["__match_route__/3<br/>[router.ex]"]
  node_route_prepare["Route.prepare/3<br/>[route.ex]"]
end

subgraph group_plug_dispatch["dispatch"]
  node_router_dispatch["Router __call__/5<br/>[router.ex]"]
  node_pipe_chain["Compiled pipe function<br/>[router.ex]"]
  node_endpoint_plug["plug.call&#40;conn, opts&#41;<br/>[router.ex]"]
end

subgraph group_realtime["realtime"]
  node_ws_transport["Transports.WebSocket call/2<br/>[websocket.ex]"]
  node_channel_server["Channel.Server &#40;GenServer per channel&#41;<br/>[server.ex]"]
end

node_ep_supervisor -->|"server_children: adapter.child_specs"| node_adapter
node_adapter -->|"adapter process invokes the endpoint plug"| node_endpoint_call
node_endpoint_call -->|"plug :socket_dispatch &#40;declared first&#41;"| node_socket_dispatch
node_endpoint_call -->|"router is the final plug the app declares"| node_router_call
node_socket_dispatch -->|"socket path match dispatches transport"| node_ws_transport
node_ws_transport -->|"upgraded socket spawns channels on join"| node_channel_server
node_ep_supervisor -->|"socket children start PoolSupervisor trees"| node_channel_server
node_router_call -->|"case __match_route__&#40;method, decoded, host&#41;"| node_match_route
node_match_route -->|"match clause returns metadata, prepare, chain, dispatch"| node_route_prepare
node_route_prepare -->|"Phoenix.Router.__call__/5"| node_router_dispatch
node_router_dispatch -->|"runs the compiled pipe function"| node_pipe_chain
node_pipe_chain -->|"plug.call&#40;conn, plug.init&#40;opts&#41;&#41;"| node_endpoint_plug


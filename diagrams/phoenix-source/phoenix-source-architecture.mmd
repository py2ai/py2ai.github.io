node_ep_supervisor -->|"config_children starts Phoenix.Config"| node_config_ets
node_ep_supervisor -->|"legacy :pubsub key"| node_pubsub_children
node_ep_supervisor -->|"one child per __sockets__ entry"| node_socket_children
node_ep_supervisor -->|"children list assembly"| node_server_children
node_server_children -->|"adapter.child_specs&#40;mod, config&#41;"| node_adapter
node_socket_children -->|"Phoenix.Socket child_spec starts PoolSupervisor"| node_pool_supervisor
node_adapter -->|"HTTP process invokes the endpoint plug"| node_endpoint_call
node_ep_before_compile -->|"defoverridable call: 2 + override"| node_endpoint_call
node_endpoint_call -->|"rescue/catch -&gt; RenderErrors.__catch__"| node_render_errors
node_endpoint_call -->|"plug :socket_dispatch runs first"| node_socket_dispatch
node_socket_dispatch -->|"socket path match halts into transport"| node_ws_call
node_endpoint_call -->|"dev-only plug declared before the router"| node_code_reloader_call
node_code_reloader_call -->|"opts&#91;:reloader&#93;.&#40;endpoint, opts&#41;"| node_code_reloader_reload
node_router_call -->|"prepare&#40;conn&#41; first"| node_prepare_conn
node_router_call -->|"case __match_route__&#40;method, decoded, host&#41;"| node_match_route
node_match_route -->|"clause returns metadata, prepare, chain, dispatch"| node_route_prepare
node_route_prepare -->|"Phoenix.Router.__call__/5"| node_router_dispatch
node_router_before_compile -->|"Route.exprs per accumulated route"| node_route_exprs
node_route_exprs -->|"one function clause per route group"| node_build_match_path
node_build_match_path -->|"compiled dispatch clauses"| node_match_route
node_plug_macro -->|"module attribute accumulates plugs"| node_pipe_macro
node_pipe_macro -->|"Plug.Builder.compile emits the function"| node_pipe_chain
node_build_match_path -->|"deduped __pipe_throughN__ closure"| node_pipe_chain
node_router_dispatch -->|"runs the compiled pipe function"| node_pipe_chain
node_pipe_chain -->|"plug.call&#40;conn, plug.init&#40;opts&#41;&#41;"| node_endpoint_plug
node_ws_call -->|"code_reload if :code_reloader"| node_transport_code_reload
node_ws_call -->|"WebSockAdapter.upgrade&#40;handler, arg, opts&#41;"| node_ws_upgrade
node_pool_supervisor -->|"starter = &amp;PoolSupervisor.start_child/3"| node_channel_join
node_ws_upgrade -->|"transport joins a topic -&gt; channel process"| node_channel_join
node_channel_join -->|"auth payload delivered as handle_info"| node_channel_handle_in
node_channel_handle_in -->|"one-to-one event to client"| node_channel_push
node_channel_handle_in -->|"&#123;:reply, :ok, socket&#125;"| node_channel_reply
node_channel_handle_in -->|"broadcast!/3"| node_channel_broadcast
node_channel_broadcast -->|"PubSub.broadcast&#40;pubsub_server, topic, broadcast&#41;"| node_pubsub_broadcast
node_pubsub_broadcast -->|"delivery arrives as handle_info event"| node_channel_handle_in


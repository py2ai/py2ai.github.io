  node_compression["Compression Helpers<br/>Kernels"]
  node_vec_cache[("Vector Cache<br/>[cache.go]")]
end

subgraph group_kv["LSM Storage"]
  node_lsmkv_bucket["LSM Bucket<br/>Storage"]
  node_lsmkv_segment["LSM Segment<br/>Storage"]
  node_kv_compactor{{"Segment Compactor<br/>Maintenance"}}
  node_roaring_set["Roaring Sets<br/>Data structure"]
  node_inverted["Inverted Analyzer<br/>Text layer"]
  node_sorter["Sorter<br/>Query support"]
  node_backup_s3["Backup S3 Module<br/>[client.go]"]
end

node_configure_api -->|"mounts"| node_graphql_schema
node_configure_api -->|"starts gRPC"| node_grpc_conn
node_grpc_conn -->|"serves protocol"| node_proto_v1
node_configure_api -->|"schema service"| node_schema_manager
node_schema_manager -->|"replicated changes"| node_raft_log
node_schema_manager -->|"computes plan"| node_shard_state
node_shard_state -.->|"shard placement"| node_db_index
node_replica_coord -->|"resolves hosts"| node_replica_finder
node_replica_coord -->|"two-phase batches"| node_db_index
node_explorer -->|"fusion queries"| node_hybrid
node_explorer -->|"re-weights"| node_boost_scorer
node_explorer -->|"near params"| node_module_cap
node_module_cap -.->|"implemented by"| node_text2vec_mod
node_module_cap -.->|"implemented by"| node_reranker_mod
node_explorer -->|"per-shard search"| node_db_index
node_db_index -->|"manages"| node_shard
node_shard -->|"vector index"| node_dynamic_idx
node_dynamic_idx -->|"promotes to"| node_hnsw
node_hnsw -->|"greedy walk"| node_hnsw_search
node_hnsw -->|"adds nodes"| node_hnsw_insert
node_hnsw -->|"tombstones"| node_hnsw_delete
node_hnsw_insert -->|"links peers"| node_hnsw_neighbors
node_hnsw_insert -->|"logs mutation"| node_commit_log
node_hnsw_search -->|"fetches vectors"| node_vec_cache
node_compression -.->|"compressed distances"| node_hnsw_search
node_shard -->|"objects and inverted"| node_lsmkv_bucket
node_lsmkv_bucket -->|"flushes"| node_lsmkv_segment
node_kv_compactor -->|"merges"| node_lsmkv_segment
node_inverted -->|"token streams"| node_lsmkv_bucket
node_roaring_set -.->|"bitmap buckets"| node_lsmkv_bucket
node_shard -.->|"sorted results"| node_sorter
node_backup_s3 -.->|"snapshots"| node_lsmkv_bucket


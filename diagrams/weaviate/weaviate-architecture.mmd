  node_proto_v1["Protocol v1<br/>Contract"]
end

subgraph group_cluster["Cluster Layer"]
  node_schema_manager["Schema Manager<br/>Coordinator"]
  node_shard_state{{"Sharding State<br/>Map"}}
  node_replica_coord["Replica Coordinator<br/>Consistency"]
  node_replica_finder["Replica Finder<br/>Consistency"]
  node_raft_log["Raft Log<br/>Consensus"]
end

subgraph group_query["Query Execution"]
  node_explorer["Explorer<br/>Query engine"]
  node_hybrid["Hybrid Search<br/>Query engine"]
  node_boost_scorer{{"Boost Scorer<br/>Ranking"}}
  node_module_cap["Module Capabilities<br/>Plugin API"]
  node_text2vec_mod["text2vec-transformers<br/>[module.go]"]
  node_reranker_mod["reranker-transformers<br/>[module.go]"]
end

subgraph group_engine["Shard Engine"]
  node_db_index["Collection Index<br/>Engine"]
  node_shard["Shard<br/>Engine"]
end

subgraph group_vector["Vector Indexes"]
  node_hnsw["HNSW Index<br/>ANN graph"]
  node_hnsw_search["HNSW Search<br/>ANN graph"]
  node_hnsw_insert["HNSW Insert<br/>ANN graph"]
  node_hnsw_delete["HNSW Delete<br/>ANN graph"]
  node_hnsw_neighbors["Neighbor Connections<br/>ANN graph"]
  node_commit_log["HNSW Commit Log<br/>Durability"]

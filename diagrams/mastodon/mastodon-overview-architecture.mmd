node_statuses_controller -->|"POST /api/v1/statuses"| node_post_status_service
node_post_status_service -->|"save! in transaction"| node_status_model
node_post_status_service -->|"perform_async"| node_distribution_worker
node_post_status_service -->|"perform_async"| node_ap_distribution
node_distribution_worker -->|"redis lock, then call"| node_fan_out_service
node_fan_out_service -->|"push_bulk followers/lists"| node_feed_insert_worker
node_feed_insert_worker -->|"push_to_home / push_to_list"| node_feed_manager
node_feed_manager -->|"perform_async if subscribed"| node_push_update_worker
node_fan_out_service -->|"push_bulk mention timelines"| node_push_update_worker
node_push_update_worker -->|"redis.publish timeline:&lt;account&gt;"| node_streaming_server
node_fan_out_service -->|"redis.publish timeline:public"| node_streaming_server
node_ap_distribution -->|"resolve target inboxes"| node_reach_finder
node_ap_distribution -->|"push_bulk per inbox"| node_ap_delivery


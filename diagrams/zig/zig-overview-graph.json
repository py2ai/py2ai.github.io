{
  "owner": "ziglang",
  "repo": "zig",
  "branch": "master",
  "groups": [
    {"id": "driver", "name": "Driver", "label": "CLI & Job Driver", "tone": "toneBlue"},
    {"id": "frontend", "name": "Frontend", "label": "Parse & AstGen", "tone": "toneTeal"},
    {"id": "ir", "name": "IR", "label": "Shared IR & InternPool", "tone": "toneIndigo"},
    {"id": "sema", "name": "Sema", "label": "Semantic Analysis", "tone": "toneAmber"},
    {"id": "backend", "name": "Backends", "label": "Codegen & Linking", "tone": "toneRose"}
  ],
  "nodes": [
    {"id": "main", "label": "main.zig CLI", "path": "src/main.zig", "groupId": "driver", "shape": "hexagon", "desc": "Entry point that dispatches build-exe, build, test, ast-check"},
    {"id": "compilation", "label": "Compilation", "path": "src/Compilation.zig", "groupId": "driver", "shape": "box", "desc": "Orchestrates one update: cache check, job queue, flush"},
    {"id": "zcu", "label": "Zcu (compiler state)", "path": "src/Zcu.zig", "groupId": "driver", "shape": "box", "desc": "Per-compilation context: files, ZIR, analysis units"},
    {"id": "tokenizer", "label": "Tokenizer", "path": "lib/std/zig/tokenizer.zig", "groupId": "frontend", "shape": "box", "desc": "Turns source bytes into a token stream"},
    {"id": "parse", "label": "Parser", "path": "lib/std/zig/Parse.zig", "groupId": "frontend", "shape": "box", "desc": "parseRoot builds an error-tolerant Ast"},
    {"id": "astgen", "label": "AstGen", "path": "lib/std/zig/AstGen.zig", "groupId": "frontend", "shape": "box", "desc": "generate() walks the AST and emits ZIR"},
    {"id": "zir", "label": "ZIR", "path": "lib/std/zig/Zir.zig", "groupId": "ir", "shape": "database", "desc": "Zig Intermediate Representation, one per file"},
    {"id": "internpool", "label": "InternPool", "path": "src/InternPool.zig", "groupId": "ir", "shape": "database", "desc": "Single interned pool of every type and value"},
    {"id": "sema", "label": "Sema", "path": "src/Sema.zig", "groupId": "sema", "shape": "hexagon", "desc": "Lazy semantic analysis: ZIR into typed AIR"},
    {"id": "air", "label": "AIR", "path": "src/Air.zig", "groupId": "ir", "shape": "database", "desc": "Analyzed IR, one per function, produced by Sema"},
    {"id": "codegen", "label": "Codegen dispatch", "path": "src/codegen.zig", "groupId": "backend", "shape": "box", "desc": "generateFunction picks a backend and lowers AIR to MIR"},
    {"id": "link", "label": "Linker front", "path": "src/link.zig", "groupId": "backend", "shape": "box", "desc": "link.File flushes objects into binaries"}
  ],
  "edges": [
    {"from": "main", "to": "compilation", "label": "dispatches commands"},
    {"from": "compilation", "to": "zcu", "label": "drives updates"},
    {"from": "zcu", "to": "parse", "label": "parses changed files"},
    {"from": "parse", "to": "tokenizer", "label": "consumes tokens"},
    {"from": "zcu", "to": "astgen", "label": "queues AstGen jobs"},
    {"from": "astgen", "to": "zir", "label": "emits ZIR"},
    {"from": "zcu", "to": "sema", "label": "queues analysis units"},
    {"from": "sema", "to": "zir", "label": "reads instructions"},
    {"from": "sema", "to": "internpool", "label": "interns types/values"},
    {"from": "sema", "to": "air", "label": "lowers to AIR"},
    {"from": "zcu", "to": "codegen", "label": "codegen jobs"},
    {"from": "codegen", "to": "air", "label": "reads AIR + liveness"},
    {"from": "codegen", "to": "link", "label": "hands over MIR"},
    {"from": "compilation", "to": "link", "label": "flushes output"}
  ]
}

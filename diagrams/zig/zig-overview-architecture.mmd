node_main -->|"dispatches commands"| node_compilation
node_compilation -->|"drives updates"| node_zcu
node_zcu -->|"parses changed files"| node_parse
node_parse -->|"consumes tokens"| node_tokenizer
node_zcu -->|"queues AstGen jobs"| node_astgen
node_astgen -->|"emits ZIR"| node_zir
node_zcu -->|"queues analysis units"| node_sema
node_sema -->|"reads instructions"| node_zir
node_sema -->|"interns types/values"| node_internpool
node_sema -->|"lowers to AIR"| node_air
node_zcu -->|"codegen jobs"| node_codegen
node_codegen -->|"reads AIR + liveness"| node_air
node_codegen -->|"hands over MIR"| node_link
node_compilation -->|"flushes output"| node_link


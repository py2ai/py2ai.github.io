{
  "owner": "rails",
  "repo": "rails",
  "branch": "main",
  "groups": [
    {"id": "entry", "name": "Rack Entry", "label": "Rails::Engine Rack surface"},
    {"id": "assembly", "name": "Stack Assembly", "label": "Middleware stack build"},
    {"id": "routing", "name": "Journey Routing", "label": "Route recognition"},
    {"id": "dispatch", "name": "Controller Dispatch", "label": "ActionController dispatch"}
  ],
  "nodes": [
    {"id": "engine_call", "label": "Rails::Engine#call", "file": "engine.rb", "path": "railties/lib/rails/engine.rb", "group": "Rack Entry", "groupId": "entry", "desc": "Rack API of the application: wraps env, merges env_config, delegates to app"},
    {"id": "engine_app", "label": "Engine#app", "file": "engine.rb", "path": "railties/lib/rails/engine.rb", "group": "Rack Entry", "groupId": "entry", "desc": "Lazily builds the middleware chain once under a build lock"},
    {"id": "stack_build", "label": "MiddlewareStack#build", "file": "stack.rb", "path": "actionpack/lib/action_dispatch/middleware/stack.rb", "group": "Stack Assembly", "groupId": "assembly", "desc": "Folds frozen middleware list in reverse around the endpoint"},
    {"id": "default_stack", "label": "DefaultMiddlewareStack#build_stack", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Stack Assembly", "groupId": "assembly", "desc": "Declares the ordered default middlewares from config"},
    {"id": "executor", "label": "ActionDispatch::Executor", "file": "executor.rb", "path": "actionpack/lib/action_dispatch/middleware/executor.rb", "group": "Stack Assembly", "groupId": "assembly", "desc": "Runs the executor state per request, finalizes via BodyProxy"},
    {"id": "route_set_call", "label": "RouteSet#call", "file": "route_set.rb", "path": "actionpack/lib/action_dispatch/routing/route_set.rb", "group": "Journey Routing", "groupId": "routing", "desc": "Normalizes PATH_INFO then hands the request to the Journey router"},
    {"id": "journey_serve", "label": "Journey::Router#serve", "file": "router.rb", "path": "actionpack/lib/action_dispatch/journey/router.rb", "group": "Journey Routing", "groupId": "routing", "desc": "Static fast path first, then full recognition, 404 with X-Cascade pass"},
    {"id": "static_hit", "label": "Routes#static_exact_map", "file": "routes.rb", "path": "actionpack/lib/action_dispatch/journey/routes.rb", "group": "Journey Routing", "groupId": "routing", "desc": "Hash lookup of verb+path for fully static routes"},
    {"id": "recognize", "label": "Journey::Router#recognize", "file": "router.rb", "path": "actionpack/lib/action_dispatch/journey/router.rb", "group": "Journey Routing", "groupId": "routing", "desc": "Filters candidate routes, extracts path parameters, respects precedence"},
    {"id": "sim_memos", "label": "GTG::Simulator#memos", "file": "simulator.rb", "path": "actionpack/lib/action_dispatch/journey/gtg/simulator.rb", "group": "Journey Routing", "groupId": "routing", "desc": "NFA simulation over the route AST transition table yields matching routes"},
    {"id": "dispatcher_serve", "label": "RouteSet::Dispatcher#serve", "file": "route_set.rb", "path": "actionpack/lib/action_dispatch/routing/route_set.rb", "group": "Controller Dispatch", "groupId": "dispatch", "desc": "Resolves controller class, builds response, calls dispatch"},
    {"id": "metal_dispatch", "label": "ActionController::Metal#dispatch", "file": "metal.rb", "path": "actionpack/lib/action_controller/metal.rb", "group": "Controller Dispatch", "groupId": "dispatch", "desc": "set_request, set_response, process action, commit flash, to_a"}
  ],
  "edges": [
    {"from": "engine_call", "to": "engine_app", "label": "app.call(env)"},
    {"from": "engine_app", "to": "default_stack", "label": "default middlewares"},
    {"from": "engine_app", "to": "stack_build", "label": "fold around endpoint"},
    {"from": "stack_build", "to": "executor", "label": "chain entry"},
    {"from": "executor", "to": "route_set_call", "label": "innermost app = routes"},
    {"from": "route_set_call", "to": "journey_serve", "label": "@router.serve(req)"},
    {"from": "journey_serve", "to": "static_hit", "label": "static path?"},
    {"from": "static_hit", "to": "dispatcher_serve", "label": "route.app.serve"},
    {"from": "journey_serve", "to": "recognize", "label": "X-Cascade pass"},
    {"from": "recognize", "to": "sim_memos", "label": "filter_routes(path)"},
    {"from": "recognize", "to": "dispatcher_serve", "label": "matched route"},
    {"from": "dispatcher_serve", "to": "metal_dispatch", "label": "controller.dispatch"}
  ]
}

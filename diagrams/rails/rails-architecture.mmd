node_engine_call -->|"app.call&#40;req.env&#41;"| node_engine_app
node_engine_app -->|"default stack"| node_app_default_stack
node_app_default_stack -->|"build_stack"| node_build_stack
node_engine_app -->|"config.middleware.build&#40;endpoint&#41;"| node_stack_build
node_build_stack -->|"first default use"| node_rack_sendfile
node_stack_build -->|"fold reversed"| node_middleware_build
node_rack_sendfile -->|"next"| node_static_mw
node_static_mw -->|"next"| node_executor_mw
node_executor_mw -->|"next"| node_rack_runtime
node_rack_runtime -->|"next"| node_method_override
node_method_override -->|"next"| node_request_id
node_request_id -->|"next"| node_remote_ip
node_remote_ip -->|"next"| node_logger_mw
node_logger_mw -->|"next"| node_debug_exceptions
node_debug_exceptions -->|"next"| node_callbacks
node_callbacks -->|"next"| node_rack_etag
node_rack_etag -->|"endpoint = routes"| node_route_set_call
node_route_set_draw -->|"routes compiled at boot"| node_route_set_call
node_route_set_call -->|"@router.serve&#40;req&#41;"| node_journey_serve
node_journey_serve -->|"exact hash lookup"| node_static_map
node_static_map -->|"static route hit"| node_dispatcher_serve
node_journey_serve -->|"cascade pass"| node_recognize
node_recognize -->|"candidate scan"| node_filter_routes
node_filter_routes -->|"NFA for path"| node_routes_simulator
node_routes_simulator -->|"transition table"| node_sim_memos
node_recognize -->|"HEAD requests"| node_match_head
node_recognize -->|"verb + constraints"| node_route_matches
node_route_matches -->|"route.app.serve"| node_constraints_serve
node_constraints_serve -->|"constraints ok"| node_dispatcher_serve
node_dispatcher_serve -->|"req.controller_class"| node_controller_class
node_dispatcher_serve -->|"make_response!"| node_make_response
node_dispatcher_serve -->|"controller.dispatch"| node_metal_dispatch
node_metal_dispatch -->|"process&#40;name&#41;"| node_process
node_process -->|"process_action"| node_process_action


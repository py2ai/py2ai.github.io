{
  "owner": "rails",
  "repo": "rails",
  "branch": "main",
  "groups": [
    {"id": "g_entry", "name": "Rack Entry", "label": "Application surface"},
    {"id": "g_stack", "name": "Stack Assembly", "label": "How the chain is built"},
    {"id": "g_mw", "name": "Default Middleware", "label": "Ordered default middlewares"},
    {"id": "g_router", "name": "Journey Router", "label": "Request routing"},
    {"id": "g_match", "name": "Matching Internals", "label": "Route matching machinery"},
    {"id": "g_ctrl", "name": "Controller Dispatch", "label": "From route to action"}
  ],
  "nodes": [
    {"id": "engine_call", "label": "Rails::Engine#call", "file": "engine.rb", "path": "railties/lib/rails/engine.rb", "group": "Rack Entry", "groupId": "g_entry", "desc": "Rack API: build_request, merge env_config, call app"},
    {"id": "engine_app", "label": "Engine#app", "file": "engine.rb", "path": "railties/lib/rails/engine.rb", "group": "Rack Entry", "groupId": "g_entry", "desc": "Lazy one-time build of middleware chain around endpoint"},
    {"id": "app_default_stack", "label": "Application#default_middleware_stack", "file": "application.rb", "path": "railties/lib/rails/application.rb", "group": "Rack Entry", "groupId": "g_entry", "desc": "Constructs DefaultMiddlewareStack and calls build_stack"},
    {"id": "build_stack", "label": "DefaultMiddlewareStack#build_stack", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Stack Assembly", "groupId": "g_stack", "desc": "Conditionally registers every default middleware in order"},
    {"id": "stack_build", "label": "MiddlewareStack#build", "file": "stack.rb", "path": "actionpack/lib/action_dispatch/middleware/stack.rb", "group": "Stack Assembly", "groupId": "g_stack", "desc": "freeze.reverse.inject folds middlewares around the endpoint"},
    {"id": "middleware_build", "label": "Middleware#build", "file": "stack.rb", "path": "actionpack/lib/action_dispatch/middleware/stack.rb", "group": "Stack Assembly", "groupId": "g_stack", "desc": "Instantiates klass.new(app, args, kwargs, block)"},
    {"id": "rack_sendfile", "label": "Rack::Sendfile", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Intercepts X-Accel/X-Sendfile headers for server-side file delivery"},
    {"id": "static_mw", "label": "ActionDispatch::Static", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Serves files from public/ when public_file_server enabled"},
    {"id": "executor_mw", "label": "ActionDispatch::Executor#call", "file": "executor.rb", "path": "actionpack/lib/action_dispatch/middleware/executor.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "executor.run! per request, finalize via BodyProxy or rack.response_finished"},
    {"id": "rack_runtime", "label": "Rack::Runtime", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Adds X-Runtime response header"},
    {"id": "method_override", "label": "Rack::MethodOverride", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Allows _method param to override POST verb"},
    {"id": "request_id", "label": "ActionDispatch::RequestId", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Assigns unique X-Request-Id per request"},
    {"id": "remote_ip", "label": "ActionDispatch::RemoteIp", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Computes client IP with spoofing checks and trusted proxies"},
    {"id": "logger_mw", "label": "Rails::Rack::Logger#call", "file": "logger.rb", "path": "railties/lib/rails/rack/logger.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Tags log, logs request start, wraps inner app in tagged logging"},
    {"id": "debug_exceptions", "label": "ActionDispatch::DebugExceptions", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Rescues exceptions and renders diagnostics when local"},
    {"id": "callbacks", "label": "ActionDispatch::Callbacks", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Runs before/after dispatch callbacks (to_prepare, etc.)"},
    {"id": "rack_etag", "label": "Rack::ETag", "file": "default_middleware_stack.rb", "path": "railties/lib/rails/application/default_middleware_stack.rb", "group": "Default Middleware", "groupId": "g_mw", "desc": "Digests cacheable bodies into ETags with no-cache default"},
    {"id": "route_set_draw", "label": "RouteSet#draw", "file": "route_set.rb", "path": "actionpack/lib/action_dispatch/routing/route_set.rb", "group": "Journey Router", "groupId": "g_router", "desc": "clear!, eval_block on Mapper, finalize! compiles routes"},
    {"id": "route_set_call", "label": "RouteSet#call", "file": "route_set.rb", "path": "actionpack/lib/action_dispatch/routing/route_set.rb", "group": "Journey Router", "groupId": "g_router", "desc": "make_request, normalize PATH_INFO, @router.serve"},
    {"id": "journey_serve", "label": "Journey::Router#serve", "file": "router.rb", "path": "actionpack/lib/action_dispatch/journey/router.rb", "group": "Journey Router", "groupId": "g_router", "desc": "Static exact match first, falls through on X-Cascade pass, else 404"},
    {"id": "static_map", "label": "Routes#static_exact_map", "file": "routes.rb", "path": "actionpack/lib/action_dispatch/journey/routes.rb", "group": "Matching Internals", "groupId": "g_match", "desc": "Precomputed verb+path hash for literal routes without constraints"},
    {"id": "routes_simulator", "label": "Routes#simulator", "file": "routes.rb", "path": "actionpack/lib/action_dispatch/journey/routes.rb", "group": "Matching Internals", "groupId": "g_match", "desc": "Builds GTG transition table from anchored route ASTs"},
    {"id": "sim_memos", "label": "GTG::Simulator#memos", "file": "simulator.rb", "path": "actionpack/lib/action_dispatch/journey/gtg/simulator.rb", "group": "Matching Internals", "groupId": "g_match", "desc": "Walks the NFA byte-wise, returns routes at accepting states"},
    {"id": "recognize", "label": "Journey::Router#recognize", "file": "router.rb", "path": "actionpack/lib/action_dispatch/journey/router.rb", "group": "Journey Router", "groupId": "g_router", "desc": "Filters candidates, checks verbs/constraints, extracts named captures"},
    {"id": "filter_routes", "label": "Router#filter_routes", "file": "router.rb", "path": "actionpack/lib/action_dispatch/journey/router.rb", "group": "Matching Internals", "groupId": "g_match", "desc": "simulator.memos(path) yields candidate routes for the path"},
    {"id": "match_head", "label": "Router#match_head_routes", "file": "router.rb", "path": "actionpack/lib/action_dispatch/journey/router.rb", "group": "Matching Internals", "groupId": "g_match", "desc": "HEAD falls back to GET routes when no HEAD-specific match"},
    {"id": "route_matches", "label": "Journey::Route#matches?", "file": "route.rb", "path": "actionpack/lib/action_dispatch/journey/route.rb", "group": "Matching Internals", "groupId": "g_match", "desc": "Request method match plus constraint checks"},
    {"id": "constraints_serve", "label": "Constraints#serve", "file": "mapper.rb", "path": "actionpack/lib/action_dispatch/routing/mapper.rb", "group": "Matching Internals", "groupId": "g_match", "desc": "Per-route constraint wrapper, 404 pass when constraints fail"},
    {"id": "dispatcher_serve", "label": "RouteSet::Dispatcher#serve", "file": "route_set.rb", "path": "actionpack/lib/action_dispatch/routing/route_set.rb", "group": "Controller Dispatch", "groupId": "g_ctrl", "desc": "Reads path_parameters, resolves controller, builds response, dispatches"},
    {"id": "controller_class", "label": "Request#controller_class", "file": "request.rb", "path": "actionpack/lib/action_dispatch/http/request.rb", "group": "Controller Dispatch", "groupId": "g_ctrl", "desc": "Caches and constantizes PostsController from :controller param"},
    {"id": "make_response", "label": "Metal.make_response!", "file": "metal.rb", "path": "actionpack/lib/action_controller/metal.rb", "group": "Controller Dispatch", "groupId": "g_ctrl", "desc": "Creates ActionDispatch::Response bound to the request"},
    {"id": "metal_dispatch", "label": "Metal#dispatch", "file": "metal.rb", "path": "actionpack/lib/action_controller/metal.rb", "group": "Controller Dispatch", "groupId": "g_ctrl", "desc": "set_request!, set_response!, process(name), commit_flash, to_a"},
    {"id": "process", "label": "AbstractController::Base#process", "file": "base.rb", "path": "actionpack/lib/abstract_controller/base.rb", "group": "Controller Dispatch", "groupId": "g_ctrl", "desc": "Finds action name, raises ActionNotFound, delegates to process_action"},
    {"id": "process_action", "label": "Base#process_action", "file": "base.rb", "path": "actionpack/lib/abstract_controller/base.rb", "group": "Controller Dispatch", "groupId": "g_ctrl", "desc": "send_action: plain Ruby send of the action method"}
  ],
  "edges": [
    {"from": "engine_call", "to": "engine_app", "label": "app.call(req.env)"},
    {"from": "engine_app", "to": "app_default_stack", "label": "default stack"},
    {"from": "app_default_stack", "to": "build_stack", "label": "build_stack"},
    {"from": "engine_app", "to": "stack_build", "label": "config.middleware.build(endpoint)"},
    {"from": "build_stack", "to": "rack_sendfile", "label": "first default use"},
    {"from": "stack_build", "to": "middleware_build", "label": "fold reversed"},
    {"from": "rack_sendfile", "to": "static_mw", "label": "next"},
    {"from": "static_mw", "to": "executor_mw", "label": "next"},
    {"from": "executor_mw", "to": "rack_runtime", "label": "next"},
    {"from": "rack_runtime", "to": "method_override", "label": "next"},
    {"from": "method_override", "to": "request_id", "label": "next"},
    {"from": "request_id", "to": "remote_ip", "label": "next"},
    {"from": "remote_ip", "to": "logger_mw", "label": "next"},
    {"from": "logger_mw", "to": "debug_exceptions", "label": "next"},
    {"from": "debug_exceptions", "to": "callbacks", "label": "next"},
    {"from": "callbacks", "to": "rack_etag", "label": "next"},
    {"from": "rack_etag", "to": "route_set_call", "label": "endpoint = routes"},
    {"from": "route_set_draw", "to": "route_set_call", "label": "routes compiled at boot"},
    {"from": "route_set_call", "to": "journey_serve", "label": "@router.serve(req)"},
    {"from": "journey_serve", "to": "static_map", "label": "exact hash lookup"},
    {"from": "static_map", "to": "dispatcher_serve", "label": "static route hit"},
    {"from": "journey_serve", "to": "recognize", "label": "cascade pass"},
    {"from": "recognize", "to": "filter_routes", "label": "candidate scan"},
    {"from": "filter_routes", "to": "routes_simulator", "label": "NFA for path"},
    {"from": "routes_simulator", "to": "sim_memos", "label": "transition table"},
    {"from": "recognize", "to": "match_head", "label": "HEAD requests"},
    {"from": "recognize", "to": "route_matches", "label": "verb + constraints"},
    {"from": "route_matches", "to": "constraints_serve", "label": "route.app.serve"},
    {"from": "constraints_serve", "to": "dispatcher_serve", "label": "constraints ok"},
    {"from": "dispatcher_serve", "to": "controller_class", "label": "req.controller_class"},
    {"from": "dispatcher_serve", "to": "make_response", "label": "make_response!"},
    {"from": "dispatcher_serve", "to": "metal_dispatch", "label": "controller.dispatch"},
    {"from": "metal_dispatch", "to": "process", "label": "process(name)"},
    {"from": "process", "to": "process_action", "label": "process_action"}
  ]
}

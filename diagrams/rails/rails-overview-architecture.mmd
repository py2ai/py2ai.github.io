node_engine_call -->|"app.call&#40;env&#41;"| node_engine_app
node_engine_app -->|"default middlewares"| node_default_stack
node_engine_app -->|"fold around endpoint"| node_stack_build
node_stack_build -->|"chain entry"| node_executor
node_executor -->|"innermost app = routes"| node_route_set_call
node_route_set_call -->|"@router.serve&#40;req&#41;"| node_journey_serve
node_journey_serve -->|"static path?"| node_static_hit
node_static_hit -->|"route.app.serve"| node_dispatcher_serve
node_journey_serve -->|"X-Cascade pass"| node_recognize
node_recognize -->|"filter_routes&#40;path&#41;"| node_sim_memos
node_recognize -->|"matched route"| node_dispatcher_serve
node_dispatcher_serve -->|"controller.dispatch"| node_metal_dispatch


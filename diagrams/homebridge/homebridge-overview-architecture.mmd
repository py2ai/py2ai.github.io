node_cli -->|"new Server&#40;options&#41;, start&#40;&#41;"| node_server
node_server -->|"config.json + storage paths"| node_user
node_server -->|"creates one HomebridgeAPI"| node_api
node_server -->|"creates with active/disabled lists"| node_plugin_manager
node_server -->|"creates with bridge config"| node_bridge_service
node_plugin_manager -->|"discover, load, initialize"| node_plugin
node_plugin -->|"initializer&#40;api&#41; registers constructors"| node_api
node_api -->|"InternalAPIEvent subscriptions"| node_bridge_service
node_bridge_service -->|"deserialize / configureAccessory / serialize"| node_platform_accessory
node_bridge_service -->|"publishBridge&#40;&#41;"| node_hap_publish
node_hap_publish -->|"bridge.publish&#40;&#41;: HAPServer + mDNS"| node_hap_nodejs
node_server -->|"publishBridge&#40;&#41; once platforms settle"| node_hap_publish
node_server -->|"configs carrying _bridge"| node_child_bridge_service
node_child_bridge_service -->|"fork&#40;childBridgeFork.js&#41;"| node_child_bridge_fork
node_child_bridge_fork -->|"fresh HomebridgeAPI in child"| node_api
node_child_bridge_fork -->|"own BridgeService publishes child bridge"| node_bridge_service


node_hubconf_yolov5s -->|"builds via _create"| node_detection_model
node_detect_run -->|"iterates sources"| node_load_images
node_load_images -->|"raw frames to"| node_letterbox
node_letterbox -->|"stride-aligned input"| node_detection_model
node_detection_model -->|"built by"| node_parse_model
node_parse_model -->|"parses layers from"| node_yaml_s
node_parse_model -->|"stacks"| node_c3
node_c3 -->|"feeds"| node_sppf
node_sppf -->|"multi-scale feats"| node_detect_head
node_parse_model -->|"attaches"| node_detect_head
node_detect_head -->|"anchor-decoded preds"| node_nms
node_detect_run -->|"filters with"| node_nms
node_detect_run -->|"loads weights via"| node_multibackend
node_multibackend -->|"rebuilds pt graph"| node_detection_model


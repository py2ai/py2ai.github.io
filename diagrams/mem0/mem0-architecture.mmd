flowchart TD

subgraph group_sdk["SDK Layer"]
  node_client{{"Python client<br/>Memory facade"}}
  node_config["Base config<br/>component selection"]
  node_factory_utils["Component factory<br/>instantiate by name"]
  node_proxy["OpenAI proxy<br/>drop-in wrapper"]
end

subgraph group_mem["Memory Engine"]
  node_main{{"Memory main<br/>add / search core"}}
  node_base["Memory base<br/>interface contract"]
  node_storage[("History storage<br/>SQLite")]
  node_mem_utils["Memory utils<br/>parsing helpers"]
  node_setup["Setup<br/>first-run bootstrap"]
end

subgraph group_store["Providers &amp; Stores"]
  node_llms["LLM adapters<br/>20+ providers"]
  node_embeddings["Embedding adapters<br/>15 providers"]
  node_vstores{{"Vector store adapters<br/>25+ backends"}}
  node_vstore_base["Vector base<br/>store contract"]
  node_qdrant[("Qdrant adapter<br/>default store")]
  node_chroma[("Chroma adapter<br/>embedded store")]
  node_pgvector[("PGVector adapter<br/>Postgres store")]
  node_reranker["Rerankers<br/>rescoring stage"]
  node_rerank_base["Reranker base<br/>rescore contract"]
  node_cohere["Cohere reranker<br/>API rescorer"]
end

subgraph group_serve["Self-Hosted Server"]
  node_server{{"Server main<br/>FastAPI app"}}
  node_auth["Auth<br/>API key checks"]
  node_db[("Server DB<br/>SQL metadata")]
  node_models["ORM models<br/>users / keys"]
  node_schemas["Pydantic schemas<br/>request / response"]
  node_rate_limit["Rate limiter<br/>throttling"]
  node_routers["Routers<br/>endpoint modules"]
  node_api_keys["API key router<br/>key issuing"]
  node_entities["Entities router<br/>user / agent state"]
  node_dashboard["Dashboard<br/>admin UI"]
end

subgraph group_clients["Clients"]
  node_ts_client["TS client<br/>platform SDK"]
  node_oss_ts["TS OSS mode<br/>in-process mirror"]
  node_cli_py["Python CLI<br/>terminal client"]
end

node_client -->|"add / search calls"| node_main
node_client -->|"load config"| node_config
node_config -->|"resolve names"| node_factory_utils
node_factory_utils -.->|"instantiate LLM"| node_llms
node_factory_utils -.->|"instantiate embedder"| node_embeddings
node_factory_utils -.->|"instantiate store"| node_vstores
node_factory_utils -.->|"instantiate reranker"| node_reranker
node_main -->|"extract facts"| node_llms
node_main -->|"parse messages"| node_mem_utils
node_main -->|"embed text"| node_embeddings
node_main -->|"upsert / query"| node_vstores
node_main -.->|"rescore results"| node_reranker
node_main -->|"append history"| node_storage
node_base -.->|"contract"| node_main
node_main -.->|"first-run checks"| node_setup
node_proxy -->|"capture completions"| node_main
node_server -->|"serve memory ops"| node_main
node_server -->|"verify keys"| node_auth
node_server -->|"metadata access"| node_db
node_server -->|"ORM rows"| node_models
node_server -->|"validate payloads"| node_schemas
node_server -.->|"throttle calls"| node_rate_limit
node_server -->|"mount endpoints"| node_routers
node_api_keys -.->|"key management"| node_server
node_entities -.->|"entity queries"| node_server
node_dashboard -.->|"admin reads"| node_db
node_ts_client -->|"HTTP calls"| node_server
node_oss_ts -.->|"TS mirror access"| node_vstores
node_cli_py -.->|"terminal calls"| node_server
node_qdrant -->|"extends"| node_vstore_base
node_chroma -->|"extends"| node_vstore_base
node_pgvector -->|"extends"| node_vstore_base
node_cohere -->|"extends"| node_rerank_base


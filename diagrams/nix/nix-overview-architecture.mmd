node_main -->|"dispatches nix build"| node_cmd_build
node_main -->|"dispatches nix daemon"| node_daemon
node_cmd_build -->|"Installable::build"| node_installable
node_installable -->|"evaluate installables"| node_eval_state
node_eval_state -->|"registers builtins"| node_primops
node_primops -->|"evalFile&#40;derivationInternal&#41;"| node_derivation_nix
node_derivation_nix -->|"derivationStrict"| node_primops
node_primops -->|"writes .drv + builds"| node_store_api
node_eval_state -->|"reads source paths"| node_store_api
node_cmd_build -->|"realise outputs"| node_worker
node_worker -->|"makeGoal"| node_derivation_goal
node_worker -->|"scan for missing paths"| node_local_store
node_derivation_goal -->|"register outputs"| node_local_store
node_derivation_goal -->|"queryPathInfo"| node_store_api
node_store_api -->|"LocalStore implements"| node_local_store
node_daemon -->|"op handlers"| node_local_store
node_local_store -->|"delete dead paths"| node_gc


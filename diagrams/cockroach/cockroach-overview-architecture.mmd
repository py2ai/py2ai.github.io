flowchart TD

subgraph group_sql["SQL Layer &#40;Postgres Wire&#41;"]
  node_sql_client{{"Postgres-Wire Client Session<br/>[conn.go]"}}
  node_conn_executor["connExecutor — Session State Machine<br/>[conn_executor.go]"]
  node_optimizer["Cost-Based Optimizer &#40;opt&#41;<br/>[coster.go]"]
end

subgraph group_exec["Plan Execution"]
  node_physical_plan["Physical Plan<br/>[physical_plan.go]"]
  node_exec_processors["Processors / Flows &#40;execinfra&#41;<br/>[processorsbase.go]"]
end

subgraph group_kv["KV / Transaction Layer"]
  node_txn["Txn — Client Transactions<br/>[txn.go]"]
  node_dist_sender["DistSender — Range Routing<br/>[dist_sender.go]"]
end

subgraph group_cluster["Node &amp; Ranges"]
  node_node["Node — KV RPC Front Door<br/>[node.go]"]
  node_store["Store — Ranges &amp; Replicas<br/>[store.go]"]
end

subgraph group_repl["Raft Replication"]
  node_replica["Replica — Leaseholder / Follower<br/>[replica.go]"]
  node_raft["Raft Consensus<br/>[replica_raft.go]"]
end

subgraph group_storage["Pebble LSM Engine"]
  node_pebble[("Pebble LSM Store<br/>[pebble.go]")]
end

node_sql_client -->|"SQL over pgwire"| node_conn_executor
node_conn_executor -->|"makeOptimizerPlan"| node_optimizer
node_optimizer -->|"costed memo → plan"| node_physical_plan
node_conn_executor -->|"dispatch to engine"| node_physical_plan
node_physical_plan -->|"flows of processors"| node_exec_processors
node_conn_executor -->|"execWithDistSQLEngine"| node_exec_processors
node_exec_processors -->|"KV reads / writes"| node_txn
node_txn -->|"TxnCoordSender"| node_dist_sender
node_dist_sender -->|"route BatchRequest &#40;gRPC&#41;"| node_node
node_node -->|"batchInternal"| node_store
node_store -->|"range → Replica"| node_replica
node_replica -->|"eval + propose"| node_raft
node_raft -->|"raft log + apply"| node_pebble
node_replica -.->|"MVCC state"| node_pebble


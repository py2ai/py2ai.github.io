node_pg_server -->|"ServeConn"| node_pg_conn
node_pg_conn -->|"session driver"| node_conn_executor
node_conn_executor -->|"execStmt"| node_exec_stmt
node_conn_executor -->|"makeOptimizerPlan"| node_planner
node_planner -->|"build AST → memo"| node_opt_builder
node_opt_builder -->|"relational expressions"| node_memo
node_memo -->|"candidates"| node_coster
node_coster -->|"exploreGroup rules"| node_explorer
node_planner -->|"costed plan"| node_physical_plan
node_conn_executor -->|"execWithDistSQLEngine"| node_flow
node_physical_plan -->|"plan fragment"| node_flow
node_flow -->|"run processors"| node_processors
node_exec_stmt -->|"session Txn"| node_txn
node_processors -->|"KV reads / writes"| node_txn
node_kv_db -->|"stage ops"| node_kv_batch
node_txn -->|"Txn.Send"| node_txn_coord
node_txn_coord -->|"BatchRequest"| node_kvpb
node_txn_coord -->|"fan-out"| node_dist_sender
node_dist_sender -->|"split by range"| node_kvpb
node_dist_sender -->|"gRPC KVBatch"| node_node
node_server -->|"starts node"| node_node
node_node -->|"cluster metadata"| node_gossip
node_node -.->|"local delivery"| node_store_send
node_store_send -->|"SendWithWorkStats"| node_store
node_store -->|"range lookup"| node_replica
node_replica -->|"ensure lease"| node_lease
node_replica -->|"evaluateBatch"| node_evaluate
node_evaluate -.->|"MVCCGet / MVCCPut"| node_mvcc
node_evaluate -->|"result → proposal"| node_eval_propose
node_eval_propose -->|"proposal buffer"| node_propose
node_propose -->|"raft Step"| node_raft_lib
node_raft_lib -->|"Ready"| node_raft_ready
node_raft_ready -.->|"raft log append + apply"| node_pebble
node_store -->|"store engine"| node_pebble
node_engine -->|"Engine impl"| node_pebble
node_pebble -->|"merged MVCC iter"| node_pebble_scanner
node_raft_ready -.->|"ack client"| node_store_send


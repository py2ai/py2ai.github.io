end

subgraph group_rust["Tauri Core"]
  node_tauri{{"lib.rs setup &amp; commands<br/>orchestrator"}}
  node_threads["threads &#40;chat sessions&#41;"]
  node_agent["agent loop, skills, subagents"]
  node_mcp["MCP client integration"]
  node_server["OpenAI-compatible server :1337"]
  node_downloads["model downloads"]
  node_jancli{{"jan CLI &#40;jan-cli crate&#41;<br/>entry"}}
end

subgraph group_tools["Agent Tools"]
  node_agenttools["agent tools: skills/permissions/memory<br/>[lib.rs]"]
  node_builtin["built-in tools"]
end

subgraph group_engines["Inference Engines"]
  node_llamacpp{{"tauri-plugin-llamacpp<br/>runtime"}}
  node_engine["engine session management"]
  node_worker["jan-llama-worker process<br/>runtime"]
  node_gguf["gguf metadata parsing"]
  node_mlx["tauri-plugin-mlx &#40;Apple MLX&#41;<br/>runtime"]
end

subgraph group_extensions["Extension Layer"]
  node_extmgr["extension manager &#40;@janhq/core&#41;<br/>abstraction"]
  node_inference["inference extension glue<br/>[inference.ts]"]
  node_assistant["assistant-extension"]
  node_conversational["conversational-extension"]
end

subgraph group_data["Memory &amp; Data"]
  node_rag["tauri-plugin-rag"]
  node_vectordb[("tauri-plugin-vector-db<br/>database")]
  node_websearch["tauri-plugin-websearch"]
  node_hardware["tauri-plugin-hardware"]
end


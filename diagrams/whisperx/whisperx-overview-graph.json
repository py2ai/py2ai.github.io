    {"id": "align", "label": "align", "file": "whisperx/alignment.py", "path": "whisperx/alignment.py", "group": "align", "groupId": "align", "desc": "wav2vec2 forced alignment with Viterbi decoding for word-level timestamps"},
    {"id": "diarize", "label": "diarize", "file": "whisperx/diarize.py", "path": "whisperx/diarize.py", "group": "diarize", "groupId": "diarize", "desc": "pyannote speaker turns plus assign_word_speakers to label each word"},
    {"id": "writers", "label": "get_writer", "file": "whisperx/utils.py", "path": "whisperx/utils.py", "group": "output", "groupId": "output", "desc": "writer factory producing srt, vtt, tsv, json, txt and Audacity labels"}

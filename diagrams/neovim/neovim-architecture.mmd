node_nlua_exec_typval_callable -->|"typval args path"| node_nlua_pcall
node_nlua_call -->|"fast-context guard"| node_nlua_in_fast_event
node_nvim_eval -->|"eval_expr&#40;arg&#41;"| node_eval_expr
node_api_vimscript -->|"Ex command expressions"| node_eval1
node_eval_expr -->|"recursive descent"| node_eval1
node_eval1 -->|"luaeval&#40;&#41; / v:lua escape"| node_nlua_exec
node_buf_ensure_loaded -->|"open memfile if needed"| node_open_buffer
node_buf_set_lines -->|"edit requires loaded buf"| node_buf_ensure_loaded
node_buf_set_lines -->|"fix_cursor adjusts view"| node_window
node_buf_set_lines -->|"changed_lines flags redraw"| node_update_screen
node_buf_set_lines -->|"buffer change events"| node_apply_autocmds
node_ui_schedule_refresh -->|"put on resize_events"| node_multiqueue_child
node_multiqueue_child -->|"ui_refresh_event runs"| node_ui_refresh

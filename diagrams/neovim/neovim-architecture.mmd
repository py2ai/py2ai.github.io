node_loop_init -->|"events queue created"| node_multiqueue_new
node_multiqueue_new -->|"children inherit flushing"| node_multiqueue_child
node_loop_poll_events -->|"wait ms"| node_loop_uv_run
node_loop_uv_run -->|"UV_RUN_ONCE"| node_uv_run
node_multiqueue_put_event -->|"consumed on next pass"| node_loop_poll_events
node_server_init -->|"listening channel accepted"| node_rpc_start
node_rpc_start -->|"feed raw bytes"| node_unpacker
node_unpacker -->|"msgpack request decoded"| node_handle_request
node_handle_request -->|"msgpack response"| node_packer
node_handle_request -->|"nvim_exec2"| node_api_vimscript
node_handle_request -->|"nvim_eval"| node_nvim_eval
node_handle_request -->|"nvim_exec_lua"| node_nlua_exec

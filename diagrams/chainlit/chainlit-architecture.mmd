node_cli -->|"loads"| node_config
node_cl_module -.->|"reads"| node_config
node_cli -->|"starts"| node_server
node_server -->|"delegates logins"| node_oauth_providers
node_server -.->|"verifies tokens"| node_jwt
node_jwt -.->|"pairs with"| node_cookie
node_oauth_providers -->|"provisions"| node_user
node_server -->|"mounts"| node_socket
node_socket -->|"creates"| node_session
node_session -->|"registered in"| node_context
node_context -->|"exposes"| node_emitter
node_context -->|"carries"| node_chat_context
node_user_session -.->|"reaches handlers via"| node_context
node_socket -->|"dispatches to handlers"| node_cl_module
node_message -->|"pushed by"| node_emitter
node_step -->|"pushed by"| node_emitter
node_element -.->|"rides on"| node_message
node_action -.->|"buttons via"| node_emitter
node_input_widget -->|"compose"| node_chat_settings
node_chat_settings -.->|"synced via"| node_emitter
node_openai_instr -.->|"auto-creates"| node_step
node_langchain_instr -.->|"auto-creates"| node_step
node_callbacks -.->|"hook into"| node_step
node_mcp -.->|"tools scoped to"| node_session
node_message -.->|"persisted per"| node_data_base
node_data_layer -->|"implements"| node_data_base
node_sql_alchemy -.->|"backend for"| node_data_layer
node_azure_storage -.->|"element files for"| node_data_layer
node_emitter -->|"events reach"| node_app_tsx
node_app_tsx -->|"updates"| node_chat_state


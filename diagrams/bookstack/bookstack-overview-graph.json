{
  "owner": "BookStackApp",
  "repo": "BookStack",
  "branch": "development",
  "groups": [
    {"id": "entry", "name": "Entry", "label": "HTTP Entry"},
    {"id": "services", "name": "Services", "label": "Domain Services"},
    {"id": "models", "name": "Models", "label": "Book - Chapter - Page Hierarchy"},
    {"id": "perms", "name": "Permissions", "label": "Permission Engine"},
    {"id": "search", "name": "Search", "label": "Search Engine"},
    {"id": "revisions", "name": "Revisions", "label": "Revision History"}
  ],
  "nodes": [
    {"id": "web_routes", "label": "Web Routes", "file": "web.php", "path": "routes/web.php", "group": "Entry", "groupId": "entry", "desc": "One routes file groups nearly every page route behind auth middleware"},
    {"id": "page_controller", "label": "Page Controller", "file": "PageController.php", "path": "app/Entities/Controllers/PageController.php", "group": "Entry", "groupId": "entry", "desc": "Thin controller that delegates all page work to repos"},
    {"id": "page_repo", "label": "Page Repository", "file": "PageRepo.php", "path": "app/Entities/Repos/PageRepo.php", "group": "Services", "groupId": "services", "desc": "Orchestrates drafts, publishing, revisions and editor selection"},
    {"id": "page_content", "label": "Page Content", "file": "PageContent.php", "path": "app/Entities/Tools/PageContent.php", "group": "Services", "groupId": "services", "desc": "setNewHTML and setNewMarkdown normalize both editor formats"},
    {"id": "book_model", "label": "Book", "file": "Book.php", "path": "app/Entities/Models/Book.php", "group": "Models", "groupId": "models", "desc": "Top container: hasMany pages and chapters, belongsToMany shelves"},
    {"id": "chapter_model", "label": "Chapter", "file": "Chapter.php", "path": "app/Entities/Models/Chapter.php", "group": "Models", "groupId": "models", "desc": "Optional grouping layer between Book and Page"},
    {"id": "page_model", "label": "Page", "file": "Page.php", "path": "app/Entities/Models/Page.php", "group": "Models", "groupId": "models", "desc": "Leaf content node holding html, markdown and text columns"},
    {"id": "permission_applicator", "label": "Permission Applicator", "file": "PermissionApplicator.php", "path": "app/Permissions/PermissionApplicator.php", "group": "Permissions", "groupId": "perms", "desc": "restrictEntityQuery filters every listing through joint permissions"},
    {"id": "joint_builder", "label": "Joint Permission Builder", "file": "JointPermissionBuilder.php", "path": "app/Permissions/JointPermissionBuilder.php", "group": "Permissions", "groupId": "perms", "desc": "Pre-computes a cached view-permission table for all roles"},
    {"id": "search_index", "label": "Search Index", "file": "SearchIndex.php", "path": "app/Search/SearchIndex.php", "group": "Search", "groupId": "search", "desc": "Scores terms from names, headings and tags into search_terms"},
    {"id": "search_runner", "label": "Search Runner", "file": "SearchRunner.php", "path": "app/Search/SearchRunner.php", "group": "Search", "groupId": "search", "desc": "Joins scored term subqueries and sorts by relevance"},
    {"id": "revision_repo", "label": "Revision Repository", "file": "RevisionRepo.php", "path": "app/Entities/Repos/RevisionRepo.php", "group": "Revisions", "groupId": "revisions", "desc": "Snapshots page content and prunes by app.revision_limit"}
  ],
  "edges": [
    {"from": "web_routes", "to": "page_controller", "label": "dispatch"},
    {"from": "page_controller", "to": "page_repo", "label": "create / update"},
    {"from": "page_repo", "to": "page_content", "label": "normalize input"},
    {"from": "page_repo", "to": "page_model", "label": "persist"},
    {"from": "page_content", "to": "page_model", "label": "html + markdown + text"},
    {"from": "page_repo", "to": "revision_repo", "label": "storeNewForPage"},
    {"from": "book_model", "to": "chapter_model", "label": "chapters()"},
    {"from": "book_model", "to": "page_model", "label": "pages()"},
    {"from": "chapter_model", "to": "page_model", "label": "pages()"},
    {"from": "page_model", "to": "permission_applicator", "label": "scopeVisible"},
    {"from": "joint_builder", "to": "permission_applicator", "label": "joint_permissions rows", "style": "dashed"},
    {"from": "page_repo", "to": "search_index", "label": "reindex on save"},
    {"from": "search_index", "to": "search_runner", "label": "scored terms"},
    {"from": "search_runner", "to": "permission_applicator", "label": "visible only"}
  ]
}

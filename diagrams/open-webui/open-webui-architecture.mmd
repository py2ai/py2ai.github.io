flowchart TD

subgraph group_ui["Frontend"]
  node_svelte_app{{"SvelteKit app<br/>page shell"}}
  node_chat_ui["Chat component<br/>message flow UI"]
  node_stores["Client stores<br/>Svelte stores"]
  node_chats_api["Chats API client<br/>typed fetchers"]
end

subgraph group_api["API Layer"]
  node_fastapi{{"FastAPI app<br/>route assembly"}}
  node_config["Config<br/>env + persistence"]
  node_auths["Auth router<br/>signin / api keys"]
  node_models_router["Models router<br/>agent presets"]
  node_knowledge_router["Knowledge router<br/>KB management"]
  node_audio_router["Audio router"]
  node_images_router["Images router<br/>generation engines"]
  node_terminals_router["Terminals router<br/>open terminal"]
  node_socket["Socket hub<br/>websocket events"]
end

subgraph group_chat["Chat &amp; Models"]
  node_middleware{{"Middleware<br/>chat orchestration"}}
  node_ollama["Ollama router<br/>local proxies"]
  node_openai["OpenAI router<br/>provider proxies"]
  node_plugin["Plugin loader<br/>[plugin.py]"]
  node_mcp["MCP client<br/>external servers"]
  node_access["Access control<br/>RBAC checks"]
end

subgraph group_data["Persistence"]
  node_models_db[("Data models<br/>peewee ORM")]
  node_knowledge_m["Knowledge model<br/>KB tables"]
  node_memories_m["Memories model<br/>user facts"]
  node_storage[("Storage provider<br/>[provider.py]")]
  node_tools["Tools runtime<br/>user toolkits"]
end

subgraph group_rag["RAG &amp; Tools"]
  node_retrieval{{"Retrieval utils<br/>context building"}}
  node_vector_main["Vector clients<br/>store factory"]
  node_vector_dbs{{"Vector adapters<br/>9 databases"}}
  node_loaders["Document loaders<br/>content extraction"]
  node_web_search["Web search<br/>provider registry"]
  node_code_interp["Code interpreter<br/>pyodide sandbox"]
end


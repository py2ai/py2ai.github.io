node_server_main -->|"dispatches subcommands"| node_cli_serve
node_cli_serve -->|"creates the async DB engine"| node_db_engine
node_cli_serve -->|"builds the FastAPI app"| node_app_create
node_app_create -->|"mounts GraphQL at /graphql"| node_graphql_router
node_app_create -->|"mounts /v1 REST routes"| node_rest_v1
node_app_create -->|"starts the gRPC listener"| node_grpc_server
node_app_create -->|"constructs with span queue"| node_bulk_inserter
node_app_create -->|"wires DML events"| node_dml_handler
node_grpc_server -->|"registers the servicer"| node_grpc_servicer
node_grpc_servicer -->|"handles Export RPC"| node_grpc_export
node_grpc_export -->|"decodes each OTLP span"| node_otel_decode
node_otel_decode -->|"produces domain Span objects"| node_span_schemas
node_grpc_export -->|"enqueues &#40;span, project&#41; pairs"| node_bulk_inserter
node_http_post_traces -->|"enqueues posted spans"| node_bulk_inserter
node_bulk_inserter -->|"drains queue in batches"| node_bulk_insert_loop
node_bulk_insert_loop -->|"inserts each span row"| node_insert_span
node_insert_span -->|"writes to spans table"| node_model_span
node_bulk_inserter -->|"emits DML events after insert"| node_dml_handler
node_otel_register -->|"returns configured provider"| node_otel_tracer_provider
node_otel_tracer_provider -->|"HTTP/protobuf export"| node_http_exporter
node_otel_tracer_provider -->|"gRPC export"| node_grpc_exporter
node_grpc_exporter -->|"exports spans to the Phoenix gRPC endpoint"| node_grpc_server
node_http_exporter -->|"POSTs OTLP/JSON to /v1/traces"| node_http_post_traces
node_rest_v1 -->|"includes trace endpoints"| node_traces_router
node_traces_router -->|"lists trace rows"| node_model_trace
node_graphql_router -->|"serves the strawberry schema"| node_graphql_schema
node_graphql_router -->|"resolvers read spans and traces"| node_model_span
node_session -->|"reads trace data into notebooks"| node_rest_v1
node_client -->|"HTTP REST calls"| node_rest_v1
node_client -->|"exposes .datasets"| node_datasets_res
node_client -->|"exposes .spans"| node_spans_res
node_client -->|"exposes .experiments"| node_experiments_res
node_datasets_res -->|"creates datasets over REST"| node_model_dataset
node_spans_res -->|"reads and logs spans"| node_model_span
node_experiments_res -->|"runs evaluators over runs"| node_llm_evaluator
node_llm_evaluator -->|"subclass for labeled choices"| node_classification_evaluator
node_db_engine -->|"sessions execute ORM writes"| node_model_span


node_otel_register -->|"exports OTLP spans over gRPC"| node_grpc_ingest
node_otel_register -->|"exports OTLP/JSON over HTTP"| node_http_ingest
node_cli_serve -->|"runs the FastAPI app in uvicorn"| node_app_create
node_app_create -->|"binds and starts the gRPC server"| node_grpc_ingest
node_app_create -->|"constructs BulkInserter for span writes"| node_bulk_inserter
node_grpc_ingest -->|"Servicer.Export decodes each OTLP span"| node_otel_decode
node_http_ingest -->|"enqueues posted spans"| node_bulk_inserter
node_otel_decode -->|"hands decoded spans to the queue"| node_bulk_inserter
node_bulk_inserter -->|"inserts Span rows"| node_db_models
node_rest_api -->|"reads traces, datasets, experiments"| node_db_models
node_graphql_api -->|"resolvers query the same models"| node_db_models
node_client -->|"calls /v1 REST endpoints"| node_rest_api
node_evals -->|"scores logged back via the client"| node_client


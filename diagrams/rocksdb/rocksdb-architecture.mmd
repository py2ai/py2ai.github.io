node_api_put -->|"submit WriteBatch"| node_impl_write
node_impl_write -->|"join write queue"| node_write_group
node_write_group -->|"leader merges group"| node_write_to_wal
node_write_to_wal -->|"AddRecord"| node_wal_writer
node_write_to_wal -->|"after WAL durable"| node_batch_insert
node_batch_insert -->|"per-record handler"| node_memtable_inserter
node_memtable_inserter -->|"Put / Delete / Merge"| node_memtable_add
node_memtable_add -->|"arena-allocated entry"| node_skiplist_insert
node_skiplist_insert -->|"lock-free insert"| node_inline_skiplist
node_memtable_list_get -.->|"scan active memtable"| node_memtable_add
node_api_get -->|"check immutable memtables"| node_memtable_list_get
node_api_get -->|"then SST levels"| node_version_get
node_api_get -.->|"open readers on demand"| node_table_cache
node_version_get -->|"TableCache::Get"| node_table_cache
node_table_cache -->|"per-SST lookup"| node_table_get
node_table_cache -.->|"lazy reader creation"| node_table_open
node_api_iter -->|"unify memtable + SST iterators"| node_memtable_list_get
node_api_iter -->|"per-level file iterators"| node_version_get
node_memtable_add -.->|"frozen memtable queued"| node_memtable_list_pick
node_bg_flush -->|"next flush job"| node_flush_to_file
node_flush_to_file -->|"construct FlushJob"| node_flush_job
node_flush_job -->|"pick memtables to flush"| node_memtable_list_pick
node_flush_job -->|"write L0 file"| node_build_table
node_build_table -->|"BlockBasedTableBuilder"| node_table_builder
node_table_builder -->|"index + footer"| node_table_finish
node_table_builder -->|"bloom / Ribbon bits"| node_filter_builder
node_build_table -->|"publish file metadata"| node_log_and_apply
node_api_compact -->|"manual range compaction"| node_pick_compaction
node_bg_compaction -->|"pick next compaction"| node_pick_compaction
node_pick_compaction -->|"execute"| node_compaction_job
node_compaction_job -->|"merge overlapping runs"| node_compaction_iter
node_compaction_iter -->|"fold merge operands"| node_merge_helper
node_compaction_job -->|"emit compacted SSTs"| node_table_builder
node_compaction_job -->|"install new Version"| node_log_and_apply
node_log_and_apply -->|"swap SuperVersion"| node_cfd
node_cfd -->|"supplies current Version"| node_version_get
node_cf_options -.->|"WAL &amp; write buffer policy"| node_impl_write
node_cf_options -.->|"levels &amp; triggers"| node_compaction_job
node_cf_options -.->|"block size &amp; compression"| node_table_builder


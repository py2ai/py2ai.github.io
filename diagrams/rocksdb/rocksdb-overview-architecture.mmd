flowchart TD

subgraph group_client_api["Client API"]
  node_api_write{{"DB::Put / DB::Write<br/>[db.h]"}}
  node_api_read{{"DB::Get / GetImpl"}}
end

subgraph group_cf_opts["Options &amp; Column Families"]
  node_cf_options["ColumnFamilyOptions / DBOptions<br/>[options.h]"]
end

subgraph group_write_path["Write Path"]
  node_impl_write["DBImpl::Write / WriteImpl<br/>[db_impl_write.cc]"]
  node_wal_writer["Writer::AddRecord &#40;WAL&#41;<br/>[log_writer.cc]"]
  node_memtable_add["MemTable::Add<br/>[memtable.cc]"]
end

subgraph group_flush["Flush to L0"]
  node_bg_flush["DBImpl::BackgroundCallFlush"]
  node_flush_job["FlushJob::Run<br/>[flush_job.cc]"]
  node_sst_builder[("BlockBasedTableBuilder")]
end

subgraph group_compaction["Background Compaction"]
  node_bg_compaction["DBImpl::BackgroundCallCompaction"]
  node_compaction_job["CompactionJob::Run<br/>[compaction_job.cc]"]
end

subgraph group_metadata["Versions &amp; Manifest"]
  node_version_set["VersionSet::LogAndApply<br/>[version_set.cc]"]
end

node_api_write -->|"submit WriteBatch"| node_impl_write
node_impl_write -->|"group commit"| node_wal_writer
node_impl_write -->|"apply after WAL durable"| node_memtable_add
node_memtable_add -.->|"immutable memtable ready"| node_bg_flush
node_bg_flush -->|"pick memtables"| node_flush_job
node_flush_job -->|"stream entries"| node_sst_builder
node_flush_job -->|"publish L0 file"| node_version_set
node_sst_builder -.->|"L0 fills up, trigger"| node_bg_compaction
node_bg_compaction -->|"execute picked compaction"| node_compaction_job
node_compaction_job -->|"emit merged SSTs"| node_sst_builder
node_compaction_job -->|"install new Version"| node_version_set
node_api_read -->|"check live + immutable memtables"| node_memtable_add
node_api_read -->|"locate files via Version::Get"| node_version_set
node_cf_options -.->|"WAL &amp; write buffer policy"| node_impl_write
node_cf_options -.->|"levels &amp; trigger thresholds"| node_compaction_job


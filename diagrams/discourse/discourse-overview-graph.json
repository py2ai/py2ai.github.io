    { "id": "jobs_base", "label": "Jobs::Base", "file": "base.rb", "path": "app/jobs/base.rb", "group": "Sidekiq jobs", "groupId": "jobs", "desc": "module Jobs with enqueue/enqueue_in and the Base#execute wrapper" },

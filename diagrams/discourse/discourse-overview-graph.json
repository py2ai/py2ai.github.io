    { "id": "search", "label": "Search", "file": "search.rb", "path": "lib/search.rb", "group": "PostgreSQL full-text search", "groupId": "search", "desc": "query side: to_tsquery, advanced filters, term execution" },
    { "id": "plugin_instance", "label": "Plugin::Instance", "file": "instance.rb", "path": "lib/plugin/instance.rb", "group": "Plugin system", "groupId": "plugins", "desc": "per-plugin API object: find_all, activate!, modifiers, serializers" }

end

subgraph group_g2["Write Path"]
  node_segwriter["Segment Writer<br/>[segment.go]"]
  node_ingester["Ingester &#40;legacy v1&#41;<br/>[ingester.go]"]
end

subgraph group_g3["Storage &amp; Compaction"]
  node_objstore["Object Storage<br/>[objstore.go]"]
  node_metastore["Metastore<br/>[index_service.go]"]
  node_compactor["Compactor<br/>[compactor.go]"]
end

subgraph group_g4["Query Path &#40;v2&#41;"]
  node_readpath["Read Path Router<br/>[router.go]"]
  node_queryfrontend["Query Frontend &#40;v2&#41;<br/>[query_frontend.go]"]
  node_querybackend["Query Backend<br/>[backend.go]"]
end

subgraph group_g5["Legacy Query Path &#40;v1&#41;"]
  node_querier["Querier &#40;legacy&#41;<br/>[querier.go]"]
  node_storegateway["Store Gateway<br/>[gateway.go]"]
end

node_distributor -->|"route each profile series"| node_writepath
node_writepath -->|"v2 write path"| node_segwriter
node_writepath -->|"legacy v1 write path"| node_ingester
node_segwriter -->|"uploadBlock"| node_objstore
node_segwriter -->|"register block metadata"| node_metastore
node_ingester -->|"shipper uploads blocks"| node_objstore
node_metastore -->|"plan compaction jobs"| node_compactor
node_compactor -->|"rewrite merged blocks"| node_objstore
node_compactor -->|"update block metas"| node_metastore
node_readpath -->|"new read path"| node_queryfrontend
node_readpath -->|"legacy read path"| node_querier
node_queryfrontend -->|"fetch block metadata"| node_metastore
node_queryfrontend -->|"invoke query plan"| node_querybackend
node_querybackend -->|"read profile blocks"| node_objstore
node_querier -->|"query recent data"| node_ingester
node_querier -->|"query stored blocks"| node_storegateway


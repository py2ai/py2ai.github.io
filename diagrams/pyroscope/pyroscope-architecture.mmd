node_push_api -->|"wraps external push service"| node_push_capture
node_push_capture -->|"Push RPC"| node_distributor
node_distributor -->|"parse pprof payloads"| node_pprof
node_distributor -->|"route series by WritePath"| node_writepath
node_writepath -->|"v2: ingest by shard key"| node_shard
node_shard -->|"ingest into heads"| node_memdb
node_memdb -->|"flush heads"| node_segment
node_segment -->|"write tenant dataset index"| node_block_index
node_segment -->|"uploadBlock"| node_objstore
node_segment -->|"storeMetadata / AddBlock"| node_metastore_raft
node_metastore_raft -->|"applied FSM state"| node_metastore
node_metastore -->|"compaction planning input"| node_compactor
node_compactor -->|"assign jobs"| node_compaction_service
node_compaction_service -->|"lease compaction jobs"| node_compaction_worker
node_compaction_worker -->|"merge and rewrite blocks"| node_objstore
node_compaction_worker -->|"update compaction level"| node_metastore
node_writepath -->|"v1: Push"| node_ingester
node_ingester -->|"per-tenant instance"| node_ingester_instance
node_ingester_instance -->|"newInstance wraps PhlareDB"| node_phlaredb
node_phlaredb -->|"ingest into head"| node_phlaredb_head
node_phlaredb_head -->|"ship flushed blocks"| node_shipper
node_shipper -->|"upload blocks"| node_objstore
node_readpath -->|"route to v2 frontend"| node_queryfrontend
node_readpath -->|"route to legacy querier"| node_querier
node_queryfrontend -->|"fetch block metadata"| node_metastore
node_queryfrontend -->|"build plan"| node_queryplan
node_queryfrontend -->|"Invoke query plan"| node_querybackend
node_queryplan -->|"MERGE / READ nodes"| node_querybackend
node_querybackend -->|"execute READ nodes"| node_block_reader
node_block_reader -->|"fetch datasets"| node_objstore
node_querier -->|"bidi merge clients"| node_clientpool
node_clientpool -->|"query ingester heads"| node_ingester
node_querier -->|"query stored blocks"| node_storegateway
node_storegateway -->|"sharded bucket stores"| node_bucket_store
node_bucket_store -->|"open single-block querier"| node_block_querier
node_bucket_store -->|"read block data"| node_objstore
node_block_querier -->|"read parquet and symbols"| node_objstore


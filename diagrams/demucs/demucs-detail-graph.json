{
  "owner": "facebookresearch",
  "repo": "demucs",
  "branch": "main",
  "groups": [
    {"id": "g1", "name": "g1", "label": "CLI & API"},
    {"id": "g2", "name": "g2", "label": "Model Registry"},
    {"id": "g3", "name": "g3", "label": "Inference Engine"},
    {"id": "g4", "name": "g4", "label": "Hybrid Architecture"},
    {"id": "g5", "name": "g5", "label": "Transformer Core"},
    {"id": "g6", "name": "g6", "label": "Conv Encoder/Decoder"},
    {"id": "g7", "name": "g7", "label": "Spectro & Audio"},
    {"id": "g8", "name": "g8", "label": "Training"}
  ],
  "nodes": [
    {"id": "separate_main", "label": "separate.main", "file": "separate.py", "path": "demucs/separate.py", "group": "g1", "groupId": "g1", "desc": "CLI entrypoint parsing flags and looping over tracks"},
    {"id": "separator", "label": "Separator", "file": "api.py", "path": "demucs/api.py", "group": "g1", "groupId": "g1", "desc": "high-level wrapper that owns model, device, and segment settings"},
    {"id": "sep_audio_file", "label": "separate_audio_file", "file": "api.py", "path": "demucs/api.py", "group": "g1", "groupId": "g1", "desc": "reads one track and returns a dict of stem tensors"},
    {"id": "get_model", "label": "get_model", "file": "pretrained.py", "path": "demucs/pretrained.py", "group": "g2", "groupId": "g2", "desc": "public loader mapping a name or signature to weights"},
    {"id": "any_repo", "label": "AnyModelRepo", "file": "repo.py", "path": "demucs/repo.py", "group": "g2", "groupId": "g2", "desc": "tries local then remote repositories for a model"},
    {"id": "remote_repo", "label": "RemoteRepo", "file": "repo.py", "path": "demucs/repo.py", "group": "g2", "groupId": "g2", "desc": "parses the remote files.txt index into model URLs"},
    {"id": "bag_repo", "label": "BagOnlyRepo", "file": "repo.py", "path": "demucs/repo.py", "group": "g2", "groupId": "g2", "desc": "resolves bag-of-models yaml specs"},
    {"id": "bag_of_models", "label": "BagOfModels", "file": "apply.py", "path": "demucs/apply.py", "group": "g2", "groupId": "g2", "desc": "holds sub-models and per-source blending weights"},
    {"id": "apply_model", "label": "apply_model", "file": "apply.py", "path": "demucs/apply.py", "group": "g3", "groupId": "g3", "desc": "shift/split/segment driver around a forward pass"},
    {"id": "save_audio", "label": "save_audio", "file": "audio.py", "path": "demucs/audio.py", "group": "g3", "groupId": "g3", "desc": "writes wav/flac/mp3 stems with clipping control"},
    {"id": "htdemucs", "label": "HTDemucs", "file": "htdemucs.py", "path": "demucs/htdemucs.py", "group": "g4", "groupId": "g4", "desc": "hybrid model class wiring both branches and the transformer"},
    {"id": "htdemucs_forward", "label": "HTDemucs.forward", "file": "htdemucs.py", "path": "demucs/htdemucs.py", "group": "g4", "groupId": "g4", "desc": "runs STFT, dual U-Net, transformer, masks, iSTFT"},
    {"id": "spec_layer", "label": "HTDemucs._spec", "file": "htdemucs.py", "path": "demucs/htdemucs.py", "group": "g4", "groupId": "g4", "desc": "pads the mix and computes the complex STFT"},
    {"id": "mask_layer", "label": "HTDemucs._mask", "file": "htdemucs.py", "path": "demucs/htdemucs.py", "group": "g4", "groupId": "g4", "desc": "turns source estimates into complex masks"},
    {"id": "wiener", "label": "HTDemucs._wiener", "file": "htdemucs.py", "path": "demucs/htdemucs.py", "group": "g4", "groupId": "g4", "desc": "OpenUnmix EM filtering when cac is off"},
    {"id": "ispec", "label": "HTDemucs._ispec", "file": "htdemucs.py", "path": "demucs/htdemucs.py", "group": "g4", "groupId": "g4", "desc": "inverse STFT back to the time domain"},
    {"id": "crosstransformer", "label": "CrossTransformerEncoder", "file": "transformer.py", "path": "demucs/transformer.py", "group": "g5", "groupId": "g5", "desc": "self and cross attention over both branches"},
    {"id": "xformer_layer", "label": "CrossTransformerEncoderLayer", "file": "transformer.py", "path": "demucs/transformer.py", "group": "g5", "groupId": "g5", "desc": "one attention block with norm-first pre-norm"},
    {"id": "mha", "label": "MultiheadAttention", "file": "transformer.py", "path": "demucs/transformer.py", "group": "g5", "groupId": "g5", "desc": "attention with optional sparse masks"},
    {"id": "henc", "label": "HEncLayer", "file": "hdemucs.py", "path": "demucs/hdemucs.py", "group": "g6", "groupId": "g6", "desc": "encoder block with conv, DConv residual, and rewrite"},
    {"id": "hdec", "label": "HDecLayer", "file": "hdemucs.py", "path": "demucs/hdemucs.py", "group": "g6", "groupId": "g6", "desc": "decoder block with skip injection and transposed conv"},
    {"id": "multiwrap", "label": "MultiWrap", "file": "hdemucs.py", "path": "demucs/hdemucs.py", "group": "g6", "groupId": "g6", "desc": "shares one layer across frequency bands"},
    {"id": "hdemucs", "label": "HDemucs", "file": "hdemucs.py", "path": "demucs/hdemucs.py", "group": "g6", "groupId": "g6", "desc": "assembles encoder/decoder stacks from the layers"},
    {"id": "demucs", "label": "Demucs", "file": "demucs.py", "path": "demucs/demucs.py", "group": "g6", "groupId": "g6", "desc": "waveform-only U-Net with BLSTM bottleneck"},
    {"id": "spectro", "label": "spectro", "file": "spec.py", "path": "demucs/spec.py", "group": "g7", "groupId": "g7", "desc": "thin wrapper over torch.stft with Hann window"},
    {"id": "ispectro", "label": "ispectro", "file": "spec.py", "path": "demucs/spec.py", "group": "g7", "groupId": "g7", "desc": "inverse STFT wrapper used by _ispec"},
    {"id": "audio_file", "label": "AudioFile", "file": "audio.py", "path": "demucs/audio.py", "group": "g7", "groupId": "g7", "desc": "ffmpeg-backed reader of any audio format"},
    {"id": "convert_audio", "label": "convert_audio", "file": "audio.py", "path": "demucs/audio.py", "group": "g7", "groupId": "g7", "desc": "resamples and fixes channel counts with julius"},
    {"id": "train_main", "label": "train.main", "file": "train.py", "path": "demucs/train.py", "group": "g8", "groupId": "g8", "desc": "hydra entrypoint that builds the solver"},
    {"id": "train_get_model", "label": "train.get_model", "file": "train.py", "path": "demucs/train.py", "group": "g8", "groupId": "g8", "desc": "builds the model for training or wraps torchaudio's"},
    {"id": "solver", "label": "Solver", "file": "solver.py", "path": "demucs/solver.py", "group": "g8", "groupId": "g8", "desc": "owns optimizers, EMA, and checkpoint state"},
    {"id": "solver_train", "label": "Solver.train", "file": "solver.py", "path": "demucs/solver.py", "group": "g8", "groupId": "g8", "desc": "epochs, early stopping, and serialization"},
    {"id": "run_epoch", "label": "Solver._run_one_epoch", "file": "solver.py", "path": "demucs/solver.py", "group": "g8", "groupId": "g8", "desc": "single pass over train or valid loader"},
    {"id": "wavset", "label": "Wavset", "file": "wav.py", "path": "demucs/wav.py", "group": "g8", "groupId": "g8", "desc": "random-crop dataset over pre-extracted wav tracks"}
  ],
  "edges": [
    {"from": "separate_main", "to": "separator", "label": "builds Separator"},
    {"from": "separator", "to": "sep_audio_file", "label": "per track"},
    {"from": "sep_audio_file", "to": "apply_model", "label": "runs separation"},
    {"from": "sep_audio_file", "to": "audio_file", "label": "reads via ffmpeg"},
    {"from": "sep_audio_file", "to": "save_audio", "label": "writes stems"},
    {"from": "separator", "to": "get_model", "label": "_load_model"},
    {"from": "get_model", "to": "any_repo", "label": "delegates lookup"},
    {"from": "any_repo", "to": "remote_repo", "label": "reads files.txt"},
    {"from": "any_repo", "to": "bag_repo", "label": "resolves bags"},
    {"from": "bag_repo", "to": "remote_repo", "label": "fetches checkpoints"},
    {"from": "any_repo", "to": "bag_of_models", "label": "assembles bag"},
    {"from": "get_model", "to": "htdemucs", "label": "default model"},
    {"from": "apply_model", "to": "bag_of_models", "label": "averages sub-models"},
    {"from": "apply_model", "to": "htdemucs_forward", "label": "model(padded_mix)"},
    {"from": "htdemucs", "to": "htdemucs_forward", "label": "forward"},
    {"from": "htdemucs_forward", "to": "spec_layer", "label": "_spec STFT"},
    {"from": "spec_layer", "to": "spectro", "label": "wraps th.stft"},
    {"from": "htdemucs_forward", "to": "mask_layer", "label": "_mask"},
    {"from": "mask_layer", "to": "wiener", "label": "OpenUnmix wiener"},
    {"from": "htdemucs_forward", "to": "ispec", "label": "_ispec"},
    {"from": "ispec", "to": "ispectro", "label": "wraps th.istft"},
    {"from": "htdemucs_forward", "to": "crosstransformer", "label": "bottom block"},
    {"from": "htdemucs_forward", "to": "henc", "label": "freq encoder"},
    {"from": "htdemucs_forward", "to": "hdec", "label": "freq decoder"},
    {"from": "crosstransformer", "to": "xformer_layer", "label": "t_layers per branch"},
    {"from": "xformer_layer", "to": "mha", "label": "attention"},
    {"from": "henc", "to": "multiwrap", "label": "multi_freqs bands"},
    {"from": "hdec", "to": "multiwrap", "label": "shared weights"},
    {"from": "hdemucs", "to": "henc", "label": "builds encoder"},
    {"from": "hdemucs", "to": "hdec", "label": "builds decoder"},
    {"from": "htdemucs", "to": "hdemucs", "label": "reuses layer recipe"},
    {"from": "htdemucs", "to": "demucs", "label": "waveform sibling"},
    {"from": "audio_file", "to": "convert_audio", "label": "resample on read"},
    {"from": "train_main", "to": "train_get_model", "label": "builds model"},
    {"from": "train_main", "to": "solver", "label": "get_solver"},
    {"from": "solver", "to": "solver_train", "label": "train()"},
    {"from": "solver_train", "to": "run_epoch", "label": "epoch loop"},
    {"from": "run_epoch", "to": "wavset", "label": "batches"},
    {"from": "wavset", "to": "convert_audio", "label": "channels and samplerate"},
    {"from": "train_get_model", "to": "htdemucs", "label": "wraps HTDemucs"}
  ]
}

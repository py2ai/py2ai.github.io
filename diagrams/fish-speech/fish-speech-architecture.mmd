flowchart TD

subgraph group_engine["Engine"]
  node_inference_engine["Inference Engine<br/>public API"]
  node_reference_loader["Reference Loader<br/>prompt builder"]
  node_vq_manager["VQ Manager<br/>codec loader"]
  node_api_client["API Client<br/>client lib"]
  node_api_server["API Server Entry<br/>CLI entry"]
end

subgraph group_semantic["Semantic Model"]
  node_llama{{"Dual-AR Transformer<br/>semantic model"}}
  node_generate["Generation<br/>token loop"]
  node_lit_module["Lightning Module<br/>training module"]
  node_lora["LoRA<br/>adapter"]
  node_quantize["Quantize Tool<br/>weight tool"]
  node_merge_lora["Merge LoRA<br/>weight tool"]
  node_eval_in_context["In-Context Eval<br/>eval tool"]
end

subgraph group_codec["Codec"]
  node_modded_dac{{"Modded DAC<br/>audio codec"}}
  node_rvq[("RVQ Quantizer<br/>[rvq.py]")]
  node_dac_inference["Codec Inference<br/>codec wrapper"]
end

subgraph group_data["Data"]
  node_semantic_ds[("Semantic Dataset<br/>[semantic.py]")]
  node_vqgan_ds[("Codec Dataset<br/>[vqgan.py]")]
  node_concat_repeat["Concat Repeat<br/>dataset util"]
  node_protos["Text Data Protos<br/>wire format"]
  node_build_dataset["Dataset Builder<br/>preprocess tool"]
  node_extract_vq["VQ Extraction<br/>preprocess tool"]
  node_create_train_split["Train Split<br/>preprocess tool"]
end

subgraph group_serving["Serving"]
  node_views["API Views<br/>HTTP endpoints"]
  node_api_utils["API Utils<br/>HTTP helpers"]
  node_model_manager[("Model Manager<br/>server registry")]
  node_model_utils["Model Utils<br/>server helpers"]
  node_webui["WebUI<br/>Gradio app"]
  node_webui_inference["WebUI Inference<br/>UI backend"]
  node_run_webui["Run WebUI<br/>CLI entry"]
end

subgraph group_training["Configs &amp; Utils"]
  node_base_config[("Base Config<br/>YAML config")]
  node_finetune_config[("Finetune Config<br/>YAML config")]
  node_dac_config[("Codec Config<br/>YAML config")]
  node_spectrogram["Spectrogram Utils<br/>signal utils"]
  node_clean["Text Cleaner<br/>text utils"]
end

node_inference_engine -->|"drives the"| node_llama
node_inference_engine -->|"builds prompts via"| node_reference_loader
node_inference_engine -.->|"loads codecs via"| node_vq_manager
node_api_client -->|"calls the"| node_views
node_api_server -->|"boots the"| node_views
node_generate -->|"token loop over the"| node_llama
node_lit_module -->|"trains the"| node_llama
node_lora -.->|"adapts the"| node_llama
node_quantize -.->|"shrinks the"| node_llama
node_merge_lora -.->|"folds the"| node_lora
node_eval_in_context -.->|"evaluates through"| node_generate
node_modded_dac -->|"quantizes through the"| node_rvq
node_dac_inference -->|"wraps the"| node_modded_dac
node_generate -.->|"tokens decoded by"| node_dac_inference
node_build_dataset -->|"writes"| node_semantic_ds
node_build_dataset -.->|"packs into"| node_protos
node_semantic_ds -.->|"feeds"| node_lit_module
node_extract_vq -->|"runs the"| node_modded_dac
node_extract_vq -->|"populates the"| node_vqgan_ds
node_create_train_split -.->|"splits into"| node_vqgan_ds
node_concat_repeat -.->|"augments the"| node_semantic_ds
node_clean -.->|"sanitizes text for"| node_build_dataset
node_views -->|"resolves through the"| node_model_manager
node_views -.->|"encodes with"| node_api_utils
node_views -.->|"wires devices via"| node_model_utils
node_model_manager -.->|"loads the"| node_inference_engine
node_webui -.->|"calls the"| node_views
node_webui_inference -.->|"calls the"| node_inference_engine
node_run_webui -->|"launches the"| node_webui
node_base_config -.->|"extends into"| node_finetune_config
node_base_config -.->|"sibling of"| node_dac_config
node_spectrogram -.->|"renders mels for"| node_vqgan_ds


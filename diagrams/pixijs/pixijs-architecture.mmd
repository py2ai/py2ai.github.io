node_app -->|"init&#40;&#41; awaits autoDetectRenderer"| node_auto_detect
node_app -->|"Ticker.shared drives rendering"| node_ticker
node_ticker -->|"listener calls renderer.render&#40;stage&#41;"| node_abstract_renderer
node_ticker -->|"onRender hooks run per frame"| node_container
node_abstract_renderer -->|"prerender/render/renderEnd emit"| node_system_runner
node_container -->|"Sprite extends ViewContainer"| node_sprite
node_container -->|"subtrees join render groups"| node_render_group
node_render_group_system -->|"updates + rebuilds lists"| node_render_group
node_render_group_system -->|"phase 1 validates renderables"| node_sprite_pipe
node_render_group -->|"each group owns an InstructionSet"| node_instruction_set
node_sprite -->|"addRenderable&#40;sprite&#41;"| node_sprite_pipe
node_sprite_pipe -->|"creates per-renderer gpu data"| node_batchable_sprite
node_batchable_sprite -->|"batch.addToBatch&#40;element&#41;"| node_batcher_pipe
node_batcher_pipe -->|"buildStart/buildEnd append"| node_instruction_set
node_batcher_pipe -->|"creates one per batcherName"| node_batcher
node_batcher_pipe -->|"blend changes break the batch"| node_blend_pipe
node_batcher -->|"abstract base / default impl"| node_default_batcher
node_batcher -->|"shared quad geometry"| node_batch_geometry
node_batcher -->|"fallback maxTextures probe"| node_max_textures
node_batcher_pipe -->|"WebGL execution"| node_gl_batch_adaptor
node_batcher_pipe -->|"WebGPU execution"| node_gpu_batch_adaptor
node_auto_detect -->|"preference 'webgpu' + isWebGPUSupported"| node_webgpu_renderer
node_auto_detect -->|"default priority order"| node_webgl_renderer
node_webgpu_renderer -->|"extends shared base"| node_abstract_renderer
node_webgl_renderer -->|"extends shared base"| node_abstract_renderer
node_abstract_renderer -->|"canvas + resize"| node_view_system
node_abstract_renderer -->|"pooled render textures"| node_texture_pool
node_abstract_renderer -->|"global world uniforms"| node_global_uniforms
node_webgpu_renderer -->|"owns GPUDevice"| node_gpu_device
node_webgpu_renderer -->|"maxBatchableTextures"| node_gpu_limits
node_webgpu_renderer -->|"PSO cache"| node_pso_cache
node_webgpu_renderer -->|"bind group cache"| node_bind_group_system
node_gpu_batch_adaptor -->|"texture bind groups"| node_bind_group_system
node_webgl_renderer -->|"context creation"| node_gl_context
node_assets -->|"alias to URL"| node_resolver
node_assets -->|"backgroundLoad"| node_background_loader
node_assets -->|"Sprite.from hits the cache"| node_sprite


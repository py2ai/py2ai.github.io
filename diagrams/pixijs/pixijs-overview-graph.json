{
  "owner": "pixijs",
  "repo": "pixijs",
  "branch": "dev",
  "groups": [
    { "id": "app", "name": "app", "label": "App & Ticker" },
    { "id": "scene", "name": "scene", "label": "Scene Graph" },
    { "id": "batch", "name": "batch", "label": "Sprite Batching" },
    { "id": "renderers", "name": "renderers", "label": "Renderer Backends" },
    { "id": "assets", "name": "assets", "label": "Asset Loading" }
  ],
  "nodes": [
    { "id": "app", "label": "Application", "file": "Application.ts", "path": "src/app/Application.ts", "group": "app", "groupId": "app", "desc": "Bootstrap wrapper: init() auto-detects a renderer and wires the shared ticker" },
    { "id": "ticker", "label": "Ticker", "file": "Ticker.ts", "path": "src/ticker/Ticker.ts", "group": "app", "groupId": "app", "desc": "requestAnimationFrame loop; computes deltaMS and emits listeners each frame" },
    { "id": "container", "label": "Container", "file": "Container.ts", "path": "src/scene/container/Container.ts", "group": "scene", "groupId": "scene", "desc": "Display-object tree base: children, transforms, dirty flags" },
    { "id": "render_group_system", "label": "RenderGroupSystem", "file": "RenderGroupSystem.ts", "path": "src/scene/container/RenderGroupSystem.ts", "group": "scene", "groupId": "scene", "desc": "Walks the scene: validates renderables, updates transforms, builds instructions" },
    { "id": "sprite_pipe", "label": "SpritePipe", "file": "SpritePipe.ts", "path": "src/scene/sprite/SpritePipe.ts", "group": "scene", "groupId": "scene", "desc": "Turns each Sprite into a BatchableSprite and hands it to the batch pipe" },
    { "id": "batcher_pipe", "label": "BatcherPipe", "file": "BatcherPipe.ts", "path": "src/rendering/batcher/shared/BatcherPipe.ts", "group": "batch", "groupId": "batch", "desc": "One pipe per renderer; collects batchable elements into active batchers" },
    { "id": "batcher", "label": "Batcher", "file": "Batcher.ts", "path": "src/rendering/batcher/shared/Batcher.ts", "group": "batch", "groupId": "batch", "desc": "Packs quads into shared attribute/index buffers and splits on texture limits" },
    { "id": "default_batcher", "label": "DefaultBatcher", "file": "DefaultBatcher.ts", "path": "src/rendering/batcher/shared/DefaultBatcher.ts", "group": "batch", "groupId": "batch", "desc": "6-float vertex layout: position, uv, ARGB color, texture id + roundPixels" },
    { "id": "auto_detect", "label": "autoDetectRenderer", "file": "autoDetectRenderer.ts", "path": "src/rendering/renderers/autoDetectRenderer.ts", "group": "renderers", "groupId": "renderers", "desc": "Priority order webgl > webgpu > canvas; dynamic-imports the chosen backend" },
    { "id": "webgl_renderer", "label": "WebGLRenderer", "file": "WebGLRenderer.ts", "path": "src/rendering/renderers/gl/WebGLRenderer.ts", "group": "renderers", "groupId": "renderers", "desc": "WebGL 1/2 backend built from the same shared systems" },
    { "id": "webgpu_renderer", "label": "WebGPURenderer", "file": "WebGPURenderer.ts", "path": "src/rendering/renderers/gpu/WebGPURenderer.ts", "group": "renderers", "groupId": "renderers", "desc": "WebGPU backend: pipelines, bind groups, render bundles" },
    { "id": "assets", "label": "Assets", "file": "Assets.ts", "path": "src/assets/Assets.ts", "group": "assets", "groupId": "assets", "desc": "Global loader/cache: aliases, bundles, background loading, texture parsing" }
  ],
  "edges": [
    { "from": "app", "to": "auto_detect", "label": "init() calls autoDetectRenderer" },
    { "from": "app", "to": "ticker", "label": "renders via Ticker.shared" },
    { "from": "ticker", "to": "container", "label": "renderer.render(stage) each frame" },
    { "from": "container", "to": "render_group_system", "label": "scene collected as render groups" },
    { "from": "container", "to": "sprite_pipe", "label": "sprites are view containers" },
    { "from": "render_group_system", "to": "batcher_pipe", "label": "builds + executes instruction sets" },
    { "from": "sprite_pipe", "to": "batcher_pipe", "label": "addRenderable > addToBatch" },
    { "from": "assets", "to": "sprite_pipe", "label": "resolved Textures feed sprites" },
    { "from": "batcher_pipe", "to": "batcher", "label": "creates/drives batchers" },
    { "from": "batcher", "to": "default_batcher", "label": "abstract base > default impl" },
    { "from": "auto_detect", "to": "webgpu_renderer", "label": "preference 'webgpu' if supported" },
    { "from": "auto_detect", "to": "webgl_renderer", "label": "default first choice" }
  ]
}

    { "id": "bind_group_system", "label": "BindGroupSystem", "file": "BindGroupSystem.ts", "path": "src/rendering/renderers/gpu/BindGroupSystem.ts", "group": "webgpu", "groupId": "webgpu", "desc": "Builds/caches GPUBindGroups for uniform buffers and texture views" },
    { "id": "webgl_renderer", "label": "WebGLRenderer", "file": "WebGLRenderer.ts", "path": "src/rendering/renderers/gl/WebGLRenderer.ts", "group": "webgl", "groupId": "webgl", "desc": "WebGL 1/2 backend composed from WebGLSystem extensions" },

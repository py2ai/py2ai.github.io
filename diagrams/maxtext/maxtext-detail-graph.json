{
  "owner": "google",
  "repo": "maxtext",
  "branch": "main",
  "groups": [
    { "id": "config", "name": "Config System", "label": "Config System" },
    { "id": "training", "name": "Training Loop", "label": "Training Loop" },
    { "id": "sharding", "name": "Meshes & Sharding", "label": "Meshes & Sharding" },
    { "id": "model", "name": "Model & Layers", "label": "Model & Layers" },
    { "id": "serving", "name": "Serving & Decode", "label": "Serving & Decode" },
    { "id": "data", "name": "Data Loading", "label": "Data Loading" }
  ],
  "nodes": [
    { "id": "base_yml", "label": "base.yml", "file": "src/maxtext/configs/base.yml", "path": "src/maxtext/configs/base.yml", "group": "config", "groupId": "config", "desc": "Default knobs: mesh, checkpointing, batch sizes" },
    { "id": "pyconfig", "label": "pyconfig.initialize", "file": "src/maxtext/configs/pyconfig.py", "path": "src/maxtext/configs/pyconfig.py", "group": "config", "groupId": "config", "desc": "Resolves, merges and validates YAML + CLI overrides" },
    { "id": "types", "label": "MaxTextConfig", "file": "src/maxtext/configs/types.py", "path": "src/maxtext/configs/types.py", "group": "config", "groupId": "config", "desc": "Pydantic schema with typed fields and defaults" },
    { "id": "train", "label": "train_step", "file": "src/maxtext/trainers/pre_train/train.py", "path": "src/maxtext/trainers/pre_train/train.py", "group": "training", "groupId": "training", "desc": "Value-and-grad over loss_fn, grad dtype cast, optimizer update" },
    { "id": "train_utils", "label": "setup_train_loop", "file": "src/maxtext/utils/train_utils.py", "path": "src/maxtext/utils/train_utils.py", "group": "training", "groupId": "training", "desc": "Mesh, optimizer, checkpoint manager, jit_train_step" },
    { "id": "train_state", "label": "TrainStateNNX", "file": "src/maxtext/common/train_state_nnx.py", "path": "src/maxtext/common/train_state_nnx.py", "group": "training", "groupId": "training", "desc": "NNX model state plus optimizer state in one module" },
    { "id": "checkpointing", "label": "save_checkpoint", "file": "src/maxtext/common/checkpointing.py", "path": "src/maxtext/common/checkpointing.py", "group": "training", "groupId": "training", "desc": "Orbax async saves, preemption handling, restore paths" },
    { "id": "data_loader", "label": "create_dataloader", "file": "src/maxtext/common/data_loader.py", "path": "src/maxtext/common/data_loader.py", "group": "data", "groupId": "data", "desc": "Grain/TFDS/HF iterators wrapped for multi-host" },
    { "id": "mesh", "label": "create_device_mesh", "file": "src/maxtext/utils/maxtext_utils.py", "path": "src/maxtext/utils/maxtext_utils.py", "group": "sharding", "groupId": "sharding", "desc": "ICI/DCN parallelism into a jax Mesh, per slice" },
    { "id": "sharding", "label": "logical_to_mesh_axes", "file": "src/maxtext/utils/sharding.py", "path": "src/maxtext/utils/sharding.py", "group": "sharding", "groupId": "sharding", "desc": "Logical axis rules to PartitionSpecs and NamedSharding" },
    { "id": "transformer", "label": "Transformer", "file": "src/maxtext/models/models.py", "path": "src/maxtext/models/models.py", "group": "model", "groupId": "model", "desc": "Embedder, optional vision/audio encoders, decoder, logits" },
    { "id": "llama2", "label": "LlamaDecoderLayer", "file": "src/maxtext/models/llama2.py", "path": "src/maxtext/models/llama2.py", "group": "model", "groupId": "model", "desc": "Reference decoder layer: norms, attention, MLP, residual" },
    { "id": "decoder", "label": "NNXDecoder", "file": "src/maxtext/layers/nnx_decoders.py", "path": "src/maxtext/layers/nnx_decoders.py", "group": "model", "groupId": "model", "desc": "Scans layers or splits them across mesh stages" },
    { "id": "attention", "label": "Attention", "file": "src/maxtext/layers/attentions.py", "path": "src/maxtext/layers/attentions.py", "group": "model", "groupId": "model", "desc": "QKV projections, rope, flash/ragged kernels, quant" },
    { "id": "embeddings", "label": "Embed", "file": "src/maxtext/layers/embeddings.py", "path": "src/maxtext/layers/embeddings.py", "group": "model", "groupId": "model", "desc": "Vocab table, logits head, RotaryEmbedding variants" },
    { "id": "linears", "label": "MlpBlock", "file": "src/maxtext/layers/linears.py", "path": "src/maxtext/layers/linears.py", "group": "model", "groupId": "model", "desc": "DenseGeneral with custom dot_general sharding" },
    { "id": "normalizations", "label": "RMSNorm", "file": "src/maxtext/layers/normalizations.py", "path": "src/maxtext/layers/normalizations.py", "group": "model", "groupId": "model", "desc": "Norm layers with shard-aware kernels" },
    { "id": "quantizations", "label": "AqtQuantization", "file": "src/maxtext/layers/quantizations.py", "path": "src/maxtext/layers/quantizations.py", "group": "model", "groupId": "model", "desc": "Weight/activation/kv quantization config objects" },
    { "id": "moe", "label": "RoutedMoE", "file": "src/maxtext/layers/moe.py", "path": "src/maxtext/layers/moe.py", "group": "model", "groupId": "model", "desc": "Expert routing, grouped GEMMs, load balancing" },
    { "id": "maxengine", "label": "MaxEngine", "file": "src/maxtext/inference/maxengine/maxengine.py", "path": "src/maxtext/inference/maxengine/maxengine.py", "group": "serving", "groupId": "serving", "desc": "load_params, prefill, insert, generate, init_decode_state" },
    { "id": "maxengine_config", "label": "create_maxengine", "file": "src/maxtext/inference/maxengine/maxengine_config.py", "path": "src/maxtext/inference/maxengine/maxengine_config.py", "group": "serving", "groupId": "serving", "desc": "Factory returning engine plus server config" },
    { "id": "maxengine_server", "label": "maxengine_server", "file": "src/maxtext/inference/maxengine/maxengine_server.py", "path": "src/maxtext/inference/maxengine/maxengine_server.py", "group": "serving", "groupId": "serving", "desc": "gRPC model server wrapping the engine" },
    { "id": "kvcache", "label": "KVCache", "file": "src/maxtext/inference/kvcache.py", "path": "src/maxtext/inference/kvcache.py", "group": "serving", "groupId": "serving", "desc": "Paged cache arrays with transpose and quant views" },
    { "id": "decode", "label": "decode.main", "file": "src/maxtext/inference/decode.py", "path": "src/maxtext/inference/decode.py", "group": "serving", "groupId": "serving", "desc": "Single-stream prefill then generate to text" },
    { "id": "offline_engine", "label": "OfflineEngine", "file": "src/maxtext/inference/offline_engine.py", "path": "src/maxtext/inference/offline_engine.py", "group": "serving", "groupId": "serving", "desc": "Threads + queues around MaxEngine for bulk inference" }
  ],
  "edges": [

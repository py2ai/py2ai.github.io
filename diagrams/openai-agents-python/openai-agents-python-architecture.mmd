flowchart TD

subgraph group_g_core["Run Internals"]
  node_run_context["Run Context<br/>context-wrapper"]
  node_run_loop{{"run_loop<br/>orchestration"}}
  node_turn_resolution["turn_resolution<br/>turn-logic"]
  node_tool_execution["tool_execution<br/>[tool_execution.py]"]
  node_run_state[("run_state<br/>serialization")]
  node_result["result<br/>[result.py]"]
end

subgraph group_g_tools["Tools and Delegation"]
  node_tool{{"tool<br/>[tool.py]"}}
  node_function_schema["function_schema<br/>schema-generation"]
  node_mcp_server["mcp server client<br/>protocol-client"]
  node_mcp_manager["mcp manager<br/>lifecycle"]
  node_handoff_history["handoff history<br/>history-filter"]
  node_guardrail["guardrail<br/>safety-checks"]
end

subgraph group_g_models["Model Providers"]
  node_model_iface{{"Model interface<br/>abstract-interface"}}
  node_openai_responses["Responses model<br/>api-client"]
  node_chatcmpl_converter["ChatCompletions converter<br/>translator"]
  node_chatcmpl_stream["ChatCompletions stream<br/>stream-handler"]
  node_multi_provider["multi provider<br/>router"]
  node_litellm_model["LiteLLM bridge<br/>provider-bridge"]
end

subgraph group_g_memory["Sessions and Tracing"]
  node_session{{"Session protocol<br/>memory-protocol"}}
  node_sqlite_session["SQLite session<br/>local-storage"]
  node_redis_session["Redis session<br/>distributed-storage"]
  node_compaction_session["compaction session<br/>context-management"]
  node_trace_create["trace creation<br/>observability"]
  node_trace_processors["trace processors<br/>exporters"]
end

subgraph group_g_sandbox["Sandbox Subsystem"]
  node_sandbox_agent{{"SandboxAgent<br/>execution-agent"}}
  node_mount_security["mount security<br/>security-layer"]
  node_mount_patterns["mount patterns<br/>pattern-matcher"]
  node_docker_sandbox["Docker sandbox<br/>local-container"]
  node_unix_local_sandbox["Unix local sandbox<br/>local-process"]
  node_modal_sandbox["Modal sandbox<br/>cloud-provider"]
  node_voice_pipeline["VoicePipeline<br/>audio-pipeline"]
  node_realtime_session["Realtime session<br/>websocket-session"]
end

node_run_loop -->|"carries"| node_run_context
node_run_loop -->|"resolves turns with"| node_turn_resolution
node_turn_resolution -->|"dispatches to"| node_tool_execution
node_run_loop -->|"serializes into"| node_run_state
node_turn_resolution -->|"produces"| node_result
node_tool_execution -->|"invokes"| node_tool
node_tool -->|"schemas built by"| node_function_schema
node_run_loop -->|"lists tools from"| node_mcp_server
node_mcp_manager -->|"manages lifecycles"| node_mcp_server
node_turn_resolution -->|"rewrites history via"| node_handoff_history
node_run_loop -.->|"checked by"| node_guardrail
node_run_loop -->|"calls through"| node_model_iface
node_model_iface -->|"implemented by"| node_openai_responses
node_model_iface -.->|"adapted by"| node_chatcmpl_converter
node_chatcmpl_converter -->|"streams via"| node_chatcmpl_stream
node_model_iface -.->|"selected by"| node_multi_provider
node_multi_provider -->|"bridges to"| node_litellm_model
node_run_loop -->|"persists history in"| node_session
node_session -->|"default is"| node_sqlite_session
node_session -->|"scaled by"| node_redis_session
node_session -.->|"compacted by"| node_compaction_session
node_run_loop -.->|"observed by"| node_trace_create
node_trace_create -->|"exported by"| node_trace_processors
node_sandbox_agent -->|"screened by"| node_mount_security
node_mount_security -->|"matches with"| node_mount_patterns
node_sandbox_agent -->|"runs on"| node_docker_sandbox
node_sandbox_agent -->|"runs on"| node_unix_local_sandbox
node_sandbox_agent -->|"runs on"| node_modal_sandbox
node_voice_pipeline -->|"feeds audio turns into"| node_run_loop
node_realtime_session -.->|"replaces with"| node_voice_pipeline


  node_sandbox_agent{{"Sandbox Agent<br/>execution-agent"}}
  node_voice_pipeline["Voice Pipeline<br/>audio-pipeline"]
end

node_runner -->|"executes"| node_agent
node_runner -->|"drives"| node_run_loop
node_run_loop -->|"persists into"| node_run_state
node_agent -->|"armed with"| node_tooling
node_agent -->|"delegates via"| node_handoffs
node_agent -.->|"validated by"| node_guardrails
node_agent -->|"pulls tools from"| node_mcp_servers
node_run_loop -->|"calls through"| node_model_iface
node_model_iface -->|"implemented by"| node_responses_model
node_runner -->|"can run"| node_sandbox_agent
node_voice_pipeline -->|"runs a workflow over"| node_agent


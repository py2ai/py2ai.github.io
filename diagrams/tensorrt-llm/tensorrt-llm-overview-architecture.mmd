node_executor_py -->|"binds into"| node_cpp_executor
node_executor_py -.->|"Torch mode"| node_pyexecutor
node_cpp_executor -->|"schedules through"| node_batch_mgr
node_batch_mgr -->|"manages pages in"| node_kv_cache
node_pyexecutor -->|"loads weights via"| node_model_loader
node_model_loader -->|"instantiates"| node_torch_models
node_model_loader -.->|"fuses"| node_quant
node_llm_api -.->|"mirrored by CLI"| node_commands_serve


node_llm -->|"builds config"| node_llm_args
node_llm -->|"wraps"| node_tokenizer
node_llm -.->|"parses reasoning with"| node_reasoning_parser
node_llm -->|"spawns workers via"| node_mpi_session
node_llm -->|"submits requests to"| node_executor_py
node_scaffolding_controller -.->|"orchestrates"| node_executor_py
node_executor_py -->|"binds into"| node_cpp_executor
node_executor_py -.->|"drives Torch backend"| node_model_engine
node_cpp_executor -->|"accepts"| node_request_cpp
node_cpp_executor -->|"returns"| node_response_cpp
node_cpp_executor -->|"feeds"| node_micro_batch
node_cpp_executor -.->|"allocates buffers from"| node_runtime
node_micro_batch -->|"admits via"| node_capacity_scheduler
node_micro_batch -->|"reserves pages in"| node_kv_cache_cpp
node_micro_batch -.->|"ships KV with"| node_data_transceiver
node_model_engine -->|"loads weights through"| node_model_loader
node_model_engine -->|"steps scheduling with"| node_scheduler
node_model_engine -.->|"replays graphs via"| node_cuda_graph
node_model_engine -.->|"enforces grammar via"| node_guided_decoder
node_model_engine -->|"manages pages in"| node_kv_cache_py
node_model_engine -->|"runs kernels from"| node_attention_backend
node_model_engine -.->|"expands drafts with"| node_speculative
node_model_engine -.->|"routes experts via"| node_moe
node_model_engine -.->|"offloads to"| node_disaggregation
node_model_loader -->|"instantiates"| node_automodel
node_automodel -->|"inherits hooks from"| node_modeling_utils
node_model_loader -.->|"applies"| node_quant_functional
node_openai_server -->|"drives"| node_llm
node_openai_server -->|"validates with"| node_openai_protocol
node_openai_server -.->|"coordinates disaggregation"| node_coordinator
node_disagg_coordinator -.->|"registers workers with"| node_coordinator
node_commands_serve -->|"launches"| node_openai_server
node_grpc_server -.->|"forwards requests to"| node_executor_py


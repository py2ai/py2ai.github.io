node_logical_build -->|"logical → physical"| node_find_best
node_histogram -.->|"row estimates"| node_find_best
node_find_best -->|"best physical plan"| node_exec_builder
node_exec_builder -->|"build &#40;L195&#41;"| node_exec_iface
node_exec_builder -->|"PointGet plan"| node_point_get
node_exec_builder -->|"TableScan plan"| node_table_reader
node_exec_builder -->|"IndexScan plan"| node_index_reader

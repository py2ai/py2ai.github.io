node_exec_builder -->|"Projection plan"| node_projection
node_selection -.->|"pulls chunks"| node_table_reader
node_point_get -->|"snapshot Get"| node_kv_iface
node_table_reader -->|"ranges + DAG"| node_req_builder
node_index_reader -->|"index ranges"| node_req_builder
node_req_builder -->|"kv.Request"| node_distsql_select
node_distsql_select -->|"split by region"| node_cop_task
node_cop_task -->|"schedule tasks"| node_cop_iter
node_cop_task -.->|"MPP fragments &#40;TiFlash&#41;"| node_mpp_client
node_cop_iter -->|"gRPC to TiKV"| node_tikv_store
node_tikv_store -.->|"implements Storage"| node_kv_iface
node_session_exec -->|"commit phase"| node_session_commit
node_session_commit -->|"doCommit &#40;L540&#41;"| node_tikv_txn
node_tikv_txn -.->|"implements Transaction"| node_kv_iface


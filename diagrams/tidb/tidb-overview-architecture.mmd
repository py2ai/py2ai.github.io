end

subgraph group_store["TiKV Client / Coprocessor"]
  node_coprocessor["copIterator — region tasks<br/>[coprocessor.go]"]
  node_tikv_driver[("tikvStore / tikvTxn → TiKV<br/>[tikv_driver.go]")]
end

node_server_run -->|"accept → clientConn.Run"| node_mysql_client
node_mysql_client -->|"dispatch → handleQuery"| node_session_exec
node_session_exec -->|"ExecuteStmt → Optimize"| node_optimizer
node_optimizer -->|"PlanBuilder.Build"| node_plan_builder
node_plan_builder -->|"physical plan"| node_exec_builder
node_exec_builder -->|"build&#40;&#41; → Executor.Next"| node_exec_next
node_exec_next -->|"ranges + operators"| node_req_builder
node_req_builder -->|"kv.Request &#40;DAG&#41;"| node_distsql_select
node_distsql_select -->|"copIterator.Next"| node_coprocessor
node_coprocessor -->|"gRPC coprocessor RPC"| node_tikv_driver
node_exec_next -.->|"chunks → RecordSet"| node_session_exec
node_session_exec -.->|"doCommitWithRetry &#40;2PC&#41;"| node_tikv_driver


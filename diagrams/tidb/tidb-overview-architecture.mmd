subgraph group_exec["Volcano Executor Tree"]
  node_exec_builder["executorBuilder.build<br/>[builder.go]"]
  node_exec_next["Executor.Next tree<br/>[executor.go]"]
end

subgraph group_dist["DistSQL Request Layer"]
  node_req_builder["RequestBuilder — kv.Request<br/>[request_builder.go]"]

flowchart TD

subgraph group_api["Gateway Surface"]
  node_proxy_server{{"FastAPI gateway<br/>proxy app"}}
  node_openai_ep["OpenAI Responses routes<br/>/v1/responses"]
  node_anthropic_ep["Anthropic Messages routes<br/>/v1/messages"]
end

subgraph group_trust["Auth &amp; Guardrails"]
  node_auth["API key and JWT auth<br/>per-request gate"]
  node_hooks["Rate limit and guardrail hooks<br/>proxy callbacks"]
end

subgraph group_route["Routing &amp; SDK"]
  node_router{{"Router load balancer<br/>deployment picker"}}
  node_strategy["Routing strategies<br/>lowest latency etc"]
  node_main["acompletion entry<br/>SDK dispatch"]
  node_http_handler["HTTP transport handler<br/>async httpx calls"]
  node_provider["Provider transformations<br/>100+ adapters"]
end

subgraph group_data["State &amp; Cost"]
  node_cache[("DualCache<br/>in-memory + Redis")]
  node_spend[("Spend writer and logs<br/>batched DB writes")]
end

node_proxy_server -->|"mounts"| node_openai_ep
node_proxy_server -->|"mounts"| node_anthropic_ep
node_openai_ep -->|"verify key"| node_auth
node_anthropic_ep -->|"verify key"| node_auth
node_auth -->|"enforce limits"| node_hooks
node_auth -.->|"key lookup"| node_cache
node_auth -->|"route_llm_request"| node_router
node_router -->|"pick deployment"| node_strategy
node_router -.->|"cooldowns / TPM"| node_cache
node_router -->|"litellm.acompletion"| node_main
node_main -->|"dispatch"| node_http_handler
node_http_handler -->|"transform and call"| node_provider
node_main -.->|"cost attribution"| node_spend


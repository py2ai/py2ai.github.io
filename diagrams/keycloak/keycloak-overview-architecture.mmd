node_keycloak_main -->|"boot provider scan"| node_providers
node_providers -->|"SPI factory maps"| node_session_factory
node_session_factory -->|"per-request session"| node_authz_endpoint
node_authz_endpoint -->|"start browser flow"| node_processor
node_login_actions -->|"form POST, processFlow"| node_processor
node_processor -->|"createFlowExecution&#40;&#41;"| node_default_flow
node_default_flow -->|"alternative: SSO cookie"| node_cookie_auth
node_default_flow -->|"alternative: login form"| node_userpass_form
node_cookie_auth -->|"resume or challenge"| node_processor
node_userpass_form -->|"validate posted credentials"| node_processor
node_userpass_form -->|"user lookup via federation"| node_ldap
node_processor -->|"login done, code issued"| node_token_endpoint
node_token_endpoint -->|"responseBuilder + grants"| node_token_manager


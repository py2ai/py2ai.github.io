node_ui_app -->|"hosts editor"| node_protyle_editor
node_ui_app -->|"opens socket"| node_ws_client
node_ws_client -->|"wss /ws handshake"| node_kernel_serve
node_protyle_editor -->|"POST /api/transactions"| node_kernel_serve
node_kernel_serve -->|"dispatches writes"| node_tx_engine
node_kernel_serve -->|"serves queries"| node_model_layer
node_tx_engine -->|"reindex touched trees"| node_model_layer
node_model_layer -->|"queue tree ops"| node_sql_queue
node_sql_queue -->|"flush rows"| node_sql_index
node_backlinks -->|"query refs table"| node_sql_index
node_sync_engine -->|"reads snapshot deltas"| node_repo_snapshots
node_sync_engine -.->|"triggered by cron/API"| node_kernel_serve
node_bazaar -.->|"installs packages"| node_ui_app
node_sql_index -->|"block data for rendering"| node_protyle_editor


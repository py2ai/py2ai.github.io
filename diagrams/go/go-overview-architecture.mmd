flowchart TD

subgraph group_toolchain["Compiler Toolchain"]
  node_gobuild["go build &#40;CmdBuild&#41;<br/>[build.go]"]
  node_buildssa["buildssa &#40;SSA backend&#41;<br/>[ssa.go]"]
end

subgraph group_entry["Runtime Entry"]
  node_rmain["runtime.main<br/>[proc.go]"]
end

subgraph group_scheduler["G/M/P Scheduler"]
  node_newproc["newproc / newproc1<br/>[proc.go]"]
  node_gmp["G / M / P structs<br/>[runtime2.go]"]
  node_schedule["schedule loop<br/>[proc.go]"]
  node_findrunnable["findRunnable<br/>[proc.go]"]
  node_gopark["gopark / goready<br/>[proc.go]"]
end

subgraph group_channels["Channels"]
  node_chansend["chansend / chanrecv<br/>[chan.go]"]
end

subgraph group_memory["Memory Allocator"]
  node_mcache["mcache &#40;per-P cache&#41;<br/>[mcache.go]"]
  node_mallocgc["mallocgc<br/>[malloc.go]"]
end

subgraph group_gc["Garbage Collector"]
  node_gcstart["gcStart cycle<br/>[mgc.go]"]
end

node_gobuild -->|"compiler lowers each function to SSA"| node_buildssa
node_gobuild -->|"static binary starts at runtime.main"| node_rmain
node_rmain -->|"spawns the main goroutine"| node_newproc
node_newproc -->|"allocates a G into a P's run queue"| node_gmp
node_newproc -->|"new G becomes runnable"| node_schedule
node_schedule -->|"M asks for the next runnable G"| node_findrunnable
node_findrunnable -->|"local runq, global runq, steal, netpoll"| node_gmp
node_schedule -->|"M executes G on its P"| node_gmp
node_gopark -->|"blocked G parks, M loops back"| node_schedule
node_chansend -->|"full buffer parks sender on sendq"| node_gopark
node_gmp -->|"running G performs channel ops"| node_chansend
node_mallocgc -->|"per-P size-class span cache"| node_mcache
node_mallocgc -->|"heap goal reached triggers cycle"| node_gcstart
node_gcstart -->|"mark workers compete in findRunnable"| node_gmp


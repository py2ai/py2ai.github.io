node_gobuild -->|"go build invokes cmd/compile per package"| node_compilemain
node_compilemain -->|"IR handed to SSA backend"| node_buildssa
node_gobuild -->|"linked binary starts at runtime.main"| node_rmain
node_rmain -->|"spawns main goroutine g1"| node_newproc
node_newproc -->|"allocates g, sets _Grunnable"| node_gstruct
node_newproc -->|"wakeupp puts G on P.runnext"| node_runqput
node_runqput -->|"256-slot ring + runnext slot"| node_pstruct
node_schedule -->|"asks for next runnable G"| node_findrunnable
node_findrunnable -->|"drains own P first"| node_runqget
node_runqget -->|"CAS on local ring buffer"| node_pstruct
node_findrunnable -->|"then steal from other Ps"| node_stealwork
node_stealwork -->|"returns stolen G"| node_gstruct
node_findrunnable -->|"global runq / spinning state"| node_schedstruct
node_schedule -->|"runs the chosen G"| node_execute
node_execute -->|"binds m.curg, _Grunning"| node_gstruct
node_execute -->|"M runs one G at a time"| node_mstruct
node_execute -->|"blocking op parks the G"| node_gopark
node_execute -->|"G returns, thread cleans up"| node_goexit0
node_gopark -->|"unblockf completes the wait"| node_goready
node_goready -->|"readied G re-enters a queue"| node_runqput
node_sysmon -->|"no-P thread polls every 10ms"| node_retake
node_retake -->|"syscall handoff / preempt &gt;10ms"| node_pstruct
node_hchan -->|"locks hchan, checks recvq/buf"| node_chansend
node_hchan -->|"locks hchan, checks sendq/buf"| node_chanrecv
node_chansend -->|"buffer full: sudog on sendq"| node_gopark
node_chanrecv -->|"buffer empty: sudog on recvq"| node_gopark
node_chansend -->|"direct handoff to parked receiver"| node_chanrecv
node_mallocgc -->|"heap goal reached triggers cycle"| node_gcstart
node_gcstart -->|"dedicated + fractional workers"| node_gcbgmarkworker
node_gcbgmarkworker -->|"workers drain gcWork"| node_gcdrain
node_findrunnable -->|"findRunnableGCWorker hand-off"| node_gcbgmarkworker
node_mallocgc -->|"GC assist pays scan debt"| node_gcdrain
node_gcstart -->|"mark termination, sweep resumes"| node_bgsweep
node_mallocgc -->|"small objects from span cache"| node_mcache_refill
node_mcache_refill -->|"pull span from central list"| node_mheapcentral
node_pollwait -->|"parks G until fd ready"| node_gopark
node_netpollready -->|"ready Gs from netpoller"| node_goready
node_newstack -->|"doubles gp.stack, rewrites pointers"| node_gstruct


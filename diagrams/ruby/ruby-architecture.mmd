node_ruby_main -->|"boot: argv in, iseq out"| node_ruby_options
node_ruby_options -->|"option table"| node_process_options
node_process_options -->|"default parser is Prism"| node_prism_script
node_process_options -->|"--parser=parse.y path"| node_yycompile
node_yycompile -->|"yyparse token loop"| node_parser_yylex
node_parser_yylex -->|"rb_ast_t NODE tree"| node_rb_iseq_new_top
node_prism_script -->|"pm AST / scope node"| node_pm_iseq_compile_node
node_rb_iseq_new_top -->|"walk NODE"| node_rb_iseq_compile_node
node_rb_iseq_compile_node -->|"per-NODE emit"| node_iseq_compile_each0
node_rb_iseq_compile_node -->|"cleanup pass"| node_iseq_peephole_optimize
node_rb_iseq_new_top -.->|"compiled &lt;main&gt; iseq"| node_rb_iseq_eval_main
node_pm_iseq_compile_node -.->|"compiled &lt;main&gt; iseq"| node_rb_iseq_eval_main
node_rb_iseq_eval_main -->|"push &lt;main&gt; frame, run"| node_vm_exec
node_vm_exec -->|"enter dispatch loop"| node_vm_exec_core
node_vm_exec_core -->|"frames live on VM stack"| node_rb_control_frame_t
node_vm_exec_core -->|"direct-threaded jump"| node_opt_send_without_block
node_vm_exec_core -->|"RTEST + JUMP"| node_branchif
node_branchif -.->|"RUBY_VM_CHECK_INTS"| node_rb_thread_schedule
node_opt_send_without_block -->|"CALL_DATA = ci + cc"| node_vm_sendish
node_vm_sendish -->|"probe inline cache"| node_vm_search_method_fastpath
node_vm_search_method -->|"entry point"| node_vm_search_method_fastpath
node_vm_search_method_fastpath -->|"miss: populate under VM lock"| node_vm_populate_cc
node_vm_populate_cc -->|"via rb_callable_method_entry"| node_callable_method_entry_or_negative
node_vm_populate_cc -->|"vm_cc_new&#40;klass, cme, handler&#41;"| node_rb_callcache
node_vm_sendish -->|"vm_cc_call&#40;cc&#41; handler"| node_vm_call_method
node_vm_call_method -->|"visibility + type from cc"| node_rb_callcache
node_vm_exec -.->|"allocations + GC.start"| node_gc_start_internal
node_gc_start_internal -->|"modular GC indirection"| node_gc_start
node_gc_start -->|"incremental marking"| node_gc_marks_step
node_gc_start -->|"lazy sweeping"| node_gc_sweep_step
node_vm_exec -.->|"newobj out of slots"| node_heap_page_allocate
node_rb_thread_schedule -->|"post-switch CHECK_INTS"| node_rb_threadptr_execute_interrupts
node_vm_exec -.->|"Thread.new"| node_rb_thread_create
node_rb_thread_create -->|"joins runnable set"| node_rb_thread_schedule
node_vm_exec -.->|"Fiber.yield / resume"| node_fiber_switch
node_fiber_switch -->|"first resume runs body"| node_rb_fiber_start


node_ruby_main -->|"options parsed, script handed to parser"| node_prism_script
node_ruby_main -->|"--parser=parse.y selects legacy grammar"| node_parser_yylex
node_prism_script -->|"Prism AST -&gt; YARV iseq"| node_pm_iseq_compile_node
node_parser_yylex -->|"NODE AST -&gt; YARV iseq"| node_rb_iseq_compile_node
node_rb_iseq_compile_node -->|"compiled &lt;main&gt; iseq starts executing"| node_vm_exec
node_pm_iseq_compile_node -->|"compiled &lt;main&gt; iseq starts executing"| node_vm_exec
node_vm_exec -->|"enter instruction dispatch"| node_vm_exec_core
node_vm_exec_core -->|"direct-threaded jump to send"| node_opt_send_without_block
node_opt_send_without_block -->|"vm_sendish + cc call handler"| node_vm_call_method
node_vm_call_method -->|"resolve cme for receiver class"| node_callable_method_entry_or_negative
node_callable_method_entry_or_negative -.->|"cme cached into call site cc"| node_vm_call_method
node_vm_exec -.->|"allocation pressure runs GC"| node_gc_start
node_vm_exec_core -.->|"CHECK_INTS between insns"| node_rb_thread_schedule


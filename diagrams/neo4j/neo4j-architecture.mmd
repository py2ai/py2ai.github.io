flowchart TD

subgraph group_bolt["Bolt server"]
  node_bolt_client["Bolt Client &#40;driver&#41;"]
  node_bolt_handshake["ModernProtocolHandshakeHandler"]
  node_bolt_protocol["BoltProtocol<br/>[BoltProtocol.java]"]
  node_bolt_fsm["StateMachineImpl"]
end

subgraph group_cypher["Cypher: parse, plan, run"]
  node_cypher_preparser["CachingPreParser"]
  node_cypher_parser["Cypher5AstParser"]
  node_idp_solver["IDPQueryGraphSolver"]
  node_cost_model["CardinalityCostModel"]
  node_cypher_runtime_api["CypherRuntime"]
  node_interpreted_runtime["InterpretedRuntime"]
  node_all_nodes_scan["AllNodesScanPipe"]
  node_produce_results["ProduceResultsPipe"]
end

subgraph group_kernel["Kernel &amp; transaction core"]
  node_kernel_tx["KernelTransactionImplementation"]
  node_tx_state["TxState<br/>[TxState.java]"]
  node_tx_append["BatchingTransactionAppender"]
  node_command_batch["CommandBatch<br/>[CommandBatch.java]"]
  node_storage_reader["StorageReader<br/>[StorageReader.java]"]
  node_node_cursor["StorageNodeCursor"]
  node_range_index["RangeIndexProvider"]
end

subgraph group_record_storage["Record storage engine"]
  node_record_storage["RecordStorageEngine"]
  node_record_state["TransactionRecordState"]
  node_record_reader["RecordStorageReader"]
  node_record_node_cursor["RecordNodeCursor"]
  node_neo_stores["NeoStores<br/>[NeoStores.java]"]
  node_node_store["NodeStore<br/>[NodeStore.java]"]
  node_rel_store["RelationshipStore"]
  node_prop_store["PropertyStore<br/>[PropertyStore.java]"]
  node_node_record["NodeRecord<br/>[NodeRecord.java]"]
  node_rel_record["RelationshipRecord"]
  node_prop_record["PropertyRecord"]
  node_format_selector["RecordFormatSelector"]
  node_node_record_format["NodeRecordFormat"]
end

subgraph group_io_wal["Page cache &amp; WAL"]
  node_page_cache["PageCache<br/>[PageCache.java]"]
  node_wal_service["EnvelopedWALService"]
end

node_bolt_client -->|"TCP connect + handshake"| node_bolt_handshake
node_bolt_handshake -->|"negotiates version"| node_bolt_protocol
node_bolt_protocol -->|"drives messages"| node_bolt_fsm
node_bolt_fsm -->|"accepts Cypher"| node_cypher_preparser
node_cypher_preparser -->|"cache miss: full parse"| node_cypher_parser
node_cypher_parser -->|"AST to logical plan"| node_idp_solver
node_idp_solver -->|"scores candidates"| node_cost_model
node_idp_solver -->|"executable plan"| node_cypher_runtime_api
node_cypher_runtime_api -->|"selects runtime"| node_interpreted_runtime
node_interpreted_runtime -->|"builds operator"| node_all_nodes_scan
node_interpreted_runtime -->|"builds operator"| node_produce_results
node_interpreted_runtime -->|"kernel API calls"| node_kernel_tx
node_all_nodes_scan -->|"scan via cursor"| node_node_cursor
node_produce_results -->|"streams results back"| node_bolt_fsm
node_kernel_tx -->|"buffers writes"| node_tx_state
node_tx_state -->|"visitor applies changes"| node_record_state
node_record_state -->|"stages records"| node_node_record
node_record_state -->|"stages records"| node_rel_record
node_record_state -->|"stages records"| node_prop_record
node_kernel_tx -->|"serializes commands"| node_command_batch
node_command_batch -->|"batch to log"| node_tx_append
node_kernel_tx -->|"commit process"| node_tx_append
node_tx_append -->|"writes log envelopes"| node_wal_service
node_kernel_tx -->|"read API"| node_storage_reader
node_storage_reader -->|"exposes cursors"| node_node_cursor
node_record_storage -->|"creates StorageReader"| node_record_reader
node_record_reader -->|"creates cursors"| node_record_node_cursor
node_record_node_cursor -->|"implements"| node_node_cursor
node_record_node_cursor -->|"reads node records"| node_node_store
node_node_store -->|"materializes"| node_node_record
node_node_store -->|"fixed-size decode"| node_node_record_format
node_format_selector -->|"default format"| node_node_record_format
node_record_storage -->|"owns store files"| node_neo_stores
node_neo_stores -->|"opens"| node_node_store
node_neo_stores -->|"opens"| node_rel_store
node_neo_stores -->|"opens"| node_prop_store
node_node_store -->|"page I/O"| node_page_cache
node_rel_store -->|"page I/O"| node_page_cache
node_prop_store -->|"page I/O"| node_page_cache
node_record_storage -->|"feeds schema indexes"| node_range_index


flowchart TD

subgraph group_bolt["Bolt server"]
  node_bolt_client["Bolt Client &#40;driver&#41;"]
  node_bolt_protocol["BoltProtocol<br/>[BoltProtocol.java]"]
  node_bolt_fsm["StateMachineImpl"]
end

subgraph group_cypher["Cypher compiler &amp; runtime"]
  node_cypher_parser["Cypher5AstParser"]
  node_cypher_planner["IDPQueryGraphSolver"]
  node_cypher_runtime["CypherRuntime"]
end

subgraph group_kernel["Kernel transactions"]
  node_kernel_tx["KernelTransactionImplementation"]
  node_tx_state["TxState<br/>[TxState.java]"]
end

subgraph group_record_storage["Record storage engine"]
  node_record_storage["RecordStorageEngine"]
  node_neo_stores["NeoStores<br/>[NeoStores.java]"]
end

subgraph group_io_wal["Page cache &amp; WAL"]
  node_page_cache["PageCache<br/>[PageCache.java]"]
  node_wal_service["EnvelopedWALService"]
end

node_bolt_client -->|"opens connection"| node_bolt_protocol
node_bolt_protocol -->|"drives messages"| node_bolt_fsm
node_bolt_fsm -->|"runs Cypher query"| node_cypher_parser
node_cypher_parser -->|"AST in, logical plan out"| node_cypher_planner
node_cypher_planner -->|"physical plan"| node_cypher_runtime
node_cypher_runtime -->|"transaction API calls"| node_kernel_tx
node_kernel_tx -->|"records mutations"| node_tx_state
node_tx_state -->|"commit: extract commands"| node_record_storage
node_record_storage -->|"applies record commands"| node_neo_stores
node_neo_stores -->|"reads/writes pages"| node_page_cache
node_kernel_tx -->|"appends commit entry"| node_wal_service


node_main -->|"runs session"| node_session_execute
node_session_execute -->|"round loop"| node_inner2_loop
node_session_execute -->|"-a 0 rules ctx"| node_straight_ctx
node_session_execute -->|"-a 1/6/7"| node_combinator_ctx
node_session_execute -->|"load mode plugin"| node_module_load
node_module_load -->|"KERN_TYPE names kernel"| node_mode_kernels
node_straight_ctx -->|"rules amplifier"| node_feed_loader
node_combinator_ctx -->|"mask feeds"| node_feed_loader
node_feed_loader -->|"dlopen feed .so"| node_feed_wordlist
node_feed_wordlist -->|"candidate batches"| node_dispatch
node_dispatch -->|"per-device work"| node_choose_kernel
node_choose_kernel -->|"KERN_RUN_1..4"| node_run_kernel
node_run_kernel -->|"compile + launch"| node_mode_kernels


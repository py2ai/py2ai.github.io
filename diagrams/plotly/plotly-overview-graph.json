    { "id": "validators_json", "label": "_validators.json", "file": "_validators.json", "path": "plotly/validators/_validators.json", "group": "Generated graph_objs", "groupId": "g_graphobjs", "desc": "10,118 validator entries (~3.2 MB) keyed by dotted property path", "shape": "database" },

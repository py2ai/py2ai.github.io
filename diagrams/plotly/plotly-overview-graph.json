    { "id": "scatter_py", "label": "graph_objs/_scatter.py", "file": "_scatter.py", "path": "plotly/graph_objs/_scatter.py", "group": "Generated graph_objs", "groupId": "g_graphobjs", "desc": "Generated Scatter trace with 65 schema-driven properties" },

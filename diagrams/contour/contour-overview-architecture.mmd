node_main -->|"runs serve"| node_do_serve
node_do_serve -->|"wires events"| node_event_handler
node_do_serve -->|"wires caches"| node_snapshot_handler
node_do_serve -->|"starts gRPC"| node_xds_server
node_event_handler -->|"inserts objects"| node_kubernetes_cache
node_event_handler -->|"rebuilds after holdoff"| node_dag_builder
node_kubernetes_cache -->|"read during Build"| node_dag_builder
node_dag_builder -->|"runs processors"| node_httpproxy_processor
node_httpproxy_processor -->|"fills listeners"| node_dag
node_dag -->|"OnChange"| node_route_cache
node_dag -->|"OnChange"| node_cluster_cache
node_route_cache -->|"supplies resources"| node_snapshot_handler
node_cluster_cache -->|"supplies resources"| node_snapshot_handler
node_snapshot_handler -->|"serves snapshots"| node_xds_server
node_dag_builder -->|"times rebuilds"| node_metrics
node_event_handler -->|"counts events"| node_metrics


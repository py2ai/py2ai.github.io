    {"id": "do_serve", "label": "Server.doServe", "file": "serve.go", "path": "cmd/contour/serve.go", "group": "Entry & Wiring", "groupId": "g1", "desc": "Assembles informers, the DAG builder, resource caches, and the xDS gRPC server."},
    {"id": "event_handler", "label": "EventHandler", "file": "handler.go", "path": "internal/contour/handler.go", "group": "Kubernetes Watch Layer", "groupId": "g2", "desc": "Buffers Kubernetes events behind a holdoff timer, then rebuilds the DAG."},
    {"id": "kubernetes_cache", "label": "KubernetesCache", "file": "cache.go", "path": "internal/dag/cache.go", "group": "Kubernetes Watch Layer", "groupId": "g2", "desc": "In-memory index of watched Services, Ingresses, HTTPProxies, and Secrets."},
    {"id": "dag_builder", "label": "Builder", "file": "builder.go", "path": "internal/dag/builder.go", "group": "DAG Build", "groupId": "g3", "desc": "Runs the ordered Processor chain over the cache and prunes invalid virtual hosts."},
    {"id": "httpproxy_processor", "label": "HTTPProxyProcessor", "file": "httpproxy_processor.go", "path": "internal/dag/httpproxy_processor.go", "group": "DAG Build", "groupId": "g3", "desc": "Turns HTTPProxy CRDs into virtual hosts, routes, and clusters."},
    {"id": "dag", "label": "DAG", "file": "dag.go", "path": "internal/dag/dag.go", "group": "DAG Build", "groupId": "g3", "desc": "Routing model of listeners, virtual hosts, routes, and clusters."},
    {"id": "snapshot_handler", "label": "SnapshotHandler", "file": "snapshot.go", "path": "internal/xdscache/v3/snapshot.go", "group": "Envoy Resource Caches", "groupId": "g4", "desc": "Packages the resource caches into go-control-plane snapshots on every DAG build."},
    {"id": "route_cache", "label": "RouteCache", "file": "route.go", "path": "internal/xdscache/v3/route.go", "group": "Envoy Resource Caches", "groupId": "g4", "desc": "Converts DAG listeners into Envoy RouteConfigurations."},
    {"id": "cluster_cache", "label": "ClusterCache", "file": "cluster.go", "path": "internal/xdscache/v3/cluster.go", "group": "Envoy Resource Caches", "groupId": "g4", "desc": "Converts DAG ServiceClusters into Envoy Clusters."},
    {"id": "xds_server", "label": "xDS Server", "file": "server.go", "path": "internal/xds/v3/server.go", "group": "xDS Serving", "groupId": "g5", "desc": "Serves LDS, RDS, CDS, EDS, SDS, and RTDS to Envoy over gRPC."},
    {"id": "metrics", "label": "Metrics", "file": "metrics.go", "path": "internal/metrics/metrics.go", "group": "Observability", "groupId": "g6", "desc": "Prometheus gauges and counters for proxies, DAG rebuilds, and status updates."}

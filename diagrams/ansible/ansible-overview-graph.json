    {"id": "free_strategy", "label": "FreeStrategy", "file": "free.py", "path": "lib/ansible/plugins/strategy/free.py", "group": "Strategy Plugins", "groupId": "g_strat", "desc": "Lets each host race ahead as soon as a worker is free"},

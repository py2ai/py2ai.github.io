    {"id": "ansiballz_builder", "label": "AnsiballZ packager", "file": "module_common.py", "path": "lib/ansible/executor/module_common.py", "group": "Module Shipping", "groupId": "g_modules", "desc": "Zips the module plus its module_utils into the self-extracting AnsiballZ payload"},
    {"id": "inventory_manager", "label": "InventoryManager", "file": "manager.py", "path": "lib/ansible/inventory/manager.py", "group": "Inventory Layer", "groupId": "g_inventory", "desc": "Feeds each source to candidate inventory plugins to build groups and hosts"}

    {"id": "playbook_model", "label": "Playbook.load", "file": "__init__.py", "path": "lib/ansible/playbook/__init__.py", "group": "Play Orchestration", "groupId": "g_orch", "desc": "Parses playbook YAML into a Playbook object holding Play entries"},

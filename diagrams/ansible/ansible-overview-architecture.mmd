node_playbook_cli -->|"hands over playbooks"| node_playbook_executor
node_playbook_cli -->|"builds host list from"| node_inventory_manager
node_playbook_executor -->|"loads YAML via"| node_playbook_model
node_playbook_executor -->|"runs each play through"| node_task_queue_manager
node_playbook_executor -->|"restricts serial batches"| node_inventory_manager
node_task_queue_manager -->|"constructs"| node_play_iterator
node_task_queue_manager -->|"selects by default"| node_linear_strategy
node_task_queue_manager -->|"selects when play.strategy=free"| node_free_strategy
node_linear_strategy -->|"extends"| node_strategy_base
node_free_strategy -->|"extends"| node_strategy_base
node_strategy_base -->|"asks for next task per host"| node_play_iterator
node_strategy_base -->|"spawns one fork per task"| node_worker_process
node_worker_process -->|"delegates to"| node_task_executor
node_task_executor -->|"requests module payload from"| node_ansiballz_builder


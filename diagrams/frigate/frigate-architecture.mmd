node_app -->|"start_camera_processor&#40;&#41;"| node_maintainer
node_maintainer -->|"__start_camera_capture&#40;&#41;"| node_capture_proc
node_capture_proc -->|"spawns watchdog thread"| node_camera_watchdog
node_camera_watchdog -->|"restarts stalled ffmpeg"| node_capture_proc
node_capture_proc -->|"capture threads per role"| node_capture_frames
node_capture_frames -->|"readinto&#40;&#41; fills slot"| node_frame_shm
node_maintainer -->|"__start_camera_processor&#40;&#41;"| node_camera_tracker
node_camera_tracker -->|"run&#40;&#41; enters loop"| node_process_frames
node_process_frames -->|"frame_manager.get&#40;&#41;"| node_frame_shm
node_process_frames -->|"detect&#40;frame&#41; -&gt; boxes"| node_motion
node_process_frames -->|"one detect&#40;&#41; per region"| node_detect_fn
node_detect_fn -->|"object_detector.detect&#40;tensor_input&#41;"| node_remote
node_remote -->|"detection_queue.put&#40;shm name&#41;"| node_det_proc
node_det_proc -->|"results via out-shm + ZMQ"| node_remote
node_process_frames -->|"object_tracker.match_and_update&#40;&#41;"| node_norfair
node_camera_tracker -->|"detected_frames_queue"| node_tracked
node_tracked -->|"owns tracker instances"| node_norfair
node_tracked -->|"EventUpdateSubscriber updates"| node_event_proc
node_app -->|"start_detectors&#40;&#41;"| node_det_proc
node_device_cfg -->|"per-device detector config"| node_det_proc
node_det_proc -->|"starts runner process"| node_runner
node_runner -->|"pulls tensor from SHM"| node_map_input
node_runner -->|"reads region tensors"| node_frame_shm
node_runner -->|"resolves DetectionApi by type"| node_registry
node_registry -->|"type: cpu_tfl"| node_cpu
node_registry -->|"type: edgetpu_tfl &#40;Coral&#41;"| node_edgetpu
node_registry -->|"type: openvino"| node_ov
node_registry -->|"type: tensorrt &#40;Jetson&#41;"| node_trt
node_app -->|"start_watchdog&#40;&#41;"| node_watchdog
node_watchdog -->|"restarts stuck detectors"| node_det_proc
node_app -->|"init_review_segment_manager&#40;&#41;"| node_review
node_app -->|"init_recording_manager&#40;&#41;"| node_record
node_record -->|"reads frames for segments"| node_frame_shm
node_app -->|"start_video_output_processor&#40;&#41;"| node_output_proc
node_output_proc -->|"live view / birdseye frames"| node_frame_shm
node_app -->|"init_dispatcher&#40;&#41;"| node_dispatcher
node_tracked -->|"object topics + snapshots"| node_dispatcher
node_dispatcher -->|"retained topics"| node_mqtt
node_dispatcher -->|"live broadcasts"| node_ws
node_ipc -->|"config commands fan-in"| node_dispatcher
node_app -->|"uvicorn.run&#40;:5001&#41;"| node_fastapi
node_fastapi -->|"best snapshot / current frame"| node_tracked
node_webapp -->|"REST + WebSocket calls"| node_fastapi
node_ws -->|"live object stream"| node_webapp


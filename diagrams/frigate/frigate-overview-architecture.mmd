node_app -->|"starts via CameraMaintainer"| node_capture_proc
node_capture_proc -->|"writes YUV slots"| node_frame_shm
node_capture_proc -->|"frame_queue &#40;name, timestamp&#41;"| node_camera_tracker
node_frame_shm -->|"zero-copy reads"| node_camera_tracker
node_camera_tracker -->|"motion boxes per frame"| node_motion
node_app -->|"start_detectors&#40;&#41;"| node_det_proc
node_camera_tracker -->|"detection queue: camera shm name"| node_det_proc
node_det_proc -->|"plugin lookup by type"| node_registry
node_det_proc -->|"results via out-shm + ZMQ"| node_camera_tracker
node_camera_tracker -->|"detected_frames_queue"| node_tracked
node_tracked -->|"event start / end"| node_event_proc
node_tracked -->|"object topics + snapshots"| node_dispatcher
node_app -->|"init_dispatcher&#40;&#41;"| node_dispatcher
node_dispatcher -->|"retained state topics"| node_mqtt
node_app -->|"uvicorn.run&#40;:5001&#41;"| node_fastapi


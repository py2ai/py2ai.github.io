{
  "owner": "blakeblackshear",
  "repo": "frigate",
  "branch": "dev",
  "groups": [
    {"id": "g_config", "name": "config", "label": "Lifecycle & Watchdogs"},
    {"id": "g_capture", "name": "capture", "label": "Camera Capture"},
    {"id": "g_analyze", "name": "analyze", "label": "Frame Analysis"},
    {"id": "g_detect", "name": "detect", "label": "Detector Runtime"},
    {"id": "g_track", "name": "track", "label": "Tracking & Events"},
    {"id": "g_output", "name": "output", "label": "Recording & Output"},
    {"id": "g_comms", "name": "comms", "label": "Communicators"},
    {"id": "g_web", "name": "web", "label": "API & Web UI"}
  ],
  "nodes": [
    {"id": "app", "label": "FrigateApp", "file": "frigate/app.py", "path": "frigate/app.py", "group": "config", "groupId": "g_config", "desc": "Boots every process in order, then runs uvicorn until shutdown."},
    {"id": "watchdog", "label": "FrigateWatchdog", "file": "frigate/watchdog.py", "path": "frigate/watchdog.py", "group": "config", "groupId": "g_config", "desc": "Restarts crashed processes and stuck detectors with capped backoff."},
    {"id": "maintainer", "label": "CameraMaintainer", "file": "frigate/camera/maintainer.py", "path": "frigate/camera/maintainer.py", "group": "capture", "groupId": "g_capture", "desc": "Starts and stops capture and tracker processes; handles runtime camera edits."},
    {"id": "capture_proc", "label": "CameraCapture", "file": "frigate/video/ffmpeg.py", "path": "frigate/video/ffmpeg.py", "group": "capture", "groupId": "g_capture", "desc": "Per-camera process whose threads pipe ffmpeg stdout straight into shared memory."},
    {"id": "capture_frames", "label": "capture_frames", "file": "frigate/video/ffmpeg.py", "path": "frigate/video/ffmpeg.py", "group": "capture", "groupId": "g_capture", "desc": "readinto() loop that fills frame slots and enqueues their names."},
    {"id": "camera_watchdog", "label": "CameraWatchdog", "file": "frigate/video/ffmpeg.py", "path": "frigate/video/ffmpeg.py", "group": "capture", "groupId": "g_capture", "desc": "Watches frame staleness inside the capture process and restarts ffmpeg."},
    {"id": "frame_shm", "label": "SharedMemoryFrameManager", "file": "frigate/util/image.py", "path": "frigate/util/image.py", "group": "capture", "groupId": "g_capture", "desc": "Ring of named YUV buffers plus a frame_times ledger in shared memory."},
    {"id": "camera_tracker", "label": "CameraTracker", "file": "frigate/video/detect.py", "path": "frigate/video/detect.py", "group": "analyze", "groupId": "g_analyze", "desc": "The per-camera analysis process that consumes frames and emits detections."},
    {"id": "process_frames", "label": "process_frames", "file": "frigate/video/detect.py", "path": "frigate/video/detect.py", "group": "analyze", "groupId": "g_analyze", "desc": "Main loop: motion, region clustering, inference requests, tracking updates."},
    {"id": "motion", "label": "ImprovedMotionDetector", "file": "frigate/motion/improved_motion.py", "path": "frigate/motion/improved_motion.py", "group": "analyze", "groupId": "g_analyze", "desc": "Frame differencing with mask support and a calibration period."},
    {"id": "detect_fn", "label": "detect", "file": "frigate/video/detect.py", "path": "frigate/video/detect.py", "group": "analyze", "groupId": "g_analyze", "desc": "Crops one region, resizes it to model input, maps boxes back to frame coords."},
    {"id": "remote", "label": "RemoteObjectDetector", "file": "frigate/object_detection/base.py", "path": "frigate/object_detection/base.py", "group": "analyze", "groupId": "g_analyze", "desc": "Client stub: copies a tensor to shm, queues the request, waits on ZMQ reply."},
    {"id": "det_proc", "label": "ObjectDetectProcess", "file": "frigate/object_detection/base.py", "path": "frigate/object_detection/base.py", "group": "detect", "groupId": "g_detect", "desc": "Owns one accelerator and its runner process; shared across cameras via a queue."},
    {"id": "runner", "label": "DetectorRunner", "file": "frigate/object_detection/base.py", "path": "frigate/object_detection/base.py", "group": "detect", "groupId": "g_detect", "desc": "Isolated inference process: pull tensor, detect_raw, write 20x6 result block."},
    {"id": "map_input", "label": "map_input_frame", "file": "frigate/object_detection/base.py", "path": "frigate/object_detection/base.py", "group": "detect", "groupId": "g_detect", "desc": "Turns a shm connection id into the transformed model input tensor."},
    {"id": "registry", "label": "api_types", "file": "frigate/detectors/detector_types.py", "path": "frigate/detectors/detector_types.py", "group": "detect", "groupId": "g_detect", "desc": "Detects all DetectionApi subclasses at import time and indexes them by type_key."},
    {"id": "device_cfg", "label": "build_detector_config", "file": "frigate/detectors/device.py", "path": "frigate/detectors/device.py", "group": "detect", "groupId": "g_detect", "desc": "Parses a device string (PCI slot, /dev path) into a concrete detector config."},
    {"id": "cpu", "label": "CpuTfl", "file": "frigate/detectors/plugins/cpu_tfl.py", "path": "frigate/detectors/plugins/cpu_tfl.py", "group": "detect", "groupId": "g_detect", "desc": "CPU fallback plugin backed by tflite-runtime."},
    {"id": "edgetpu", "label": "EdgeTpuTfl", "file": "frigate/detectors/plugins/edgetpu_tfl.py", "path": "frigate/detectors/plugins/edgetpu_tfl.py", "group": "detect", "groupId": "g_detect", "desc": "Google Coral USB/PCIe Edge TPU plugin."},
    {"id": "ov", "label": "OvDetector", "file": "frigate/detectors/plugins/openvino.py", "path": "frigate/detectors/plugins/openvino.py", "group": "detect", "groupId": "g_detect", "desc": "Intel OpenVINO plugin with dedicated YOLO post-processing."},
    {"id": "trt", "label": "TensorRtDetector", "file": "frigate/detectors/plugins/tensorrt.py", "path": "frigate/detectors/plugins/tensorrt.py", "group": "detect", "groupId": "g_detect", "desc": "NVIDIA Jetson TensorRT plugin with explicit GPU buffer allocation."},
    {"id": "tracked", "label": "TrackedObjectProcessor", "file": "frigate/track/object_processing.py", "path": "frigate/track/object_processing.py", "group": "track", "groupId": "g_track", "desc": "Central thread for snapshots, manual events, sub_labels and MQTT state."},
    {"id": "norfair", "label": "NorfairTracker", "file": "frigate/track/norfair_tracker.py", "path": "frigate/track/norfair_tracker.py", "group": "track", "groupId": "g_track", "desc": "Centroid + histogram distance tracking on top of the Norfair library."},
    {"id": "event_proc", "label": "EventProcessor", "file": "frigate/events/maintainer.py", "path": "frigate/events/maintainer.py", "group": "track", "groupId": "g_track", "desc": "Writes event start/end rows and feeds the timeline queue."},
    {"id": "review", "label": "ReviewProcess", "file": "frigate/review/review.py", "path": "frigate/review/review.py", "group": "track", "groupId": "g_track", "desc": "Builds review segments that the UI timeline and alerts are built on."},
    {"id": "output_proc", "label": "OutputProcess", "file": "frigate/output/output.py", "path": "frigate/output/output.py", "group": "output", "groupId": "g_output", "desc": "Renders live streams and birdseye composite frames for the UI."},
    {"id": "record", "label": "RecordProcess", "file": "frigate/record/record.py", "path": "frigate/record/record.py", "group": "output", "groupId": "g_output", "desc": "Writes recording segments and manages retention cleanup."},
    {"id": "dispatcher", "label": "Dispatcher", "file": "frigate/comms/dispatcher.py", "path": "frigate/comms/dispatcher.py", "group": "comms", "groupId": "g_comms", "desc": "Routes topic traffic between every Communicator and Frigate internals."},
    {"id": "mqtt", "label": "MqttClient", "file": "frigate/comms/mqtt.py", "path": "frigate/comms/mqtt.py", "group": "comms", "groupId": "g_comms", "desc": "Worker-thread MQTT client with publish queueing and retained state replay."},
    {"id": "ws", "label": "WebSocketClient", "file": "frigate/comms/ws.py", "path": "frigate/comms/ws.py", "group": "comms", "groupId": "g_comms", "desc": "Pushes live object, stats and review updates to browser clients."},
    {"id": "ipc", "label": "InterProcessCommunicator", "file": "frigate/comms/inter_process.py", "path": "frigate/comms/inter_process.py", "group": "comms", "groupId": "g_comms", "desc": "ZMQ backbone that carries config updates and requests between processes."},
    {"id": "fastapi", "label": "create_fastapi_app", "file": "frigate/api/fastapi_app.py", "path": "frigate/api/fastapi_app.py", "group": "web", "groupId": "g_web", "desc": "Builds the REST app served by uvicorn behind nginx on 127.0.0.1:5001."},
    {"id": "webapp", "label": "React web UI", "file": "web/src/App.tsx", "path": "web/src/App.tsx", "group": "web", "groupId": "g_web", "desc": "Vite + React single-page app: Live, Events, Explore, Settings pages."}
  ],
  "edges": [
    {"from": "app", "to": "maintainer", "label": "start_camera_processor()"},
    {"from": "maintainer", "to": "capture_proc", "label": "__start_camera_capture()"},
    {"from": "capture_proc", "to": "camera_watchdog", "label": "spawns watchdog thread"},
    {"from": "camera_watchdog", "to": "capture_proc", "label": "restarts stalled ffmpeg"},
    {"from": "capture_proc", "to": "capture_frames", "label": "capture threads per role"},
    {"from": "capture_frames", "to": "frame_shm", "label": "readinto() fills slot"},
    {"from": "maintainer", "to": "camera_tracker", "label": "__start_camera_processor()"},
    {"from": "camera_tracker", "to": "process_frames", "label": "run() enters loop"},
    {"from": "process_frames", "to": "frame_shm", "label": "frame_manager.get()"},
    {"from": "process_frames", "to": "motion", "label": "detect(frame) -> boxes"},
    {"from": "process_frames", "to": "detect_fn", "label": "one detect() per region"},
    {"from": "detect_fn", "to": "remote", "label": "object_detector.detect(tensor_input)"},
    {"from": "remote", "to": "det_proc", "label": "detection_queue.put(shm name)"},
    {"from": "det_proc", "to": "remote", "label": "results via out-shm + ZMQ"},
    {"from": "process_frames", "to": "norfair", "label": "object_tracker.match_and_update()"},
    {"from": "camera_tracker", "to": "tracked", "label": "detected_frames_queue"},
    {"from": "tracked", "to": "norfair", "label": "owns tracker instances"},
    {"from": "tracked", "to": "event_proc", "label": "EventUpdateSubscriber updates"},
    {"from": "app", "to": "det_proc", "label": "start_detectors()"},
    {"from": "device_cfg", "to": "det_proc", "label": "per-device detector config"},
    {"from": "det_proc", "to": "runner", "label": "starts runner process"},
    {"from": "runner", "to": "map_input", "label": "pulls tensor from SHM"},
    {"from": "runner", "to": "frame_shm", "label": "reads region tensors"},
    {"from": "runner", "to": "registry", "label": "resolves DetectionApi by type"},
    {"from": "registry", "to": "cpu", "label": "type: cpu_tfl"},
    {"from": "registry", "to": "edgetpu", "label": "type: edgetpu_tfl (Coral)"},
    {"from": "registry", "to": "ov", "label": "type: openvino"},
    {"from": "registry", "to": "trt", "label": "type: tensorrt (Jetson)"},
    {"from": "app", "to": "watchdog", "label": "start_watchdog()"},
    {"from": "watchdog", "to": "det_proc", "label": "restarts stuck detectors"},
    {"from": "app", "to": "review", "label": "init_review_segment_manager()"},
    {"from": "app", "to": "record", "label": "init_recording_manager()"},
    {"from": "record", "to": "frame_shm", "label": "reads frames for segments"},
    {"from": "app", "to": "output_proc", "label": "start_video_output_processor()"},
    {"from": "output_proc", "to": "frame_shm", "label": "live view / birdseye frames"},
    {"from": "app", "to": "dispatcher", "label": "init_dispatcher()"},
    {"from": "tracked", "to": "dispatcher", "label": "object topics + snapshots"},
    {"from": "dispatcher", "to": "mqtt", "label": "retained topics"},
    {"from": "dispatcher", "to": "ws", "label": "live broadcasts"},
    {"from": "ipc", "to": "dispatcher", "label": "config commands fan-in"},
    {"from": "app", "to": "fastapi", "label": "uvicorn.run(:5001)"},
    {"from": "fastapi", "to": "tracked", "label": "best snapshot / current frame"},
    {"from": "webapp", "to": "fastapi", "label": "REST + WebSocket calls"},
    {"from": "ws", "to": "webapp", "label": "live object stream"}
  ]
}

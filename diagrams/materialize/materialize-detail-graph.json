{
  "owner": "MaterializeInc",
  "repo": "materialize",
  "branch": "main",
  "groups": [
    {
      "id": "adapter",
      "name": "Adapter / Coordinator",
      "label": "adapter"
    },
    {
      "id": "storage",
      "name": "Storage / Ingestion",
      "label": "storage"
    },
    {
      "id": "compute",
      "name": "Compute / Dataflows",
      "label": "compute"
    },
    {
      "id": "persist",
      "name": "Persist / Durability",
      "label": "persist"
    }
  ],
  "nodes": [
    {
      "id": "coordinator",
      "label": "Coordinator",
      "file": "coord.rs",
      "path": "src/adapter/src/coord.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "Owns the catalog, bootstraps the environment, and multiplexes client commands through its message loop."
    },
    {
      "id": "sequencer",
      "label": "Statement sequencer",
      "file": "inner.rs",
      "path": "src/adapter/src/coord/sequencer/inner.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "Stages and commits each DDL/DML statement, e.g. sequence_create_source for ingestion plans."
    },
    {
      "id": "create_mv",
      "label": "CREATE MATERIALIZED VIEW path",
      "file": "create_materialized_view.rs",
      "path": "src/adapter/src/coord/sequencer/inner/create_materialized_view.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "create_materialized_view_finish optimizes, installs and stores the MV's dataflow definition."
    },
    {
      "id": "cluster_controller",
      "label": "Cluster controller",
      "file": "cluster_controller.rs",
      "path": "src/adapter/src/coord/cluster_controller.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "ClusterControllerRequest models provisioning, size changes and routing to storage/compute replicas."
    },
    {
      "id": "timestamping",
      "label": "Timestamp selection",
      "file": "timestamp_selection.rs",
      "path": "src/adapter/src/coord/timestamp_selection.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "TimestampDetermination pins a query to a logical time where all inputs are readable."
    },
    {
      "id": "peek_client",
      "label": "Peek client",
      "file": "peek_client.rs",
      "path": "src/adapter/src/peek_client.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "Sends one-shot peeks to replicas and resolves them with per-peek deadlines and target recovery."
    },
    {
      "id": "storage_server",
      "label": "storage serve()",
      "file": "server.rs",
      "path": "src/storage/src/server.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "Async entry point that spins up storage state and its command loop for one cluster."
    },
    {
      "id": "storage_state",
      "label": "StorageState",
      "file": "storage_state.rs",
      "path": "src/storage/src/storage_state.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "Holds every source/sink instance plus the async storage worker driving progress."
    },
    {
      "id": "render_sources",
      "label": "render_source",
      "file": "sources.rs",
      "path": "src/storage/src/render/sources.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "Wires a source description into the timely ingestion graph for one worker."
    },
    {
      "id": "reclock",
      "label": "Reclock operator",
      "file": "reclock.rs",
      "path": "src/storage/src/source/reclock.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "ReclockOperator translates source-native progress (offsets, LSNs) into Materialize timestamps."
    },
    {
      "id": "kafka_source",
      "label": "Kafka source reader",
      "file": "kafka.rs",
      "path": "src/storage/src/source/kafka.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "KafkaSourceReader consumes partitions and emits (offset-stamped) updates."
    },
    {
      "id": "pg_source",
      "label": "Postgres CDC source",
      "file": "postgres.rs",
      "path": "src/storage/src/source/postgres.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "Takes a consistent snapshot, then ensure_replication_slot tails the WAL replication stream."
    },
    {
      "id": "avro_decode",
      "label": "Avro decoder",
      "file": "avro.rs",
      "path": "src/storage/src/decode/avro.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "AvroDecoderState turns Confluent-schema-registry payloads into Rows (or Debezium events)."
    },
    {
      "id": "upsert_rocksdb",
      "label": "Upsert RocksDB",
      "file": "rocksdb.rs",
      "path": "src/storage/src/upsert/rocksdb.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "Durable key-value backfill for upsert sources keyed by (partition, offset)."
    },
    {
      "id": "kafka_sink",
      "label": "Kafka sink progress",
      "file": "kafka.rs",
      "path": "src/storage/src/sink/kafka.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "ProgressRecord tracks exactly-once offsets written back out to Kafka topics."
    },
    {
      "id": "compute_server",
      "label": "compute serve()",
      "file": "server.rs",
      "path": "src/compute/src/server.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "Starts a timely::Config worker thread set wired to the cluster client."
    },
    {
      "id": "compute_state",
      "label": "ComputeState",
      "file": "compute_state.rs",
      "path": "src/compute/src/compute_state.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "Per-worker state machine for dataflows, arrangements, peeks and subscriptions."
    },
    {
      "id": "render",
      "label": "Dataflow renderer",
      "file": "render.rs",
      "path": "src/compute/src/render.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "build_compute_dataflow turns an optimized plan into differential operators."
    },
    {
      "id": "render_plan",
      "label": "Per-operator render",
      "file": "render.rs",
      "path": "src/compute/src/render.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "render_plan dispatches each LIR operator (join, reduce, top_k...) to its implementation."
    },
    {
      "id": "arrangement",
      "label": "TraceManager",
      "file": "manager.rs",
      "path": "src/compute/src/arrangement/manager.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "Keeps per-worker arrangement traces alive and compacts them on read-policy ticks."
    },
    {
      "id": "peek_exec",
      "label": "serve_index_peek",
      "file": "compute_state.rs",
      "path": "src/compute/src/compute_state.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "Executes a peek against an arrangement once its as-of frontier is ready."
    },
    {
      "id": "memory_limiter",
      "label": "Memory limiter",
      "file": "memory_limiter.rs",
      "path": "src/compute/src/memory_limiter.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "start_limiter reserves global memory budgets so dataflows stay within replica limits."
    },
    {
      "id": "mv_sink",
      "label": "MV persist sink",
      "file": "materialized_view.rs",
      "path": "src/compute/src/sink/materialized_view.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "persist_sink streams dataflow outputs into durable persist shards."
    },
    {
      "id": "subscribe",
      "label": "SUBSCRIBE sink",
      "file": "subscribe.rs",
      "path": "src/compute/src/sink/subscribe.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "Streams tail-of-relation updates out to a client in batches with frontiers."
    },
    {
      "id": "location",
      "label": "Blob + Consensus",
      "file": "location.rs",
      "path": "src/persist/src/location.rs",
      "group": "Persist / Durability",
      "groupId": "persist",
      "desc": "Blob: immutable versioned buffers. Consensus: linearizable compare-and-swap over a log."
    },
    {
      "id": "consensus",
      "label": "Consensus trait",
      "file": "location.rs",
      "path": "src/persist/src/location.rs",
      "group": "Persist / Durability",
      "groupId": "persist",
      "desc": "Backed by Postgres/CRDB; every shard's upper frontier and state lives here."
    },
    {
      "id": "file_blob",
      "label": "FileBlob",
      "file": "file.rs",
      "path": "src/persist/src/file.rs",
      "group": "Persist / Durability",
      "groupId": "persist",
      "desc": "CRC-checked local-filesystem blob implementation used by materialized in single-node mode."
    },
    {
      "id": "hedge",
      "label": "Hedged reads",
      "file": "hedge.rs",
      "path": "src/persist/src/hedge.rs",
      "group": "Persist / Durability",
      "groupId": "persist",
      "desc": "HedgedBlob fires a second read when the first is slow, hiding object-storage tail latency."
    },
    {
      "id": "parquet",
      "label": "Parquet encoding",
      "file": "parquet.rs",
      "path": "src/persist/src/indexed/columnar/parquet.rs",
      "group": "Persist / Durability",
      "groupId": "persist",
      "desc": "encode_trace_parquet packs trace batches into columnar format for S3/GCS blobs."
    }

{
  "owner": "MaterializeInc",
  "repo": "materialize",
  "branch": "main",
  "groups": [
    {
      "id": "adapter",
      "name": "Adapter / Coordinator",
      "label": "adapter"
    },
    {
      "id": "storage",
      "name": "Storage / Ingestion",
      "label": "storage"
    },
    {
      "id": "compute",
      "name": "Compute / Dataflows",
      "label": "compute"
    },
    {
      "id": "persist",
      "name": "Persist / Durability",
      "label": "persist"
    }
  ],
  "nodes": [
    {
      "id": "coordinator",
      "label": "Coordinator",
      "file": "coord.rs",
      "path": "src/adapter/src/coord.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "The heart of environmentd: parses SQL, builds catalog state, and drives the message loop for every client session."
    },
    {
      "id": "sequencer",
      "label": "Sequencer",
      "file": "inner.rs",
      "path": "src/adapter/src/coord/sequencer/inner.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "Turns parsed statements like CREATE SOURCE into staged, deterministic plan executions."
    },
    {
      "id": "cluster_controller",
      "label": "Cluster controller",
      "file": "cluster_controller.rs",
      "path": "src/adapter/src/coord/cluster_controller.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "Provisions and routes to storage and compute clusters, sizing them per replica."
    },
    {
      "id": "peek_client",
      "label": "Peek client",
      "file": "peek_client.rs",
      "path": "src/adapter/src/peek_client.rs",
      "group": "Adapter / Coordinator",
      "groupId": "adapter",
      "desc": "Fans SELECT peeks out to compute replicas and collects the fastest correct answer."
    },
    {
      "id": "storage_server",
      "label": "storage serve()",
      "file": "server.rs",
      "path": "src/storage/src/server.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "Entry point of the storaged process: renders sources and sinks for a storage cluster."
    },
    {
      "id": "reclock",
      "label": "Reclock operator",
      "file": "reclock.rs",
      "path": "src/storage/src/source/reclock.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "ReclockOperator maps source-native progress (Kafka offsets, Postgres LSNs) onto Materialize's timestamp timeline."
    },
    {
      "id": "kafka_source",
      "label": "Kafka source reader",
      "file": "kafka.rs",
      "path": "src/storage/src/source/kafka.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "Partitions Kafka (or Redpanda) topics into ordered streams of decoded updates."
    },
    {
      "id": "pg_source",
      "label": "Postgres CDC source",
      "file": "postgres.rs",
      "path": "src/storage/src/source/postgres.rs",
      "group": "Storage / Ingestion",
      "groupId": "storage",
      "desc": "Snapshots tables then tails the logical replication stream with LSN-based progress."
    },
    {
      "id": "compute_server",
      "label": "compute serve()",
      "file": "server.rs",
      "path": "src/compute/src/server.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "Boots a timely/differential worker loop for a compute cluster replica."
    },
    {
      "id": "compute_state",
      "label": "ComputeState",
      "file": "compute_state.rs",
      "path": "src/compute/src/compute_state.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "Per-worker registry of arrangements, dataflows, peeks and subscriptions."
    },
    {
      "id": "render",
      "label": "Dataflow renderer",
      "file": "render.rs",
      "path": "src/compute/src/render.rs",
      "group": "Compute / Dataflows",
      "groupId": "compute",
      "desc": "Lowers planned MIR/LIR plans into differential dataflow operators."
    },
    {
      "id": "persist_core",
      "label": "Blob + Consensus",
      "file": "location.rs",
      "path": "src/persist/src/location.rs",
      "group": "Persist / Durability",
      "groupId": "persist",
      "desc": "The two abstractions under durability: immutable blobs (S3/file) and a compare-and-swap log (CRDB/Postgres)."
    }
  ],
  "edges": [
    {
      "from": "coordinator",
      "to": "sequencer",
      "label": "sequences statements"
    },
    {
      "from": "coordinator",
      "to": "cluster_controller",
      "label": "drives clusters"
    },
    {
      "from": "coordinator",
      "to": "peek_client",
      "label": "routes SELECTs"
    },
    {
      "from": "sequencer",
      "to": "cluster_controller",
      "label": "creates sources/sinks"
    },
    {
      "from": "cluster_controller",
      "to": "storage_server",
      "label": "runs storaged"
    },
    {
      "from": "cluster_controller",
      "to": "compute_server",
      "label": "runs clusterd workers"
    },
    {
      "from": "storage_server",
      "to": "reclock",
      "label": "renders ingest"
    },
    {
      "from": "kafka_source",
      "to": "reclock",
      "label": "updates with offsets"
    },
    {
      "from": "pg_source",
      "to": "reclock",
      "label": "updates with LSNs"
    },
    {
      "from": "reclock",
      "to": "persist_core",
      "label": "durable collections"
    },
    {
      "from": "compute_server",
      "to": "compute_state",
      "label": "worker state"
    },
    {
      "from": "compute_state",
      "to": "render",
      "label": "installs dataflows"
    },
    {
      "from": "peek_client",
      "to": "compute_server",
      "label": "peek requests"
    },
    {
      "from": "compute_server",
      "to": "persist_core",
      "label": "read/write shards"
    }
  ]
}

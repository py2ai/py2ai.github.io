node_aio_config -->|"traces exporter"| node_storage_exporter
node_aio_config -->|"jaeger_query ext"| node_query_server
node_adaptive_sampling -->|"batched spans"| node_storage_exporter
node_storage_exporter -->|"resolves backend"| node_storage_ext
node_storage_ext -->|"returns factory"| node_tracestore_api
node_storage_ext -->|"memory backend"| node_memory_store
node_storage_ext -->|"ES/OpenSearch backend"| node_es_store
node_memory_store -->|"implements"| node_tracestore_api
node_es_store -->|"implements"| node_tracestore_api
node_query_server -->|"serves"| node_query_service
node_query_server -->|"reads via factory"| node_storage_ext
node_query_service -->|"FindTraces"| node_tracestore_api
node_remote_storage -->|"resolves trace store"| node_storage_ext


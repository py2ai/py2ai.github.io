  "nodes": [
    { "id": "start", "label": "start()", "file": "controller.py", "path": "lib/controller/controller.py", "group": "controller", "groupId": "controller", "desc": "Scan orchestrator: identifies injectable parameters and hands each to checkSqlInjection", "shape": "box" },
    { "id": "checks", "label": "checkSqlInjection()", "file": "checks.py", "path": "lib/controller/checks.py", "group": "controller", "groupId": "controller", "desc": "The detection loop: for each technique test, cycles matching boundaries and forges one probe per pair", "shape": "hexagon" },
    { "id": "agent", "label": "Agent.payload()", "file": "agent.py", "path": "lib/core/agent.py", "group": "core", "groupId": "core", "desc": "Assembles the final request value from test payload template plus boundary prefix/suffix and comment", "shape": "box" },
    { "id": "boundaries", "label": "boundaries.xml", "file": "boundaries.xml", "path": "data/xml/boundaries.xml", "group": "data_xml", "groupId": "data_xml", "desc": "54 boundary vectors: prefix/suffix/ptype plus level, clause and where filters", "shape": "database" },
    { "id": "tests", "label": "payloads/*.xml", "file": "payloads", "path": "data/xml/payloads", "group": "data_xml", "groupId": "data_xml", "desc": "367 technique tests across 6 XML files (boolean, error, stacked, time, union, inline)", "shape": "database" },
    { "id": "connect", "label": "Connect.getPage()", "file": "connect.py", "path": "lib/request/connect.py", "group": "request", "groupId": "request", "desc": "Issues one HTTP request per forged payload; runs the tamper chain first", "shape": "box" },
    { "id": "querypage", "label": "queryPage()", "file": "connect.py", "path": "lib/request/connect.py", "group": "request", "groupId": "request", "desc": "Fetches and classifies every response, applying time-based and content-based verdict paths", "shape": "box" },
    { "id": "comparison", "label": "comparison()", "file": "comparison.py", "path": "lib/request/comparison.py", "group": "request", "groupId": "request", "desc": "Ratio-based page similarity decides whether a response looks true or false", "shape": "hexagon" },
    { "id": "blind", "label": "bisection()", "file": "inference.py", "path": "lib/techniques/blind/inference.py", "group": "techniques", "groupId": "techniques", "desc": "Boolean and time-based blind inference: extracts data character by character", "shape": "box" },
    { "id": "uniontest", "label": "unionTest()", "file": "test.py", "path": "lib/techniques/union/test.py", "group": "techniques", "groupId": "techniques", "desc": "Finds the UNION column count and the reflection position for the exploitable column", "shape": "box" },
    { "id": "erroruse", "label": "errorUse()", "file": "use.py", "path": "lib/techniques/error/use.py", "group": "techniques", "groupId": "techniques", "desc": "Extracts query output from DBMS error messages using errors.xml regexes", "shape": "box" },
    { "id": "tamper", "label": "tamper(payload, **kwargs)", "file": "space2comment.py", "path": "tamper/space2comment.py", "group": "tamper", "groupId": "tamper", "desc": "Tamper script contract: pure payload-in, payload-out functions chained before every send", "shape": "box" }
  ],
  "edges": [
    { "from": "start", "to": "checks", "label": "drives detection per parameter", "style": "solid" },
    { "from": "checks", "to": "boundaries", "label": "filters 54 vectors by level/clause/where", "style": "solid" },
    { "from": "checks", "to": "tests", "label": "queues 367 tests via getSortedInjectionTests", "style": "solid" },
    { "from": "tests", "to": "agent", "label": "supplies payload template", "style": "solid" },
    { "from": "boundaries", "to": "agent", "label": "supplies prefix/suffix", "style": "solid" },

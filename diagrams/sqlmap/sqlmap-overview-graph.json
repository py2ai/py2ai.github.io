    { "from": "connect", "to": "tamper", "label": "kb.tamperFunctions mutate payload", "style": "dashed" },
    { "from": "connect", "to": "querypage", "label": "classifies each response", "style": "solid" },
    { "from": "querypage", "to": "comparison", "label": "page-similarity verdict", "style": "solid" },
    { "from": "querypage", "to": "blind", "label": "true/false oracle for inference", "style": "solid" },
    { "from": "blind", "to": "connect", "label": "hundreds of follow-up requests", "style": "dashed" },
    { "from": "checks", "to": "uniontest", "label": "confirms column count once injectable", "style": "solid" },
    { "from": "uniontest", "to": "agent", "label": "builds forged UNION query", "style": "solid" },
    { "from": "checks", "to": "erroruse", "label": "extracts via parsed DBMS errors", "style": "solid" }

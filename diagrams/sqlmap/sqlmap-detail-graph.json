{
  "owner": "sqlmapproject",
  "repo": "sqlmap",
  "branch": "master",
  "groups": [
    { "id": "controller", "name": "Controller", "label": "Scan controller" },
    { "id": "core", "name": "Core", "label": "Payload engine" },
    { "id": "data_xml", "name": "Data", "label": "XML dictionaries" },
    { "id": "request", "name": "Request", "label": "HTTP layer" },
    { "id": "techniques", "name": "Techniques", "label": "Extraction engines" },
    { "id": "tamper", "name": "Tamper", "label": "Payload mutators" }
  ],
  "nodes": [
    { "id": "start", "label": "start()", "file": "controller.py", "path": "lib/controller/controller.py", "group": "controller", "groupId": "controller", "desc": "Orchestrates the scan: parameter discovery, calibration, WAF checks, then per-parameter detection", "shape": "box" },
    { "id": "checks", "label": "checkSqlInjection()", "file": "checks.py", "path": "lib/controller/checks.py", "group": "controller", "groupId": "controller", "desc": "Detection loop at L126: pops ordered tests, cycles matching boundaries, forges and fires probes", "shape": "hexagon" },
    { "id": "heuristic", "label": "heuristicCheckSqlInjection()", "file": "checks.py", "path": "lib/controller/checks.py", "group": "controller", "groupId": "controller", "desc": "Sends a random string containing one quote of each kind to spot DBMS errors and cast problems", "shape": "hexagon" },
    { "id": "agent", "label": "Agent.payload()", "file": "agent.py", "path": "lib/core/agent.py", "group": "core", "groupId": "core", "desc": "Replaces the parameter value with the forged statement; locates payload delimiters in the request string", "shape": "box" },
    { "id": "prefixquery", "label": "prefixQuery()", "file": "agent.py", "path": "lib/core/agent.py", "group": "core", "groupId": "core", "desc": "Applies the boundary prefix per WHERE clause (REPLACE/APPEND/NEGATE)", "shape": "box" },
    { "id": "suffixquery", "label": "suffixQuery()", "file": "agent.py", "path": "lib/core/agent.py", "group": "core", "groupId": "core", "desc": "Appends boundary suffix and the technique comment that terminates the statement", "shape": "box" },
    { "id": "enums", "label": "PAYLOAD.TECHNIQUE", "file": "enums.py", "path": "lib/core/enums.py", "group": "core", "groupId": "core", "desc": "Technique codes 1-6: BOOLEAN, ERROR, QUERY, STACKED, TIME, UNION", "shape": "box" },
    { "id": "sortedtests", "label": "getSortedInjectionTests()", "file": "common.py", "path": "lib/core/common.py", "group": "core", "groupId": "core", "desc": "Ranks queued tests so cheap, level-1 tests run before exotic high-risk payloads", "shape": "box" },
    { "id": "kb", "label": "kb / conf", "file": "data.py", "path": "lib/core/data.py", "group": "core", "groupId": "core", "desc": "Shared knowledge base: boundaries, tamperFunctions, injection results, heuristics", "shape": "box" },
    { "id": "option", "label": "initialization", "file": "option.py", "path": "lib/core/option.py", "group": "core", "groupId": "core", "desc": "Loads boundaries and payload XMLs at startup; imports tamper scripts into kb.tamperFunctions", "shape": "box" },
    { "id": "boundaries_xml", "label": "boundaries.xml", "file": "boundaries.xml", "path": "data/xml/boundaries.xml", "group": "data_xml", "groupId": "data_xml", "desc": "54 boundary vectors, each with prefix, suffix, ptype, clause, where and level", "shape": "database" },
    { "id": "payloads_dir", "label": "payloads/*.xml", "file": "payloads", "path": "data/xml/payloads", "group": "data_xml", "groupId": "data_xml", "desc": "367 test definitions: title, stype, level, risk, request payload, response match rules", "shape": "database" },
    { "id": "boolean_xml", "label": "boolean_blind.xml", "file": "boolean_blind.xml", "path": "data/xml/payloads/boolean_blind.xml", "group": "data_xml", "groupId": "data_xml", "desc": "75 boolean tests: AND-based true/false expression pairs", "shape": "document" },
    { "id": "time_xml", "label": "time_blind.xml", "file": "time_blind.xml", "path": "data/xml/payloads/time_blind.xml", "group": "data_xml", "groupId": "data_xml", "desc": "118 time tests: SLEEP/BENCHMARK-style delay vectors per DBMS", "shape": "document" },
    { "id": "error_xml", "label": "error_based.xml", "file": "error_based.xml", "path": "data/xml/payloads/error_based.xml", "group": "data_xml", "groupId": "data_xml", "desc": "92 error-based tests exploiting verbose DBMS error output", "shape": "document" },
    { "id": "union_xml", "label": "union_query.xml", "file": "union_query.xml", "path": "data/xml/payloads/union_query.xml", "group": "data_xml", "groupId": "data_xml", "desc": "36 UNION tests with column-count ranges and char variants", "shape": "document" },
    { "id": "stacked_xml", "label": "stacked_queries.xml", "file": "stacked_queries.xml", "path": "data/xml/payloads/stacked_queries.xml", "group": "data_xml", "groupId": "data_xml", "desc": "38 stacked-query tests using statement-terminating suffixes", "shape": "document" },
    { "id": "queries_xml", "label": "queries.xml", "file": "queries.xml", "path": "data/xml/queries.xml", "group": "data_xml", "groupId": "data_xml", "desc": "171 KB of per-DBMS SQL syntax: fingerprint, delay, cast, limit, banner queries", "shape": "database" },
    { "id": "errors_xml", "label": "errors.xml", "file": "errors.xml", "path": "data/xml/errors.xml", "group": "data_xml", "groupId": "data_xml", "desc": "Regular expressions matching DBMS error pages, used to fingerprint the backend", "shape": "database" },
    { "id": "connect", "label": "Connect.getPage()", "file": "connect.py", "path": "lib/request/connect.py", "group": "request", "groupId": "request", "desc": "Single entry point for every HTTP exchange: retries, proxies, chunked bodies, multipart", "shape": "box" },
    { "id": "querypage", "label": "queryPage()", "file": "connect.py", "path": "lib/request/connect.py", "group": "request", "groupId": "request", "desc": "Builds the request, runs the tamper chain, then classifies the response (L1202)", "shape": "box" },
    { "id": "comparison", "label": "comparison()", "file": "comparison.py", "path": "lib/request/comparison.py", "group": "request", "groupId": "request", "desc": "Similarity-ratio page diff against baseline with dynamic reflections removed", "shape": "hexagon" },
    { "id": "inject", "label": "getValue()", "file": "inject.py", "path": "lib/request/inject.py", "group": "request", "groupId": "request", "desc": "Chooses the fastest available technique per query, then falls back down the chain", "shape": "hexagon" },
    { "id": "gobool", "label": "_goBooleanProxy()", "file": "inject.py", "path": "lib/request/inject.py", "group": "request", "groupId": "request", "desc": "Runs one boolean expression and reads the true/false verdict", "shape": "box" },
    { "id": "goinference", "label": "_goInference()", "file": "inject.py", "path": "lib/request/inject.py", "group": "request", "groupId": "request", "desc": "Length-then-chars blind extraction driving bisection or multibit", "shape": "box" },
    { "id": "gostacked", "label": "goStacked()", "file": "inject.py", "path": "lib/request/inject.py", "group": "request", "groupId": "request", "desc": "Fires a second statement through stacked-query injectable parameters", "shape": "box" },
    { "id": "timeless", "label": "readBit()", "file": "timeless.py", "path": "lib/request/timeless.py", "group": "request", "groupId": "request", "desc": "Timeless blind oracle: statistical comparison of fast/slow request pairs instead of page content", "shape": "hexagon" },
    { "id": "bisection", "label": "bisection()", "file": "inference.py", "path": "lib/techniques/blind/inference.py", "group": "techniques", "groupId": "techniques", "desc": "Binary-search character extraction for boolean and time-based blind (L302)", "shape": "box" },
    { "id": "multibit", "label": "attempt()", "file": "multibit.py", "path": "lib/techniques/blind/multibit.py", "group": "techniques", "groupId": "techniques", "desc": "Multibit inference: several bits per request to cut round-trips", "shape": "box" },
    { "id": "uniontest", "label": "unionTest()", "file": "test.py", "path": "lib/techniques/union/test.py", "group": "techniques", "groupId": "techniques", "desc": "Bruteforces column count, then locates the reflecting column (L402)", "shape": "box" },
    { "id": "unionuse", "label": "unionUse()", "file": "use.py", "path": "lib/techniques/union/use.py", "group": "techniques", "groupId": "techniques", "desc": "Reads query output through the confirmed UNION injection point", "shape": "box" },
    { "id": "erroruse", "label": "errorUse()", "file": "use.py", "path": "lib/techniques/error/use.py", "group": "techniques", "groupId": "techniques", "desc": "Chunked extraction from error messages (L303)", "shape": "box" },
    { "id": "err_oneshot", "label": "_oneShotErrorUse()", "file": "use.py", "path": "lib/techniques/error/use.py", "group": "techniques", "groupId": "techniques", "desc": "Single request that smuggles the whole expression into the error channel", "shape": "box" },
    { "id": "space2comment", "label": "space2comment", "file": "space2comment.py", "path": "tamper/space2comment.py", "group": "tamper", "groupId": "tamper", "desc": "Example tamper: swaps spaces for SQL comments; contract is payload in, payload out", "shape": "box" }
  ],

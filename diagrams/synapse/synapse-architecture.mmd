node_client_servlets -->|"registers /rooms/*/send servlets"| node_client_put
node_client_put -->|"txns.fetch_or_execute_request dedupe"| node_txn_cache
node_client_put -->|"create_and_send_nonmember_event"| node_event_creation
node_sync_servlet -->|"wait_for_sync_for_user long-poll"| node_sync_handler
node_event_creation -->|"worker forwards to event persister"| node_send_events_servlet
node_send_events_servlet -->|"persist on writer instance"| node_persist_ctrl
node_event_creation -->|"persist_and_notify_client_events"| node_persist_ctrl
node_persist_ctrl -->|"recompute extremities + delta"| node_state_delta
node_persist_ctrl -->|"_persist_events_txn"| node_persist_store
node_persist_store -->|"main / state / persist_events stores"| node_databases
node_persist_ctrl -->|"notifier.on_new_room_events"| node_notifier
node_notifier -->|"wake deferred /sync waiters"| node_sync_handler
node_notifier -->|"notify_replication"| node_events_stream
node_notifier -->|"notify_new_events"| node_fed_sender
node_notifier -->|"queue rows on non-sender workers"| node_send_queue
node_events_stream -->|"RDATA rows"| node_repl_handler
node_repl_redis -->|"Redis pub/sub delivery"| node_repl_handler
node_worker_cfg -->|"assigns send_federation duty"| node_fed_sender
node_send_queue -->|"get_replication_rows"| node_fed_stream
node_fed_stream -->|"rows consumed by sender worker"| node_fed_sender
node_fed_sender -->|"_get_per_destination_queue"| node_per_dest
node_per_dest -->|"attempt_new_transaction"| node_txn_manager
node_txn_manager -->|"send_new_transaction"| node_transport_client
node_transport_client -->|"PUT /_matrix/federation/v1/send/&#123;txn_id&#125;"| node_fed_send_servlet
node_fed_send_servlet -->|"on_incoming_transaction"| node_fed_server
node_fed_server -->|"on_receive_pdu"| node_fed_event_handler
node_fed_event_handler -->|"auth + persist received PDU"| node_persist_ctrl
node_fed_server -->|"m.typing EDU -&gt; _recv_edu"| node_typing_follower
node_typing_follower -->|"subclass adds EDU sending"| node_typing_writer
node_typing_writer -->|"build_and_send_edu &#40;m.typing&#41;"| node_fed_sender
node_presence -->|"presence deltas"| node_presence_queue
node_presence_queue -->|"m.presence EDUs"| node_fed_sender


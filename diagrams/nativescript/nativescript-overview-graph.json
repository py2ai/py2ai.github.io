{
	"owner": "NativeScript",
	"repo": "NativeScript",
	"branch": "main",
	"groups": [
		{ "id": "grp_workspace", "name": "Nx Workspace", "label": "monorepo root (nx)" },
		{ "id": "grp_core", "name": "Core Framework", "label": "@nativescript/core" },
		{ "id": "grp_native", "name": "Native Widgets", "label": "ui-mobile-base" },
		{ "id": "grp_types", "name": "Generated Typings", "label": "API type packages" },
		{ "id": "grp_build", "name": "Build Tooling", "label": "@nativescript/vite" }
	],
	"nodes": [
		{
			"id": "workspace",
			"label": "NativeScript monorepo",
			"file": "package.json",
			"path": "package.json",
			"group": "Nx Workspace",
			"groupId": "grp_workspace",
			"shape": "hexagon",
			"desc": "nx-managed workspace holding every @nativescript package; name 'nativescript', v9.0.0"
		},
		{
			"id": "core_index",
			"label": "core entry module",
			"file": "index.ts",
			"path": "packages/core/index.ts",
			"group": "Core Framework",
			"groupId": "grp_core",
			"shape": "hexagon",
			"desc": "imports './globals' first, then re-exports application, data, http, ui and friends"
		},
		{
			"id": "core_application",
			"label": "application lifecycle",
			"file": "application-common.ts",
			"path": "packages/core/application/application-common.ts",
			"group": "Core Framework",
			"groupId": "grp_core",
			"desc": "launch/suspend/resume/exit events plus the abstract run() each platform implements"
		},
		{
			"id": "core_views",
			"label": "ui widgets surface",
			"file": "index.ts",
			"path": "packages/core/ui/index.ts",
			"group": "Core Framework",
			"groupId": "grp_core",
			"desc": "re-exports Button, Label, layouts, Frame, Page and every other JS view class"
		},
		{
			"id": "core_builder",
			"label": "xml view builder",
			"file": "index.ts",
			"path": "packages/core/ui/builder/index.ts",
			"group": "Core Framework",
			"groupId": "grp_core",
			"desc": "parse() turns markup templates into live view trees"
		},
		{
			"id": "core_properties",
			"label": "property engine",
			"file": "index.ts",
			"path": "packages/core/ui/core/properties/index.ts",
			"group": "Core Framework",
			"groupId": "grp_core",
			"desc": "Property<T extends ViewBase> class with a per-property setNative symbol"
		},
		{
			"id": "core_viewbase",
			"label": "view base",
			"file": "index.ts",
			"path": "packages/core/ui/core/view-base/index.ts",
			"group": "Core Framework",
			"groupId": "grp_core",
			"desc": "ViewBase holds nativeViewProtected — the raw native peer object"
		},
		{
			"id": "java_widgets",
			"label": "org.nativescript.widgets",
			"file": "GridLayout.java",
			"path": "packages/ui-mobile-base/android/widgets/src/main/java/org/nativescript/widgets/GridLayout.java",
			"group": "Native Widgets",
			"groupId": "grp_native",
			"desc": "hand-written Java widgets (GridLayout, BottomNavigationBar, ContentLayout) compiled into an AAR"
		},
		{
			"id": "objc_widgets",
			"label": "TNSWidgets pod",
			"file": "TNSLabel.m",
			"path": "packages/ui-mobile-base/ios/TNSWidgets/TNSWidgets/TNSLabel.m",
			"group": "Native Widgets",
			"groupId": "grp_native",
			"desc": "Objective-C helpers shipped as the TNSWidgets xcframework"
		},
		{
			"id": "types_android",
			"label": "android api types",
			"file": "android.d.ts",
			"path": "packages/types-android/src/lib/android.d.ts",
			"group": "Generated Typings",
			"groupId": "grp_types",
			"shape": "document",
			"desc": "generated d.ts covering Android API 21-37 plus androidx and org.nativescript.widgets"
		},
		{
			"id": "vite",
			"label": "vite build plugin",
			"file": "index.ts",
			"path": "packages/vite/index.ts",
			"group": "Build Tooling",
			"groupId": "grp_build",
			"shape": "hexagon",
			"desc": "configuration presets, platform resolvers and the HMR client the CLI drives"
		}
	],
	"edges": [
		{ "from": "workspace", "to": "core_index", "label": "workspace package" },
		{ "from": "core_index", "to": "core_application", "label": "export * from './application'" },
		{ "from": "core_index", "to": "core_views", "label": "export * from './ui'" },
		{ "from": "core_views", "to": "core_builder", "label": "views resolve markup" },
		{ "from": "core_views", "to": "core_properties", "label": "styling + properties" },
		{ "from": "core_application", "to": "core_views", "label": "lifecycle roots the ui" },
		{ "from": "core_properties", "to": "core_viewbase", "label": "Property<T extends ViewBase>" },
		{ "from": "core_viewbase", "to": "java_widgets", "label": "nativeViewProtected (android)" },
		{ "from": "core_viewbase", "to": "objc_widgets", "label": "nativeViewProtected (ios)" },
		{ "from": "java_widgets", "to": "types_android", "label": "typed bridge surface" },
		{ "from": "vite", "to": "core_index", "label": "bundles core into app" },
		{ "from": "core_application", "to": "core_builder", "label": "run() loads entry view" }
	]
}

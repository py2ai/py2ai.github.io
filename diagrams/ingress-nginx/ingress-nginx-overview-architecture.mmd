node_cmd_main -->|"builds"| node_ngx_new
node_ngx_new -->|"launches"| node_ngx_start
node_ngx_start -->|"starts"| node_store_run
node_ngx_start -->|"elects"| node_leader_elect
node_ngx_start -->|"enqueues"| node_sync_ingress
node_store_run -->|"cache events"| node_sync_ingress
node_sync_ingress -->|"builds model"| node_get_config
node_sync_ingress -->|"full reload"| node_on_update
node_sync_ingress -->|"dynamic path"| node_dyn_cfg
node_on_update -->|"renders"| node_gen_tmpl
node_gen_tmpl -->|"validates"| node_test_tmpl
node_on_update -->|"then streams endpoints"| node_dyn_cfg
node_webhook -->|"gates bad objects"| node_sync_ingress


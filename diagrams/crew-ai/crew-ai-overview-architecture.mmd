node_crew -->|"exposes kickoff&#40;inputs&#41;"| node_kickoff
node_kickoff -->|"reads process mode"| node_process
node_process -->|"dispatch: sequential loop or manager-first hierarchy"| node_exec_tasks
node_kickoff -->|"sequential default path"| node_exec_tasks
node_crew -->|"owns the task list"| node_exec_tasks
node_exec_tasks -->|"runs each task with prior outputs as context"| node_task_exec
node_task_exec -->|"delegates to the assigned agent"| node_agent_exec
node_agent_exec -->|"drives the tool-calling loop"| node_agent_executor
node_agent_executor -->|"asks for next action or final answer"| node_llm
node_agent_executor -->|"model requested a tool"| node_tool_usage
node_tool_usage -->|"manager delegates via AgentTools"| node_delegation
node_delegation -->|"coworker re-enters execute_task"| node_agent_exec
node_task_exec -->|"recall before / remember after"| node_memory
node_flow -->|"flow steps kick off embedded crews"| node_kickoff


node_mysql_client -->|"runs queries"| node_session
node_sql_server -->|"wire connections"| node_session
node_session -->|"opens databases"| node_engine
node_engine -->|"reads/writes snapshots"| node_root
node_engine -->|"column metadata"| node_schema
node_engine -->|"branch/commit ops"| node_dolt_db
node_dolt_db -->|"Resolve -&gt; RootValue"| node_root
node_root -->|"rows as maps"| node_prolly_map
node_prolly_map -->|"key-value nodes"| node_tree_nodes
node_tree_nodes -->|"flush chunks"| node_chunk_store
node_chunk_store -->|"persist table files"| node_nbs
node_dolt_db -->|"commits &amp; refs"| node_datas
node_datas -->|"store commit objects"| node_chunk_store


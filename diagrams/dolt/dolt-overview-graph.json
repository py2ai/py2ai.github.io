    {"from": "dolt_db", "to": "root", "label": "Resolve -> RootValue"},
    {"from": "root", "to": "prolly_map", "label": "rows as maps"},
    {"from": "prolly_map", "to": "tree_nodes", "label": "key-value nodes"},

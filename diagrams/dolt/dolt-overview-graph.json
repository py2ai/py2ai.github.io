  ],
  "nodes": [
    {"id": "mysql_client", "label": "MySQL Client / dolt CLI", "file": "sql.go", "path": "go/cmd/dolt/commands/sql.go", "group": "Clients & CLI", "groupId": "clients", "desc": "dolt sql shell and one-off -q queries; any MySQL client works too"},
    {"id": "sql_server", "label": "sql-server (wire)", "file": "sqlserver.go", "path": "go/cmd/dolt/commands/sqlserver/sqlserver.go", "group": "Clients & CLI", "groupId": "clients", "desc": "SqlServerCmd starts a MySQL-wire-compatible server on port 3306"},
    {"id": "session", "label": "DoltSession", "file": "session.go", "path": "go/libraries/doltcore/sqle/dsess/session.go", "group": "SQL Engine", "groupId": "sql", "desc": "per-connection session state: current database, branch, transaction"},
    {"id": "engine", "label": "SQL Engine (doltDatabase)", "file": "database.go", "path": "go/libraries/doltcore/sqle/database.go", "group": "SQL Engine", "groupId": "sql", "desc": "adapts dolt databases/tables to the GMS SQL engine (analysis, execution)"},
    {"id": "root", "label": "RootValue", "file": "root_val.go", "path": "go/libraries/doltcore/doltdb/root_val.go", "group": "Version Core (doltcore)", "groupId": "version", "desc": "immutable snapshot of table names, schemas and row-map addresses"},
    {"id": "dolt_db", "label": "DoltDB / CommitSpec", "file": "doltdb.go", "path": "go/libraries/doltcore/doltdb/doltdb.go", "group": "Version Core (doltcore)", "groupId": "version", "desc": "resolves refs/commit specs to commits; creates branches and commits"},
    {"id": "schema", "label": "Schema", "file": "schema.go", "path": "go/libraries/doltcore/schema/schema.go", "group": "Version Core (doltcore)", "groupId": "version", "desc": "columns, primary keys, indexes and checks for each table"},
    {"id": "prolly_map", "label": "prolly.Map", "file": "tuple_map.go", "path": "go/store/prolly/tuple_map.go", "group": "Prolly & Chunk Storage", "groupId": "storage", "desc": "probabilistic B-tree map of encoded row tuples"},
    {"id": "tree_nodes", "label": "tree.Node + NodeStore", "file": "node.go", "path": "go/store/prolly/tree/node.go", "group": "Prolly & Chunk Storage", "groupId": "storage", "desc": "tree nodes with structural sharing, cached via NodeStore"},
    {"id": "chunk_store", "label": "ChunkStore", "file": "chunk_store.go", "path": "go/store/chunks/chunk_store.go", "group": "Prolly & Chunk Storage", "groupId": "storage", "desc": "content-addressed chunk persistence interface"},
    {"id": "nbs", "label": "NomsBlockStore (NBS)", "file": "store.go", "path": "go/store/nbs/store.go", "group": "Prolly & Chunk Storage", "groupId": "storage", "desc": "on-disk blob store: table files, manifest, chunk journal"},
    {"id": "datas", "label": "datas: Dataset & Commit", "file": "dataset.go", "path": "go/store/datas/dataset.go", "group": "Prolly & Chunk Storage", "groupId": "storage", "desc": "datasets (refs) and commit objects with parents and metadata"}
  ],
  "edges": [
    {"from": "mysql_client", "to": "session", "label": "runs queries"},
    {"from": "sql_server", "to": "session", "label": "wire connections"},

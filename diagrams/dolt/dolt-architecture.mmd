node_sql_cmd -->|"runs queries"| node_dolt_session
node_server_cmd -->|"wire connections"| node_dolt_session
node_dolt_session -->|"resolves databases"| node_db_provider
node_db_provider -->|"reads/writes roots"| node_root_val
node_db_provider -->|"index scans"| node_prolly_index
node_prolly_index -->|"indexes as maps"| node_prolly_map
node_add_cmd -->|"stage changes"| node_stage_tables
node_commit_cmd -->|"commit flow"| node_commit_staged
node_diff_cmd -->|"working vs HEAD"| node_working_set
node_stage_tables -->|"updates staged root"| node_working_set
node_commit_staged -->|"reads working+staged"| node_working_set
node_commit_staged -->|"NewCommitMeta"| node_commit_meta
node_commit_cmd -->|"NewCommitSpec"| node_commit_spec
node_commit_spec -->|"~ and ^ suffixes"| node_ancestor_spec
node_commit_spec -->|"Resolve"| node_dolt_db
node_dolt_db -->|"returns Commit"| node_doltdb_commit
node_commit_staged -->|"DoltDB.Commit"| node_dolt_db
node_doltdb_commit -->|"points at root"| node_root_val
node_root_val -->|"GetTable"| node_dolt_table
node_dolt_table -->|"column metadata"| node_schema
node_working_set -->|"holds roots"| node_root_val
node_root_val -->|"row data maps"| node_prolly_map
node_prolly_map -->|"Mutate&#40;&#41;"| node_mutable_map
node_mutable_map -->|"flush edits"| node_tree_mutator
node_tree_mutator -->|"builds nodes"| node_node
node_tree_mutator -->|"serialize messages"| node_serializer
node_node -->|"cached nodes"| node_node_store
node_node_store -->|"backed by chunks"| node_chunk_store
node_serializer -->|"bytes -&gt; Chunks"| node_chunk
node_chunk -->|"HashOf"| node_hash
node_chunk_store -->|"NBS implements"| node_nbs_store
node_nbs_store -->|"append chunks"| node_journal
node_nbs_store -->|"table file registry"| node_file_manifest
node_nbs_store -->|"read table files"| node_chunk_source
node_dolt_db -->|"wraps Database"| node_datas_db
node_datas_db -->|"heads &amp; refs"| node_dataset
node_dataset -->|"workingSets refs"| node_working_set


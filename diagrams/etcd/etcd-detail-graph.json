    { "from": "client_watch", "to": "rpc_kv", "label": "Watch stream" },
    { "from": "rpc_kv", "to": "v3_server", "label": "server-side handlers" },
    { "from": "raft_internal", "to": "raft_request", "label": "request envelope" },
    { "from": "v3_server", "to": "raft_request", "label": "mutations" },
    { "from": "v3_server", "to": "read_index", "label": "linearizable reads" },
    { "from": "v3_server", "to": "txn_range", "label": "serializable reads" },
    { "from": "raft_request", "to": "raft_loop", "label": "Propose" },
    { "from": "server_start", "to": "raft_loop", "label": "start raft goroutine" },
    { "from": "server_start", "to": "read_index", "label": "attach read loop" },
    { "from": "raft_node", "to": "raft_loop", "label": "run loop" },
    { "from": "raft_loop", "to": "wal_save", "label": "persist before ack" },
    { "from": "raft_loop", "to": "rafthttp", "label": "leader sends" },
    { "from": "rafthttp", "to": "raft_loop", "label": "peer messages in" },
    { "from": "raft_loop", "to": "apply_entries", "label": "committed entries" },
    { "from": "raft_loop", "to": "wal_read", "label": "replay at boot" },
    { "from": "read_index", "to": "raft_loop", "label": "ReadIndex round" },
    { "from": "apply_entries", "to": "apply_entry", "label": "one Apply per entry" },
    { "from": "apply_entry", "to": "uber_applier", "label": "wrapped request" },
    { "from": "uber_applier", "to": "applier_backend", "label": "wrapper chain" },
    { "from": "uber_applier", "to": "txn_range", "label": "dispatch Range" },
    { "from": "uber_applier", "to": "txn_txn", "label": "dispatch Txn" },
    { "from": "applier_backend", "to": "txn_put", "label": "execute Put" },
    { "from": "txn_txn", "to": "txn_put", "label": "branch ops" },
    { "from": "txn_put", "to": "kv_txn", "label": "write via TxnWrite" },
    { "from": "txn_range", "to": "kv_store", "label": "read view" },
    { "from": "kv_store", "to": "kv_txn", "label": "Write() txn" },
    { "from": "kv_txn", "to": "store_put", "label": "per-key put" },
    { "from": "store_put", "to": "revision", "label": "RevToBytes" },
    { "from": "store_put", "to": "tree_index", "label": "index update" },
    { "from": "store_put", "to": "schema_key", "label": "UnsafeSeqPut" },
    { "from": "store_put", "to": "watch_txn", "label": "changes buffered" },
    { "from": "store_put", "to": "lessor", "label": "Attach/Detach" },
    { "from": "tree_index", "to": "key_index", "label": "generations" },
    { "from": "schema_key", "to": "backend", "label": "bolt txns" },
    { "from": "kv_store", "to": "compaction", "label": "history grows" },
    { "from": "compaction", "to": "tree_index", "label": "drop old revs" },
    { "from": "watch_txn", "to": "watchable_store", "label": "notify(rev, events)" },
    { "from": "watchable_store", "to": "sync_watchers", "label": "catch up slow watchers" },
    { "from": "watchable_store", "to": "client_watch", "label": "WatchResponse" },
    { "from": "wal_read", "to": "kv_store", "label": "restore index" }
  ]
}

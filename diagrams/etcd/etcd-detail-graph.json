{
  "owner": "etcd-io",
  "repo": "etcd",
  "branch": "main",
  "groups": [
    { "id": "clients", "name": "clients", "label": "Clients" },
    { "id": "api", "name": "api", "label": "gRPC API" },
    { "id": "server_core", "name": "server_core", "label": "etcdserver" },
    { "id": "consensus", "name": "consensus", "label": "Raft Consensus" },
    { "id": "applier", "name": "applier", "label": "Apply Layer" },
    { "id": "mvcc", "name": "mvcc", "label": "MVCC Store" },
    { "id": "storage", "name": "storage", "label": "Durable Storage" },
    { "id": "lease", "name": "lease", "label": "Leases" }
  ],
  "nodes": [
    { "id": "client_new", "label": "clientv3.New", "file": "client.go", "path": "client/v3/client.go", "group": "clients", "groupId": "clients", "desc": "Dials endpoints, sets up gRPC connections and auth" },
    { "id": "client_kv", "label": "KV interface", "file": "kv.go", "path": "client/v3/kv.go", "group": "clients", "groupId": "clients", "desc": "Put, Get, Delete and Txn operations on the cluster" },
    { "id": "client_watch", "label": "Watcher", "file": "watch.go", "path": "client/v3/watch.go", "group": "clients", "groupId": "clients", "desc": "Opens watch streams and resends after disruptions" },
    { "id": "rpc_kv", "label": "service KV", "file": "rpc.proto", "path": "api/etcdserverpb/rpc.proto", "group": "api", "groupId": "api", "desc": "Range, Put, Txn and Watch gRPC service surface" },
    { "id": "raft_internal", "label": "InternalRaftRequest", "file": "raft_internal.proto", "path": "api/etcdserverpb/raft_internal.proto", "group": "api", "groupId": "api", "desc": "Envelope that carries every mutation through the log" },
    { "id": "server_start", "label": "EtcdServer.Start", "file": "server.go", "path": "server/etcdserver/server.go", "group": "server_core", "groupId": "server_core", "desc": "Boots goroutines: raft loop, read loop, monitors" },
    { "id": "v3_server", "label": "KV handlers", "file": "v3_server.go", "path": "server/etcdserver/v3_server.go", "group": "server_core", "groupId": "server_core", "desc": "Put, Range and Txn entry points with auth checks" },
    { "id": "raft_request", "label": "raftRequest", "file": "v3_server.go", "path": "server/etcdserver/v3_server.go", "group": "server_core", "groupId": "server_core", "desc": "Wraps mutation, waits for it to be applied" },
    { "id": "read_index", "label": "LinearizableReadLoop", "file": "read.go", "path": "server/etcdserver/read/read.go", "group": "server_core", "groupId": "server_core", "desc": "ReadIndex protocol proves leadership before serving reads" },
    { "id": "apply_entries", "label": "applyEntries", "file": "server.go", "path": "server/etcdserver/server.go", "group": "server_core", "groupId": "server_core", "desc": "Feeds committed entries to the applier in order" },
    { "id": "raft_node", "label": "raftNode", "file": "raft.go", "path": "server/etcdserver/raft.go", "group": "consensus", "groupId": "consensus", "desc": "Glue between etcdserver and the go.etcd.io/raft library" },
    { "id": "raft_loop", "label": "raftNode.start loop", "file": "raft.go", "path": "server/etcdserver/raft.go", "group": "consensus", "groupId": "consensus", "desc": "Tick and Ready cycle: propose, persist, send, hand off" },
    { "id": "rafthttp", "label": "Transport.Send", "file": "transport.go", "path": "server/etcdserver/api/rafthttp/transport.go", "group": "consensus", "groupId": "consensus", "desc": "Streams raft messages to peer members" },
    { "id": "apply_entry", "label": "Apply", "file": "apply.go", "path": "server/etcdserver/apply/apply.go", "group": "applier", "groupId": "applier", "desc": "Decodes entry data into InternalRaftRequest" },
    { "id": "uber_applier", "label": "uberApplier.Apply", "file": "uber_applier.go", "path": "server/etcdserver/apply/uber_applier.go", "group": "applier", "groupId": "applier", "desc": "Wrapper chain then dispatch to type-specific appliers" },
    { "id": "applier_backend", "label": "applierV3backend", "file": "backend.go", "path": "server/etcdserver/apply/backend.go", "group": "applier", "groupId": "applier", "desc": "Base applier that touches MVCC, auth and alarms" },
    { "id": "txn_put", "label": "txn.Put", "file": "put.go", "path": "server/etcdserver/txn/put.go", "group": "applier", "groupId": "applier", "desc": "Lease checks, ignore_value/lease flags, prev_kv fetch" },
    { "id": "txn_range", "label": "txn.Range", "file": "range.go", "path": "server/etcdserver/txn/range.go", "group": "applier", "groupId": "applier", "desc": "Sort, limit, revision and count_only handling" },
    { "id": "txn_txn", "label": "txn.Txn", "file": "txn.go", "path": "server/etcdserver/txn/txn.go", "group": "applier", "groupId": "applier", "desc": "Evaluates if/then/else comparisons atomically" },
    { "id": "kv_store", "label": "mvcc store", "file": "kvstore.go", "path": "server/storage/mvcc/kvstore.go", "group": "mvcc", "groupId": "mvcc", "desc": "Holds currentRev, tree index, backend and lessor" },
    { "id": "kv_txn", "label": "store.Write", "file": "kvstore_txn.go", "path": "server/storage/mvcc/kvstore_txn.go", "group": "mvcc", "groupId": "mvcc", "desc": "Opens a write transaction over bolt and index" },
    { "id": "store_put", "label": "storeTxnWrite.put", "file": "kvstore_txn.go", "path": "server/storage/mvcc/kvstore_txn.go", "group": "mvcc", "groupId": "mvcc", "desc": "Encodes revision key, marshals KeyValue, updates index" },
    { "id": "watch_txn", "label": "watchableStoreTxnWrite.End", "file": "watchable_store_txn.go", "path": "server/storage/mvcc/watchable_store_txn.go", "group": "mvcc", "groupId": "mvcc", "desc": "Collects changes and fires notifications at close" },
    { "id": "watchable_store", "label": "watchableStore", "file": "watchable_store.go", "path": "server/storage/mvcc/watchable_store.go", "group": "mvcc", "groupId": "mvcc", "desc": "Tracks synced watchers and parked victims" },
    { "id": "sync_watchers", "label": "syncWatchers", "file": "watchable_store.go", "path": "server/storage/mvcc/watchable_store.go", "group": "mvcc", "groupId": "mvcc", "desc": "Catches unsynced watchers up from the revision history" },
    { "id": "tree_index", "label": "treeIndex", "file": "index.go", "path": "server/storage/mvcc/index.go", "group": "mvcc", "groupId": "mvcc", "desc": "B-tree from key to its revision generations" },
    { "id": "key_index", "label": "keyIndex", "file": "key_index.go", "path": "server/storage/mvcc/key_index.go", "group": "mvcc", "groupId": "mvcc", "desc": "Per-key generations of modifications and tombstones" },
    { "id": "revision", "label": "Revision codec", "file": "revision.go", "path": "server/storage/mvcc/revision.go", "group": "mvcc", "groupId": "mvcc", "desc": "Packs Main and Sub revision ints into orderable bytes" },
    { "id": "compaction", "label": "scheduleCompaction", "file": "kvstore_compaction.go", "path": "server/storage/mvcc/kvstore_compaction.go", "group": "mvcc", "groupId": "mvcc", "desc": "Drops history older than the compact revision" },
    { "id": "wal_save", "label": "WAL.Save", "file": "wal.go", "path": "server/storage/wal/wal.go", "group": "storage", "groupId": "storage", "desc": "Appends entries and hard state, fsyncs when needed" },
    { "id": "wal_read", "label": "WAL.ReadAll", "file": "wal.go", "path": "server/storage/wal/wal.go", "group": "storage", "groupId": "storage", "desc": "Replays the log at startup to rebuild raft state" },
    { "id": "schema_key", "label": "schema.Key bucket", "file": "bucket.go", "path": "server/storage/schema/bucket.go", "group": "storage", "groupId": "storage", "desc": "Named bolt bucket holding revisioned key records" },
    { "id": "backend", "label": "backend.New", "file": "backend.go", "path": "server/storage/backend/backend.go", "group": "storage", "groupId": "storage", "desc": "BoltDB wrapper with batched transactions" },
    { "id": "lessor", "label": "lessor", "file": "lessor.go", "path": "server/lease/lessor.go", "group": "lease", "groupId": "lease", "desc": "Grant, Renew and Revoke expiring leases" }
  ],
  "edges": [
    { "from": "client_new", "to": "client_kv", "label": "exposes KV" },
    { "from": "client_new", "to": "client_watch", "label": "exposes Watcher" },

flowchart TD

subgraph group_clients["Clients"]
  node_client_v3["client/v3 Client<br/>[client.go]"]
end

subgraph group_api["gRPC API"]
  node_kv_api["service KV &#40;protobuf&#41;<br/>[rpc.proto]"]
end

subgraph group_server_core["etcdserver"]
  node_v3_server["EtcdServer request handlers<br/>[v3_server.go]"]
  node_apply_entry["Apply entry<br/>[apply.go]"]
  node_uber_applier["uberApplier dispatch<br/>[uber_applier.go]"]
  node_txn_put["txn.Put<br/>[put.go]"]
end

subgraph group_consensus["Raft Consensus"]
  node_raft_node["raftNode loop<br/>[raft.go]"]
  node_rafthttp["rafthttp Transport<br/>[transport.go]"]
end

subgraph group_storage["Storage"]
  node_wal["WAL<br/>[wal.go]"]
  node_mvcc_store["MVCC storeTxnWrite<br/>[kvstore_txn.go]"]
  node_watchable["watchableStore<br/>[watchable_store.go]"]
end

node_client_v3 -->|"gRPC calls"| node_kv_api
node_kv_api -->|"RPC handlers"| node_v3_server
node_v3_server -->|"propose InternalRaftRequest"| node_raft_node
node_raft_node -->|"Save hard state + entries"| node_wal
node_raft_node -->|"leader replicates"| node_rafthttp
node_raft_node -->|"committed entries"| node_apply_entry
node_apply_entry -->|"wrapped request"| node_uber_applier
node_uber_applier -->|"dispatch Put"| node_txn_put
node_txn_put -->|"storeTxnWrite.put"| node_mvcc_store
node_mvcc_store -->|"txn End&#40;&#41; emits events"| node_watchable
node_v3_server -->|"Range reads"| node_mvcc_store
node_watchable -->|"WatchResponse stream"| node_client_v3


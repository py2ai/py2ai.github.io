node_client_new -->|"exposes KV"| node_client_kv
node_client_new -->|"exposes Watcher"| node_client_watch
node_client_kv -->|"gRPC stubs"| node_rpc_kv
node_client_watch -->|"Watch stream"| node_rpc_kv
node_rpc_kv -->|"server-side handlers"| node_v3_server
node_raft_internal -->|"request envelope"| node_raft_request
node_v3_server -->|"mutations"| node_raft_request
node_v3_server -->|"linearizable reads"| node_read_index
node_v3_server -->|"serializable reads"| node_txn_range
node_raft_request -->|"Propose"| node_raft_loop
node_server_start -->|"start raft goroutine"| node_raft_loop
node_server_start -->|"attach read loop"| node_read_index
node_raft_node -->|"run loop"| node_raft_loop
node_raft_loop -->|"persist before ack"| node_wal_save
node_raft_loop -->|"leader sends"| node_rafthttp
node_rafthttp -->|"peer messages in"| node_raft_loop
node_raft_loop -->|"committed entries"| node_apply_entries
node_raft_loop -->|"replay at boot"| node_wal_read
node_read_index -->|"ReadIndex round"| node_raft_loop
node_apply_entries -->|"one Apply per entry"| node_apply_entry
node_apply_entry -->|"wrapped request"| node_uber_applier
node_uber_applier -->|"wrapper chain"| node_applier_backend
node_uber_applier -->|"dispatch Range"| node_txn_range
node_uber_applier -->|"dispatch Txn"| node_txn_txn
node_applier_backend -->|"execute Put"| node_txn_put
node_txn_txn -->|"branch ops"| node_txn_put
node_txn_put -->|"write via TxnWrite"| node_kv_txn
node_txn_range -->|"read view"| node_kv_store
node_kv_store -->|"Write&#40;&#41; txn"| node_kv_txn
node_kv_txn -->|"per-key put"| node_store_put
node_store_put -->|"RevToBytes"| node_revision
node_store_put -->|"index update"| node_tree_index
node_store_put -->|"UnsafeSeqPut"| node_schema_key
node_store_put -->|"changes buffered"| node_watch_txn
node_store_put -->|"Attach/Detach"| node_lessor
node_tree_index -->|"generations"| node_key_index
node_schema_key -->|"bolt txns"| node_backend
node_kv_store -->|"history grows"| node_compaction
node_compaction -->|"drop old revs"| node_tree_index
node_watch_txn -->|"notify&#40;rev, events&#41;"| node_watchable_store
node_watchable_store -->|"catch up slow watchers"| node_sync_watchers
node_watchable_store -->|"WatchResponse"| node_client_watch
node_wal_read -->|"restore index"| node_kv_store


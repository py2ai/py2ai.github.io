node_server_main -->|"boots the object layer"| node_server_pools
node_api_router -->|"routes object verbs"| node_object_handlers
node_object_handlers -->|"invokes ObjectLayer"| node_object_interface
node_server_pools -->|"spawns sets per pool"| node_erasure_sets
node_erasure_sets -->|"set-local object ops"| node_erasure_object
node_erasure_object -->|"encode/decode shards"| node_erasure_coding
node_erasure_object -->|"reads/writes FileInfo"| node_erasure_metadata
node_erasure_coding -->|"shard IO on disks"| node_xl_storage
node_erasure_metadata -->|"persists xl.meta"| node_xl_meta
node_erasure_object -->|"locks bucket/object"| node_namespace_lock
node_erasure_object -->|"implements ObjectLayer"| node_object_interface
node_erasure_metadata -->|"quorum on-disk checks"| node_xl_storage


{
  "owner": "love2d",
  "repo": "love",
  "branch": "main",
  "groups": [
    { "id": "entry", "name": "Executable Entry", "label": "exe" },
    { "id": "lua_boot", "name": "Lua Boot Layer", "label": "boot" },
    { "id": "modules", "name": "Module Wrappers", "label": "modules" },
    { "id": "backends", "name": "Native Backends", "label": "backends" }
  ],
  "nodes": [
    {
      "id": "main_cpp",
      "label": "love.cpp (exe main)",
      "file": "love.cpp",
      "path": "src/love.cpp",
      "group": "entry",
      "groupId": "entry",
      "desc": "main() creates the Lua VM, requires love, and reruns the whole state for restart"
    },
    {
      "id": "love_module_cpp",
      "label": "luaopen_love",
      "file": "love.cpp",
      "path": "src/modules/love/love.cpp",
      "group": "lua_boot",
      "groupId": "lua_boot",
      "desc": "Registers every love.* module; boot.lua/callbacks.lua are embedded as C string literals"
    },
    {
      "id": "boot_lua",
      "label": "boot.lua",
      "file": "boot.lua",
      "path": "src/modules/love/boot.lua",
      "group": "lua_boot",
      "groupId": "lua_boot",
      "desc": "love.boot mounts the game source, love.init reads conf.lua and loads modules, opens the window"
    },
    {
      "id": "callbacks_lua",
      "label": "callbacks.lua / love.run",
      "file": "callbacks.lua",
      "path": "src/modules/love/callbacks.lua",
      "group": "lua_boot",
      "groupId": "lua_boot",
      "desc": "The canonical main loop: event pump, update(dt), clear, draw, present"
    },
    {
      "id": "jitsetup_lua",
      "label": "jitsetup.lua",
      "file": "jitsetup.lua",
      "path": "src/modules/love/jitsetup.lua",
      "group": "lua_boot",
      "groupId": "lua_boot",
      "desc": "Tunes LuaJIT trace limits; no-op when built against PUC Lua"
    },
    {
      "id": "fs_physfs",
      "label": "Filesystem (PhysFS)",
      "file": "Filesystem.cpp",
      "path": "src/modules/filesystem/physfs/Filesystem.cpp",
      "group": "modules",
      "groupId": "modules",
      "desc": "setSource mounts a game directory or .love zip archive via PhysFS"
    },
    {
      "id": "graphics_wrap",
      "label": "love.graphics wrapper",
      "file": "wrap_Graphics.cpp",
      "path": "src/modules/graphics/wrap_Graphics.cpp",
      "group": "modules",
      "groupId": "modules",
      "desc": "luaopen_love_graphics instantiates the backend Graphics object and exposes it to Lua"
    },
    {
      "id": "timer_cpp",
      "label": "Timer module",
      "file": "Timer.cpp",
      "path": "src/modules/timer/Timer.cpp",
      "group": "modules",
      "groupId": "modules",
      "desc": "step() produces frame dt, sleep() throttles the loop"
    },
    {
      "id": "event_sdl",
      "label": "Event (SDL3)",
      "file": "Event.cpp",
      "path": "src/modules/event/sdl/Event.cpp",
      "group": "backends",
      "groupId": "backends",
      "desc": "Pumps SDL3 events and converts them into love.event messages"
    },
    {
      "id": "window_sdl",
      "label": "Window (SDL3)",
      "file": "Window.cpp",
      "path": "src/modules/window/sdl/Window.cpp",
      "group": "backends",
      "groupId": "backends",
      "desc": "setWindow creates the SDL3 window plus GL/Metal/Vulkan context, then calls graphics->setMode"
    },
    {
      "id": "audio_openal",
      "label": "Audio (OpenAL)",
      "file": "Audio.cpp",
      "path": "src/modules/audio/openal/Audio.cpp",
      "group": "backends",
      "groupId": "backends",
      "desc": "Opens an OpenAL device/context and runs a mixer pool thread"
    }
  ],
  "edges": [
    { "from": "main_cpp", "to": "love_module_cpp", "label": "require \"love\"" },
    { "from": "love_module_cpp", "to": "boot_lua", "label": "luaopen_love_boot" },
    { "from": "love_module_cpp", "to": "callbacks_lua", "label": "embedded callbacks.lua" },
    { "from": "love_module_cpp", "to": "jitsetup_lua", "label": "JIT preload" },
    { "from": "boot_lua", "to": "fs_physfs", "label": "setSource mounts game" },
    { "from": "boot_lua", "to": "window_sdl", "label": "love.window.setMode" },
    { "from": "boot_lua", "to": "graphics_wrap", "label": "require \"love.graphics\"" },
    { "from": "window_sdl", "to": "graphics_wrap", "label": "graphics->setMode" },
    { "from": "callbacks_lua", "to": "event_sdl", "label": "pump + poll" },
    { "from": "callbacks_lua", "to": "timer_cpp", "label": "dt = step()" },
    { "from": "callbacks_lua", "to": "graphics_wrap", "label": "clear/draw/present" }
  ]
}

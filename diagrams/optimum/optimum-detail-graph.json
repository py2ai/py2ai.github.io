    {"id": "parallel_embedding", "label": "VocabParallelEmbedding", "file": "optimum/fx/parallelization/parallel_layers/embedding.py", "group": "fx", "groupId": "fx", "desc": "vocab-sharded embedding layer", "path": "optimum/fx/parallelization/parallel_layers/embedding.py"},
    {"id": "dist_ops", "label": "all_reduce", "file": "optimum/fx/parallelization/distributed/dist_ops.py", "group": "fx", "groupId": "fx", "desc": "process-group collectives with differentiable autograd functions", "path": "optimum/fx/parallelization/distributed/dist_ops.py"},
    {"id": "subpackages", "label": "load_subpackages", "file": "optimum/subpackages.py", "group": "support", "groupId": "support", "desc": "discovers installed optimum-* namespace distributions and boots their modules", "path": "optimum/subpackages.py"},
    {"id": "runs_base", "label": "Run", "file": "optimum/runs_base.py", "group": "support", "groupId": "support", "desc": "calibration and evaluation run harness used by backend quantizers", "path": "optimum/runs_base.py"},

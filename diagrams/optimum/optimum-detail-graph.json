    {"id": "normalized_config", "label": "NormalizedConfigManager", "file": "optimum/utils/normalized_config.py", "group": "routing", "groupId": "routing", "desc": "maps model architectures to normalized config classes exporters can rely on", "path": "optimum/utils/normalized_config.py"},
    {"id": "import_utils", "label": "is_transformers_version", "file": "optimum/utils/import_utils.py", "group": "routing", "groupId": "routing", "desc": "package availability probes and version comparison gates", "path": "optimum/utils/import_utils.py"},

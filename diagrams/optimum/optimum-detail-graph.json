    {"id": "optimum_cli", "label": "main", "file": "optimum/commands/optimum_cli.py", "group": "cli", "groupId": "cli", "desc": "optimum-cli entry point that assembles root subcommands and namespace backend commands", "path": "optimum/commands/optimum_cli.py"},
    {"id": "root_command", "label": "RootOptimumCLICommand", "file": "optimum/commands/base.py", "group": "cli", "groupId": "cli", "desc": "argparse root; also defines the BaseOptimumCLICommand contract every subcommand follows", "path": "optimum/commands/base.py"},
    {"id": "export_command", "label": "ExportCommand", "file": "optimum/commands/export/base.py", "group": "cli", "groupId": "cli", "desc": "the export subcommand that hands off to backend-specific exporter CLIs", "path": "optimum/commands/export/base.py"},
    {"id": "env_command", "label": "EnvironmentCommand", "file": "optimum/commands/env.py", "group": "cli", "groupId": "cli", "desc": "optimum-cli env prints installed backend and library versions", "path": "optimum/commands/env.py"},

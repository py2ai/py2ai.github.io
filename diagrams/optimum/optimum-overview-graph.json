  "groups": [
    {"id": "cli", "name": "CLI Layer", "label": "CLI Layer"},
    {"id": "routing", "name": "Task Routing", "label": "Task Routing"},
    {"id": "export", "name": "Export Contract", "label": "Export Contract"},
    {"id": "runtime", "name": "Model & Runtime Base", "label": "Model & Runtime Base"},
    {"id": "quant", "name": "Quantization", "label": "Quantization"},
    {"id": "fx", "name": "torch.fx Tools", "label": "torch.fx Tools"},
    {"id": "dispatch", "name": "Subpackage Dispatch", "label": "Subpackage Dispatch"}
  ],
  "nodes": [
    {"id": "optimum_cli", "label": "main", "file": "optimum/commands/optimum_cli.py", "group": "cli", "groupId": "cli", "desc": "optimum-cli entry point; registers root subcommands then boots backend subpackages", "path": "optimum/commands/optimum_cli.py"},
    {"id": "export_command", "label": "ExportCommand", "file": "optimum/commands/export/base.py", "group": "cli", "groupId": "cli", "desc": "the export subcommand; delegates to backend-specific exporter CLIs", "path": "optimum/commands/export/base.py"},
    {"id": "tasks_manager", "label": "TasksManager", "file": "optimum/exporters/tasks.py", "group": "routing", "groupId": "routing", "desc": "task name to model class mappings plus task, library and framework inference", "path": "optimum/exporters/tasks.py"},
    {"id": "exporter_config", "label": "ExporterConfig", "file": "optimum/exporters/base.py", "group": "export", "groupId": "export", "desc": "base config pairing a normalized config with dummy input generators and validation tolerance", "path": "optimum/exporters/base.py"},
    {"id": "normalized_config", "label": "NormalizedConfigManager", "file": "optimum/utils/normalized_config.py", "group": "routing", "groupId": "routing", "desc": "maps model architectures to normalized config classes for exporters", "path": "optimum/utils/normalized_config.py"},
    {"id": "dummy_inputs", "label": "DummyInputGenerator", "file": "optimum/utils/input_generators.py", "group": "export", "groupId": "export", "desc": "builds the dummy tensors tracing needs for each task", "path": "optimum/utils/input_generators.py"},
    {"id": "optimized_model", "label": "OptimizedModel", "file": "optimum/modeling_base.py", "group": "runtime", "groupId": "runtime", "desc": "base class of ORTModel, OVModel and friends; from_pretrained with export=True converts on the fly", "path": "optimum/modeling_base.py"},
    {"id": "quantizer_base", "label": "OptimumQuantizer", "file": "optimum/quantization_base.py", "group": "quant", "groupId": "quant", "desc": "abstract quantizer contract: from_pretrained plus quantize", "path": "optimum/quantization_base.py"},
    {"id": "gptq_quantizer", "label": "GPTQQuantizer", "file": "optimum/gptq/quantizer.py", "group": "quant", "groupId": "quant", "desc": "in-repo GPTQ implementation quantizing torch modules layer by layer", "path": "optimum/gptq/quantizer.py"},
    {"id": "fx_transforms", "label": "Transformation", "file": "optimum/fx/optimization/transformations.py", "group": "fx", "groupId": "fx", "desc": "reversible torch.fx graph rewrites such as MergeLinears and FuseBiasInLinear", "path": "optimum/fx/optimization/transformations.py"},
    {"id": "fx_parallel", "label": "parallelize_model", "file": "optimum/fx/parallelization/api.py", "group": "fx", "groupId": "fx", "desc": "one-call tensor parallelization of a torch model via passes and op handlers", "path": "optimum/fx/parallelization/api.py"},
    {"id": "subpackages", "label": "load_subpackages", "file": "optimum/subpackages.py", "group": "dispatch", "groupId": "dispatch", "desc": "discovers installed optimum-* namespace distributions and loads their modules", "path": "optimum/subpackages.py"}
  ],
  "edges": [
    {"from": "optimum_cli", "to": "export_command", "label": "root subcommand"},
    {"from": "optimum_cli", "to": "subpackages", "label": "load_subpackages()"},
    {"from": "subpackages", "to": "optimum_cli", "label": "backend subcommands"},
    {"from": "export_command", "to": "tasks_manager", "label": "model and task resolution"},
    {"from": "tasks_manager", "to": "exporter_config", "label": "get_exporter_config_constructor"},
    {"from": "tasks_manager", "to": "normalized_config", "label": "architecture-aware configs"},
    {"from": "tasks_manager", "to": "optimized_model", "label": "get_model_from_task"},
    {"from": "exporter_config", "to": "normalized_config", "label": "NORMALIZED_CONFIG_CLASS"},
    {"from": "exporter_config", "to": "dummy_inputs", "label": "DUMMY_INPUT_GENERATOR_CLASSES"},

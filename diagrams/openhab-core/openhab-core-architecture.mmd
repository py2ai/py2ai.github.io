node_item_event_factory -->|"builds ItemCommandEvent/ItemStateEvent"| node_event
node_item_event_factory -.->|"topics name items"| node_item
node_item -->|"managed in"| node_item_registry
node_event_publisher -->|"default implementation"| node_osgi_event_publisher
node_event_subscriber -->|"dynamic @Reference tracking"| node_osgi_event_manager
node_osgi_event_publisher -->|"EventAdmin.postEvent&#40;openhab/*&#41;"| node_osgi_event_manager
node_osgi_event_manager -->|"rebuilds + receive&#40;&#41;"| node_event_subscriber
node_thing -->|"hosts"| node_channel
node_thing -.->|"may attach to"| node_bridge
node_thing_type -->|"template for"| node_thing
node_managed_thing_provider -->|"storage provider"| node_thing_registry
node_thing_registry -->|"implemented by"| node_thing_registry_impl
node_thing_registry_impl -->|"ThingTracker notifications"| node_thing_manager_impl
node_thing_registry_impl -->|"add / update / remove"| node_thing
node_thing_manager_impl -->|"resolves by ThingTypeUID"| node_handler_factory
node_handler_factory -->|"registerHandler&#40;Thing&#41;"| node_thing_handler
node_thing_manager_impl -->|"doInitializeHandler&#40;&#41;"| node_thing_handler
node_thing_handler -.->|"convenience base"| node_base_thing_handler
node_base_thing_handler -->|"updateStatus / updateState"| node_thing
node_comm_manager -->|"receives item events"| node_event_subscriber
node_link_registry -->|"tracks links"| node_item_channel_link
node_link_registry -->|"RegistryChangeListener"| node_comm_manager
node_comm_manager -->|"profile per link"| node_item_channel_link
node_comm_manager -->|"receiveCommand&#40;&#41; intercept"| node_auto_update
node_comm_manager -->|"onCommandFromItem -&gt; handleCommand"| node_thing_handler
node_base_thing_handler -->|"publishes ItemStateEvent"| node_event_publisher
node_event_trigger_handler -->|"subscribes to topics"| node_event_subscriber
node_event_trigger_handler -->|"fires on match"| node_trigger_callback
node_trigger_callback -->|"re.runRule&#40;ruleUID&#41;"| node_rule_engine_impl
node_rule_engine_impl -->|"registers per rule"| node_trigger_callback
node_rule_engine_impl -->|"initializes + executes"| node_rule
node_rule -->|"composes"| node_trigger
node_rule -->|"composes"| node_condition
node_rule -->|"composes"| node_action
node_discovery_service -.->|"base class"| node_abstract_discovery
node_abstract_discovery -->|"emits"| node_discovery_result
node_abstract_discovery -->|"listener notified"| node_inbox
node_inbox -->|"approve&#40;&#41; -&gt; add"| node_thing_registry_impl
node_inbox -.->|"stores proposals"| node_discovery_result


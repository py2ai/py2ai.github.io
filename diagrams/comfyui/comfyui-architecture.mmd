  node_frontend_mgmt["Frontend Manager<br/>static-assets"]
  node_folder_paths[("Folder Paths<br/>path-registry")]
end

subgraph group_g_execution["Execution Engine"]
  node_execution{{"Graph Executor<br/>orchestration"}}
  node_graph["Executable Graph<br/>data-model"]
  node_graph_caching["Cache Strategy<br/>[caching.py]"]
  node_jobs["Job Tracker<br/>orchestration"]
  node_validation["Prompt Validation<br/>[validation.py]"]
  node_progress["Progress Reporter<br/>observability"]
end

subgraph group_g_nodes["Node Surface"]
  node_nodes["Core Nodes<br/>node-registry"]
  node_node_helpers["Node Helpers<br/>[node_helpers.py]"]
  node_extras["Extra Nodes<br/>node-registry"]
  node_api_nodes["Partner API Nodes<br/>node-registry"]
end

subgraph group_g_models["Model Layer"]
  node_model_management{{"Model Manager<br/>resource-manager"}}
  node_memory_management["Memory Utilities<br/>resource-manager"]
  node_sd["Checkpoint Loader<br/>[sd.py]"]
  node_model_detection["Model Detector<br/>algorithm"]
  node_supported_models["Model Registry<br/>metadata-catalog"]
  node_model_base["Model Base<br/>base-class"]
  node_model_sampling["Model Sampling<br/>algorithm"]
  node_latent_formats["Latent Formats<br/>data-model"]
  node_model_patcher{{"Model Patcher<br/>wrapper"}}
  node_ops["Patched Ops<br/>kernel-wrapper"]
  node_quant_ops["Quantized Ops<br/>kernel-wrapper"]
end

subgraph group_g_conditioning["Conditioning and Control"]
  node_lora["LoRA<br/>adapter-loader"]
  node_hooks["Hooks<br/>extension-mechanism"]
  node_controlnet["ControlNet<br/>conditioning-model"]
  node_clip_model["CLIP Encoders<br/>text-encoder"]
end

subgraph group_g_sampling["Sampling"]
  node_samplers{{"Samplers<br/>inference-engine"}}
  node_sampler_helpers["Sampler Helpers<br/>orchestration"]
  node_context_windows["Context Windows<br/>algorithm"]
end

node_main_entry -->|"boots"| node_server
node_server -->|"serves UI via"| node_frontend_mgmt
node_server -->|"scans"| node_folder_paths
node_server -->|"hands prompts to"| node_execution
node_execution -->|"checks first"| node_validation
node_validation -->|"verifies files in"| node_folder_paths
node_execution -->|"walks with"| node_graph
node_execution -->|"skips via"| node_graph_caching
node_execution -->|"tracks as"| node_jobs
node_execution -->|"reports via"| node_progress
node_execution -->|"invokes"| node_nodes
node_extras -->|"register into"| node_nodes
node_api_nodes -->|"register into"| node_nodes
node_nodes -.->|"share"| node_node_helpers
node_nodes -->|"load through"| node_model_management
node_model_management -->|"loads checkpoints with"| node_sd
node_sd -->|"recognizes via"| node_model_detection
node_model_detection -->|"matches against"| node_supported_models
node_sd -->|"builds"| node_model_base
node_model_base -->|"parameterizes"| node_model_sampling
node_model_base -->|"decodes via"| node_latent_formats
node_model_patcher -->|"wraps"| node_model_base
node_model_patcher -->|"patches through"| node_ops
node_quant_ops -->|"extends"| node_ops
node_model_management -->|"manages via"| node_memory_management
node_lora -->|"patches into"| node_model_patcher
node_hooks -->|"hook into"| node_model_patcher
node_controlnet -->|"exposed via"| node_nodes
node_clip_model -->|"exposed via"| node_nodes
node_nodes -->|"samples with"| node_samplers
node_samplers -->|"prepares via"| node_sampler_helpers
node_sampler_helpers -->|"arms"| node_controlnet
node_samplers -->|"sigmas from"| node_model_sampling
node_context_windows -->|"chunks for"| node_samplers
node_model_management -->|"frees VRAM for"| node_samplers


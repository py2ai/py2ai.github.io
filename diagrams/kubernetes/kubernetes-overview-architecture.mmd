node_apis_main -->|"runs cobra command"| node_apis_command
node_apis_command -->|"RunE -&gt; Run -&gt; chain"| node_create_server_chain
node_create_server_chain -->|"config.KubeAPIs.New"| node_controlplane_instance
node_controlplane_instance -->|"StorageProviders install REST"| node_pod_rest
node_pod_rest -->|"validate + default"| node_pod_strategy
node_new_main_kubelet -->|"makePodSourceConfig"| node_pod_source_apiserver
node_pod_source_apiserver -->|"list-watch pods by nodeName"| node_pod_rest
node_new_main_kubelet -->|"StartKubelet"| node_kubelet_run
node_kubelet_run -->|"final blocking loop"| node_kubelet_sync_loop
node_kubelet_sync_loop -->|"hand off pod updates"| node_pod_workers
node_pod_workers -->|"SyncPod via SyncHandler"| node_kuberuntime_manager
node_kubelet_run -->|"PLEG + runtime probes"| node_kuberuntime_manager


flowchart TD

subgraph group_g1["Client &amp; Supervisor"]
  node_libpq["libpq PQconnectdb<br/>[fe-connect.c]"]
  node_postmaster["PostmasterMain<br/>[postmaster.c]"]
end

subgraph group_g2["Backend Session"]
  node_backend["exec_simple_query<br/>[postgres.c]"]
  node_pgparse["pg_parse_query<br/>[postgres.c]"]
end

subgraph group_g3["Parse &amp; Rewrite"]
  node_parser["raw_parser<br/>[parser.c]"]
  node_analyzer["transformTopLevelStmt<br/>[analyze.c]"]
  node_rewriter["QueryRewrite<br/>[rewriteHandler.c]"]
end

subgraph group_g4["Optimizer"]
  node_planner["standard_planner<br/>[planner.c]"]
  node_allpaths["make_one_rel<br/>[allpaths.c]"]
  node_joinrels["make_join_rel<br/>[joinrels.c]"]
  node_createplan["create_plan<br/>[createplan.c]"]
end

subgraph group_g5["Executor"]
  node_execmain["ExecutorRun<br/>[execMain.c]"]
  node_execproc["ExecProcNode dispatch<br/>[execProcnode.c]"]
  node_seqscan["SeqNext<br/>[nodeSeqscan.c]"]
  node_indexscan["IndexNext<br/>[nodeIndexscan.c]"]
  node_hashjoin["ExecHashJoin<br/>[nodeHashjoin.c]"]
  node_hashbuild["ExecHashTableCreate<br/>[nodeHash.c]"]
  node_aggnode["agg_fill_hash_table<br/>[nodeAgg.c]"]
  node_sortnode["ExecSort<br/>[nodeSort.c]"]
  node_snapmgr["GetTransactionSnapshot<br/>[snapmgr.c]"]
end

subgraph group_g6["Buffers &amp; Heap &#40;MVCC&#41;"]
  node_bufmgr["BufferAlloc<br/>[bufmgr.c]"]
  node_buftable["BufTableLookup<br/>[buf_table.c]"]
  node_freelist["StrategyGetBuffer<br/>[freelist.c]"]
  node_heapam["heap_insert / heapgettup<br/>[heapam.c]"]
  node_heapvis["HeapTupleSatisfiesMVCC"]
end

subgraph group_g7["WAL &amp; Recovery"]
  node_xloginsert["XLogInsert<br/>[xloginsert.c]"]
  node_xlog["CreateCheckPoint<br/>[xlog.c]"]
  node_recovery["ApplyWalRecord<br/>[xlogrecovery.c]"]
  node_clog["TransactionIdSetStatusBit<br/>[clog.c]"]
end

subgraph group_g8["Checkpoint &amp; Vacuum"]
  node_checkpointer["CheckpointerMain<br/>[checkpointer.c]"]
  node_autovac["AutoVacWorkerMain<br/>[autovacuum.c]"]
  node_vacuum["heap_vacuum_rel<br/>[vacuumlazy.c]"]
end

node_libpq -->|"startup packet"| node_postmaster
node_postmaster -->|"forks backend"| node_backend
node_postmaster -->|"launches workers"| node_autovac
node_backend -->|"raw SQL text"| node_pgparse
node_pgparse -->|"invoke grammar"| node_parser
node_parser -->|"raw parse tree"| node_analyzer
node_analyzer -->|"Query tree"| node_rewriter
node_rewriter -->|"rewritten Query"| node_planner
node_planner -->|"build access paths"| node_allpaths
node_allpaths -->|"join order search"| node_joinrels
node_joinrels -->|"cheapest Path"| node_createplan
node_createplan -->|"Plan tree"| node_execmain
node_execmain -->|"query snapshot"| node_snapmgr
node_snapmgr -->|"snapshot"| node_heapvis
node_execmain -->|"pull tuples"| node_execproc
node_execproc -->|"next tuple"| node_seqscan
node_execproc -->|"next tuple"| node_indexscan
node_execproc -->|"next tuple"| node_hashjoin
node_execproc -->|"grouped input"| node_aggnode
node_execproc -->|"ordered output"| node_sortnode
node_hashjoin -->|"build hash table"| node_hashbuild
node_seqscan -->|"heapgettup fetch"| node_heapam
node_indexscan -->|"heap tuple fetch"| node_heapam
node_heapam -->|"visibility check"| node_heapvis
node_heapvis -->|"commit status"| node_clog
node_heapam -->|"page access"| node_bufmgr
node_bufmgr -->|"tag lookup"| node_buftable
node_bufmgr -->|"victim buffer"| node_freelist
node_heapam -->|"WAL before change"| node_xloginsert
node_xloginsert -->|"records into WAL"| node_xlog
node_checkpointer -->|"checkpoint record"| node_xlog
node_xlog -->|"sync dirty pages"| node_bufmgr
node_xlog -->|"replay on restart"| node_recovery
node_autovac -->|"trigger vacuum"| node_vacuum
node_vacuum -->|"scan dead tuples"| node_heapam
node_vacuum -->|"WAL-logged cleanup"| node_xloginsert


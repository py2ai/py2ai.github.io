flowchart TD

subgraph group_g1["Client &amp; Supervisor"]
  node_libpq["libpq Client<br/>[fe-connect.c]"]
  node_postmaster["Postmaster<br/>[postmaster.c]"]
end

subgraph group_g2["Backend Session"]
  node_backend["Backend Process<br/>[postgres.c]"]
end

subgraph group_g3["SQL Compilers"]
  node_parser["Parser<br/>[parser.c]"]
  node_analyzer["Parse Analysis<br/>[analyze.c]"]
  node_rewriter["Rewriter<br/>[rewriteHandler.c]"]
  node_planner["Planner<br/>[planner.c]"]
  node_executor["Executor<br/>[execMain.c]"]
end

subgraph group_g4["Storage Engine"]
  node_bufmgr["Buffer Manager<br/>[bufmgr.c]"]
  node_heapam["Heap Access<br/>[heapam.c]"]
end

subgraph group_g5["Durability &#40;WAL&#41;"]
  node_xlog["WAL Insert<br/>[xloginsert.c]"]
  node_recovery["WAL Recovery<br/>[xlogrecovery.c]"]
end

node_libpq -->|"startup packet"| node_postmaster
node_postmaster -->|"forks one backend"| node_backend
node_backend -->|"SQL text"| node_parser
node_parser -->|"parse tree"| node_analyzer
node_analyzer -->|"Query tree"| node_rewriter
node_rewriter -->|"rewritten Query"| node_planner
node_planner -->|"PlannedStmt"| node_executor
node_executor -->|"tuple access"| node_heapam
node_executor -->|"page reads"| node_bufmgr
node_heapam -->|"heap pages"| node_bufmgr
node_heapam -->|"WAL record first"| node_xlog
node_bufmgr -->|"checkpoint flush"| node_xlog
node_xlog -->|"replay on restart"| node_recovery


node_hcl_parser -->|"ParseHCL / ParseJSON"| node_load_hcl_file
node_load_hcl_file -->|"decoded blocks"| node_load_config_dir
node_is_config_dir -->|"dir contains .tf"| node_load_config_dir
node_load_config_dir -->|"one Module per directory"| node_module_struct
node_module_struct -->|"root of module tree"| node_config_struct
node_config_struct -->|"request per module call"| node_module_walker
node_module_walker -->|"child module attached"| node_config_struct
node_config_struct -->|"resolve provider types"| node_finalize
node_config_struct -->|"desired-state input"| node_plan_builder
node_state -->|"prior-state input"| node_plan_builder
node_plan_builder -->|"operation-specific list"| node_steps
node_steps -->|"create config nodes"| node_cfg_transformer
node_steps -->|"add state instances"| node_state_transformer
node_steps -->|"analyze expressions"| node_ref_transformer
node_ref_transformer -->|"drop redundant edges"| node_trans_reduction
node_steps -->|"run in order"| node_basic_builder
node_basic_builder -->|"validated DAG"| node_graph_dag
node_apply_builder -->|"same runner, plan input"| node_basic_builder
node_graph_dag -->|"visit vertices in parallel"| node_walk
node_walk -->|"enter/exit + Execute"| node_walker_iface
node_walker_iface -->|"evaluation scopes"| node_eval_ctx
node_walk -->|"per-vertex DynamicExpand"| node_expand_res
node_expand_res -->|"shared resource logic"| node_abs_resource
node_state -->|"current + deposed objects"| node_state_transformer
node_state_transformer -->|"instances without config"| node_orphan_node
node_state -->|"Modules map lookup"| node_resource_instance
node_resource_instance -->|"current and deposed objects"| node_inst_obj_src
node_inst_obj_src -->|"serializable attributes"| node_statefile_read
node_state -->|"atomic operations"| node_sync_state
node_eval_ctx -->|"read/write during walk"| node_sync_state
node_walk -->|"configure provider + calls"| node_grpc_provider
node_expand_res -->|"PlanResourceChange requests"| node_grpc_provider
node_versioned_plugins -->|"protocol 5/6 plugin sets"| node_serve
node_handshake -->|"magic cookie gate"| node_serve
node_grpc_provider -->|"gRPC calls to plugin process"| node_serve
node_context_plan -->|"mode-specific build"| node_plan_builder
node_context_plan -->|"planWalk executes graph"| node_walk
node_context_plan -->|"choose normal/refresh/destroy"| node_plan_graph_modes
node_plan_graph_modes -->|"RefreshOnly sets skipPlanChanges"| node_plan_builder


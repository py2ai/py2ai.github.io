node_hcl_parser -->|"ParseHCL / ParseJSON"| node_load_config_dir
node_load_config_dir -->|"module calls resolved"| node_config_tree
node_config_tree -->|"config input"| node_context_plan
node_state -->|"prior state input"| node_context_plan
node_context_plan -->|"build plan graph"| node_plan_builder
node_plan_builder -->|"transformer steps + validate"| node_graph_dag
node_graph_dag -->|"visit vertices"| node_walk
node_walk -->|"DynamicExpand"| node_expand_resource
node_walk -->|"configure + call providers"| node_grpc_provider
node_grpc_provider -->|"proposed object diffs"| node_changes
node_expand_resource -->|"per-instance changes"| node_changes
node_changes -->|"assemble artifact"| node_plan_return
node_walk -->|"plan handed back"| node_plan_return


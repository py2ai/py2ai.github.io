{
  "owner": "envoyproxy",
  "repo": "envoy",
  "branch": "main",
  "groups": [
    { "id": "g1", "name": "bootstrap", "label": "Bootstrap & Entry" },
    { "id": "g2", "name": "server_core", "label": "Server Core & Config" },
    { "id": "g3", "name": "listeners", "label": "Listener Fabric" },
    { "id": "g4", "name": "hcm", "label": "HTTP Connection Manager" },
    { "id": "g5", "name": "router", "label": "L7 Router" },
    { "id": "g6", "name": "upstream", "label": "Cluster & Upstream" },
    { "id": "g7", "name": "xds", "label": "xDS Control Plane" },
    { "id": "g8", "name": "admin", "label": "Admin Surface" }
  ],
  "nodes": [
    { "id": "main_entry", "label": "main()", "file": "main.cc", "path": "source/exe/main.cc", "group": "Bootstrap & Entry", "groupId": "g1", "desc": "site-specific entry that delegates to MainCommon" },
    { "id": "main_common_run", "label": "MainCommonBase::run", "file": "main_common.cc", "path": "source/exe/main_common.cc", "group": "Bootstrap & Entry", "groupId": "g1", "desc": "dispatches on mode: serve, validate or init-only" },
    { "id": "server_run", "label": "InstanceBase::run", "file": "server.cc", "path": "source/server/server.cc", "group": "Bootstrap & Entry", "groupId": "g1", "desc": "RunHelper then the blocking main dispatch loop" },
    { "id": "start_workers", "label": "InstanceBase::startWorkers", "file": "server.cc", "path": "source/server/server.cc", "group": "Bootstrap & Entry", "groupId": "g1", "desc": "opens the gates: workers begin accepting traffic" },
    { "id": "config_init", "label": "MainImpl::initialize", "file": "configuration_impl.cc", "path": "source/server/configuration_impl.cc", "group": "Server Core & Config", "groupId": "g2", "desc": "parses bootstrap, builds cluster manager, tracers, watchdogs" },
    { "id": "xds_manager", "label": "XdsManagerImpl::initialize", "file": "xds_manager_impl.cc", "path": "source/common/config/xds_manager_impl.cc", "group": "Server Core & Config", "groupId": "g2", "desc": "sets up the mux and ADS connections from bootstrap" },
    { "id": "subscription_factory", "label": "SubscriptionFactoryImpl::subscriptionFromConfigSource", "file": "subscription_factory_impl.cc", "path": "source/common/config/subscription_factory_impl.cc", "group": "Server Core & Config", "groupId": "g2", "desc": "turns ConfigSource protos into gRPC/file subscriptions" },
    { "id": "admin_start", "label": "AdminImpl::startHttpListener", "file": "admin.cc", "path": "source/server/admin/admin.cc", "group": "Admin Surface", "groupId": "g8", "desc": "binds the local admin HTTP listener" },
    { "id": "listener_add", "label": "ListenerManagerImpl::addOrUpdateListener", "file": "listener_manager_impl.cc", "path": "source/common/listener_manager/listener_manager_impl.cc", "group": "Listener Fabric", "groupId": "g3", "desc": "draining-aware add/update of listener configs" },
    { "id": "listener_impl", "label": "ListenerImpl", "file": "listener_impl.cc", "path": "source/common/listener_manager/listener_impl.cc", "group": "Listener Fabric", "groupId": "g3", "desc": "resolves filters, per-connection sockets, socket options" },
    { "id": "filter_chain", "label": "ListenerImpl::createListenerFilterChain", "file": "listener_impl.cc", "path": "source/common/listener_manager/listener_impl.cc", "group": "Listener Fabric", "groupId": "g3", "desc": "instantiates network filters for a matched chain" },
    { "id": "lm_start_workers", "label": "ListenerManagerImpl::startWorkers", "file": "listener_manager_impl.cc", "path": "source/common/listener_manager/listener_manager_impl.cc", "group": "Listener Fabric", "groupId": "g3", "desc": "per-worker registration of active listeners" },
    { "id": "worker_add_listener", "label": "WorkerImpl::addListener", "file": "worker_impl.cc", "path": "source/server/worker_impl.cc", "group": "Listener Fabric", "groupId": "g3", "desc": "posts listener add onto the worker's own dispatcher" },
    { "id": "conn_handler_add", "label": "ConnectionHandlerImpl::addListener", "file": "connection_handler_impl.cc", "path": "source/common/listener_manager/connection_handler_impl.cc", "group": "Listener Fabric", "groupId": "g3", "desc": "creates the active listener entry on the worker" },
    { "id": "tcp_listener", "label": "TcpListenerImpl::onSocketEvent", "file": "tcp_listener_impl.cc", "path": "source/common/network/tcp_listener_impl.cc", "group": "Listener Fabric", "groupId": "g3", "desc": "evented accept callback wrapping each accepted socket" },
    { "id": "hcm_on_data", "label": "ConnectionManagerImpl::onData", "file": "conn_manager_impl.cc", "path": "source/common/http/conn_manager_impl.cc", "group": "HTTP Connection Manager", "groupId": "g4", "desc": "network filter callback: bytes in, codec parses" },
    { "id": "hcm_new_stream", "label": "ConnectionManagerImpl::newStream", "file": "conn_manager_impl.cc", "path": "source/common/http/conn_manager_impl.cc", "group": "HTTP Connection Manager", "groupId": "g4", "desc": "creates the per-request ActiveStream object" },
    { "id": "decode_headers", "label": "ActiveStream::decodeHeaders", "file": "conn_manager_impl.cc", "path": "source/common/http/conn_manager_impl.cc", "group": "HTTP Connection Manager", "groupId": "g4", "desc": "runs the decoder filter chain on request headers" },
    { "id": "decode_data", "label": "ActiveStream::decodeData", "file": "conn_manager_impl.cc", "path": "source/common/http/conn_manager_impl.cc", "group": "HTTP Connection Manager", "groupId": "g4", "desc": "streams request body through decoder filters" },
    { "id": "encode_headers", "label": "ActiveStream::encodeHeaders", "file": "conn_manager_impl.cc", "path": "source/common/http/conn_manager_impl.cc", "group": "HTTP Connection Manager", "groupId": "g4", "desc": "runs the encoder filter chain on response headers" },
    { "id": "encode_data", "label": "ActiveStream::encodeData", "file": "conn_manager_impl.cc", "path": "source/common/http/conn_manager_impl.cc", "group": "HTTP Connection Manager", "groupId": "g4", "desc": "streams response body through encoder filters" },
    { "id": "do_end_stream", "label": "ConnectionManagerImpl::doEndStream", "file": "conn_manager_impl.cc", "path": "source/common/http/conn_manager_impl.cc", "group": "HTTP Connection Manager", "groupId": "g4", "desc": "final cleanup, stats and deferred stream close" },
    { "id": "router_dec_hdr", "label": "Router::Filter::decodeHeaders", "file": "router.cc", "path": "source/common/router/router.cc", "group": "L7 Router", "groupId": "g5", "desc": "route match, cluster pick, request upstream pool" },
    { "id": "router_dec_data", "label": "Router::Filter::decodeData", "file": "router.cc", "path": "source/common/router/router.cc", "group": "L7 Router", "groupId": "g5", "desc": "forwards body chunks and per-try timeouts" },
    { "id": "router_up_hdr", "label": "Router::Filter::onUpstreamHeaders", "file": "router.cc", "path": "source/common/router/router.cc", "group": "L7 Router", "groupId": "g5", "desc": "evaluates retries, redirects, then returns response" },
    { "id": "router_up_data", "label": "Router::Filter::onUpstreamData", "file": "router.cc", "path": "source/common/router/router.cc", "group": "L7 Router", "groupId": "g5", "desc": "relays upstream body back down the filter chain" },
    { "id": "cluster_mgr", "label": "ClusterManagerImpl", "file": "cluster_manager_impl.cc", "path": "source/common/upstream/cluster_manager_impl.cc", "group": "Cluster & Upstream", "groupId": "g6", "desc": "owns clusters, TLS thread-local state and pools" },
    { "id": "choose_host", "label": "ClusterEntry::chooseHost", "file": "cluster_manager_impl.cc", "path": "source/common/upstream/cluster_manager_impl.cc", "group": "Cluster & Upstream", "groupId": "g6", "desc": "load balancer picks a healthy upstream host" },
    { "id": "http_conn_pool", "label": "ClusterEntry::httpConnPool", "file": "cluster_manager_impl.cc", "path": "source/common/upstream/cluster_manager_impl.cc", "group": "Cluster & Upstream", "groupId": "g6", "desc": "per-host HTTP connection pool (HTTP/1, 2, 3)" },
    { "id": "update_hosts", "label": "ClusterEntry::updateHosts", "file": "cluster_manager_impl.cc", "path": "source/common/upstream/cluster_manager_impl.cc", "group": "Cluster & Upstream", "groupId": "g6", "desc": "thread-local membership updates and pool draining" },
    { "id": "host_create_conn", "label": "HostImplBase::createConnection", "file": "upstream_impl.cc", "path": "source/common/upstream/upstream_impl.cc", "group": "Cluster & Upstream", "groupId": "g6", "desc": "opens and configures the TCP connection to the host" },
    { "id": "xds_add_watch", "label": "GrpcMuxImpl::addWatch", "file": "grpc_mux_impl.cc", "path": "source/extensions/config_subscription/grpc/xds_mux/grpc_mux_impl.cc", "group": "xDS Control Plane", "groupId": "g7", "desc": "registers interest in a resource type on the mux" },
    { "id": "xds_send_req", "label": "GrpcMuxImpl::trySendDiscoveryRequests", "file": "grpc_mux_impl.cc", "path": "source/extensions/config_subscription/grpc/xds_mux/grpc_mux_impl.cc", "group": "xDS Control Plane", "groupId": "g7", "desc": "flushes pending DiscoveryRequests per type URL" },
    { "id": "xds_handle_resp", "label": "GrpcMuxImpl::genericHandleResponse", "file": "grpc_mux_impl.cc", "path": "source/extensions/config_subscription/grpc/xds_mux/grpc_mux_impl.cc", "group": "xDS Control Plane", "groupId": "g7", "desc": "routes DiscoveryResponses to matching watches" }
  ],
  "edges": [
    { "from": "main_entry", "to": "main_common_run", "label": "calls" },
    { "from": "main_common_run", "to": "server_run", "label": "serves" },
    { "from": "server_run", "to": "config_init", "label": "loads bootstrap" },
    { "from": "config_init", "to": "cluster_mgr", "label": "builds clusters" },
    { "from": "config_init", "to": "xds_manager", "label": "initializes xDS" },
    { "from": "xds_manager", "to": "subscription_factory", "label": "creates subscriptions" },
    { "from": "subscription_factory", "to": "xds_add_watch", "label": "mux watches" },
    { "from": "xds_add_watch", "to": "xds_send_req", "label": "queues request" },
    { "from": "xds_handle_resp", "to": "xds_send_req", "label": "acks and re-requests" },
    { "from": "xds_handle_resp", "to": "listener_add", "label": "LDS config" },
    { "from": "xds_handle_resp", "to": "cluster_mgr", "label": "CDS config" },
    { "from": "listener_add", "to": "listener_impl", "label": "instantiates" },
    { "from": "listener_impl", "to": "filter_chain", "label": "builds chains" },
    { "from": "server_run", "to": "start_workers", "label": "after CDS init" },
    { "from": "start_workers", "to": "lm_start_workers", "label": "starts" },
    { "from": "lm_start_workers", "to": "worker_add_listener", "label": "hands listeners" },
    { "from": "worker_add_listener", "to": "conn_handler_add", "label": "registers" },
    { "from": "conn_handler_add", "to": "tcp_listener", "label": "creates acceptor" },
    { "from": "tcp_listener", "to": "filter_chain", "label": "onAccept match" },
    { "from": "filter_chain", "to": "hcm_on_data", "label": "HCM as network filter" },
    { "from": "hcm_on_data", "to": "hcm_new_stream", "label": "parses stream" },
    { "from": "hcm_new_stream", "to": "decode_headers", "label": "invokes" },
    { "from": "hcm_on_data", "to": "decode_data", "label": "body chunks" },
    { "from": "decode_headers", "to": "router_dec_hdr", "label": "next filter" },
    { "from": "decode_data", "to": "router_dec_data", "label": "next filter" },
    { "from": "router_dec_hdr", "to": "choose_host", "label": "selects host" },
    { "from": "cluster_mgr", "to": "choose_host", "label": "serves pools" },
    { "from": "choose_host", "to": "http_conn_pool", "label": "allocates pool" },
    { "from": "update_hosts", "to": "http_conn_pool", "label": "refreshes pools" },
    { "from": "http_conn_pool", "to": "host_create_conn", "label": "dials host" },
    { "from": "host_create_conn", "to": "router_up_hdr", "label": "response arrives" },
    { "from": "router_up_hdr", "to": "encode_headers", "label": "returns headers" },
    { "from": "router_up_data", "to": "encode_data", "label": "returns body" },
    { "from": "encode_headers", "to": "do_end_stream", "label": "may complete" },
    { "from": "encode_data", "to": "do_end_stream", "label": "completes" },
    { "from": "server_run", "to": "admin_start", "label": "starts admin" }
  ]
}

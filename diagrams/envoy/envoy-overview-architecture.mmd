  node_listener_mgr["ListenerManagerImpl::startWorkers"]
  node_tcp_listener["TcpListenerImpl::onSocketEvent"]
end

subgraph group_g4["HTTP Connection Manager"]
  node_hcm_on_data["ConnectionManagerImpl::onData"]
  node_hcm_new_stream["ConnectionManagerImpl::newStream"]
end

subgraph group_g5["L7 Router"]
  node_router_decode["Router::Filter::decodeHeaders<br/>[router.cc]"]

  node_admin_start["AdminImpl::startHttpListener<br/>[admin.cc]"]
end

node_main_entry -->|"boots"| node_server_run
node_server_run -->|"pulls config over xDS"| node_xds_mux
node_server_run -->|"starts admin listener"| node_admin_start
node_server_run -->|"after clusters init"| node_start_workers
node_xds_mux -->|"LDS updates"| node_listener_mgr
node_xds_mux -->|"CDS updates"| node_cluster_mgr
node_start_workers -->|"spawns listeners"| node_listener_mgr
node_listener_mgr -->|"installs acceptors"| node_tcp_listener
node_tcp_listener -->|"accept, run filter chain"| node_hcm_on_data
node_hcm_on_data -->|"parses HTTP"| node_hcm_new_stream
node_hcm_new_stream -->|"runs filter chain"| node_router_decode
node_router_decode -->|"requests conn pool"| node_cluster_mgr
node_cluster_mgr -->|"dials chosen host"| node_host_conn
node_host_conn -->|"returns response"| node_router_decode


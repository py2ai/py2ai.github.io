node_main_entry -->|"calls"| node_main_common_run
node_main_common_run -->|"serves"| node_server_run
node_server_run -->|"loads bootstrap"| node_config_init
node_config_init -->|"builds clusters"| node_cluster_mgr
node_config_init -->|"initializes xDS"| node_xds_manager
node_xds_manager -->|"creates subscriptions"| node_subscription_factory
node_subscription_factory -->|"mux watches"| node_xds_add_watch
node_xds_add_watch -->|"queues request"| node_xds_send_req
node_xds_handle_resp -->|"acks and re-requests"| node_xds_send_req
node_xds_handle_resp -->|"LDS config"| node_listener_add
node_xds_handle_resp -->|"CDS config"| node_cluster_mgr
node_listener_add -->|"instantiates"| node_listener_impl
node_listener_impl -->|"builds chains"| node_filter_chain
node_server_run -->|"after CDS init"| node_start_workers
node_start_workers -->|"starts"| node_lm_start_workers
node_lm_start_workers -->|"hands listeners"| node_worker_add_listener
node_worker_add_listener -->|"registers"| node_conn_handler_add
node_conn_handler_add -->|"creates acceptor"| node_tcp_listener
node_tcp_listener -->|"onAccept match"| node_filter_chain
node_filter_chain -->|"HCM as network filter"| node_hcm_on_data
node_hcm_on_data -->|"parses stream"| node_hcm_new_stream
node_hcm_new_stream -->|"invokes"| node_decode_headers
node_hcm_on_data -->|"body chunks"| node_decode_data
node_decode_headers -->|"next filter"| node_router_dec_hdr
node_decode_data -->|"next filter"| node_router_dec_data
node_router_dec_hdr -->|"selects host"| node_choose_host
node_cluster_mgr -->|"serves pools"| node_choose_host
node_choose_host -->|"allocates pool"| node_http_conn_pool
node_update_hosts -->|"refreshes pools"| node_http_conn_pool
node_http_conn_pool -->|"dials host"| node_host_create_conn
node_host_create_conn -->|"response arrives"| node_router_up_hdr
node_router_up_hdr -->|"returns headers"| node_encode_headers
node_router_up_data -->|"returns body"| node_encode_data
node_encode_headers -->|"may complete"| node_do_end_stream
node_encode_data -->|"completes"| node_do_end_stream
node_server_run -->|"starts admin"| node_admin_start


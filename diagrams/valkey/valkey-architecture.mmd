node_main_loop -->|"initServer, then enter aeMain"| node_event_loop
node_event_loop -.->|"timed callback"| node_server_cron
node_event_loop -->|"before each poll"| node_before_sleep
node_before_sleep -->|"harvest IO jobs"| node_io_responses
node_before_sleep -.->|"fsync AOF buffers"| node_aof_flush
node_before_sleep -.->|"hand sockets to workers"| node_io_read
node_read_query -->|"parsed RESP command"| node_process_cmd
node_process_cmd -->|"SET GET INCR"| node_set_cmd
node_process_cmd -->|"HSET HMGET"| node_hset_cmd
node_process_cmd -->|"ZADD ZRANGE"| node_zadd_cmd
node_process_cmd -->|"PHSET PHGET"| node_phset_cmd
node_set_cmd -->|"resolve or add key"| node_lookup_key
node_hset_cmd -->|"resolve or add key"| node_lookup_key
node_zadd_cmd -->|"resolve or add key"| node_lookup_key
node_phset_cmd -->|"resolve or add key"| node_lookup_key
node_lookup_key -->|"per-DB hashtable ops"| node_hashtable_core
node_hashtable_core -->|"logical DB containers"| node_kvstore_mgmt
node_server_cron -.->|"incremental expiry"| node_expire_cycle
node_server_cron -.->|"enforce maxmemory"| node_evictions
node_process_cmd -->|"BGSAVE"| node_rdb_save
node_rdb_save -.->|"thread-based alternative"| node_forkless_save
node_main_loop -.->|"restore dataset on boot"| node_rdb_load
node_aof_flush -.->|"background fsync jobs"| node_bio_jobs
node_rdb_load -->|"dbAddRDBLoad insertions"| node_lookup_key
node_check_rdb -.->|"validate snapshot files"| node_rdb_save
node_process_cmd -->|"SYNC / PSYNC"| node_sync_cmd
node_sync_cmd -->|"snapshot for replica"| node_rdb_save
node_sync_cmd -->|"replica offers dual-channel"| node_dual_channel
node_dual_channel -->|"RDB flows over second link"| node_rdb_load
node_process_cmd -->|"replicate write commands"| node_repl_feed
node_before_sleep -->|"flush pending replies"| node_write_client
node_server_cron -.->|"link upkeep"| node_repl_cron
node_process_cmd -->|"CLUSTER subcommands"| node_cluster_cmd
node_server_cron -.->|"gossip and failover"| node_cluster_cron
node_cluster_cron -->|"drive import/export jobs"| node_slot_migration
node_slot_stats -->|"CLUSTER SLOT-STATS"| node_cluster_cmd
node_main_loop -->|"start IO workers"| node_io_threads_init
node_io_threads_init -->|"queue read jobs"| node_io_read
node_io_threads_init -->|"queue write jobs"| node_io_write
node_io_read -.->|"completed reads applied"| node_read_query
node_io_write -.->|"completed writes applied"| node_write_client


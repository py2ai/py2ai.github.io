node_main_loop -->|"boots server, enters aeMain"| node_event_loop
node_main_loop -.->|"initIOThreads at startup"| node_io_threads
node_main_loop -.->|"restore dataset on boot"| node_rdb
node_event_loop -->|"fires on readable sockets"| node_client_io
node_client_io -.->|"read/write offload to workers"| node_io_threads
node_client_io -->|"parsed RESP command"| node_process_cmd
node_process_cmd -->|"SET GET INCR"| node_strings
node_process_cmd -->|"ZADD ZRANGE"| node_zsets
node_process_cmd -->|"PHSET PHGET"| node_path_hash
node_strings -->|"read or write keys"| node_kvstore
node_zsets -->|"read or write keys"| node_kvstore
node_path_hash -->|"read or write keys"| node_kvstore
node_process_cmd -->|"BGSAVE"| node_rdb
node_process_cmd -->|"write commands appended"| node_aof
node_event_loop -.->|"beforeSleep fsync"| node_aof
node_process_cmd -->|"SYNC / PSYNC"| node_replication
node_replication -.->|"dual-channel RDB sync"| node_rdb


node_assets -.->|"tiktoken vocabularies"| node_tokenizer
node_audio -->|"30-second mel windows"| node_transcribe
node_transcribe -->|"runs each window"| node_whisper
node_transcribe -->|"creates decoding tasks"| node_decoding
node_decoding -->|"drives token by token"| node_whisper
node_whisper -->|"contains"| node_encoder
node_whisper -->|"contains"| node_decoder
node_tokenizer -->|"special tokens"| node_decoding
node_tokenizer -->|"task tokens"| node_transcribe
node_transcribe -->|"adds word timestamps"| node_timing
node_timing -.->|"reads cross-attention"| node_decoder
node_transcribe -.->|"writes subtitles and json"| node_utils


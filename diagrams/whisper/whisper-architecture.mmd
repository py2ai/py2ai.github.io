node_load_model -->|"instantiates with dims"| node_whisper_cls
node_model_dims -->|"sizes every layer"| node_whisper_cls
node_transcribe_fn -->|"loads and windows"| node_audio
node_mel_filters -.->|"supplies filterbank"| node_audio
node_audio -->|"mel spectrograms in"| node_encoder
node_encoder -->|"stacks"| node_rab
node_decoder -->|"stacks"| node_rab
node_rab -->|"uses"| node_mha
node_whisper_cls -->|"owns"| node_encoder
node_whisper_cls -->|"owns"| node_decoder
node_transcribe_fn -->|"decode per window"| node_decoding
node_decoding -->|"orchestrated by"| node_decoding_task
node_decoding_task -->|"queries logits"| node_inference
node_inference -->|"forward pass"| node_whisper_cls
node_decoding_task -->|"or"| node_greedy
node_decoding_task -->|"or"| node_beam
node_ranker -->|"picks final text"| node_decoding_task
node_logit_filters -->|"constrains steps"| node_decoding_task
node_apply_timestamp_rules -->|"member"| node_logit_filters
node_tokenizer -->|"wraps"| node_encodings
node_tokenizer -->|"special tokens"| node_decoding
node_detect_language -.->|"exported from"| node_decoding
node_transcribe_fn -->|"word_timestamps option"| node_timing
node_timing -->|"aligns via"| node_dtw
node_dtw -.->|"GPU kernels"| node_triton
node_find_alignment -->|"calls"| node_dtw
node_find_alignment -->|"produces"| node_word_timing
node_transcribe_fn -->|"task and language tokens"| node_tokenizer
node_transcribe_fn -.->|"output_format switch"| node_utils
node_cli -.->|"writes files"| node_utils
node_normalizers -.->|"available for scoring"| node_cli


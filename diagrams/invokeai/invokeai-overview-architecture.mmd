flowchart TD

subgraph group_frontend["React Frontend"]
  node_webapp{{"React web app<br/>entry"}}
end

subgraph group_api["API Layer"]
  node_api_app{{"API app<br/>core"}}
  node_routers["REST routers"]
end

subgraph group_graph["Graph Execution Engine"]
  node_session_queue["session queue"]
  node_session_processor{{"session processor<br/>core"}}
  node_baseinvocation{{"base invocation<br/>core"}}
end

subgraph group_nodes["Invocation Library"]
  node_invocations[("invocation library<br/>database")]
  node_denoise["denoise latents<br/>[denoise_latents.py]"]
  node_flux_inv["flux nodes<br/>[flux_denoise.py]"]
end

subgraph group_backend["Model Backend"]
  node_model_manager[("model manager<br/>database")]
  node_quantization["quantization"]
  node_services["platform services"]
end

node_webapp -->|"calls"| node_api_app
node_api_app -->|"exposes"| node_routers
node_routers -->|"enqueues into"| node_session_queue
node_session_queue -->|"feeds"| node_session_processor
node_session_processor -->|"executes"| node_invocations
node_invocations -.->|"extend"| node_baseinvocation
node_invocations -->|"include"| node_denoise
node_invocations -->|"include"| node_flux_inv
node_denoise -->|"loads models via"| node_model_manager
node_model_manager -.->|"compresses with"| node_quantization
node_api_app -->|"serves through"| node_services
node_services -.->|"state streamed to"| node_webapp


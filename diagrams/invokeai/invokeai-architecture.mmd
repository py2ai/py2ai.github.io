node_webapp -.->|"organized into"| node_features
node_workbench -.->|"built on"| node_features
node_webapp -->|"calls"| node_api_app
node_api_app -->|"mounts"| node_routers
node_api_app -->|"streams via"| node_sockets
node_routers -.->|"inject services via"| node_api_deps
node_routers -->|"enqueue"| node_session_queue
node_session_queue -->|"next session to"| node_session_processor
node_session_processor -->|"executes subclasses of"| node_baseinvocation
node_session_processor -->|"instantiates from"| node_invocations
node_batch -.->|"expands into"| node_session_queue
node_fields -.->|"type"| node_baseinvocation
node_primitives -.->|"seed graphs with"| node_invocations
node_invocations -->|"include"| node_denoise
node_invocations -->|"include"| node_flux_inv
node_invocations -->|"include"| node_sd3_inv
node_invocations -->|"include"| node_wan_inv
node_invocations -->|"include"| node_controlnet
node_invocations -->|"include"| node_upscale
node_invocations -->|"include"| node_prompt
node_denoise -->|"resolves models via"| node_model_manager
node_flux_inv -->|"runs through"| node_flux_backend
node_sd3_inv -.->|"runs through"| node_sd_backend
node_model_manager -->|"loads via"| node_model_load
node_model_load -->|"caches in"| node_model_cache
node_model_load -.->|"quantizes with"| node_quantization
node_flux_backend -.->|"applies"| node_patches
node_api_app -->|"wires"| node_services
node_services -->|"includes"| node_gallery
node_services -->|"includes"| node_events
node_services -->|"includes"| node_download
node_services -->|"includes"| node_images
node_services -.->|"builds on"| node_shared
node_events -->|"publish to"| node_sockets
node_session_processor -.->|"reports progress"| node_events
node_images -.->|"populate"| node_gallery


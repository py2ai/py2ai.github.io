node_fetch -->|"make_reader&#40;&#41; read path"| node_disk_log
node_raft_group_manager -->|"drives elections + heartbeats"| node_consensus
node_consensus -->|"become_leader&#40;&#41; election"| node_vote_stm
node_consensus -->|"leader coalescing"| node_replicate_batcher
node_consensus -->|"per-follower round"| node_replicate_entries_stm
node_consensus -->|"match index tracking"| node_follower_states
node_consensus -->|"catch up lagging follower"| node_recovery_stm
node_consensus -->|"batched heartbeats"| node_heartbeat_manager
node_replicate_batcher -->|"dispatch batched entries"| node_replicate_entries_stm
node_replicate_entries_stm -->|"follower enqueues append_entries"| node_append_entries_buffer
node_consensus -->|"append to partition log"| node_storage_api
node_storage_api -->|"owns log manager"| node_log_manager
node_log_manager -->|"manage&#40;ntp&#41;"| node_disk_log
node_log_manager -->|"shared reader reuse"| node_readers_cache
node_disk_log -->|"ordered segments"| node_segment_set

node_segment -->|"append&#40;record_batch&#41;"| node_segment_appender
node_disk_log -->|"hot batch reads"| node_batch_cache
node_disk_log -->|"kafka offset mapping"| node_offset_translator
node_disk_log -->|"clean offset bookkeeping"| node_kvstore
node_disk_log -->|"compaction index build"| node_compacted_index


node_kafka_server -->|"one connection_context per client socket"| node_conn_ctx
node_conn_ctx -->|"handler_for_key&#40;api_key&#41; dispatch"| node_handlers
node_handlers -->|"key 0"| node_produce
node_handlers -->|"key 1"| node_fetch
node_produce -->|"acks=-1/1/0 maps to quorum/leader/no ack"| node_consensus
node_fetch -->|"make_reader&#40;&#41; from fetched offsets"| node_disk_log
node_group_manager -->|"heartbeats drive elections"| node_consensus
node_consensus -->|"leader batches concurrent writes"| node_replicate_batcher
node_consensus -->|"append committed entries"| node_log_manager
node_log_manager -->|"manage&#40;ntp&#41; opens the log"| node_disk_log
node_disk_log -->|"sequential segment writes"| node_segment_appender


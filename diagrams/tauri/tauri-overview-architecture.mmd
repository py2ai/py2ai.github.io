node_app_builder -->|"produces App + handle"| node_app_handle
node_app_builder -->|"builds AppManager"| node_manager
node_manager -->|"stores per-run key"| node_invoke_key
node_invoke_key -->|"key verified per call"| node_handle_ipc
node_app_builder -->|"registers tauri+ipc schemes"| node_ipc_scheme
node_ipc_scheme -->|"forwards POST body"| node_handle_ipc
node_handle_ipc -->|"constructs Invoke"| node_invoke_types
node_invoke_types -->|"resolve_access gate"| node_authority
node_authority -->|"consumes resolved ACL"| node_acl_resolved
node_manager -->|"Mutex&lt;RuntimeAuthority&gt;"| node_authority
node_handle_ipc -->|"fetch queued data"| node_channel
node_invoke_types -->|"streams progress"| node_channel
node_manager -->|"calls Runtime API"| node_runtime_trait
node_runtime_trait -->|"default impl"| node_wry_impl
node_wry_impl -->|"with_ipc_handler"| node_ipc_scheme


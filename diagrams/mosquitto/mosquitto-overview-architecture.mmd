flowchart TD

subgraph group_loop["Event Loop"]
  node_main_loop["mosquitto_main_loop&#40;&#41;<br/>[loop.c]"]
  node_mux["mux__handle&#40;&#41;<br/>[mux.c]"]
  node_accept["net__socket_accept&#40;&#41;<br/>[net.c]"]
end

subgraph group_protocol["MQTT Protocol"]
  node_dispatch["handle__packet&#40;&#41;<br/>[read_handle.c]"]
  node_handle_connect["handle__connect&#40;&#41;<br/>[handle_connect.c]"]
  node_handle_publish["handle__publish&#40;&#41;<br/>[handle_publish.c]"]
  node_handle_subscribe["handle__subscribe&#40;&#41;<br/>[handle_subscribe.c]"]
end

subgraph group_routing["Pub/Sub Routing"]
  node_subs_tree["sub__messages_queue&#40;&#41;<br/>[subs.c]"]
  node_retain_tree["retain__store&#40;&#41;<br/>[retain.c]"]
end

subgraph group_storage["Persistence"]
  node_msg_store["db__message_store&#40;&#41;<br/>[database.c]"]
  node_persist["persist__backup&#40;&#41;<br/>[persist_write.c]"]
end

subgraph group_auth["Auth &amp; Plugins"]
  node_plugins["mosquitto_callback_register&#40;&#41;<br/>[plugin_callbacks.c]"]
end

node_main_loop -->|"each tick"| node_mux
node_mux -->|"EPOLLIN on listener"| node_accept
node_mux -->|"EPOLLIN on client, packet__read"| node_dispatch
node_dispatch -->|"CMD_CONNECT"| node_handle_connect
node_dispatch -->|"CMD_PUBLISH"| node_handle_publish
node_dispatch -->|"CMD_SUBSCRIBE"| node_handle_subscribe
node_handle_connect -->|"MOSQ_EVT_BASIC_AUTH"| node_plugins
node_handle_publish -->|"MOSQ_EVT_MESSAGE_IN"| node_plugins
node_handle_publish -->|"db__message_store"| node_msg_store
node_msg_store -->|"sub__messages_queue"| node_subs_tree
node_handle_subscribe -->|"sub__add leaf"| node_subs_tree
node_handle_subscribe -->|"replay via retain__queue"| node_retain_tree
node_handle_publish -->|"retain flag: retain__store"| node_retain_tree
node_subs_tree -->|"queued PUBLISH writes"| node_mux
node_main_loop -->|"autosave interval"| node_persist
node_persist -->|"restore at boot"| node_msg_store


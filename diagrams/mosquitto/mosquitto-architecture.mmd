node_main -->|"after db__open + listeners"| node_main_loop
node_main_loop -->|"block on I/O"| node_mux
node_mux -->|"vtable: epoll on Linux"| node_mux_epoll
node_mux_epoll -->|"listener EPOLLIN"| node_accept
node_mux_epoll -->|"client EPOLLIN"| node_packet_read
node_accept -->|"new context reads CONNECT"| node_dispatch
node_main_loop -->|"every tick"| node_keepalive
node_main_loop -->|"every tick"| node_session_expiry
node_dispatch -->|"CMD_CONNECT"| node_handle_connect
node_dispatch -->|"CMD_PUBLISH"| node_handle_publish
node_dispatch -->|"CMD_SUBSCRIBE"| node_handle_subscribe
node_dispatch -->|"CMD_AUTH"| node_handle_auth
node_handle_connect -->|"MOSQ_EVT_BASIC_AUTH"| node_callback_register
node_handle_auth -->|"MOSQ_EVT_EXTENDED_AUTH"| node_callback_register
node_handle_publish -->|"db__message_store"| node_msg_store
node_msg_store -->|"ref-counted record"| node_base_msg
node_msg_store -->|"QoS 2 incoming"| node_msg_insert_in
node_accepted_publish -->|"per QoS level"| node_sub_queue
node_sub_queue -->|"leaf match"| node_subs_process
node_sub_queue -->|"$share group"| node_shared_subs
node_subs_process -->|"queue per client"| node_msg_insert_out
node_msg_insert_out -->|"schedule PUBLISH write"| node_mux
node_handle_subscribe -->|"insert leaf"| node_sub_add
node_handle_subscribe -->|"replay retained"| node_retain_queue
node_retain_queue -->|"reads stored messages"| node_retain_store
node_handle_publish -->|"retain flag"| node_retain_store
node_sub_add -->|"tree lookup later"| node_sub_queue
node_main_loop -->|"autosave_interval"| node_persist_backup
node_persist_restore -->|"rebuild at boot"| node_msg_store
node_persist_restore -->|"re-arm expiring sessions"| node_session_expiry
node_password_file -->|"MOSQ_EVT_BASIC_AUTH"| node_callback_register
node_dynsec -->|"auth + ACL + control events"| node_callback_register
node_dynsec -->|"$CONTROL dynamic-security"| node_dynsec_cmd
node_dynsec_cmd -->|"reply messages"| node_broker_publish
node_callback_register -->|"MOSQ_EVT_MESSAGE_IN"| node_handle_publish
node_mosquitto_new -->|"then mosquitto_connect&#40;&#41;"| node_client_loop
node_client_loop -->|"readable socket"| node_packet_read
node_client_loop -->|"complete packet"| node_client_dispatch
node_packet_read -->|"dispatch per type"| node_client_dispatch


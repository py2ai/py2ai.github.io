node_kafka_producer -->|"doSend&#40;&#41; appends to partition batch"| node_record_accumulator
node_record_accumulator -->|"tryAppend&#40;&#41; fills batches"| node_producer_batch
node_record_accumulator -->|"drain&#40;&#41; ready batches"| node_sender
node_sender -->|"sendProduceRequest&#40;&#41;"| node_network_client
node_network_client -->|"ProduceRequest over the wire"| node_socket_server
node_kafka_consumer -->|"delegates &#40;classic protocol&#41;"| node_classic_consumer
node_kafka_consumer -->|"delegates &#40;KIP-848 protocol&#41;"| node_async_consumer
node_classic_consumer -->|"collectFetch&#40;&#41;"| node_fetch_collector
node_async_consumer -->|"collectFetch&#40;&#41;"| node_fetch_collector
node_classic_consumer -->|"send&#40;&#41; fetch &amp; commit"| node_consumer_network_client
node_async_consumer -->|"background fetchers"| node_consumer_network_client
node_consumer_network_client -.->|"shared I/O layer"| node_network_client
node_network_client -.->|"FetchRequest"| node_socket_server
node_socket_server -->|"enqueue request"| node_request_channel
node_request_channel -->|"bounded queue"| node_request_handler
node_handler_pool -->|"num.io.threads workers"| node_request_handler
node_request_handler -->|"apis.handle&#40;&#41;"| node_kafka_apis
node_kafka_apis -->|"produce / fetch paths"| node_replica_manager
node_replica_manager -->|"per-partition leader state"| node_partition
node_partition -.->|"ISR &amp; acks check"| node_replica_manager
node_replica_manager -->|"broker wires log dirs"| node_log_manager_scala
node_log_manager_scala -->|"builds Java LogManager"| node_log_manager
node_log_manager -->|"retention &amp; segment knobs"| node_log_config
node_log_manager -->|"getOrCreateLog&#40;&#41;"| node_unified_log
node_unified_log -->|"delegates local appends"| node_local_log
node_unified_log -->|"idempotence &amp; txn state"| node_producer_state_manager
node_local_log -->|"active segment append"| node_log_segment
node_unified_log -->|"maybeRoll&#40;&#41; new segment"| node_log_segment
node_log_segment -->|"append&#40;&#41; to mmap file"| node_file_records
node_log_segment -->|"index first entry"| node_offset_index
node_log_segment -->|"maybeAppend&#40;&#41; timestamps"| node_time_index
node_kafka_apis -->|"JoinGroup / SyncGroup"| node_group_coordinator_service
node_group_coordinator_service -->|"route to partition shard"| node_group_coordinator_shard
node_group_coordinator_shard -->|"commitOffset&#40;&#41;"| node_offset_metadata_manager
node_group_coordinator_service -.->|"assignment &amp; heartbeats"| node_kafka_consumer


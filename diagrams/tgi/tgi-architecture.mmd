  node_watermark["Watermark<br/>Green-list logits bias"]
  node_hub["Hub Utils<br/>Model metadata"]
end

node_launcher_main -->|"detect runtime flags"| node_env_runtime
node_launcher_main -->|"spawn router process"| node_router_server
node_launcher_main -->|"spawn one shard per GPU"| node_shard_server
node_router_server -.->|"read runtime settings"| node_config
node_router_server -->|"route chat traffic"| node_chat
node_chat -->|"render templates"| node_chat_template
node_chat -.->|"build tool grammars"| node_tool_grammar
node_router_server -->|"gate every request"| node_validation
node_validation -->|"hand off validated work"| node_infer_mod
node_router_server -->|"generate and stream routes"| node_infer_mod
node_router_server -.->|"structured logs"| node_logging
node_infer_mod -->|"batched RPC calls"| node_proto
node_proto -.->|"same contract for alt engines"| node_backend_client
node_proto -->|"serve Shard service"| node_shard_server
node_shard_server -->|"decode protobuf to dataclasses"| node_types
node_shard_server -->|"dispatch to model kind"| node_model_base
node_model_base -.->|"vanilla attention path"| node_causal_lm
node_model_base -.->|"encoder-decoder path"| node_seq2seq
node_model_base -.->|"state-space path"| node_mamba
node_model_base -.->|"vision-language path"| node_vlm
node_flash_causal_lm -->|"implements the ABC"| node_model_base
node_flash_causal_lm -->|"allocate and free pages"| node_kv_cache
node_flash_causal_lm -->|"prefill and decode kernels"| node_attn_cuda
node_flash_causal_lm -.->|"selectable backend"| node_flashinfer
node_flash_causal_lm -.->|"speculative heads"| node_medusa
node_shard_server -->|"materialize checkpoints"| node_weights
node_shard_server -.->|"resolve files and revisions"| node_hub
node_weights -->|"fill quant-aware layers"| node_linear
node_weights -.->|"FP8 requantization"| node_fp8
node_linear -->|"split across GPUs"| node_tensor_parallel
node_linear -.->|"attach adapter deltas"| node_lora
node_adapter -.->|"resolve adapter weights"| node_lora
node_flash_causal_lm -->|"warp logits before sampling"| node_logits_process
node_logits_process -.->|"optional watermark bias"| node_watermark


node_launcher -->|"spawn and supervise"| node_router
node_launcher -->|"one Python shard per GPU"| node_shard
node_router -->|"mount chat routes"| node_chat_completions
node_router -->|"admission checks"| node_validation
node_router -->|"enqueue requests"| node_infer
node_infer -->|"batched token streams"| node_grpc_proto
node_grpc_proto -->|"dispatch to GPU process"| node_shard
node_shard -->|"route per model kind"| node_flash_causal_lm
node_flash_causal_lm -->|"allocate cache pages"| node_kv_cache
node_flash_causal_lm -->|"prefill and decode calls"| node_attn_kernels
node_shard -->|"load checkpoint shards"| node_weights
node_router -.->|"alternative engines opt-in"| node_backends


node_main -->|"runs the event loop"| node_ae_loop
node_main -->|"registers timer callback"| node_server_cron
node_main -->|"restore RDB at startup"| node_rdb_load
node_ae_loop -->|"one loop iteration"| node_ae_events
node_ae_events -->|"readable socket"| node_read_client
node_ae_events -->|"writable socket"| node_write_client
node_read_client -->|"query buffer grows"| node_parse_input
node_parse_input -->|"execute ready command"| node_dispatch
node_dispatch -->|"SET"| node_set_cmd
node_dispatch -->|"GET"| node_get_cmd
node_dispatch -->|"HSET"| node_hset_cmd
node_dispatch -->|"HGET"| node_hget_cmd
node_dispatch -->|"HGETALL"| node_hgetall_cmd
node_dispatch -->|"ZADD"| node_zadd_gen
node_dispatch -->|"ZRANGE"| node_zrange_gen
node_dispatch -->|"ZRANK"| node_zrank_gen
node_dispatch -->|"LPUSH"| node_lpush_cmd
node_dispatch -->|"BLPOP"| node_blpop_cmd
node_dispatch -->|"BGSAVE"| node_rdb_save
node_dispatch -->|"SYNC / PSYNC"| node_sync_cmd
node_propagate -->|"write command to log"| node_aof_feed
node_propagate -->|"replication stream"| node_feed_slaves
node_before_sleep -->|"flush each cycle"| node_aof_flush
node_before_sleep -->|"pending replies"| node_write_client
node_aof_feed -->|"buffered appends"| node_aof_flush
node_aof_flush -.->|"deferred fsync job"| node_bio_jobs
node_aof_flush -.->|"oversize triggers rewrite"| node_aof_rewrite
node_server_cron -.->|"save-point checks"| node_rdb_save
node_server_cron -.->|"gossip ticks"| node_cluster_cron
node_sync_cmd -->|"offset in backlog"| node_partial_resync
node_sync_cmd -->|"fallback full sync"| node_full_resync
node_feed_slaves -.->|"queued on repl links"| node_write_client
node_cluster_cron -->|"PING / MEET gossip"| node_ping_peers
node_ping_peers -->|"cluster bus messages"| node_process_packet
node_process_packet -->|"apply new slot config"| node_slots_update


node_main_loop -->|"boots server, runs loop"| node_ae_loop
node_main_loop -->|"restore dataset on boot"| node_rdb
node_ae_loop -->|"fires on readable sockets"| node_client_io
node_ae_loop -.->|"beforeSleep flush"| node_aof
node_client_io -->|"parsed RESP commands"| node_dispatch
node_dispatch -->|"SET GET INCR"| node_strings
node_dispatch -->|"HSET HGET HGETALL"| node_hashes
node_dispatch -->|"ZADD ZRANGE ZRANK"| node_zsets
node_dispatch -->|"LPUSH BLPOP"| node_lists
node_dispatch -->|"SAVE BGSAVE"| node_rdb
node_dispatch -->|"propagated writes"| node_aof
node_dispatch -->|"SYNC / PSYNC"| node_replication
node_main_loop -.->|"cron keeps repl link alive"| node_replication


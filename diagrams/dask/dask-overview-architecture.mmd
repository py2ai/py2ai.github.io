node_hlg -->|"materializes into"| node_task
node_mixin -->|"delegates to"| node_compute_fn
node_compute_fn -->|"optimizes through"| node_expr_opt
node_expr_opt -->|"lowers to"| node_hlg
node_compute_fn -->|"culls layers of"| node_hlg
node_compute_fn -->|"default dispatch"| node_threaded_get
node_compute_fn -->|"dispatches to"| node_mp_get
node_threaded_get -->|"drives"| node_engine
node_mp_get -->|"shares loop"| node_engine
node_delayed_fn -->|"emits tasks"| node_task
node_delayed_fn -->|"returns collection"| node_mixin
node_ddf -->|"inherits"| node_mixin
node_arr -->|"inherits"| node_mixin
node_ddf -->|"optimized as expr"| node_expr_opt
node_arr -->|"chunk graph as HLG"| node_hlg
node_datanode -->|"feeds literals to"| node_task


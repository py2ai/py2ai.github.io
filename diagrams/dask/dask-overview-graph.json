{
  "owner": "dask",
  "repo": "dask",
  "branch": "main",
  "groups": [
    { "id": "g1", "name": "g1", "label": "Task-graph core" },
    { "id": "g2", "name": "g2", "label": "Collection protocol" },
    { "id": "g3", "name": "g3", "label": "Expression optimizer" },
    { "id": "g4", "name": "g4", "label": "Local schedulers" },
    { "id": "g5", "name": "g5", "label": "DataFrame collection" },
    { "id": "g6", "name": "g6", "label": "Array collection" },
    { "id": "g7", "name": "g7", "label": "Delayed" }
  ],
  "nodes": [
    { "id": "task", "label": "Task", "file": "_task_spec.py", "path": "dask/_task_spec.py", "group": "g1", "groupId": "g1", "desc": "Runnable graph node holding func and args; called with resolved dependencies" },
    { "id": "datanode", "label": "DataNode", "file": "_task_spec.py", "path": "dask/_task_spec.py", "group": "g1", "groupId": "g1", "desc": "Non-runnable node holding a literal value directly in the graph" },
    { "id": "hlg", "label": "HighLevelGraph", "file": "highlevelgraph.py", "path": "dask/highlevelgraph.py", "group": "g1", "groupId": "g1", "desc": "Layered mapping of per-collection subgraphs behind every collection" },
    { "id": "mixin", "label": "DaskMethodsMixin", "file": "base.py", "path": "dask/base.py", "group": "g2", "groupId": "g2", "desc": "compute/persist/visualize protocol mixed into every collection" },
    { "id": "compute_fn", "label": "compute()", "file": "base.py", "path": "dask/base.py", "group": "g2", "groupId": "g2", "desc": "Gathers collections, optimizes graphs, dispatches to a scheduler" },
    { "id": "expr_opt", "label": "expr optimize", "file": "_expr.py", "path": "dask/_expr.py", "group": "g3", "groupId": "g3", "desc": "Optimizer entry point fusing expression trees into a low-level graph" },
    { "id": "threaded_get", "label": "threaded get", "file": "threaded.py", "path": "dask/threaded.py", "group": "g4", "groupId": "g4", "desc": "Default scheduler running tasks on a thread pool" },
    { "id": "engine", "label": "get_async loop", "file": "local.py", "path": "dask/local.py", "group": "g4", "groupId": "g4", "desc": "Core async task loop that every local scheduler drives" },
    { "id": "mp_get", "label": "multiprocessing get", "file": "multiprocessing.py", "path": "dask/multiprocessing.py", "group": "g4", "groupId": "g4", "desc": "Process-based scheduler shipping pickled tasks to workers" },
    { "id": "delayed_fn", "label": "delayed()", "file": "delayed.py", "path": "dask/delayed.py", "group": "g7", "groupId": "g7", "desc": "Decorator turning arbitrary Python calls into task nodes" },
    { "id": "ddf", "label": "DataFrame", "file": "_collection.py", "path": "dask/dataframe/dask_expr/_collection.py", "group": "g5", "groupId": "g5", "desc": "Partitioned DataFrame backed by the dask-expr expression tree" },
    { "id": "arr", "label": "Array", "file": "core.py", "path": "dask/array/core.py", "group": "g6", "groupId": "g6", "desc": "Chunked N-D array whose blocks live in a task graph" }
  ],
  "edges": [
    { "from": "hlg", "to": "task", "label": "materializes into" },
    { "from": "mixin", "to": "compute_fn", "label": "delegates to" },
    { "from": "compute_fn", "to": "expr_opt", "label": "optimizes through" },
    { "from": "expr_opt", "to": "hlg", "label": "lowers to" },
    { "from": "compute_fn", "to": "hlg", "label": "culls layers of" },
    { "from": "compute_fn", "to": "threaded_get", "label": "default dispatch" },
    { "from": "compute_fn", "to": "mp_get", "label": "dispatches to" },
    { "from": "threaded_get", "to": "engine", "label": "drives" },
    { "from": "mp_get", "to": "engine", "label": "shares loop" },
    { "from": "delayed_fn", "to": "task", "label": "emits tasks" },
    { "from": "delayed_fn", "to": "mixin", "label": "returns collection" },
    { "from": "ddf", "to": "mixin", "label": "inherits" },
    { "from": "arr", "to": "mixin", "label": "inherits" },
    { "from": "ddf", "to": "expr_opt", "label": "optimized as expr" },
    { "from": "arr", "to": "hlg", "label": "chunk graph as HLG" },
    { "from": "datanode", "to": "task", "label": "feeds literals to" }
  ]
}

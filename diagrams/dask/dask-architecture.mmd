node_compute_fn -->|"default scheduler"| node_threaded_get
node_compute_fn -->|"synchronous mode"| node_get_sync
node_threaded_get -->|"drives"| node_get_async
node_get_sync -->|"wraps"| node_get_async
node_get_async -->|"completes via"| node_finish_task
node_get_async -->|"resolves deps"| node_get_dependencies
node_get_async -->|"ranks keys"| node_order
node_get_async -->|"runs each node"| node_task
node_finish_task -->|"stores results of"| node_task
node_optimize_blockwise -->|"fuses layers of"| node_blockwise
node_blockwise -->|"contributes layers"| node_hlg
node_elemwise -->|"extends"| node_expr_cls
node_fused -->|"fusion container of"| node_expr_cls
node_expr_cls -->|"evaluates subgraphs"| node_execute_graph
node_frame_base -->|"inherits"| node_mixin
node_ddf -->|"extends"| node_frame_base
node_ddseries -->|"extends"| node_frame_base
node_ddf -->|"wraps Expr tree"| node_expr_cls
node_from_pandas -->|"constructs"| node_ddf
node_read_csv -->|"produces"| node_ddf
node_arr -->|"inherits"| node_mixin
node_from_array -->|"constructs"| node_arr
node_arr -->|"exposes graph via"| node_arr_graph
node_arr_graph -->|"returns"| node_hlg
node_einsum -->|"assembles graph into"| node_arr_graph
node_delayed_fn -->|"produces"| node_delayed_cls
node_delayed_cls -->|"emits Task nodes"| node_task
node_delayed_cls -->|"inherits"| node_mixin


node_ctr -->|"invokes over gRPC"| node_daemon_main
node_daemon_main -->|"server.New&#40;ctx, config&#41;"| node_server
node_server -->|"LoadPlugins"| node_tasks_service
node_server -->|"LoadPlugins"| node_content_service
node_server -->|"LoadPlugins"| node_images_service
node_server -->|"LoadPlugins"| node_containers_service
node_server -->|"LoadPlugins"| node_snapshots_service
node_server -->|"LoadPlugins"| node_transfer_service
node_server -->|"LoadPlugins"| node_events_service
node_tasks_service -->|"forwards RPCs"| node_tasks_local
node_tasks_service -->|"serves api.tasks.v1"| node_tasks_proto
node_content_service -->|"contentserver.New"| node_contentserver
node_content_service -->|"serves api.content.v1"| node_content_proto
node_tasks_local -->|"runtime v2 calls"| node_task_manager
node_task_manager -->|"resolve shim"| node_shim_manager
node_shim_manager -->|"NewBundle per container"| node_bundle
node_shim_manager -->|"exec shim binary"| node_shim_binary_launcher
node_shim_binary_launcher -->|"spawn + bootstrap"| node_runc_main
node_shim_manager -->|"connects ttrpc"| node_shim_instance
node_shim_instance -->|"wrapped as task"| node_shim_task
node_shim_task -->|"versioned task client"| node_bridge
node_bridge -->|"api.runtime.task.v2"| node_shim_proto
node_runc_main -->|"shim.RunShim"| node_runc_task_service
node_runc_task_service -->|"registers TTRPC"| node_shim_proto
node_runc_task_service -->|"publishes TaskExit"| node_exchange
node_events_service -->|"Subscribe/Publish"| node_exchange
node_snapshots_service -->|"per-name snapshotter"| node_snapshotter_iface
node_snapshotter_iface -->|"key metadata"| node_metastore_bolt
node_snapshotter_iface -->|"returns &#91;&#93;Mount"| node_mounts
node_snapshotter_iface -->|"keys in bolt"| node_metadata_db
node_content_service -->|"backs the service"| node_content_store
node_content_store -->|"blob metadata"| node_metadata_db
node_images_service -->|"resolve image refs"| node_resolver
node_resolver -->|"ingest blobs"| node_content_store
node_unpacker -->|"reads layers"| node_content_store
node_unpacker -->|"Prepare + Commit"| node_snapshotter_iface
node_transfer_service -->|"streams progress"| node_transfer_local
node_transfer_local -->|"fetch remote layers"| node_resolver
node_transfer_local -->|"unpack into snapshotter"| node_unpacker
node_transfer_local -->|"pull progress events"| node_exchange


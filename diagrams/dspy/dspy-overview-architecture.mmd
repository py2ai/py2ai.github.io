flowchart TD

subgraph group_authoring["Program Authoring"]
  node_signature["Signature &#40;typed I/O&#41;<br/>abstraction"]
  node_module{{"Module &#40;your program&#41;<br/>abstraction"}}
  node_predict["Predict &amp; built-in modules<br/>[predict.py]"]
  node_adapters["Adapters &#40;chat/JSON/XML&#41;<br/>[chat_adapter.py]"]
end

subgraph group_runtime["LM Runtime"]
  node_clients["LM clients &#40;dspy.LM&#41;<br/>connector"]
  node_engines["Request engines &#40;LiteLLM&#41;<br/>connector"]
  node_cache[("Cache &amp; cost tracking<br/>storage")]
end

subgraph group_optimize["Optimizers"]
  node_teleprompt["Teleprompter base<br/>abstraction"]
  node_mipro["MIPROv2 optimizer"]
  node_gepa["GEPA optimizer<br/>[gepa.py]"]
end

subgraph group_eval["Evaluation &amp; Streaming"]
  node_evaluate["Evaluate harness<br/>[evaluate.py]"]
  node_streaming["Streamify<br/>[streamify.py]"]
end

node_predict -->|"formats fields"| node_signature
node_module -->|"composes"| node_predict
node_predict -->|"builds messages"| node_adapters
node_adapters -->|"sends to LM"| node_clients
node_clients -->|"request path"| node_engines
node_engines -->|"caches &amp; costs"| node_cache
node_streaming -.->|"token stream"| node_clients
node_mipro -->|"extends"| node_teleprompt
node_gepa -->|"extends"| node_teleprompt
node_teleprompt -->|"optimizes programs"| node_module
node_mipro -.->|"scores candidates"| node_evaluate
node_evaluate -->|"runs programs"| node_module


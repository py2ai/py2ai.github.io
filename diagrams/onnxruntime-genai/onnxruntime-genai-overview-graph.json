    { "id": "cache_mgr", "label": "cache_manager.h", "file": "src/engine/cache_manager.h", "group": "engine", "desc": "CacheManager: admission control against KV capacity, paged variant" },
    { "id": "builder", "label": "builder.py", "file": "src/python/py/models/builder.py", "group": "builders", "desc": "Model builder: converts HF checkpoints to ONNX + genai_config.json" }

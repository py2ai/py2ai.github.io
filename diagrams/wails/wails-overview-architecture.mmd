node_bindings_ns -->|"Call -&gt; 'C'+JSON"| node_wails_invoke
node_dispatcher -->|"case 'C'"| node_call_handler
node_call_handler -->|"callback 'c'+JSON"| node_dispatcher
node_dispatcher -->|"Notify on 'E'"| node_events_api
node_v3js -->|"POST /wails/runtime"| node_msg_processor
node_msg_processor -->|"case callRequest"| node_call_proc
node_call_proc -->|"resolve by name or ID"| node_bindings_v3
node_generator -->|"stable method IDs"| node_bindings_v3
node_generator -->|"TS models + index"| node_v3js


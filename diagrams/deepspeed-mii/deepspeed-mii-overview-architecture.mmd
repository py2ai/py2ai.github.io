node_mii_api -->|"parses kwargs into"| node_model_config
node_model_config -->|"embedded in"| node_mii_config
node_mii_api -->|"starts"| node_mii_server
node_mii_api -->|"returns"| node_grpc_client_stub
node_mii_server -->|"spawns"| node_multi_gpu_server
node_mii_server -->|"allocates replicas from"| node_mii_config
node_multi_gpu_server -->|"loads engine via"| node_load_model
node_multi_gpu_server -->|"drives generation loop"| node_mii_async_batching
node_multi_gpu_server -->|"hosts"| node_grpc_server
node_multi_gpu_server -->|"hosts"| node_rest_gateway
node_load_model -->|"reads"| node_model_config
node_load_model -->|"pairs with"| node_load_tokenizer
node_grpc_server -->|"queues requests into"| node_mii_async_batching
node_grpc_client_stub -->|"gRPC calls"| node_grpc_server
node_rest_gateway -->|"forwards HTTP as"| node_grpc_client_stub
node_openai_api -->|"forwards chat traffic"| node_grpc_client_stub


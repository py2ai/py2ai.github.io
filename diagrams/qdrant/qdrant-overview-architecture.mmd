flowchart TD

subgraph group_api["API Layer"]
  node_rest{{"REST API<br/>Actix web"}}
  node_grpc["gRPC API<br/>Tonic services"]
end

subgraph group_coord["Coordination"]
  node_startup["Server startup<br/>bootstrap"]
  node_consensus["Raft consensus<br/>cluster metadata"]
  node_dispatcher["API dispatcher<br/>request routing"]
  node_content_manager{{"Content manager<br/>collections table"}}
end

subgraph group_core["Data Path Crates"]
  node_collection{{"Collection crate<br/>logical collections"}}
  node_shard{{"Shard crate<br/>query and update"}}
  node_segment{{"Segment crate<br/>physical storage"}}
end

subgraph group_store["Durability &amp; Indexing"]
  node_wal[("Write-ahead log<br/>crash safety")]
  node_quantization["Quantization<br/>RAM reduction"]
  node_sparse["Sparse vectors<br/>keyword search"]
end

node_startup -->|"mount"| node_rest
node_startup -->|"mount"| node_grpc
node_startup -->|"join cluster"| node_consensus
node_rest -->|"route requests"| node_dispatcher
node_grpc -->|"route requests"| node_dispatcher
node_dispatcher -->|"resolve collection"| node_content_manager
node_consensus -->|"replicate ops"| node_content_manager
node_content_manager -->|"apply operations"| node_collection
node_collection -->|"fan out shards"| node_shard
node_shard -->|"read / write"| node_segment
node_shard -->|"append first"| node_wal
node_segment -.->|"recover state"| node_wal
node_segment -.->|"compress vectors"| node_quantization
node_segment -.->|"sparse indexes"| node_sparse


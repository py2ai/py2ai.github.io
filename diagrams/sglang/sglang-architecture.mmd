flowchart TD

subgraph group_api["Serving Front-End"]
  node_launch["launch_server entry<br/>CLI bootstrap"]
  node_http_server["FastAPI HTTP server<br/>uvicorn app"]
  node_openai_api["OpenAI-compatible API<br/>chat / completions"]
  node_anthropic_api["Anthropic and Ollama APIs<br/>protocol adapters"]
  node_grpc_server["gRPC server<br/>RPC surface"]
  node_engine_cls["Engine offline API<br/>in-process"]
  node_server_args["ServerArgs config<br/>flag validation"]
  node_gateway{{"Rust model gateway<br/>router"}}
end

subgraph group_engine["Manager Processes"]
  node_tok_mgr{{"TokenizerManager<br/>async front-end"}}
  node_multi_tok["Multi-tokenizer mixin<br/>many tokenizers"]
  node_io_struct["ZMQ message structs<br/>IPC vocabulary"]
  node_detok["DetokenizerManager<br/>incremental decode"]
  node_dp_ctl["DataParallel controller<br/>replica fan-out"]
end

subgraph group_sched["Scheduling &amp; Cache"]
  node_scheduler["Scheduler<br/>continuous batching"]
  node_schedule_batch["Req / ScheduleBatch<br/>batch records"]
  node_schedule_policy["Cache-aware policies<br/>LRU / weight"]
  node_radix[("RadixAttention cache<br/>prefix tree")]
  node_allocator[("Token allocator<br/>paged token slots")]
  node_evict["Eviction policies<br/>LRU / priority"]
  node_overlap["Batch overlap<br/>CPU/GPU overlap"]
  node_disaggregation["PD disaggregation<br/>prefill / decode split"]
end

subgraph group_exec["Execution"]
  node_tp_worker{{"TP worker<br/>replica driver"}}
  node_model_runner{{"ModelRunner<br/>device loop"}}
  node_forward_batch["ForwardBatch<br/>batch metadata"]
  node_cuda_graph["Decode CUDA graph runner<br/>graph replay"]
  node_models["Model architectures<br/>model zoo"]
  node_layers["Attention / MoE layers<br/>fused ops"]
  node_quantization["Quantization methods"]
  node_moe["MoE kernels<br/>expert dispatch"]
  node_distributed["TP / PP collectives<br/>device groups"]
end

subgraph group_feat["Feature Modules"]
  node_speculative["Speculative decoding"]
  node_constrained["Constrained decoding<br/>grammar compile"]
  node_function_call["Function call parsers<br/>tool output parse"]
  node_lora["LoRA serving<br/>adapter load"]
end

node_launch -->|"parses"| node_server_args
node_launch -->|"starts"| node_http_server
node_http_server -->|"mounts"| node_openai_api
node_http_server -.->|"mounts"| node_anthropic_api
node_grpc_server -.->|"alternative"| node_tok_mgr
node_engine_cls -.->|"in-process"| node_tok_mgr
node_gateway -.->|"routes traffic"| node_http_server
node_openai_api -->|"generate"| node_tok_mgr
node_tok_mgr -->|"tokenizer choice"| node_multi_tok
node_tok_mgr -->|"TokenizedGenerateReqInput"| node_io_struct
node_tok_mgr -->|"dispatch"| node_dp_ctl
node_dp_ctl -->|"ZMQ to replica"| node_scheduler
node_scheduler -->|"batches"| node_schedule_batch
node_scheduler -->|"ordering"| node_schedule_policy
node_schedule_policy -->|"prefix match"| node_radix
node_radix -->|"token slots"| node_allocator
node_evict -.->|"evict leaves"| node_radix
node_scheduler -.->|"hide CPU cost"| node_overlap
node_disaggregation -.->|"KV handoff"| node_scheduler
node_scheduler -->|"run batch"| node_tp_worker
node_tp_worker -->|"forward"| node_model_runner
node_model_runner -->|"build"| node_forward_batch
node_model_runner -->|"capture / replay"| node_cuda_graph
node_model_runner -->|"instantiate"| node_models
node_models -->|"compose"| node_layers
node_layers -.->|"quant weights"| node_quantization
node_layers -.->|"expert routing"| node_moe
node_distributed -.->|"collectives"| node_model_runner
node_speculative -.->|"draft + verify"| node_scheduler
node_constrained -.->|"grammar masks"| node_scheduler
node_scheduler -->|"token ids"| node_detok
node_detok -->|"text output"| node_tok_mgr
node_function_call -.->|"parsed tools"| node_openai_api
node_lora -.->|"adapter swap"| node_model_runner


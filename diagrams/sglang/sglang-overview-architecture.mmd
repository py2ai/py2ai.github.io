flowchart TD

subgraph group_api["Serving Front-End"]
  node_http["FastAPI HTTP server<br/>uvicorn app"]
  node_openai_api["OpenAI-compatible API<br/>REST adapters"]
  node_engine["Engine offline API<br/>programmatic entry"]
end

subgraph group_engine["Manager Processes"]
  node_tok_mgr{{"TokenizerManager<br/>async front-end"}}
  node_dp_ctl["DataParallel controller<br/>replica routing"]
end

subgraph group_sched["Scheduling &amp; Cache"]
  node_scheduler["Scheduler loop<br/>continuous batching"]
  node_radix[("RadixAttention cache<br/>prefix tree")]
  node_policy["Cache-aware policies<br/>LRU / FCFS"]
end

subgraph group_exec["Execution"]
  node_tp_worker{{"TP worker<br/>per-replica driver"}}
  node_model_runner["ModelRunner<br/>batched forward"]
  node_models["Model architectures<br/>model zoo"]
  node_layers[("Attention / MoE layers<br/>kernels + quant")]
end

node_http -->|"mounts"| node_openai_api
node_openai_api -->|"submit request"| node_tok_mgr
node_engine -.->|"submit request"| node_tok_mgr
node_tok_mgr -->|"dispatch"| node_dp_ctl
node_dp_ctl -->|"route to replica"| node_scheduler
node_scheduler -->|"pick next batch"| node_policy
node_policy -->|"match prefixes"| node_radix
node_scheduler -->|"launch batch"| node_tp_worker
node_tp_worker -->|"forward"| node_model_runner
node_model_runner -->|"instantiate"| node_models
node_models -->|"compose layers"| node_layers
node_tp_worker -.->|"step results"| node_scheduler
node_scheduler -.->|"outputs via detokenizer"| node_tok_mgr


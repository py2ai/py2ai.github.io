node_main -->|"returns SetupResult"| node_setup
node_setup -->|"enters processing loop"| node_run_loop
node_run_loop -->|"Process&#40;&#41; on ready sources"| node_pkt_src
node_run_loop -->|"event_mgr.Drain&#40;&#41; each pass"| node_drain
node_pkt_src -->|"current_packet"| node_dispatch_packet
node_dispatch_packet -->|"ProcessPacket&#40;pkt&#41;"| node_pa_manager
node_pa_manager -->|"root_analyzer-&gt;ForwardPacket&#40;&#41;"| node_pa_root
node_pa_root -->|"dispatch on link_type"| node_ethernet
node_ethernet -->|"ForwardPacket&#40;ethertype&#41;"| node_ip_analyzer
node_ip_analyzer -->|"protocol 6"| node_tcp_analyzer
node_ip_analyzer -->|"protocol 17"| node_udp_analyzer
node_tcp_analyzer -->|"inherits AnalyzePacket"| node_ipbased
node_udp_analyzer -->|"inherits AnalyzePacket"| node_ipbased
node_ipbased -->|"unknown ConnKey"| node_new_conn
node_ipbased -->|"MakeSessionAdapter&#40;&#41;"| node_tcp_analyzer
node_new_conn -->|"Insert&#40;session&#41;"| node_session_mgr
node_tcp_analyzer -->|"TCPSessionAdapter root"| node_tcp_adapter
node_tcp_adapter -->|"per-direction state"| node_tcp_endpoint
node_tcp_adapter -->|"byte stream capture"| node_tcp_reassembler
node_tcp_reassembler -->|"app analyzers raise events"| node_enqueue
node_udp_analyzer -->|"DeliverPacket -&gt; app events"| node_enqueue
node_session_mgr -->|"new_connection / conn events"| node_enqueue
node_enqueue -->|"queued events"| node_drain
node_drain -->|"one Event at a time"| node_event_dispatch
node_event_dispatch -->|"handler invocation"| node_script_handlers
node_script_handlers -->|"create_stream on zeek_init"| node_conn_stream
node_script_handlers -->|"create_stream on zeek_init"| node_dns_stream
node_script_handlers -->|"Log::write&#40;&#41;"| node_log_write
node_log_write -->|"builtin -&gt; manager"| node_log_manager
node_log_manager -->|"frontend owns filter"| node_writer_frontend
node_writer_frontend -->|"buffer full"| node_flush_buffer
node_flush_buffer -->|"new WriteMessage"| node_write_message
node_write_message -->|"SendIn -&gt; queue_in"| node_msg_thread
node_msg_thread -->|"Process -&gt; DoWrites"| node_writer_backend
node_writer_backend -->|"DoWrite impl"| node_ascii_writer


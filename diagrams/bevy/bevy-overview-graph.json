{
  "owner": "bevyengine",
  "repo": "bevy",
  "branch": "main",
  "groups": [
    { "id": "app", "name": "App & Plugins", "label": "bevy_app" },
    { "id": "ecs", "name": "ECS Core", "label": "bevy_ecs" },
    { "id": "sched", "name": "Scheduler", "label": "bevy_ecs / schedule" },
    { "id": "render", "name": "Renderer", "label": "bevy_render" },
    { "id": "assets", "name": "Assets", "label": "bevy_asset" }
  ],
  "nodes": [
    {
      "id": "app",
      "label": "App",
      "file": "app.rs",
      "path": "crates/bevy_app/src/app.rs",
      "group": "App & Plugins",
      "groupId": "app",
      "desc": "Builder that owns the main World, registers plugins and systems, then hands itself to a runner"
    },
    {
      "id": "mainlabels",
      "label": "Main / Startup / Update",
      "file": "main_schedule.rs",
      "path": "crates/bevy_app/src/main_schedule.rs",
      "group": "App & Plugins",
      "groupId": "app",
      "desc": "Schedule labels composing one frame: Startup, First, PreUpdate, Update, PostUpdate, Last"
    },
    {
      "id": "world",
      "label": "World",
      "file": "mod.rs",
      "path": "crates/bevy_ecs/src/world/mod.rs",
      "group": "ECS Core",
      "groupId": "ecs",
      "desc": "Central store of entities, components and resources; the only place state actually lives"
    },
    {
      "id": "archetype",
      "label": "Archetypes",
      "file": "archetype.rs",
      "path": "crates/bevy_ecs/src/archetype.rs",
      "group": "ECS Core",
      "groupId": "ecs",
      "desc": "One archetype per unique component combination; moving an entity is a move between archetypes"
    },
    {
      "id": "storage",
      "label": "Tables & SparseSets",
      "file": "mod.rs",
      "path": "crates/bevy_ecs/src/storage/table/mod.rs",
      "group": "ECS Core",
      "groupId": "ecs",
      "desc": "Columnar Tables for bulk component data plus SparseSets for components that move often"
    },
    {
      "id": "query",
      "label": "Query / QueryState",
      "file": "state.rs",
      "path": "crates/bevy_ecs/src/query/state.rs",
      "group": "ECS Core",
      "groupId": "ecs",
      "desc": "Declarative component access; state caches archetype matches so iteration needs no re-filtering"
    },
    {
      "id": "schedule",
      "label": "Schedule",
      "file": "schedule.rs",
      "path": "crates/bevy_ecs/src/schedule/schedule.rs",
      "group": "Scheduler",
      "groupId": "sched",
      "desc": "Builds an ordering graph from .before/.after constraints and runs the systems inside one label"
    },
    {
      "id": "executor",
      "label": "MultiThreadedExecutor",
      "file": "multi_threaded.rs",
      "path": "crates/bevy_ecs/src/schedule/executor/multi_threaded.rs",
      "group": "Scheduler",
      "groupId": "sched",
      "desc": "Spawns one task per ready system and lets them run in parallel on the task pool"
    },
    {
      "id": "renderapp",
      "label": "RenderApp + RenderGraph",
      "file": "lib.rs",
      "path": "crates/bevy_render/src/lib.rs",
      "group": "Renderer",
      "groupId": "render",
      "desc": "Sub-app with its own World; a RenderGraph schedule drives extraction, prepare, render, submit"
    },
    {
      "id": "assetserver",
      "label": "AssetServer",
      "file": "mod.rs",
      "path": "crates/bevy_asset/src/server/mod.rs",
      "group": "Assets",
      "groupId": "assets",
      "desc": "Non-blocking asset loading; returns typed Handles immediately and fills Assets<T> later"
    }
  ],
  "edges": [
    { "from": "app", "to": "mainlabels", "label": "runs one frame per tick" },
    { "from": "app", "to": "world", "label": "owns the main World" },
    { "from": "mainlabels", "to": "schedule", "label": "PreUpdate / Update / PostUpdate" },
    { "from": "world", "to": "archetype", "label": "groups entities" },
    { "from": "archetype", "to": "storage", "label": "each points at one Table" },
    { "from": "query", "to": "archetype", "label": "iterates matched archetypes" },
    { "from": "query", "to": "world", "label": "borrows components" },
    { "from": "schedule", "to": "query", "label": "systems declare access" },
    { "from": "schedule", "to": "executor", "label": "delegates execution" },
    { "from": "executor", "to": "world", "label": "parallel access via UnsafeWorldCell" },
    { "from": "app", "to": "renderapp", "label": "spawns RenderApp sub-app" },
    { "from": "mainlabels", "to": "renderapp", "label": "extract after PostUpdate" },
    { "from": "app", "to": "assetserver", "label": "installs as resource" },
    { "from": "assetserver", "to": "world", "label": "fills Assets<T> resources" },
    { "from": "app", "to": "schedule", "label": "App::add_systems registers" }
  ]
}

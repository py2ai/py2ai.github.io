node_app -->|"runs one frame per tick"| node_mainlabels
node_app -->|"owns the main World"| node_world
node_mainlabels -->|"PreUpdate / Update / PostUpdate"| node_schedule
node_world -->|"groups entities"| node_archetype
node_archetype -->|"each points at one Table"| node_storage
node_query -->|"iterates matched archetypes"| node_archetype
node_query -->|"borrows components"| node_world
node_schedule -->|"systems declare access"| node_query
node_schedule -->|"delegates execution"| node_executor
node_executor -->|"parallel access via UnsafeWorldCell"| node_world
node_app -->|"spawns RenderApp sub-app"| node_renderapp
node_mainlabels -->|"extract after PostUpdate"| node_renderapp
node_app -->|"installs as resource"| node_assetserver
node_assetserver -->|"fills Assets&lt;T&gt; resources"| node_world
node_app -->|"App::add_systems registers"| node_schedule


{
  "owner": "influxdata",
  "repo": "influxdb",
  "branch": "main",
  "groups": [
    { "id": "cli", "name": "cli", "label": "CLI & Startup" },
    { "id": "http", "name": "http", "label": "HTTP API" },
    { "id": "ingest", "name": "ingest", "label": "Ingest Path" },
    { "id": "storage", "name": "storage", "label": "Parquet Storage" },
    { "id": "query", "name": "query", "label": "Query Engine" }
  ],
  "nodes": [
    {
      "id": "cli_main",
      "label": "influxdb3 binary",
      "file": "main.rs",
      "path": "influxdb3/src/main.rs",
      "group": "cli",
      "groupId": "cli",
      "desc": "fn main() boots the influxdb3 server binary"
    },
    {
      "id": "serve_cmd",
      "label": "serve command",
      "file": "serve.rs",
      "path": "influxdb3/src/commands/serve.rs",
      "group": "cli",
      "groupId": "cli",
      "desc": "builds the object store, write buffer and query executor, then starts the server"
    },
    {
      "id": "server_lib",
      "label": "Server",
      "file": "lib.rs",
      "path": "influxdb3_server/src/lib.rs",
      "group": "cli",
      "groupId": "cli",
      "desc": "Server struct assembles runtime components and runs the listener"
    },
    {
      "id": "http_api",
      "label": "HttpApi",
      "file": "http.rs",
      "path": "influxdb3_server/src/http.rs",
      "group": "http",
      "groupId": "http",
      "desc": "holds the write buffer and query executor behind one HTTP interface"
    },
    {
      "id": "api_paths",
      "label": "route constants",
      "file": "all_paths.rs",
      "path": "influxdb3_server/src/all_paths.rs",
      "group": "http",
      "groupId": "http",
      "desc": "API_V3_WRITE /api/v3/write_lp and API_V3_QUERY_SQL /api/v3/query_sql"
    },
    {
      "id": "route_dispatch",
      "label": "route_request",
      "file": "http.rs",
      "path": "influxdb3_server/src/http.rs",
      "group": "http",
      "groupId": "http",
      "desc": "matches (method, path) pairs to request handlers"
    },
    {
      "id": "write_lp_handler",
      "label": "write_lp handler",
      "file": "http.rs",
      "path": "influxdb3_server/src/http.rs",
      "group": "http",
      "groupId": "http",
      "desc": "parses line protocol write requests"
    },
    {
      "id": "write_buffer",
      "label": "WriteBufferImpl",
      "file": "mod.rs",
      "path": "influxdb3_write/src/write_buffer/mod.rs",
      "group": "ingest",
      "groupId": "ingest",
      "desc": "validates line protocol rows, appends WAL ops, owns the catalog"
    },
    {
      "id": "queryable_buffer",
      "label": "QueryableBuffer",
      "file": "queryable_buffer.rs",
      "path": "influxdb3_write/src/write_buffer/queryable_buffer.rs",
      "group": "ingest",
      "groupId": "ingest",
      "desc": "in-memory Arrow chunks that also act as the WAL file notifier"
    },
    {
      "id": "persister",
      "label": "Persister",
      "file": "persister.rs",
      "path": "influxdb3_write/src/persister.rs",
      "group": "storage",
      "groupId": "storage",
      "desc": "serializes RecordBatches to Parquet files in object storage"
    },
    {
      "id": "query_executor",
      "label": "QueryExecutorImpl",
      "file": "lib.rs",
      "path": "influxdb3_query_executor/src/lib.rs",
      "group": "query",
      "groupId": "query",
      "desc": "DataFusion/IOx session context planning SQL over buffer and Parquet"
    },
    {
      "id": "flight_grpc",
      "label": "FlightSQL gRPC",
      "file": "grpc.rs",
      "path": "influxdb3_server/src/grpc.rs",
      "group": "query",
      "groupId": "query",
      "desc": "FlightSQL service exposing queries over gRPC"
    }
  ],
  "edges": [
    { "from": "cli_main", "to": "serve_cmd", "label": "dispatches serve" },
    { "from": "serve_cmd", "to": "server_lib", "label": "Server::new" },
    { "from": "serve_cmd", "to": "http_api", "label": "HttpApi::new" },
    { "from": "serve_cmd", "to": "query_executor", "label": "QueryExecutorImpl::new" },
    { "from": "server_lib", "to": "http_api", "label": "mounts HTTP API" },
    { "from": "server_lib", "to": "flight_grpc", "label": "exposes FlightSQL" },
    { "from": "api_paths", "to": "route_dispatch", "label": "route constants" },
    { "from": "route_dispatch", "to": "write_lp_handler", "label": "POST /api/v3/write_lp" },
    { "from": "route_dispatch", "to": "query_executor", "label": "GET /api/v3/query_sql" },
    { "from": "write_lp_handler", "to": "write_buffer", "label": "write_lp" },
    { "from": "write_buffer", "to": "queryable_buffer", "label": "applies WAL ops" },
    { "from": "queryable_buffer", "to": "persister", "label": "snapshot to Parquet" },
    { "from": "query_executor", "to": "queryable_buffer", "label": "reads buffered chunks" },
    { "from": "query_executor", "to": "persister", "label": "scans Parquet files" }
  ]
}

node_cli_main -->|"dispatches serve"| node_serve_cmd
node_serve_cmd -->|"Server::new"| node_server_lib
node_serve_cmd -->|"HttpApi::new"| node_http_api
node_serve_cmd -->|"QueryExecutorImpl::new"| node_query_executor
node_server_lib -->|"mounts HTTP API"| node_http_api
node_server_lib -->|"exposes FlightSQL"| node_flight_grpc
node_api_paths -->|"route constants"| node_route_dispatch
node_route_dispatch -->|"POST /api/v3/write_lp"| node_write_lp_handler
node_route_dispatch -->|"GET /api/v3/query_sql"| node_query_executor
node_write_lp_handler -->|"write_lp"| node_write_buffer
node_write_buffer -->|"applies WAL ops"| node_queryable_buffer
node_queryable_buffer -->|"snapshot to Parquet"| node_persister
node_query_executor -->|"reads buffered chunks"| node_queryable_buffer
node_query_executor -->|"scans Parquet files"| node_persister


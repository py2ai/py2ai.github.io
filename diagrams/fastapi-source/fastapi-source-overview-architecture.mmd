node_asgi_app -->|"builds stack on first call"| node_middleware
node_middleware -->|"innermost ASGI app"| node_router
node_router -->|"path + method match"| node_route
node_route -->|"registration-time analysis"| node_get_dependant
node_get_dependant -->|"produces the tree"| node_dependant
node_route -->|"self.app closure"| node_handler
node_handler -->|"body in, values out"| node_solve
node_solve -->|"query/path/header/cookie"| node_params_to_args
node_solve -->|"body fields"| node_body_to_args
node_handler -->|"errors empty"| node_endpoint
node_endpoint -->|"raw return value"| node_serialize
node_solve -->|"walks sub-dependencies"| node_dependant
node_handler -->|"wraps in Response"| node_serialize


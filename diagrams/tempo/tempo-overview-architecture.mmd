subgraph group_g_write["Write Path"]
  node_blockbuilder["Block Builder<br/>[blockbuilder.go]"]
  node_wal[("WAL<br/>[wal.go]")]
  node_livestore[("Live Store<br/>[live_store.go]")]
end

subgraph group_g_storage["Object Storage"]
  node_tempodb[("TempoDB<br/>[tempodb.go]")]
  node_backend_iface[("Backend<br/>[backend.go]")]
end


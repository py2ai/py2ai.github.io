subgraph group_g_query["Query Path"]
  node_query_frontend["Query Frontend<br/>[frontend.go]"]
  node_querier["Querier<br/>[querier.go]"]
  node_traceql_engine["TraceQL Engine<br/>[engine.go]"]
end

node_main -->|"boots module"| node_distributor
node_main -->|"boots module"| node_query_frontend
node_distributor -->|"PushBytesRequest on Kafka"| node_kafka_decoder
node_kafka_decoder -->|"consume records"| node_blockbuilder
node_blockbuilder -->|"AppendTrace"| node_wal
node_blockbuilder -->|"write complete blocks"| node_tempodb
node_distributor -->|"push live spans"| node_livestore
node_livestore -->|"blocks on object store"| node_tempodb
node_tempodb -->|"Reader/Writer"| node_backend_iface
node_tempodb -->|"compactionLoop"| node_vparquet_compactor
node_vparquet_compactor -->|"rewrite blocks"| node_backend_iface
node_query_frontend -->|"shard + fan out"| node_querier
node_querier -->|"recent traces"| node_livestore
node_querier -->|"block reads"| node_tempodb
node_querier -->|"compile + run TraceQL"| node_traceql_engine
node_traceql_engine -->|"fetch spansets"| node_tempodb


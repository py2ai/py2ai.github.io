node_cli_main -->|"calls deno::main&#40;&#41;"| node_cli_lib_main
node_cli_lib_main -->|"spawns main runtime"| node_main_worker
node_cli_lib_main -->|"static snapshot linked in"| node_cli_snapshot
node_snapshot_builder -->|"writes blob at build time"| node_cli_snapshot
node_cli_snapshot -->|"startup_snapshot option"| node_jsruntime
node_main_worker -->|"bootstrap_from_options"| node_bootstrap
node_bootstrap -->|"lazy_init_extensions"| node_ext_wiring
node_bootstrap -->|"JsRuntime::new&#40;RuntimeOptions&#41;"| node_jsruntime
node_bootstrap -->|"runs bootstrap scripts"| node_exec_script
node_exec_script -->|"evaluates 99_main.js"| node_js_main
node_ext_wiring -->|"deno_fetch::args&#40;...&#41; etc"| node_ext_decl
node_ext_decl -->|"materializes Extension"| node_extension_struct
node_ext_decl -->|"ops declared via &#35;&#91;op2&#93;"| node_op2
node_ext_wiring -->|"registers fetch ops"| node_op_fetch
node_ext_wiring -->|"registers net ops"| node_op_net_connect
node_main_worker -->|"execute_main_module"| node_exec_main
node_exec_main -->|"evaluate_module"| node_eval_module
node_eval_module -->|"tokio::select! branch"| node_run_el_worker
node_eval_module -->|"load_main_es_module"| node_cli_loader
node_run_el_worker -->|"polls event loop"| node_jsruntime
node_cli_loader -->|"load&#40;&#41; impl"| node_cli_loader_load
node_cli_loader_load -->|"implements ModuleLoader"| node_module_loader_trait
node_jsruntime -->|"resolve&#40;&#41;/load&#40;&#41; callbacks"| node_module_loader_trait
node_jsruntime -->|"main realm + realms"| node_jsrealm
node_jsrealm -->|"pending_ops field"| node_opdriver_impl
node_opdriver_impl -->|"implements OpDriver"| node_op_driver_trait
node_opctx -->|"async ops submitted"| node_op_driver_trait
node_opctx -->|"OpCommonCtx holds OpState"| node_opstate
node_op2 -->|"generates dispatch wrappers"| node_opctx
node_op_driver_trait -->|"settles promises in JS"| node_core_js
node_store_cbs -->|"grabs __eventLoopTick fn"| node_core_js
node_core_js -->|"JS calls ops via ctx"| node_opctx
node_opstate -->|"ops borrow permission state"| node_perms_container
node_op_fetch -->|"check_net_url&#40;url, &quot;fetch&#40;&#41;&quot;&#41;"| node_check_net_url
node_op_net_connect -->|"check_net&#40;...&#41;"| node_perms_container
node_perms_container -->|"delegates to UnaryPermission"| node_read_check
node_perms_container -->|"prompt when ungranted"| node_permission_prompt


flowchart TD

subgraph group_core["Core Engine"]
  node_pipeline{{"Pipeline engine<br/>sync / async runs"}}
  node_component["Component contract<br/>decorator + sockets"]
  node_agent{{"Agent component<br/>tool-calling loop"}}
end

subgraph group_components["Component Library"]
  node_retrievers["Retrievers<br/>BM25 / embedding"]
  node_generators["Generators<br/>chat LLM calls"]
  node_converters["Converters"]
  node_writers["Writers<br/>store documents"]
  node_rankers["Rankers<br/>rescoring"]
end

subgraph group_data["Data Layer"]
  node_document_store[("Document store<br/>in-memory + protocol")]
  node_dataclasses[("Dataclasses<br/>Document / ChatMessage")]
end

subgraph group_tooling["Tooling"]
  node_tools["Tools<br/>function calling"]
  node_marshal["YAML marshal<br/>serialization"]
end

node_component -->|"register nodes"| node_pipeline
node_pipeline -->|"wire sockets"| node_component
node_pipeline -->|"run as node"| node_agent
node_agent -->|"function calling"| node_tools
node_pipeline -.->|"LLM nodes"| node_generators
node_pipeline -.->|"search nodes"| node_retrievers
node_converters -->|"indexing flow"| node_writers
node_writers -->|"persist"| node_document_store
node_retrievers -->|"query"| node_document_store
node_retrievers -.->|"emit Documents"| node_dataclasses
node_generators -.->|"emit replies"| node_dataclasses
node_agent -.->|"chat state"| node_dataclasses
node_pipeline -.->|"YAML round-trip"| node_marshal


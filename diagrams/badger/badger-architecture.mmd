node_new_txn -->|"acquire readTs"| node_oracle
node_new_txn -->|"Set/Get then Commit"| node_commit_and_send
node_commit_and_send -->|"SSI check"| node_has_conflict
node_commit_and_send -->|"assign commitTs"| node_new_commit_ts
node_commit_and_send -->|"entries -&gt; writeCh"| node_batch_set
node_batch_set -->|"pooled requests"| node_do_writes
node_do_writes -->|"apply requests"| node_write_requests
node_write_requests -->|"append values first"| node_vlog_write
node_vlog_write -->|"emit &#123;fid, offset, len&#125;"| node_value_pointer
node_value_pointer -->|"locate value bytes"| node_vlog_read
node_write_requests -->|"then LSM"| node_write_to_lsm
node_write_to_lsm -->|"KeyWithTs entries"| node_mt_put
node_mt_put -->|"CRC record to WAL"| node_wal_encode
node_mt_put -->|"skiplist insert"| node_skl_put
node_skl_put -->|"bump-allocate node"| node_arena_put_node
node_mt_put -->|"full -&gt; flushChan"| node_flush_memtable
node_flush_memtable -->|"WAL recovery on open"| node_replay
node_flush_memtable -->|"iterate skiplist"| node_builder_add
node_builder_add -->|"block offsets + index"| node_build_index
node_flush_memtable -->|"mmap finished SST"| node_open_table
node_open_table -->|"register in L0"| node_add_l0
node_add_l0 -->|"compaction priority"| node_pick_compact
node_pick_compact -->|"compactDef ranges"| node_subcompact
node_subcompact -->|"merge stream"| node_compact_build
node_compact_build -->|"write new SSTs"| node_builder_add
node_compact_build -->|"table create/delete"| node_build_changeset
node_build_changeset -->|"journal change"| node_apply_changeset
node_apply_changeset -->|"persist layout"| node_manifest
node_flush_memtable -->|"L0 table change"| node_apply_changeset
node_txn_get -->|"versioned key"| node_db_get
node_db_get -->|"after memtables"| node_lc_get
node_lc_get -->|"bloom -&gt; block read"| node_table_block
node_txn_get -->|"range scans"| node_merge_iterator
node_merge_iterator -->|"newest Item"| node_yield_value
node_yield_value -->|"fetch via vptr"| node_vlog_read


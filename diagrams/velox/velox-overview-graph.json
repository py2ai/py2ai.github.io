{
  "owner": "facebookincubator",
  "repo": "velox",
  "branch": "main",
  "groups": [
    { "id": "g1", "name": "plan", "label": "Plan & Task" },
    { "id": "g2", "name": "driver", "label": "Driver Runtime" },
    { "id": "g3", "name": "operators", "label": "Operators" },
    { "id": "g4", "name": "vectors", "label": "Columnar Vectors" },
    { "id": "g5", "name": "expressions", "label": "Expression Eval" },
    { "id": "g6", "name": "connectors", "label": "Connectors" }
  ],
  "nodes": [
    {
      "id": "task",
      "label": "Task",
      "file": "Task",
      "path": "velox/exec/Task.h",
      "group": "plan",
      "groupId": "g1",
      "desc": "Runs one plan fragment on a node, owning splits, drivers and memory."
    },
    {
      "id": "localplanner",
      "label": "LocalPlanner",
      "file": "LocalPlanner",
      "path": "velox/exec/LocalPlanner.cpp",
      "group": "plan",
      "groupId": "g1",
      "desc": "Translates a plan fragment into per-driver operator chains."
    },
    {
      "id": "driver",
      "label": "Driver",
      "file": "Driver",
      "path": "velox/exec/Driver.cpp",
      "group": "driver",
      "groupId": "g2",
      "desc": "Single-threaded pull loop that drives one operator chain."
    },
    {
      "id": "operator",
      "label": "Operator",
      "file": "Operator",
      "path": "velox/exec/Operator.h",
      "group": "operators",
      "groupId": "g3",
      "desc": "Base API for operators: addInput, getOutput, isBlocked, isFinished."
    },
    {
      "id": "filterproject",
      "label": "FilterProject",
      "file": "FilterProject",
      "path": "velox/exec/FilterProject.cpp",
      "group": "operators",
      "groupId": "g3",
      "desc": "Vectorized filter and projection over incoming RowVectors."
    },
    {
      "id": "hashaggregation",
      "label": "HashAggregation",
      "file": "HashAggregation",
      "path": "velox/exec/HashAggregation.cpp",
      "group": "operators",
      "groupId": "g3",
      "desc": "Hash-based grouping and aggregate accumulation."
    },
    {
      "id": "exchange",
      "label": "Exchange",
      "file": "Exchange",
      "path": "velox/exec/Exchange.cpp",
      "group": "operators",
      "groupId": "g3",
      "desc": "Pulls serialized data produced by upstream tasks."
    },
    {
      "id": "partitionedoutput",
      "label": "PartitionedOutput",
      "file": "PartitionedOutput",
      "path": "velox/exec/PartitionedOutput.cpp",
      "group": "operators",
      "groupId": "g3",
      "desc": "Partitions results toward downstream tasks or the sink."
    },
    {
      "id": "exprset",
      "label": "ExprSet",
      "file": "Expr",
      "path": "velox/expression/Expr.h",
      "group": "expressions",
      "groupId": "g5",
      "desc": "Vectorized expression evaluation over whole batches."
    },
    {
      "id": "rowvector",
      "label": "RowVector",
      "file": "ComplexVector",
      "path": "velox/vector/ComplexVector.h",
      "group": "vectors",
      "groupId": "g4",
      "desc": "Arrow-compatible columnar batch handed between operators."
    },
    {
      "id": "selectivityvector",
      "label": "SelectivityVector",
      "file": "SelectivityVector",
      "path": "velox/vector/SelectivityVector.h",
      "group": "vectors",
      "groupId": "g4",
      "desc": "Dense active-row mask steering vectorized compute."
    },
    {
      "id": "hivedatasource",
      "label": "HiveDataSource",
      "file": "HiveDataSource",
      "path": "velox/connectors/hive/HiveDataSource.cpp",
      "group": "connectors",
      "groupId": "g6",
      "desc": "Connector scan: split to reader to columnar vectors."
    }
  ],
  "edges": [
    { "from": "task", "to": "localplanner", "label": "plan fragment" },
    { "from": "localplanner", "to": "driver", "label": "compile chains" },
    { "from": "driver", "to": "operator", "label": "pull loop" },
    { "from": "operator", "to": "hivedatasource", "label": "scan via SPI" },
    { "from": "hivedatasource", "to": "rowvector", "label": "columnar batches" },
    { "from": "rowvector", "to": "filterproject", "label": "input vectors" },
    { "from": "selectivityvector", "to": "exprset", "label": "active rows" },
    { "from": "exprset", "to": "filterproject", "label": "compiled exprs" },
    { "from": "filterproject", "to": "hashaggregation", "label": "filtered rows" },
    { "from": "hashaggregation", "to": "partitionedoutput", "label": "grouped rows" },
    { "from": "partitionedoutput", "to": "exchange", "label": "to next stage" },
    { "from": "exchange", "to": "driver", "label": "feed downstream" }
  ]
}

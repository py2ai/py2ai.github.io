node_metadata_svc -->|"emit AssetMetadataExtracted"| node_event_repo
node_event_repo -->|"@OnEvent handler"| node_template_svc
node_job_repo -->|"thumbnail + transcode jobs"| node_media_gen
node_job_repo -->|"SmartSearch job"| node_smart_svc
node_job_repo -->|"FileDelete job"| node_storage_svc
node_storage_svc -->|"unlink originals"| node_storage_repo
node_media_gen -->|"write previews"| node_storage_repo
node_media_svc -->|"getNestedFolder"| node_storage_core
node_template_svc -->|"getLibraryFolder"| node_storage_core
node_template_svc -->|"rename into template path"| node_storage_repo
node_smart_svc -->|"encodeImage"| node_ml_repo
node_ml_repo -->|"POST /predict + ping checks"| node_ml_main
node_ml_main -.->|"load defaults"| node_ml_config
node_ml_main -->|"entries&#40;&#41;"| node_ml_inference
node_ml_inference -->|"image embedding"| node_clip_visual
node_ml_inference -->|"text embedding"| node_clip_textual
node_ml_inference -->|"crop faces"| node_face_detect
node_ml_inference -->|"face vectors"| node_face_recognize
node_smart_svc -->|"upsert embedding"| node_search_repo
node_search_svc -->|"smart / metadata search"| node_search_repo
node_search_svc -.->|"encode text query"| node_ml_repo
node_search_repo -->|"embedding &lt;=&gt; query"| node_smart_table
node_face_recognize -.->|"face embeddings"| node_face_table


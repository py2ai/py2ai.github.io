flowchart TD

subgraph group_api["HTTP API Layer"]
  node_upload_ctrl{{"AssetMediaController<br/>upload + bulk check"}}
  node_asset_ctrl{{"AssetController<br/>asset queries"}}
  node_upload_interceptor["AssetUploadInterceptor<br/>checksum short-circuit"]
  node_file_interceptor["FileUploadInterceptor<br/>multipart storage"]
end

subgraph group_services["Domain Services"]
  node_media_svc["AssetMediaService<br/>uploadAsset&#40;&#41;"]
  node_metadata_svc["MetadataService"]
  node_media_gen["MediaService<br/>sharp + ffmpeg"]
  node_smart_svc["SmartInfoService<br/>CLIP encode"]
  node_template_svc["StorageTemplateService<br/>handlebars render"]
  node_storage_svc["StorageService<br/>disk checks + deletes"]
  node_search_svc["SearchService<br/>smart + metadata search"]
end

subgraph group_repos["Repositories &amp; Job Workers"]
  node_job_repo{{"JobRepository<br/>BullMQ workers"}}
  node_event_repo["EventRepository<br/>in-process events"]
  node_asset_repo["AssetRepository<br/>asset rows"]
  node_ml_repo["MachineLearningRepository<br/>health-checked fetch"]
  node_search_repo["SearchRepository<br/>KNN queries"]
end

subgraph group_schema["Postgres Schema"]
  node_asset_table[("asset<br/>checksum + paths")]
  node_exif_table[("asset_exif<br/>camera + GPS columns")]
  node_smart_table[("smart_search<br/>vector&#40;512&#41; HNSW")]
  node_face_table[("face_search<br/>face vectors")]
end

subgraph group_storage["File Storage &amp; Templates"]
  node_storage_core["StorageCore<br/>nested folders"]
  node_storage_repo["StorageRepository<br/>fs wrappers"]
end

subgraph group_mlpy["Python ML Service"]
  node_ml_main{{"ML FastAPI app<br/>POST /predict"}}
  node_ml_config["ML config<br/>pydantic settings"]
  node_ml_inference["Inference slots<br/>pydantic options"]
end

subgraph group_models["Model Registry"]
  node_clip_visual["CLIP visual<br/>OpenClipVisualEncoder"]
  node_clip_textual["CLIP textual<br/>MClip / OpenClip"]
  node_face_detect["Face detector<br/>FaceDetector"]
  node_face_recognize["Face recognizer<br/>FaceRecognizer"]
end


{
  "owner": "BurntSushi",
  "repo": "ripgrep",
  "branch": "master",
  "groups": [
    { "id": "g_cli", "name": "CLI front-end", "label": "crates/core + crates/cli" },
    { "id": "g_walker", "name": "Parallel walker", "label": "crates/ignore" },
    { "id": "g_filter", "name": "Path filters", "label": "globset + gitignore" },
    { "id": "g_engine", "name": "Regex engines", "label": "crates/regex + crates/pcre2" },
    { "id": "g_search", "name": "Searcher", "label": "crates/searcher" },
    { "id": "g_output", "name": "Output", "label": "crates/printer" }
  ],
  "nodes": [
    { "id": "rg_bin", "label": "rg binary", "shape": "hexagon", "file": "main.rs", "path": "crates/core/main.rs", "group": "g_cli", "groupId": "g_cli", "desc": "main() parses flags and dispatches to single- or multi-threaded search" },
    { "id": "flags", "label": "flags::parse", "shape": "box", "file": "parse.rs", "path": "crates/core/flags/parse.rs", "group": "g_cli", "groupId": "g_cli", "desc": "parses raw CLI flags into LowArgs, then lifts them into HiArgs" },
    { "id": "args", "label": "HiArgs", "shape": "box", "file": "hiargs.rs", "path": "crates/core/flags/hiargs.rs", "group": "g_cli", "groupId": "g_cli", "desc": "high-level configuration: builds matcher, searcher, printer and walk builder" },
    { "id": "worker", "label": "SearchWorker", "shape": "box", "file": "search.rs", "path": "crates/core/search.rs", "group": "g_cli", "groupId": "g_cli", "desc": "glues matcher + searcher + printer; one clone per thread" },
    { "id": "walk", "label": "WalkParallel", "shape": "box", "file": "walk.rs", "path": "crates/ignore/src/walk.rs", "group": "g_walker", "groupId": "g_walker", "desc": "work-stealing parallel directory traversal" },
    { "id": "gitignore", "label": "Gitignore matcher", "shape": "document", "file": "gitignore.rs", "path": "crates/ignore/src/gitignore.rs", "group": "g_filter", "groupId": "g_filter", "desc": "parses .gitignore/.ignore/.rgignore globs into a GlobSet" },
    { "id": "globset", "label": "GlobSet", "shape": "document", "file": "lib.rs", "path": "crates/globset/src/lib.rs", "group": "g_filter", "groupId": "g_filter", "desc": "matches many globs in one pass via specialized strategies" },
    { "id": "matcher", "label": "RegexMatcher", "shape": "box", "file": "matcher.rs", "path": "crates/regex/src/matcher.rs", "group": "g_engine", "groupId": "g_engine", "desc": "grep-matcher implementation over Rust's regex crate, with a fast literal probe" },
    { "id": "searcher", "label": "Searcher", "shape": "box", "file": "mod.rs", "path": "crates/searcher/src/searcher/mod.rs", "group": "g_search", "groupId": "g_search", "desc": "picks mmap vs streaming, then drives the line-oriented loop" },
    { "id": "mmap", "label": "MmapChoice", "shape": "box", "file": "mmap.rs", "path": "crates/searcher/src/searcher/mmap.rs", "group": "g_search", "groupId": "g_search", "desc": "memory-map heuristic: disabled on macOS, auto only for a few explicit files" },
    { "id": "core_loop", "label": "Core line loop", "shape": "box", "file": "core.rs", "path": "crates/searcher/src/searcher/core.rs", "group": "g_search", "groupId": "g_search", "desc": "fast line-by-line matching with candidate-line probing" },
    { "id": "printer", "label": "Printer + Sink", "shape": "document", "file": "standard.rs", "path": "crates/printer/src/standard.rs", "group": "g_output", "groupId": "g_output", "desc": "classic grep-style output, JSON, summary; results flow through Sink" }
  ],
  "edges": [
    { "from": "rg_bin", "to": "flags", "label": "dispatch" },
    { "from": "flags", "to": "args", "label": "LowArgs to HiArgs" },
    { "from": "args", "to": "worker", "label": "assembles" },
    { "from": "args", "to": "walk", "label": "walk_builder() configures" },
    { "from": "args", "to": "matcher", "label": "engine choice" },
    { "from": "worker", "to": "matcher", "label": "holds RustRegex/PCRE2" },
    { "from": "worker", "to": "walk", "label": "visitor per haystack" },
    { "from": "walk", "to": "gitignore", "label": "prune ignored dirs" },
    { "from": "gitignore", "to": "globset", "label": "delegates matching" },
    { "from": "worker", "to": "searcher", "label": "search(&haystack)" },
    { "from": "worker", "to": "printer", "label": "sinks results" },
    { "from": "searcher", "to": "mmap", "label": "mmap heuristic" },
    { "from": "searcher", "to": "core_loop", "label": "line-oriented search" },
    { "from": "core_loop", "to": "matcher", "label": "find candidate line" }
  ]
}

node_rg_bin -->|"dispatch"| node_flags
node_flags -->|"LowArgs to HiArgs"| node_args
node_args -->|"assembles"| node_worker
node_args -->|"walk_builder&#40;&#41; configures"| node_walk
node_args -->|"engine choice"| node_matcher
node_worker -->|"holds RustRegex/PCRE2"| node_matcher
node_worker -->|"visitor per haystack"| node_walk
node_walk -->|"prune ignored dirs"| node_gitignore
node_gitignore -->|"delegates matching"| node_globset
node_worker -->|"search&#40;&amp;haystack&#41;"| node_searcher
node_worker -->|"sinks results"| node_printer
node_searcher -->|"mmap heuristic"| node_mmap
node_searcher -->|"line-oriented search"| node_core_loop
node_core_loop -->|"find candidate line"| node_matcher


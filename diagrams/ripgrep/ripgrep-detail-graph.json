{
  "owner": "BurntSushi",
  "repo": "ripgrep",
  "branch": "master",
  "groups": [
    { "id": "g_cli", "name": "CLI and driver", "label": "crates/core" },
    { "id": "g_walker", "name": "Directory walker", "label": "crates/ignore walk" },
    { "id": "g_filter", "name": "Ignore and glob filters", "label": "crates/ignore dir + crates/globset" },
    { "id": "g_engine", "name": "Regex engine stack", "label": "crates/regex + crates/matcher + crates/pcre2" },
    { "id": "g_search", "name": "Searcher internals", "label": "crates/searcher" },
    { "id": "g_output", "name": "Output layer", "label": "crates/printer + sink" }
  ],
  "nodes": [
    { "id": "main", "label": "main / run", "shape": "hexagon", "file": "main.rs", "path": "crates/core/main.rs", "group": "g_cli", "groupId": "g_cli", "desc": "run() picks single-threaded search, search_parallel, files or types mode" },
    { "id": "flags_parse", "label": "flags::parse", "shape": "box", "file": "parse.rs", "path": "crates/core/flags/parse.rs", "group": "g_cli", "groupId": "g_cli", "desc": "two-phase parsing: raw flags into LowArgs, then lifted into HiArgs" },
    { "id": "hiargs", "label": "HiArgs", "shape": "box", "file": "hiargs.rs", "path": "crates/core/flags/hiargs.rs", "group": "g_cli", "groupId": "g_cli", "desc": "matcher(), searcher(), walk_builder() and printer factories live here" },
    { "id": "worker", "label": "SearchWorker", "shape": "box", "file": "search.rs", "path": "crates/core/search.rs", "group": "g_cli", "groupId": "g_cli", "desc": "clone per thread; handles preprocessors, decompression, binary detection" },
    { "id": "pattern_matcher", "label": "PatternMatcher", "shape": "box", "file": "search.rs", "path": "crates/core/search.rs", "group": "g_cli", "groupId": "g_cli", "desc": "enum RustRegex or PCRE2 chosen at startup" },
    { "id": "printer_enum", "label": "Printer enum", "shape": "box", "file": "search.rs", "path": "crates/core/search.rs", "group": "g_cli", "groupId": "g_cli", "desc": "Standard, Summary or JSON printer per search worker" },
    { "id": "walk_builder", "label": "WalkBuilder", "shape": "box", "file": "walk.rs", "path": "crates/ignore/src/walk.rs", "group": "g_walker", "groupId": "g_walker", "desc": "configures hidden/parents/gitignore flags; HiArgs wires -g, -t and .rgignore here" },
    { "id": "walk_parallel", "label": "WalkParallel", "shape": "box", "file": "walk.rs", "path": "crates/ignore/src/walk.rs", "group": "g_walker", "groupId": "g_walker", "desc": "parallel traversal; run() calls the visitor for every entry" },
    { "id": "threads", "label": "threads()", "shape": "box", "file": "walk.rs", "path": "crates/ignore/src/walk.rs", "group": "g_walker", "groupId": "g_walker", "desc": "defaults to available_parallelism capped at 12 threads" },
    { "id": "ignore_struct", "label": "Ignore chain", "shape": "box", "file": "dir.rs", "path": "crates/ignore/src/dir.rs", "group": "g_filter", "groupId": "g_filter", "desc": "persistent per-directory matcher; each dir links to its parent" },
    { "id": "matched_ignore", "label": "matched_ignore", "shape": "box", "file": "dir.rs", "path": "crates/ignore/src/dir.rs", "group": "g_filter", "groupId": "g_filter", "desc": "walks the parent chain applying custom, .ignore, .gitignore and exclude matchers" },
    { "id": "gitignore", "label": "Gitignore", "shape": "document", "file": "gitignore.rs", "path": "crates/ignore/src/gitignore.rs", "group": "g_filter", "groupId": "g_filter", "desc": "one matcher per directory's ignore file; globs compiled into a GlobSet" },
    { "id": "gitignore_matched", "label": "Gitignore::matched", "shape": "box", "file": "gitignore.rs", "path": "crates/ignore/src/gitignore.rs", "group": "g_filter", "groupId": "g_filter", "desc": "strips the directory prefix then queries the GlobSet with a reusable pool" },
    { "id": "globset", "label": "GlobSet", "shape": "document", "file": "lib.rs", "path": "crates/globset/src/lib.rs", "group": "g_filter", "groupId": "g_filter", "desc": "matches all globs in a single pass over a Candidate path" },
    { "id": "globset_strats", "label": "GlobSetMatchStrategy", "shape": "box", "file": "lib.rs", "path": "crates/globset/src/lib.rs", "group": "g_filter", "groupId": "g_filter", "desc": "literal, basename, extension, prefix, suffix and regex strategies chosen per set" },
    { "id": "glob", "label": "Glob", "shape": "box", "file": "glob.rs", "path": "crates/globset/src/glob.rs", "group": "g_filter", "groupId": "g_filter", "desc": "single gitignore-style pattern compiled from its token stream" },
    { "id": "matcher_trait", "label": "Matcher trait", "shape": "box", "file": "lib.rs", "path": "crates/matcher/src/lib.rs", "group": "g_engine", "groupId": "g_engine", "desc": "engine-agnostic interface: find_at, shortest_match_at, find_candidate_line" },
    { "id": "regex_builder", "label": "RegexMatcherBuilder", "shape": "box", "file": "matcher.rs", "path": "crates/regex/src/matcher.rs", "group": "g_engine", "groupId": "g_engine", "desc": "case, fixed strings, word boundary, line terminator and size limits" },
    { "id": "configured_hir", "label": "ConfiguredHIR", "shape": "box", "file": "config.rs", "path": "crates/regex/src/config.rs", "group": "g_engine", "groupId": "g_engine", "desc": "parses patterns to HIR, then compiles with tuned DFA size limits" },
    { "id": "regex_matcher", "label": "RegexMatcher", "shape": "box", "file": "matcher.rs", "path": "crates/regex/src/matcher.rs", "group": "g_engine", "groupId": "g_engine", "desc": "wraps meta regex plus an optional fast_line_regex literal probe" },
    { "id": "candidate_line", "label": "find_candidate_line", "shape": "box", "file": "matcher.rs", "path": "crates/regex/src/matcher.rs", "group": "g_engine", "groupId": "g_engine", "desc": "confirms or proposes a candidate line so the loop can skip whole lines" },
    { "id": "pcre2", "label": "PCRE2 matcher", "shape": "box", "file": "matcher.rs", "path": "crates/pcre2/src/matcher.rs", "group": "g_engine", "groupId": "g_engine", "desc": "optional -P engine behind the pcre2 feature flag, with JIT enabled on 64-bit" },
    { "id": "searcher", "label": "Searcher", "shape": "box", "file": "mod.rs", "path": "crates/searcher/src/searcher/mod.rs", "group": "g_search", "groupId": "g_search", "desc": "config carries encoding, binary detection, context and match limits" },
    { "id": "search_path", "label": "search_path", "shape": "box", "file": "mod.rs", "path": "crates/searcher/src/searcher/mod.rs", "group": "g_search", "groupId": "g_search", "desc": "opens the file, tries mmap first, falls back to streaming search" },
    { "id": "mmap_choice", "label": "MmapChoice", "shape": "box", "file": "mmap.rs", "path": "crates/searcher/src/searcher/mmap.rs", "group": "g_search", "groupId": "g_search", "desc": "Auto default in HiArgs applies only to at most 10 explicit file paths" },
    { "id": "line_buffer", "label": "LineBuffer", "shape": "box", "file": "line_buffer.rs", "path": "crates/searcher/src/line_buffer.rs", "group": "g_search", "groupId": "g_search", "desc": "64 KB rolling buffer; BOM sniffing and transcoding happen here" },
    { "id": "glue_read", "label": "ReadByLine", "shape": "box", "file": "glue.rs", "path": "crates/searcher/src/searcher/glue.rs", "group": "g_search", "groupId": "g_search", "desc": "fill/match loop over buffered reads for the streaming path" },
    { "id": "core_loop", "label": "Core", "shape": "box", "file": "core.rs", "path": "crates/searcher/src/searcher/core.rs", "group": "g_search", "groupId": "g_search", "desc": "match_by_line picks the fast or slow path; tracks line numbers and context" },
    { "id": "fast_loop", "label": "match_by_line_fast", "shape": "box", "file": "core.rs", "path": "crates/searcher/src/searcher/core.rs", "group": "g_search", "groupId": "g_search", "desc": "jumps straight to the candidate match and sinks whole lines" },
    { "id": "sink", "label": "Sink trait", "shape": "box", "file": "sink.rs", "path": "crates/searcher/src/sink.rs", "group": "g_output", "groupId": "g_output", "desc": "callbacks for matched lines, context and summary; printers implement it" },
    { "id": "printer_standard", "label": "Standard printer", "shape": "document", "file": "standard.rs", "path": "crates/printer/src/standard.rs", "group": "g_output", "groupId": "g_output", "desc": "classic grep output: colors, headings, stats and hyperlinks" }
  ],
  "edges": [
    { "from": "main", "to": "flags_parse", "label": "dispatch" },
    { "from": "flags_parse", "to": "hiargs", "label": "LowArgs to HiArgs" },
    { "from": "hiargs", "to": "worker", "label": "assembles" },
    { "from": "hiargs", "to": "pattern_matcher", "label": "engine choice" },
    { "from": "worker", "to": "pattern_matcher", "label": "holds matcher" },
    { "from": "worker", "to": "printer_enum", "label": "holds printer" },
    { "from": "hiargs", "to": "walk_builder", "label": "walk_builder() configures" },
    { "from": "walk_builder", "to": "walk_parallel", "label": "build_parallel()" },
    { "from": "walk_parallel", "to": "threads", "label": "worker pool size" },
    { "from": "walk_parallel", "to": "ignore_struct", "label": "per-directory state" },
    { "from": "ignore_struct", "to": "matched_ignore", "label": "precedence walk" },
    { "from": "matched_ignore", "to": "gitignore", "label": ".gitignore/.ignore" },
    { "from": "gitignore", "to": "gitignore_matched", "label": "matched()" },
    { "from": "gitignore", "to": "globset", "label": "backed by GlobSet" },
    { "from": "globset", "to": "globset_strats", "label": "strategy dispatch" },
    { "from": "globset_strats", "to": "glob", "label": "compiled patterns" },
    { "from": "matched_ignore", "to": "walk_parallel", "label": "prune subtrees" },
    { "from": "pattern_matcher", "to": "regex_builder", "label": "RustRegex default" },
    { "from": "regex_builder", "to": "configured_hir", "label": "parse and analyze" },
    { "from": "configured_hir", "to": "regex_matcher", "label": "to_regex() compile" },
    { "from": "regex_matcher", "to": "matcher_trait", "label": "implements" },
    { "from": "pattern_matcher", "to": "pcre2", "label": "-P behind feature flag" },
    { "from": "pcre2", "to": "matcher_trait", "label": "implements" },
    { "from": "worker", "to": "searcher", "label": "search(&haystack)" },
    { "from": "searcher", "to": "search_path", "label": "search_path/search_slice" },
    { "from": "search_path", "to": "mmap_choice", "label": "mmap when beneficial" },
    { "from": "search_path", "to": "glue_read", "label": "streaming fallback" },
    { "from": "glue_read", "to": "line_buffer", "label": "64 KB rolling reads" },
    { "from": "glue_read", "to": "core_loop", "label": "match_by_line" },
    { "from": "core_loop", "to": "fast_loop", "label": "fast path" },
    { "from": "fast_loop", "to": "candidate_line", "label": "probe before confirm" },
    { "from": "core_loop", "to": "sink", "label": "sinks matches" },
    { "from": "printer_enum", "to": "printer_standard", "label": "Standard/Summary/JSON" },
    { "from": "printer_standard", "to": "sink", "label": "sink_with_path" }
  ]
}

node_main -->|"dispatch"| node_flags_parse
node_flags_parse -->|"LowArgs to HiArgs"| node_hiargs
node_hiargs -->|"assembles"| node_worker
node_hiargs -->|"engine choice"| node_pattern_matcher
node_worker -->|"holds matcher"| node_pattern_matcher
node_worker -->|"holds printer"| node_printer_enum
node_hiargs -->|"walk_builder&#40;&#41; configures"| node_walk_builder
node_walk_builder -->|"build_parallel&#40;&#41;"| node_walk_parallel
node_walk_parallel -->|"worker pool size"| node_threads
node_walk_parallel -->|"per-directory state"| node_ignore_struct
node_ignore_struct -->|"precedence walk"| node_matched_ignore
node_matched_ignore -->|".gitignore/.ignore"| node_gitignore
node_gitignore -->|"matched&#40;&#41;"| node_gitignore_matched
node_gitignore -->|"backed by GlobSet"| node_globset
node_globset -->|"strategy dispatch"| node_globset_strats
node_globset_strats -->|"compiled patterns"| node_glob
node_matched_ignore -->|"prune subtrees"| node_walk_parallel
node_pattern_matcher -->|"RustRegex default"| node_regex_builder
node_regex_builder -->|"parse and analyze"| node_configured_hir
node_configured_hir -->|"to_regex&#40;&#41; compile"| node_regex_matcher
node_regex_matcher -->|"implements"| node_matcher_trait
node_pattern_matcher -->|"-P behind feature flag"| node_pcre2
node_pcre2 -->|"implements"| node_matcher_trait
node_worker -->|"search&#40;&amp;haystack&#41;"| node_searcher
node_searcher -->|"search_path/search_slice"| node_search_path
node_search_path -->|"mmap when beneficial"| node_mmap_choice
node_search_path -->|"streaming fallback"| node_glue_read
node_glue_read -->|"64 KB rolling reads"| node_line_buffer
node_glue_read -->|"match_by_line"| node_core_loop
node_core_loop -->|"fast path"| node_fast_loop
node_fast_loop -->|"probe before confirm"| node_candidate_line
node_core_loop -->|"sinks matches"| node_sink
node_printer_enum -->|"Standard/Summary/JSON"| node_printer_standard
node_printer_standard -->|"sink_with_path"| node_sink


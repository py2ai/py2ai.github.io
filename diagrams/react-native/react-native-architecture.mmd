node_app_registry -->|"renders component tree"| node_react_fabric
node_app_registry -->|"native access"| node_turbo_registry
node_react_fabric -->|"commits via host object"| node_ui_manager_binding
node_react_fabric -->|"runs inside a JSI runtime"| node_jsi_runtime
node_react_fabric -->|"imports for native props"| node_turbo_registry
node_turbo_registry -->|"resolves module by name"| node_turbomodule_binding
node_native_modules -->|"batched remote calls"| node_message_queue
node_message_queue -->|"legacy async bridge"| node_native_to_js
node_native_to_js -->|"executes bundles"| node_js_executor
node_native_to_js -->|"schedules JS-thread work"| node_call_invoker
node_native_to_js -->|"resolves native modules"| node_module_registry
node_js_executor -->|"targets a JSI runtime"| node_jsi_runtime
node_call_invoker -->|"invokes on JS thread"| node_jsi_runtime
node_ui_manager_binding -->|"delegates to C++ manager"| node_ui_manager
node_ui_manager_binding -->|"exposed as HostObject"| node_jsi_runtime
node_ui_manager -->|"commits through"| node_scheduler
node_scheduler -->|"drives tryCommit/commit"| node_shadow_tree
node_shadow_tree -->|"stores immutable revisions"| node_shadow_node
node_component_descriptor -->|"createShadowNode/cloneShadowNode"| node_shadow_node
node_shadow_node -->|"measures layout"| node_yoga_calc
node_shadow_node -->|"backed by YGNode"| node_ygnode
node_shadow_tree -->|"publishes revisions"| node_mounting_coordinator
node_mounting_coordinator -->|"records commit timings"| node_telemetry
node_shadow_node -->|"emits user events"| node_event_dispatcher
node_event_dispatcher -->|"invokes JS handlers"| node_jsi_runtime
node_turbomodule_binding -->|"instantiates lazily"| node_turbomodule
node_turbomodule -->|"extends jsi::HostObject"| node_host_object
node_turbomodule -->|"called directly over JSI"| node_jsi_runtime
node_turbomodule_binding -->|"registers C++ modules"| node_cxx_utils
node_turbomodule_binding -->|"preserves callbacks"| node_long_lived
node_bridging -->|"converts C++ types"| node_jsi_value
node_codegen -->|"generates typed specs"| node_turbomodule
node_feature_flags -->|"gates renderer behavior"| node_scheduler


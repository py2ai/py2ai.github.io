node_app -->|"App.run&#40;&#41; delegates"| node_run_touch_app
node_run_touch_app -->|"EventLoop.run&#40;&#41;"| node_event_loop
node_event_loop -->|"idle&#40;&#41;: Clock.tick&#40;&#41;"| node_clock
node_clock -->|"schedules next frame"| node_event_loop
node_run_touch_app -->|"MTWindow becomes the listener"| node_window
node_event_loop -->|"dispatch on_draw / on_flip"| node_window
node_input_factory -->|"get&#40;id&#41; then start&#40;&#41;"| node_provider
node_provider -->|"update&#40;&#41; emits touches"| node_motion_event
node_motion_event -->|"begin/update/end queue"| node_event_loop
node_event_loop -->|"dispatch to grabbed widgets"| node_widget
node_window -->|"on_touch_down walks children"| node_widget
node_widget -->|"children that are Layouts"| node_box_layout
node_box_layout -->|"repositions pos/size"| node_widget
node_widget -->|"widget.canvas.add&#40;&#41;"| node_render_context
node_render_context -->|"compile before draw"| node_compiler


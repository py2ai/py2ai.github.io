{
  "owner": "kivy",
  "repo": "kivy",
  "branch": "master",
  "groups": [
    {"id": "entry", "name": "entry", "label": "App Entrypoint"},
    {"id": "loop", "name": "loop", "label": "Event Loop"},
    {"id": "input", "name": "input", "label": "Input Providers"},
    {"id": "uix", "name": "uix", "label": "Widget Tree"},
    {"id": "graphics", "name": "graphics", "label": "Graphics Compiler"}
  ],
  "nodes": [
    {"id": "app", "label": "App", "file": "app.py", "path": "kivy/app.py", "group": "entry", "groupId": "entry", "desc": "Owns the root widget and lifecycle events; App.run() delegates to runTouchApp"},
    {"id": "run_touch_app", "label": "runTouchApp()", "file": "base.py", "path": "kivy/base.py", "group": "entry", "groupId": "entry", "desc": "Static main that prepares the window and starts the frame pump"},
    {"id": "event_loop", "label": "EventLoopBase", "file": "base.py", "path": "kivy/base.py", "group": "loop", "groupId": "loop", "desc": "Singleton EventLoop: run() spins idle() until quit"},
    {"id": "clock", "label": "ClockBase", "file": "clock.py", "path": "kivy/clock.py", "group": "loop", "groupId": "loop", "desc": "Frame scheduler over the Cython CyClockBase; tick() and tick_draw() bound by maxfps"},
    {"id": "window", "label": "WindowBase", "file": "__init__.py", "path": "kivy/core/window/__init__.py", "group": "loop", "groupId": "loop", "desc": "Root input listener; dispatches on_draw and on_flip each redraw"},
    {"id": "input_factory", "label": "MotionEventFactory", "file": "factory.py", "path": "kivy/input/factory.py", "group": "input", "groupId": "input", "desc": "Registry that maps provider ids (mouse, mtdev, tuio...) to classes"},
    {"id": "provider", "label": "MotionEventProvider", "file": "provider.py", "path": "kivy/input/provider.py", "group": "input", "groupId": "input", "desc": "start()/stop() lifecycle; update() polls the device each frame"},
    {"id": "motion_event", "label": "MotionEvent", "file": "motionevent.py", "path": "kivy/input/motionevent.py", "group": "input", "groupId": "input", "desc": "Abstract touch with pos, push/pop stack and grab() bookkeeping"},
    {"id": "widget", "label": "Widget", "file": "widget.py", "path": "kivy/uix/widget.py", "group": "uix", "groupId": "uix", "desc": "EventDispatcher with its own canvas; collide_point and walk() build the tree"},
    {"id": "box_layout", "label": "BoxLayout", "file": "boxlayout.py", "path": "kivy/uix/boxlayout.py", "group": "uix", "groupId": "uix", "desc": "Layout subclass; do_layout() positions children along one orientation"},
    {"id": "render_context", "label": "RenderContext", "file": "instructions.pyx", "path": "kivy/graphics/instructions.pyx", "group": "graphics", "groupId": "graphics", "desc": "Canvas with a shader; owns the GraphicsCompiler instance"},
    {"id": "compiler", "label": "GraphicsCompiler", "file": "compiler.pyx", "path": "kivy/graphics/compiler.pyx", "group": "graphics", "groupId": "graphics", "desc": "Folds context changes and flags unchanged state GI_IGNORE to skip re-apply"}
  ],
  "edges": [
    {"from": "app", "to": "run_touch_app", "label": "App.run() delegates"},
    {"from": "run_touch_app", "to": "event_loop", "label": "EventLoop.run()"},
    {"from": "event_loop", "to": "clock", "label": "idle(): Clock.tick()"},
    {"from": "clock", "to": "event_loop", "label": "schedules next frame"},
    {"from": "run_touch_app", "to": "window", "label": "MTWindow becomes the listener"},
    {"from": "event_loop", "to": "window", "label": "dispatch on_draw / on_flip"},
    {"from": "input_factory", "to": "provider", "label": "get(id) then start()"},
    {"from": "provider", "to": "motion_event", "label": "update() emits touches"},
    {"from": "motion_event", "to": "event_loop", "label": "begin/update/end queue"},
    {"from": "event_loop", "to": "widget", "label": "dispatch to grabbed widgets"},
    {"from": "window", "to": "widget", "label": "on_touch_down walks children"},
    {"from": "widget", "to": "box_layout", "label": "children that are Layouts"},
    {"from": "box_layout", "to": "widget", "label": "repositions pos/size"},
    {"from": "widget", "to": "render_context", "label": "widget.canvas.add()"},
    {"from": "render_context", "to": "compiler", "label": "compile before draw"}
  ]
}

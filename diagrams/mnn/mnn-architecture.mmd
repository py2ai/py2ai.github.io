node_converter_main -->|"delegates to"| node_cli
node_cli -->|"writes models against"| node_schema
node_conv_common -->|"reads conv params from"| node_schema
node_schema -->|"deserialized by"| node_interpreter
node_schema -->|"re-parsed by"| node_module_impl
node_interpreter -->|"streams model with"| node_file_loader
node_interpreter -->|"spawns"| node_session
node_interpreter -->|"plans a session via"| node_schedule
node_schedule -->|"hands ScheduleInfo to"| node_session
node_session -->|"materializes ops via"| node_geometry
node_conv_common -->|"supplies unpacked weights to"| node_cpu_conv
node_schedule -->|"selects backends via"| node_runtime_factory
node_runtime_factory -->|"builds runtimes against"| node_backend_api
node_backend_api -->|"implemented by"| node_cpu_backend
node_backend_api -->|"implemented by"| node_opencl
node_backend_api -->|"implemented by"| node_metal
node_cpu_backend -->|"probes SIMD features via"| node_cpu_info
node_cpu_backend -->|"creates executions in"| node_cpu_conv
node_cpu_conv -->|"specializes into"| node_conv_tiled
node_cpu_conv -->|"opts into when usable"| node_winograd
node_cpu_conv -->|"routes quantized conv to"| node_conv_int8
node_conv_int8 -->|"shares tiled GEMM with"| node_conv_tiled
node_kvcache -->|"uses mmap file primitives of"| node_file_loader
node_module -->|"runs vars through"| node_executor
node_module_impl -->|"implements"| node_module
node_module_impl -->|"acquires RuntimeManager from"| node_executor
node_executor -->|"requests runtimes from"| node_runtime_factory
node_nnops -->|"builds vars consumed by"| node_module
node_optimizer -->|"fuses modules for"| node_module
node_llm -->|"reads options from"| node_llm_config
node_llm -->|"encodes prompts with"| node_tokenizer
node_llm -->|"gathers input embeddings from"| node_embedding
node_llm -->|"loads transformer via"| node_module_impl
node_llm -->|"picks tokens via"| node_sampler
node_llm -->|"spills KV cache through"| node_kvcache
node_sampler -->|"reads sampling params from"| node_llm_config
node_pymnn_llm -->|"pybinds"| node_llm
node_pymnn -->|"exposes classic API to Python"| node_interpreter
node_pymnn -->|"exposes expr API to Python"| node_module


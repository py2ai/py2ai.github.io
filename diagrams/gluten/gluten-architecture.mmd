node_plugin -->|"appends extension name"| node_extensions
node_plugin -->|"checks off-heap settings"| node_coreconfig
node_plugin -.->|"off-heap budget"| node_memtarget
node_extensions -->|"registers columnar rule"| node_columnarrule
node_columnarrule -->|"applies offload rules"| node_offload
node_columnarrule -->|"evaluates fallback"| node_policy
node_policy -->|"tags unsupported plans"| node_fallbackrules
node_fallbackrules -->|"sets fallback tag"| node_fallbacktag
node_policy -.->|"velox partial offload"| node_partialfallback
node_policy -.->|"fallback exits columnar"| node_c2r
node_columnarrule -.->|"inserts R2C transition"| node_r2c
node_offload -->|"produces transformers"| node_wst
node_wst -->|"resolves backend"| node_backendsapi
node_wst -->|"makePlan"| node_planbuilder
node_wst -->|"columnar exchange"| node_shuffle
node_planbuilder -->|"rel nodes"| node_planrel
node_planrel -->|"expressions"| node_exprbuilder
node_backendsapi -->|"active backend"| node_backend
node_backend -->|"supplies IteratorApi"| node_iteratorapi
node_backend -->|"supplies ValidatorApi"| node_validatorapi
node_iteratorapi -->|"NativePlanEvaluator.create"| node_evaluator
node_validatorapi -->|"native plan validation"| node_evaluator
node_evaluator -->|"JNI plan bytes"| node_planconv
node_evaluator -->|"row-to-columnar JNI"| node_r2cjni
node_planconv -->|"Velox PlanNode tree"| node_resultiter
node_resultiter -->|"wraps RowVectors"| node_veloxbatches
node_veloxbatches -->|"Spark ColumnarBatch"| node_batches
node_batches -->|"load/offload via JNI"| node_batchjni
node_iteratorapi -->|"attaches metrics"| node_metricsjni
node_metricsjni -.->|"native metrics reported"| node_wst
node_backendcc -->|"per-task runtime"| node_runtimecc
node_runtimecc -->|"drives execution"| node_resultiter


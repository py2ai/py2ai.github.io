subgraph group_sdk["SDK Core"]
  node_agent{{"Agent main class<br/>orchestrator"}}
  node_agentsession["agent session state<br/>[_session.py]"]
  node_agentmsg["message building<br/>[_messages.py]"]
  node_agenttools["tool resolution<br/>[_tools.py]"]
  node_agentstorage["storage wiring<br/>[_storage.py]"]
  node_team["Team with modes<br/>orchestrator"]
  node_workflow{{"Workflow orchestrator<br/>[workflow.py]"}}
  node_wfstep["step primitive<br/>[step.py]"]
  node_wfparallel["parallel branching<br/>[parallel.py]"]
  node_wfcondition["conditional branching<br/>[condition.py]"]
end

subgraph group_models["Model Adapters"]
  node_modelbase["Model ABC &#40;invoke&#41;<br/>abstraction"]
  node_openai["OpenAI adapter"]
  node_anthropic["Anthropic adapter"]
  node_google["Gemini adapter"]
  node_ollama["Ollama local adapter"]
end

subgraph group_tools["Tools"]
  node_toolkit["Toolkit base class<br/>abstraction"]
  node_mcp["MCP client tools"]
  node_shell["shell toolkit<br/>[shell.py]"]
end

subgraph group_runtime["AgentOS Runtime"]
  node_agentos{{"AgentOS FastAPI app<br/>orchestrator"}}
  node_router["50+ REST routes<br/>[router.py]"]
  node_mcpserver["AgentOS MCP server<br/>[mcp.py]"]
  node_interfaces["Slack, A2A, AG-UI"]
  node_authz["RBAC authorization"]
  node_eventstreams["event stream backends"]
end

subgraph group_data["State and Knowledge"]
  node_db[("storage abstraction<br/>database")]
  node_postgres[("Postgres backend<br/>database")]
  node_memory["memory manager<br/>[manager.py]"]
  node_knowledge[("knowledge base<br/>database")]
  node_vectordb[("vector stores<br/>database")]
end

subgraph group_control["Run Control"]
  node_run["run control types"]
  node_approval["human approval<br/>[approval.py]"]
  node_scheduler["cron scheduler"]
end

subgraph group_ops["Observability"]
  node_tracing["OpenTelemetry tracing"]
  node_eval["eval harness"]
end


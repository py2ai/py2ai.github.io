node_job -->|"adds scheduling and SCM wiring"| node_abstract_project
node_abstract_project -->|"concrete classic subclass"| node_freestyle
node_job -->|"each execution records a Run"| node_run
node_run -->|"adds workspace and Queue.Executable"| node_abstract_build
node_descriptor -->|"DescriptorImpl @Extension&#40;ordinal = 1000&#41;"| node_freestyle
node_abstract_project -->|"scheduleBuild2&#40;&#41; calls schedule2&#40;&#41;"| node_queue
node_queue -->|"Refused, Existing or Created"| node_schedule_result
node_queue -->|"tasks are SubTasks with createExecutable&#40;&#41;"| node_sub_task
node_sub_task -->|"MappingWorksheet assigns slot-sized units"| node_work_unit
node_queue -->|"reorders items before dispatch"| node_queue_sorter
node_queue -->|"explains why an item is blocked"| node_cause_of_blockage
node_queue -->|"fires on every transition"| node_queue_listener
node_queue -->|"maintain&#40;&#41; hands units to idle threads"| node_executor
node_executor -->|"one Executor thread per node slot"| node_computer
node_computer -->|"leases a workspace directory per build"| node_workspace_list
node_executor -->|"createExecutable&#40;&#41; returns the build to run"| node_abstract_build
node_extension_point -->|"one typed list per marker"| node_extension_list
node_extension_list -->|"ensureLoaded&#40;&#41; scans via finders"| node_extension_finder

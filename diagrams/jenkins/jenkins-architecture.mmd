node_war_main -->|"Winstone serves the servlet that instantiates Jenkins"| node_jenkins
node_jenkins -->|"getPluginManager&#40;&#41; with uberClassLoader"| node_plugin_manager
node_plugin_manager -->|"install and update jobs run here"| node_update_center
node_jenkins -->|"top-level item group over persisted items"| node_item
node_item -->|"items can nest other items"| node_item_group

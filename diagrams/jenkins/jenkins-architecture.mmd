node_trigger -->|"pluggable scheduling source"| node_extension_point
node_scm -->|"pluggable source control"| node_extension_point
node_builder -->|"pluggable build steps"| node_extension_point
node_scm -->|"checkout happens inside the run"| node_abstract_build
node_builder -->|"perform&#40;&#41; called during the run"| node_abstract_build
node_jenkins -->|"getExtensionList&#40;Class&#41;"| node_extension_list
node_extension_list -->|"refreshes when plugins arrive"| node_jenkins
node_queue -->|"maintainer thread owned by the controller"| node_jenkins
node_cli_client -->|"duplex stream over plain HTTP"| node_full_duplex
node_full_duplex -->|"dispatches named commands"| node_cli_command
node_cli_command -->|"implements ExtensionPoint, Cloneable"| node_extension_point
node_agent_protocol -->|"pluggable inbound agent protocols"| node_extension_point
node_computer -->|"agents connect through registered protocols"| node_agent_protocol
node_executor -->|"grabbed WorkUnit under the queue lock"| node_queue


{
  "owner": "tensorflow",
  "repo": "tensorflow",
  "branch": "master",
  "groups": [
    {"id": "pyapi", "name": "Python Front-End", "label": "Python Front-End"},
    {"id": "tracing", "name": "tf.function Tracing", "label": "tf.function Tracing"},
    {"id": "bridge", "name": "Python-C++ Bridge", "label": "Python-C++ Bridge"},
    {"id": "cpprun", "name": "C++ Eager Runtime", "label": "C++ Eager Runtime"},
    {"id": "grappler", "name": "Grappler Optimizer", "label": "Grappler Optimizer"}
  ],
  "nodes": [
    {"id": "pyops", "label": "Ops and Graph", "file": "tensorflow/python/framework/ops.py", "group": "pyapi", "desc": "Python op wrappers; the Graph class that FuncGraph builds on", "path": "tensorflow/python/framework/ops.py", "groupId": "pyapi", "shape": "hexagon"},
    {"id": "pyctx", "label": "Eager Context", "file": "tensorflow/python/eager/context.py", "group": "pyapi", "desc": "Global eager mode, device and dtype policy", "path": "tensorflow/python/eager/context.py", "groupId": "pyapi", "shape": "box"},
    {"id": "tf_function", "label": "tf.function", "file": "tensorflow/python/eager/polymorphic_function/polymorphic_function.py", "group": "tracing", "desc": "Decorator that wraps Python callables into traced functions", "path": "tensorflow/python/eager/polymorphic_function/polymorphic_function.py", "groupId": "tracing", "shape": "hexagon"},
    {"id": "trace_call", "label": "Trace and Cache", "file": "tensorflow/python/eager/polymorphic_function/tracing_compilation.py", "group": "tracing", "desc": "Cache lookup, tracing and ConcreteFunction creation", "path": "tensorflow/python/eager/polymorphic_function/tracing_compilation.py", "groupId": "tracing", "shape": "box"},
    {"id": "fgraph", "label": "FuncGraph", "file": "tensorflow/python/framework/func_graph.py", "group": "tracing", "desc": "Records ops while the Python body executes", "path": "tensorflow/python/framework/func_graph.py", "groupId": "tracing", "shape": "box"},
    {"id": "quick_exec", "label": "quick_execute", "file": "tensorflow/python/eager/execute.py", "group": "bridge", "desc": "pybind entry that crosses into the C API", "path": "tensorflow/python/eager/execute.py", "groupId": "bridge", "shape": "box"},
    {"id": "capi", "label": "TFE C API", "file": "tensorflow/c/eager/c_api.cc", "group": "bridge", "desc": "TFE_Execute and friends across the language boundary", "path": "tensorflow/c/eager/c_api.cc", "groupId": "bridge", "shape": "box"},
    {"id": "eagerop", "label": "EagerOperation", "file": "tensorflow/core/common_runtime/eager/eager_operation.cc", "group": "cpprun", "desc": "Op name, attrs, inputs and device placement", "path": "tensorflow/core/common_runtime/eager/eager_operation.cc", "groupId": "cpprun", "shape": "box"},
    {"id": "executor", "label": "Eager Executor", "file": "tensorflow/core/common_runtime/eager/eager_executor.cc", "group": "cpprun", "desc": "Sync or async queue of pending execution nodes", "path": "tensorflow/core/common_runtime/eager/eager_executor.cc", "groupId": "cpprun", "shape": "box"},
    {"id": "kernellaunch", "label": "KernelAndDevice", "file": "tensorflow/core/common_runtime/eager/kernel_and_device.cc", "group": "cpprun", "desc": "Runs registered kernels or an optimized FunctionDef", "path": "tensorflow/core/common_runtime/eager/kernel_and_device.cc", "groupId": "cpprun", "shape": "box"},
    {"id": "itembuild", "label": "Grappler Item Builder", "file": "tensorflow/core/grappler/grappler_item_builder.cc", "group": "grappler", "desc": "Wraps GraphDef plus fetch tensors into a GrapplerItem", "path": "tensorflow/core/grappler/grappler_item_builder.cc", "groupId": "grappler", "shape": "box"},
    {"id": "metaopt", "label": "MetaOptimizer", "file": "tensorflow/core/grappler/optimizers/meta_optimizer.cc", "group": "grappler", "desc": "Schedules and runs the concrete Grappler passes", "path": "tensorflow/core/grappler/optimizers/meta_optimizer.cc", "groupId": "grappler", "shape": "hexagon"}
  ],
  "edges": [
    {"from": "pyctx", "to": "pyops", "label": "mode and device policy"},
    {"from": "pyops", "to": "quick_exec", "label": "eager op dispatch"},
    {"from": "tf_function", "to": "trace_call", "label": "first call: cache miss"},
    {"from": "trace_call", "to": "fgraph", "label": "trace Python body"},
    {"from": "trace_call", "to": "quick_exec", "label": "cache hit: TFE_Execute"},
    {"from": "fgraph", "to": "itembuild", "label": "GraphDef plus fetches"},
    {"from": "itembuild", "to": "metaopt", "label": "GrapplerItem"},
    {"from": "metaopt", "to": "kernellaunch", "label": "optimized FunctionDef"},
    {"from": "quick_exec", "to": "capi", "label": "quick_execute"},
    {"from": "capi", "to": "eagerop", "label": "build op"},
    {"from": "eagerop", "to": "executor", "label": "enqueue or sync run"},
    {"from": "executor", "to": "kernellaunch", "label": "run pending node"},
    {"from": "kernellaunch", "to": "capi", "label": "TensorHandle outputs"}
  ]
}

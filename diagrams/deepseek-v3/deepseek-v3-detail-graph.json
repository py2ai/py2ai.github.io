{
  "owner": "deepseek-ai",
  "repo": "DeepSeek-V3",
  "branch": "main",
  "groups": [
    { "id": "entry", "name": "Generation Entry", "label": "Generation Entry" },
    { "id": "model", "name": "Model Core", "label": "Model Core" },
    { "id": "attention", "name": "MLA Attention", "label": "MLA Attention" },
    { "id": "moe", "name": "Mixture of Experts", "label": "Mixture of Experts" },
    { "id": "quant", "name": "FP8 Kernels", "label": "FP8 Kernels" },
    { "id": "weights", "name": "Weights & Config", "label": "Weights & Config" }
  ],
  "nodes": [
    { "id": "gen_main", "label": "main()", "file": "inference/generate.py", "path": "inference/generate.py", "group": "entry", "groupId": "entry", "desc": "CLI entry: NCCL setup, config load, chat or batch mode", "shape": "hexagon" },
    { "id": "generate", "label": "generate()", "file": "inference/generate.py", "path": "inference/generate.py", "group": "entry", "groupId": "entry", "desc": "Incremental decoding loop over cached positions" },
    { "id": "sample", "label": "sample()", "file": "inference/generate.py", "path": "inference/generate.py", "group": "entry", "groupId": "entry", "desc": "Temperature sampling via exponential-gumbel trick" },
    { "id": "transformer", "label": "Transformer", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "Embed, layers, norm, vocab head; owns global TP rank state" },
    { "id": "block", "label": "Block", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "Residual attention then FFN, each pre-normed" },
    { "id": "modelargs", "label": "ModelArgs", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "All hyperparameters: dims, experts, MLA ranks, YaRN" },
    { "id": "parallel_embed", "label": "ParallelEmbedding", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "Vocab-sharded embedding with all-reduce" },
    { "id": "rmsnorm", "label": "RMSNorm", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "Root-mean-square norm used throughout" },
    { "id": "freqs", "label": "precompute_freqs_cis", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "YaRN-corrected rotary frequency table" },
    { "id": "rotary", "label": "apply_rotary_emb", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "Complex-multiply rotary embedding on rope dims" },
    { "id": "linear", "label": "Linear", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "Quantization-aware linear layer, fp8 or bf16" },
    { "id": "col_parallel", "label": "ColumnParallelLinear", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "Output-feature sharded linear (wq, w1, w3, head)" },
    { "id": "row_parallel", "label": "RowParallelLinear", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "Input-feature sharded linear with all-reduce (wo, w2)" },
    { "id": "mlp", "label": "MLP", "file": "inference/model.py", "path": "inference/model.py", "group": "model", "groupId": "model", "desc": "SwiGLU feed-forward: w2(silu(w1 x) * w3 x)" },
    { "id": "mla", "label": "MLA", "file": "inference/model.py", "path": "inference/model.py", "group": "attention", "groupId": "attention", "desc": "Multi-head Latent Attention, naive vs absorb KV caches" },
    { "id": "moe", "label": "MoE", "file": "inference/model.py", "path": "inference/model.py", "group": "moe", "groupId": "moe", "desc": "Routes tokens to local experts, adds shared experts" },
    { "id": "gate", "label": "Gate", "file": "inference/model.py", "path": "inference/model.py", "group": "moe", "groupId": "moe", "desc": "Sigmoid scores + expert bias, grouped top-k selection" },
    { "id": "expert", "label": "Expert", "file": "inference/model.py", "path": "inference/model.py", "group": "moe", "groupId": "moe", "desc": "One routed expert: SwiGLU MLP on its token subset" },
    { "id": "linear_fn", "label": "linear()", "file": "inference/model.py", "path": "inference/model.py", "group": "quant", "groupId": "quant", "desc": "Dispatch: bf16 F.linear, dequant path, or fp8 GEMM" },
    { "id": "act_quant", "label": "act_quant", "file": "inference/kernel.py", "path": "inference/kernel.py", "group": "quant", "groupId": "quant", "desc": "Block-wise fp8 quantization of activations, 128 tile" },
    { "id": "act_quant_kernel", "label": "act_quant_kernel", "file": "inference/kernel.py", "path": "inference/kernel.py", "group": "quant", "groupId": "quant", "desc": "Triton kernel: amax per tile, scale to fp8, ue8m0 option" },
    { "id": "weight_dequant", "label": "weight_dequant", "file": "inference/kernel.py", "path": "inference/kernel.py", "group": "quant", "groupId": "quant", "desc": "Triton dequant of fp8 weights times 128x-block scales" },
    { "id": "fp8_gemm", "label": "fp8_gemm", "file": "inference/kernel.py", "path": "inference/kernel.py", "group": "quant", "groupId": "quant", "desc": "fp8 matmul wrapper with autotuned tile configs" },
    { "id": "fp8_gemm_kernel", "label": "fp8_gemm_kernel", "file": "inference/kernel.py", "path": "inference/kernel.py", "group": "quant", "groupId": "quant", "desc": "Triton kernel: K-loop of tl.dot scaled by block scales" },
    { "id": "convert", "label": "convert.py", "file": "inference/convert.py", "path": "inference/convert.py", "group": "weights", "groupId": "weights", "desc": "HF name mapping, expert sharding, model-mp splits" },
    { "id": "fp8_cast", "label": "fp8_cast_bf16.py", "file": "inference/fp8_cast_bf16.py", "path": "inference/fp8_cast_bf16.py", "group": "weights", "groupId": "weights", "desc": "Whole-checkpoint fp8 to bf16 weight conversion" },
    { "id": "config", "label": "config_671B.json", "file": "inference/configs/config_671B.json", "path": "inference/configs/config_671B.json", "group": "weights", "groupId": "weights", "desc": "671B hyperparameters feeding ModelArgs", "shape": "document" }
  ],
  "edges": [
    { "from": "gen_main", "to": "generate", "label": "calls" },
    { "from": "gen_main", "to": "modelargs", "label": "builds from JSON" },
    { "from": "gen_main", "to": "config", "label": "reads" },
    { "from": "generate", "to": "transformer", "label": "forward per step" },
    { "from": "generate", "to": "sample", "label": "temperature sampling" },
    { "from": "transformer", "to": "parallel_embed", "label": "embed tokens" },
    { "from": "transformer", "to": "block", "label": "n_layers x" },
    { "from": "transformer", "to": "col_parallel", "label": "lm head" },
    { "from": "transformer", "to": "freqs", "label": "precompute RoPE" },
    { "from": "transformer", "to": "rmsnorm", "label": "final norm" },
    { "from": "block", "to": "mla", "label": "attn" },
    { "from": "block", "to": "moe", "label": "MoE layers" },
    { "from": "block", "to": "mlp", "label": "dense layer 0" },
    { "from": "block", "to": "rmsnorm", "label": "pre-norm x2" },
    { "from": "mla", "to": "rotary", "label": "apply RoPE" },
    { "from": "mla", "to": "col_parallel", "label": "wq_b / wkv_b" },
    { "from": "mla", "to": "row_parallel", "label": "wo" },
    { "from": "mla", "to": "rmsnorm", "label": "q_norm / kv_norm" },
    { "from": "mla", "to": "linear_fn", "label": "absorb path" },
    { "from": "moe", "to": "gate", "label": "route tokens" },
    { "from": "moe", "to": "expert", "label": "routed experts" },
    { "from": "moe", "to": "mlp", "label": "shared experts" },
    { "from": "expert", "to": "linear", "label": "w1 / w2 / w3" },
    { "from": "mlp", "to": "col_parallel", "label": "w1 / w3" },
    { "from": "mlp", "to": "row_parallel", "label": "w2" },
    { "from": "gate", "to": "linear_fn", "label": "scores" },
    { "from": "col_parallel", "to": "linear", "label": "inherits" },
    { "from": "row_parallel", "to": "linear", "label": "inherits" },
    { "from": "linear", "to": "linear_fn", "label": "forward" },
    { "from": "linear_fn", "to": "weight_dequant", "label": "bf16 path" },
    { "from": "linear_fn", "to": "act_quant", "label": "fp8 path" },
    { "from": "linear_fn", "to": "fp8_gemm", "label": "fp8 GEMM" },
    { "from": "act_quant", "to": "act_quant_kernel", "label": "triton" },
    { "from": "fp8_gemm", "to": "fp8_gemm_kernel", "label": "triton" },
    { "from": "fp8_cast", "to": "weight_dequant", "label": "cast weights" },
    { "from": "convert", "to": "transformer", "label": "sharded checkpoints" }
  ]
}

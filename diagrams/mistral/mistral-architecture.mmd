node_cli -->|"loads"| node_args
node_cli -->|"runs"| node_generate
node_deploy -.->|"packages"| node_cli
node_generate -->|"programs against"| node_model_base
node_generate -->|"steps"| node_transformer
node_generate -->|"steps"| node_mamba
node_model_base -.->|"base of"| node_transformer
node_model_base -.->|"base of"| node_mamba
node_transformer -->|"stacks blocks"| node_layers
node_layers -->|"positions via"| node_rope
node_transformer -->|"allocates"| node_cache
node_cache -.->|"supplies views to"| node_layers
node_layers -->|"replaces FFN with"| node_moe
node_moe -.->|"experts live in"| node_layers
node_mamba -->|"stores state in"| node_cache
node_vision_encoder -.->|"2D positions from"| node_rope
node_vision_encoder -->|"embeddings into"| node_transformer
node_transformer -.->|"wraps with"| node_lora
node_tests -.->|"verify"| node_cache
node_tests -.->|"verify"| node_mamba
node_tests -.->|"verify"| node_vision_encoder
node_tutorials -.->|"call"| node_generate


flowchart TD

subgraph group_api["API Layer"]
  node_api["TTS Class<br/>public API"]
  node_synthesizer["Synthesizer<br/>engine"]
  node_manager[("Model Manager<br/>model registry")]
  node_server["Demo Server<br/>Flask app"]
end

subgraph group_ttsmodels["Acoustic Models"]
  node_base_tts["BaseTTS Model<br/>abstract base"]
  node_xtts{{"XTTSv2<br/>flagship model"}}
  node_vits["VITS<br/>acoustic model"]
  node_forward_tts["ForwardTTS<br/>acoustic family"]
  node_tacotron["Tacotron<br/>acoustic family"]
  node_glow_tts["Glow-TTS<br/>acoustic model"]
  node_tortoise["Tortoise<br/>acoustic model"]
end

subgraph group_xttsguts["XTTS Internals"]
  node_gpt{{"GPT Transformer<br/>transformer core"}}
  node_gpt_inference["GPT Inference<br/>inference wrapper"]
  node_stream_generator["Stream Generator<br/>streaming"]
  node_tokenizer["Tokenizer<br/>vocabulary"]
  node_hifigan_decoder["HiFi-GAN Decoder<br/>[hifigan_decoder.py]"]
  node_dvae["Discrete VAE<br/>audio codec"]
  node_perceiver["Perceiver Encoder<br/>attention encoder"]
  node_xtts_manager[("Speaker Manager<br/>embedding store")]
end

subgraph group_audio["Audio Stack"]
  node_vocoder_gan[("GAN Vocoders<br/>vocoder family")]
  node_hifigan_gen["HiFi-GAN Generator<br/>vocoder"]
  node_wavernn["WaveRNN<br/>vocoder"]
  node_speaker_encoder["Speaker Encoder<br/>voice embedding"]
  node_freevc["FreeVC<br/>voice conversion"]
end

subgraph group_ops["Operations"]
  node_train_tts["Train TTS<br/>training entry"]
  node_train_vocoder["Train Vocoder<br/>training entry"]
  node_synthesize["Synthesize CLI<br/>CLI tool"]
  node_compute_embeddings["Compute Embeddings<br/>CLI tool"]
  node_resample["Resample<br/>CLI tool"]
end

subgraph group_support["Support"]
  node_audio_processor["Audio Processor<br/>signal utils"]
  node_voices[("Voice Cloning Cache<br/>caching")]
  node_downloaders["Downloaders<br/>fetch utils"]
  node_shared_configs[("Shared Configs<br/>config classes")]
  node_hubconf["Torch Hub Entry<br/>hub entry point"]
end

node_api -->|"drives the"| node_synthesizer
node_api -->|"resolves models via"| node_manager
node_server -->|"serves the"| node_api
node_manager -.->|"fetches with"| node_downloaders
node_synthesizer -->|"runs any model through"| node_base_tts
node_base_tts -.->|"parents"| node_tacotron
node_base_tts -.->|"parents"| node_forward_tts
node_forward_tts -.->|"family of fast models with"| node_glow_tts
node_base_tts -.->|"parents"| node_vits
node_xtts -->|"generates through the"| node_gpt
node_xtts -->|"encodes references with the"| node_dvae
node_xtts -->|"reads text via the"| node_tokenizer
node_xtts -.->|"decodes via"| node_gpt_inference
node_gpt_inference -.->|"streams via the"| node_stream_generator
node_xtts -->|"renders mels with the"| node_hifigan_decoder
node_xtts -.->|"condenses speakers via the"| node_perceiver
node_xtts -.->|"stores speakers in the"| node_xtts_manager
node_forward_tts -.->|"mels to wave via"| node_vocoder_gan
node_vocoder_gan -->|"trains the"| node_hifigan_gen
node_vocoder_gan -.->|"alternatives beside"| node_wavernn
node_freevc -->|"embeds targets via the"| node_speaker_encoder
node_xtts -.->|"caches clones in"| node_voices
node_train_tts -->|"trains through"| node_base_tts
node_train_vocoder -->|"trains"| node_vocoder_gan
node_synthesize -->|"batch runs the"| node_synthesizer
node_compute_embeddings -.->|"precomputes latents with"| node_xtts
node_resample -.->|"converts via the"| node_audio_processor
node_base_tts -.->|"computes specs via the"| node_audio_processor
node_shared_configs -.->|"configures the"| node_tacotron
node_hubconf -.->|"loads models through the"| node_api


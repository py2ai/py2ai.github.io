flowchart TD

subgraph group_cli_entry["Single binary: cmd entrypoints"]
  node_main_entry["main.go cli app<br/>[main.go]"]
  node_web_cmd["gitea web<br/>[web.go]"]
  node_serv_cmd["gitea serv<br/>[serv.go]"]
  node_serv_nocommand["ServNoCommand shell probe<br/>[serv.go]"]
  node_lfs_auth["LFS auth + pure SSH transfer<br/>[serv.go]"]
  node_keys_cmd["gitea keys<br/>[keys.go]"]
end

subgraph group_web_routes["Web route layer &#40;routers/web&#41;"]
  node_web_router["web.go route mounting<br/>[web.go]"]
  node_githttp_router["githttp.go route table<br/>[githttp.go]"]
end

subgraph group_http_handlers["Smart HTTP handlers &#40;routers/web/repo&#41;"]
  node_http_base["httpBase gate<br/>[githttp.go]"]
  node_service_rpc["serviceRPC stream<br/>[githttp.go]"]
  node_info_refs["GetInfoRefs<br/>[githttp.go]"]
  node_pkt_line["pkt-line writers<br/>[githttp.go]"]
  node_dumb_serve["sendFile object serving<br/>[githttp.go]"]
end

subgraph group_internal_api["Internal API + hooks &#40;routers/private&#41;"]
  node_internal_routes["internal route registry<br/>[internal.go]"]
  node_internal_auth["X-Gitea-Internal-Auth<br/>[internal.go]"]
  node_serv_command["ServCommand<br/>[serv.go]"]
  node_agit_relax["AGit refs/for relaxation<br/>[serv.go]"]
  node_pre_receive["HookPreReceive"]
  node_force_push["force push + protected files"]
  node_signed_commits["signed commit enforcement"]
  node_post_receive["HookPostReceive"]
  node_proc_receive["HookProcReceive"]
end

subgraph group_git_module["Git module &#40;modules/git&#41;"]
  node_git_features["version + feature flags<br/>[git.go]"]
  node_gitcmd["gitcmd.Command<br/>[command.go]"]
  node_gitrepo["gitrepo helpers<br/>[gitrepo.go]"]
  node_catfile["cat-file batch readers<br/>[catfile_batch.go]"]
end

node_main_entry -->|"web subcommand"| node_web_cmd
node_main_entry -->|"serv subcommand"| node_serv_cmd
node_main_entry -->|"keys subcommand"| node_keys_cmd
node_web_cmd -->|"NormalRoutes"| node_web_router
node_web_router -->|"addOwnerRepoGitHTTPRouters"| node_githttp_router
node_githttp_router -->|"all git paths enter here"| node_http_base
node_http_base -->|"write/read mode granted"| node_service_rpc
node_http_base -->|"?service=..."| node_info_refs
node_info_refs -->|"advertise refs"| node_pkt_line
node_githttp_router -->|"GET object paths"| node_dumb_serve
node_service_rpc -->|"upload/receive-pack --stateless-rpc"| node_gitcmd
node_serv_cmd -->|"empty command"| node_serv_nocommand
node_serv_cmd -->|"git-lfs-authenticate &#124; lfs-transfer"| node_lfs_auth
node_serv_cmd -->|"GET /serv/command/&#123;keyid&#125;/&#123;owner&#125;/&#123;repo&#125;"| node_internal_routes
node_keys_cmd -->|"POST /ssh/authorized_keys"| node_internal_routes
node_internal_routes -->|"guarded"| node_internal_auth
node_internal_routes -->|"resolve"| node_serv_command
node_internal_routes -->|"POST /hook/pre-receive/..."| node_pre_receive
node_internal_routes -->|"POST /hook/post-receive/..."| node_post_receive
node_internal_routes -->|"POST /hook/proc-receive/..."| node_proc_receive
node_serv_command -->|"receive-pack on refs/for"| node_agit_relax
node_pre_receive -->|"protected branches"| node_force_push
node_pre_receive -->|"required signatures"| node_signed_commits
node_gitcmd -->|"open bare repo"| node_gitrepo
node_gitrepo -->|"object reads"| node_catfile
node_git_features -->|"capability gate"| node_gitcmd


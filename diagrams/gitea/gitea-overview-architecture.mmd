flowchart TD

subgraph group_http_entry["Smart HTTP entry &#40;routers/web&#41;"]
  node_client_http["git client &#40;HTTPS remote&#41;"]
  node_web_router["web.go mounts git routes<br/>[web.go]"]
  node_githttp_router["githttp.go route table<br/>[githttp.go]"]
end

subgraph group_http_handlers["Smart HTTP handlers"]
  node_http_base["httpBase auth + permission gate<br/>[githttp.go]"]
  node_service_rpc["serviceRPC runs git services<br/>[githttp.go]"]
  node_info_refs["GetInfoRefs advertisement<br/>[githttp.go]"]
end

subgraph group_ssh_entry["SSH entry &#40;cmd&#41;"]
  node_client_ssh["git client &#40;SSH remote&#41;"]
  node_sshd["sshd AuthorizedKeysCommand"]
  node_serv_cmd["gitea serv<br/>[serv.go]"]
  node_keys_cmd["gitea keys<br/>[keys.go]"]
end

subgraph group_internal_api["Internal API &#40;routers/private&#41;"]
  node_internal_api["internal HTTP API<br/>[internal.go]"]
end

subgraph group_git_exec["Git execution &#40;modules/git&#41;"]
  node_git_exec["gitcmd.Command subprocess<br/>[command.go]"]
end

node_client_http -->|"GET /info/refs?service=..."| node_web_router
node_web_router -->|"addOwnerRepoGitHTTPRouters"| node_githttp_router
node_githttp_router -->|"POST /git-upload-pack &#124; /git-receive-pack"| node_http_base
node_http_base -->|"auth ok, mode resolved"| node_service_rpc
node_githttp_router -->|"GET /info/refs"| node_info_refs
node_service_rpc -->|"--stateless-rpc"| node_git_exec
node_client_ssh -->|"git-upload-pack owner/repo.git"| node_sshd
node_sshd -->|"AuthorizedKeysCommand"| node_keys_cmd
node_sshd -->|"gitea serv key-&lt;id&gt;"| node_serv_cmd
node_serv_cmd -->|"GET /serv/command/..."| node_internal_api
node_keys_cmd -->|"POST /ssh/authorized_keys"| node_internal_api
node_internal_api -->|"repo path + permissions"| node_serv_cmd
node_serv_cmd -->|"spawn git-upload-pack / receive-pack"| node_git_exec


node_main -->|"serves UI + API on :9090"| node_web_handler
node_web_handler -->|"mounts /api/v1"| node_api
node_api -->|"compiles queries"| node_engine
node_engine -->|"pulls series via queriers"| node_db
node_main -->|"starts scrape manager"| node_scrape_manager
node_scrape_manager -->|"one loop per target"| node_scrape_loop
node_scrape_loop -->|"appends samples"| node_db
node_main -->|"starts rule manager"| node_rule_manager
node_rule_manager -->|"evaluates rule expressions"| node_engine
node_main -->|"opens local TSDB"| node_db
node_db -->|"fresh writes land here"| node_head
node_head -->|"records before ack"| node_wal
node_db -->|"background compaction"| node_compact
node_compact -->|"drains head into blocks"| node_head


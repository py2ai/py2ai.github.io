node_main -->|"opens TSDB storage"| node_db_open
node_main -->|"scrape.NewManager"| node_scrape_manager
node_main -->|"rules.NewManager"| node_rule_manager
node_main -->|"web.New"| node_web_handler
node_scrape_manager -->|"start goroutine"| node_scrape_run
node_scrape_run -->|"spawn per target"| node_scrape_loop
node_scrape_loop -->|"loop body"| node_loop_run
node_loop_run -->|"each interval"| node_scrape_and_report
node_scrape_and_report -->|"decoded samples"| node_db_appender
node_db_appender -->|"delegates to head"| node_head_append
node_head_append -->|"series into mem chunks"| node_head
node_head_append -->|"record before ack"| node_wal_log
node_db_open -->|"startup replay"| node_load_wal
node_load_wal -->|"rebuilds series"| node_head
node_db_open -->|"background loop"| node_db_compact
node_db_compact -->|"Plan + Write"| node_compactor_iface
node_compactor_iface -->|"default impl"| node_leveled_compactor
node_leveled_compactor -->|"writes index + chunks"| node_block_reader
node_web_handler -->|"mounts /api/v1"| node_api
node_web_handler -->|"run loop"| node_web_run
node_api -->|"GET/POST /query"| node_api_query
node_api -->|"GET/POST /query_range"| node_api_query_range
node_api_query -->|"one timestamp"| node_instant_query
node_api_query_range -->|"start/end/step"| node_range_query
node_instant_query -->|"submit"| node_exec_fn
node_range_query -->|"submit"| node_exec_fn
node_exec_fn -->|"evaluate AST"| node_exec_eval
node_exec_eval -->|"querier: newest samples"| node_head
node_exec_eval -->|"querier: old blocks"| node_block_reader
node_rule_manager -->|"runs groups"| node_rule_group
node_rule_group -->|"per interval"| node_group_eval
node_group_eval -->|"rule expressions"| node_exec_fn
node_group_eval -->|"state transitions"| node_alerting_rule


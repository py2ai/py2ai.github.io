node_client_main -->|"connect refused: lock socket, fork server"| node_server_start
node_server_start -->|"listen on unix socket"| node_server_accept
node_server_accept -->|"client command arrives"| node_cmd_new_session_exec
node_cmd_new_session_exec -->|"first window: create session"| node_session_create
node_cmd_new_session_exec -->|"spawn window"| node_window_create
node_window_create -->|"window holds panes"| node_window_pane_create
node_window_pane_create -->|"screen sized to pane"| node_screen_init
node_screen_init -->|"backing grid"| node_grid_create
node_window_pane_create -->|"bufferevent on pty fd"| node_window_pane_read_callback
node_window_pane_read_callback -->|"feed bytes"| node_input_parse
node_input_parse -->|"cells written, panes marked dirty"| node_redraw_draw


{
  "owner": "tmux",
  "repo": "tmux",
  "branch": "master",
  "groups": [
    {"id": "client", "name": "client", "label": "Client"},
    {"id": "server", "name": "server", "label": "Server"},
    {"id": "commands", "name": "commands", "label": "Commands"},
    {"id": "sessions", "name": "sessions", "label": "Sessions & Windows"},
    {"id": "screen", "name": "screen", "label": "Screen Model"},
    {"id": "parsing", "name": "parsing", "label": "PTY Input Parsing"},
    {"id": "render", "name": "render", "label": "Redraw & TTY"}
  ],
  "nodes": [
    {"id": "client_main", "label": "client_main", "file": "client.c", "path": "client.c", "group": "Client", "groupId": "client", "desc": "The tmux binary you type; connects to the server or starts one"},
    {"id": "server_start", "label": "server_start", "file": "server.c", "path": "server.c", "group": "Server", "groupId": "server", "desc": "Fork, daemonize, build the global windows/sessions trees"},
    {"id": "server_accept", "label": "server_accept", "file": "server.c", "path": "server.c", "group": "Server", "groupId": "server", "desc": "Accepts new client connections on the unix socket"},
    {"id": "cmd_new_session_exec", "label": "cmd_new_session_exec", "file": "cmd-new-session.c", "path": "cmd-new-session.c", "group": "Commands", "groupId": "commands", "desc": "Executes the new-session command sent by a client"},
    {"id": "session_create", "label": "session_create", "file": "session.c", "path": "session.c", "group": "Sessions & Windows", "groupId": "sessions", "desc": "Allocates struct session and inserts it into the sessions tree"},
    {"id": "window_create", "label": "window_create", "file": "window.c", "path": "window.c", "group": "Sessions & Windows", "groupId": "sessions", "desc": "Creates a window object owned by a session"},
    {"id": "window_pane_create", "label": "window_pane_create", "file": "window.c", "path": "window.c", "group": "Sessions & Windows", "groupId": "sessions", "desc": "Allocates a pane and opens its pty"},
    {"id": "screen_init", "label": "screen_init", "file": "screen.c", "path": "screen.c", "group": "Screen Model", "groupId": "screen", "desc": "Initializes the pane's screen: size, cursor, grid"},
    {"id": "grid_create", "label": "grid_create", "file": "grid.c", "path": "grid.c", "group": "Screen Model", "groupId": "screen", "desc": "Allocates the backing cell grid with scrollback"},
    {"id": "window_pane_read_callback", "label": "window_pane_read_callback", "file": "window.c", "path": "window.c", "group": "PTY Input Parsing", "groupId": "parsing", "desc": "bufferevent callback when the pane's program writes output"},
    {"id": "input_parse", "label": "input_parse", "file": "input.c", "path": "input.c", "group": "PTY Input Parsing", "groupId": "parsing", "desc": "Escape-sequence state machine consuming pty bytes"},
    {"id": "redraw_draw", "label": "redraw_draw", "file": "screen-redraw.c", "path": "screen-redraw.c", "group": "Redraw & TTY", "groupId": "render", "desc": "Draws window scenes to each attached client terminal"}
  ],
  "edges": [
    {"from": "client_main", "to": "server_start", "label": "connect refused: lock socket, fork server"},
    {"from": "server_start", "to": "server_accept", "label": "listen on unix socket"},
    {"from": "server_accept", "to": "cmd_new_session_exec", "label": "client command arrives"},
    {"from": "cmd_new_session_exec", "to": "session_create", "label": "first window: create session"},
    {"from": "cmd_new_session_exec", "to": "window_create", "label": "spawn window"},
    {"from": "window_create", "to": "window_pane_create", "label": "window holds panes"},
    {"from": "window_pane_create", "to": "screen_init", "label": "screen sized to pane"},
    {"from": "screen_init", "to": "grid_create", "label": "backing grid"},
    {"from": "window_pane_create", "to": "window_pane_read_callback", "label": "bufferevent on pty fd"},
    {"from": "window_pane_read_callback", "to": "input_parse", "label": "feed bytes"},
    {"from": "input_parse", "to": "redraw_draw", "label": "cells written, panes marked dirty"}
  ]
}

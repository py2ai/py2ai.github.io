node_client_main -->|"open the server socket"| node_client_connect
node_client_connect -->|"ECONNREFUSED: take flock"| node_client_get_lock
node_client_connect -->|"still no server: fork one"| node_server_start
node_server_start -->|"detach from caller"| node_proc_fork_and_daemon
node_proc_fork_and_daemon -->|"child binds socket"| node_server_create_socket
node_server_create_socket -->|"listen, EV_READ"| node_server_accept
node_server_accept -->|"peer registered"| node_server_client_dispatch
node_server_client_dispatch -->|"command string"| node_cmd_parse_lines
node_cmd_parse_lines -->|"parsed command list"| node_cmd_new_session_exec
node_cmd_new_session_exec -->|"session if needed"| node_session_create
node_cmd_new_session_exec -->|"spawn first window"| node_spawn_window
node_spawn_window -->|"first pane"| node_spawn_pane
node_spawn_pane -->|"attach pane"| node_window_add_pane
node_window_add_pane -->|"allocate pane + pty"| node_window_pane_create
node_session_create -->|"RB_INSERT&#40;&amp;sessions&#41;"| node_struct_session
node_window_pane_create -->|"id, flags, pty fd"| node_struct_window_pane
node_window_pane_create -->|"screen sized to pane"| node_screen_init
node_screen_init -->|"allocate grids"| node_grid_create
node_grid_create -->|"arrays of cells"| node_struct_grid_cell
node_window_pane_create -->|"parser per pane"| node_input_init
node_input_init -->|"starts in ground"| node_input_state_ground
node_window_pane_read_callback -->|"pty bytes"| node_input_parse
node_input_parse -->|"transition lookup"| node_input_state_ground
node_input_parse -->|"printable char handler"| node_input_print
node_input_parse -->|"non-print stops collection"| node_screen_write_collect_end
node_input_print -->|"chars land in grid"| node_screen_write_cell
node_screen_write_collect_end -->|"flush run"| node_screen_write_cell
node_screen_write_cell -->|"read/write cells"| node_struct_grid_cell
node_server_client_loop -->|"check_redraw flushes dirty panes"| node_redraw_draw
node_redraw_draw -->|"build or reuse scene"| node_redraw_make_scene
node_redraw_make_scene -->|"stage 1 cells"| node_redraw_build_cells
node_redraw_draw -->|"spans to client ttys"| node_tty_write
node_tty_write -->|"ensure terminal ready"| node_tty_start_tty


node_adapter_handle -->|"app.fetch&#40;req, env&#41;"| node_fetch
node_adapter_vercel -->|"forwards Request"| node_fetch
node_adapter_deno -->|"same fetch contract"| node_fetch
node_fetch -->|"delegates"| node_dispatch
node_dispatch -->|"resolve path"| node_getpath_util
node_dispatch -->|"router.match&#40;method, path&#41;"| node_router_iface
node_router_iface -->|"default implementation"| node_smart
node_smart -->|"try first"| node_regexp
node_smart -->|"fallback on UnsupportedPathError"| node_trie
node_dispatch -->|"new Context&#40;request&#41;"| node_context
node_dispatch -->|"compose&#40;matchResult&#91;0&#93;&#41;"| node_compose
node_compose -->|"mutates context.res"| node_context


node_adapter_handle -->|"getProcessor&#40;event&#41;"| node_processor
node_adapter_handle -->|"app.fetch&#40;req, env&#41;"| node_fetch
node_adapter_vercel -->|"forwards Request"| node_fetch
node_adapter_deno -->|"app.use&#40;serveStatic&#40;&#41;&#41;"| node_add_route
node_hono_class -->|"extends"| node_hono_base
node_hono_class -->|"default router"| node_smart
node_preset_tiny -->|"extends"| node_hono_base
node_preset_tiny -->|"this.router = new PatternRouter&#40;&#41;"| node_pattern_router
node_add_route -->|"router.add&#40;method, path&#41;"| node_router_iface
node_fetch -->|"delegates"| node_dispatch
node_dispatch -->|"method === HEAD"| node_head_rewriter
node_dispatch -->|"this.getPath&#40;request, env&#41;"| node_getpath_util
node_dispatch -->|"router.match&#40;method, path&#41;"| node_router_iface
node_router_iface -->|"Result&lt;T&gt; contract"| node_smart
node_smart -->|"replay routes, try match"| node_regexp
node_smart -->|"fallback on UnsupportedPathError"| node_trie
node_regexp -->|"first match triggers build"| node_regexp_matcher
node_trie -->|"insert / search"| node_trie_node
node_dispatch -->|"new Context&#40;request, options&#41;"| node_context
node_dispatch -->|"matchResult&#91;0&#93;.length === 1"| node_fastpath
node_fastpath -->|"res &#124;&#124; notFoundHandler"| node_notfound
node_dispatch -->|"compose&#40;matchResult&#91;0&#93;, errorHandler&#41;"| node_compose
node_compose -->|"dispatch&#40;0&#41;"| node_dispatch_fn
node_dispatch_fn -->|"context.req.routeIndex = i"| node_routeindex
node_dispatch_fn -->|"handler&#40;context, next&#41;"| node_logger
node_logger -->|"reads c.req"| node_req
node_logger -->|"c.res after next&#40;&#41;"| node_res_set
node_dispatch_fn -->|"catch / unfinalized"| node_onerror
node_dispatch_fn -->|"context.res = res"| node_res_set
node_context -->|"lazy get req"| node_req
node_req -->|"param&#40;key&#41;"| node_req_param
node_req_param -->|"ParamStash lookup"| node_router_iface
node_context -->|"first read builds Response"| node_res_get
node_context -->|"bindings &amp; event accessors"| node_env_exec
node_notfound -->|"c.text&#40;'404 Not Found', 404&#41;"| node_context


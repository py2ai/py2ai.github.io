node_dflds -->|"fields become model_fields with prefixes"| node_dsig
node_dmk -->|"string 'in -&gt; out' -&gt; typed subclass"| node_dsig
node_dsig -->|"ensure_signature binds the contract"| node_dpred
node_dsig -->|"prepend&#40;'reasoning'&#41; extends fields"| node_dcot
node_dmod -->|"forward&#40;&#41; composes predictors"| node_dpred
node_dpred -->|"kwargs -&gt; &#40;lm, config, signature, demos&#41;"| node_dpre
node_dpre -->|"resolve_adapter -&gt; adapter&#40;lm, ...&#41;"| node_dacall
node_dcot -->|"wraps a Predict"| node_dpred
node_dparam -->|"self.demos feed the prompt"| node_dpre
node_dpost -->|"trace entry &#40;self, inputs, pred&#41;"| node_dparam
node_dpost -->|"from_completions per signature"| node_dpredout
node_dex -->|"example.inputs&#40;&#41; supplies kwargs"| node_dpre
node_dacall -->|"parse each Response"| node_dparse
node_dchat -->|"field-tag parser + JSON fallback"| node_dparse
node_djson -->|"subclass; adds response_format"| node_dchat
node_dacall -->|"lm&#40;Request&#41; once per candidate"| node_dcall
node_dcall -->|"build PreparedCall"| node_dprep
node_dprep -->|"request + options -&gt; cache key"| node_dkey
node_dprep -->|"execute&#40;call&#41;"| node_dexec
node_dexec -->|"get before, put after"| node_dcached
node_dbfs -->|"up to max_rounds per example"| node_dboot
node_dboot -->|"teacher&#40;**example.inputs&#40;&#41;&#41; under trace ctx"| node_dmod
node_dbfs -->|"metric-passing traces kept"| node_dtrain
node_dtrain -->|"student predictor.demos = traces"| node_dparam
node_dtp -->|"subclass"| node_dbfs
node_dtp -->|"subclass"| node_dmipro
node_dmipro -->|"STEP 1: N demo candidate sets"| node_dcands
node_dcands -->|"bootstraps via BootstrapFewShot"| node_dbfs
node_dmipro -->|"STEP 2: propose instructions"| node_dprop
node_dprop -->|"GroundedProposer per predictor"| node_dgp
node_dmipro -->|"STEP 3: Optuna TPE study"| node_dbayes
node_dmipro -->|"Evaluate&#40;devset, metric&#41;"| node_dev
node_dbayes -->|"minibatch score per trial"| node_devcall
node_devcall -->|"ParallelExecutor.execute"| node_dpitem
node_dpitem -->|"program&#40;**example.inputs&#40;&#41;&#41;"| node_dmod
node_dpitem -->|"metric&#40;example, prediction&#41;"| node_dpredout
node_dbayes -->|"insert winning demos + instructions"| node_dparam


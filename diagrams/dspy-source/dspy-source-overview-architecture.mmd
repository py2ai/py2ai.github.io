flowchart TD

subgraph group_g_signatures["Signatures &#40;the typed contract&#41;"]
  node_fields["InputField / OutputField<br/>[field.py]"]
  node_sig{{"Signature<br/>[signature.py]"}}
end

subgraph group_g_program["Program &#40;Modules &amp; Predictors&#41;"]
  node_mod["Module<br/>[module.py]"]
  node_pred["Predict<br/>[predict.py]"]
  node_state[("Parameter state<br/>[parameter.py]")]
  node_out["Prediction<br/>[prediction.py]"]
end

subgraph group_g_adapters["Adapters &#40;prompt rendering&#41;"]
  node_adapter["Adapter<br/>[base.py]"]
  node_chat["ChatAdapter / JSONAdapter<br/>[chat_adapter.py]"]
end

subgraph group_g_clients["LM Clients &#40;engine + execution&#41;"]
  node_lm{{"LM &#40;BaseLM&#41;<br/>[base_lm.py]"}}
  node_exec["Execution layer<br/>[execution.py]"]
end

subgraph group_g_optimizers["Optimizers &#40;Teleprompters&#41;"]
  node_opt{{"Teleprompter.compile<br/>[teleprompt.py]"}}
end

subgraph group_g_eval["Evaluation &#40;metrics&#41;"]
  node_ev["Evaluate<br/>[evaluate.py]"]
end

node_fields -->|"declare typed inputs/outputs"| node_sig
node_sig -->|"Modules compose predictors"| node_mod
node_sig -->|"ensure_signature binds the contract"| node_pred
node_mod -->|"named_predictors&#40;&#41; finds leaves"| node_pred
node_pred -->|"demos &amp; traces accumulate"| node_state
node_pred -->|"forward&#40;&#41;: format -&gt; call -&gt; parse"| node_adapter
node_chat -->|"Chat/JSON adapters implement it"| node_adapter
node_adapter -->|"Prompt -&gt; lm&#40;Request&#41;"| node_lm
node_lm -->|"prepare -&gt; execute -&gt; finalize"| node_exec
node_exec -->|"cache hits &amp; retries"| node_lm
node_exec -->|"Responses back to parse"| node_adapter
node_adapter -->|"Prediction.from_completions"| node_out
node_state -->|"traces become training signal"| node_opt
node_opt -->|"compile&#40;&#41;: writes demos &amp; instructions"| node_pred
node_opt -->|"minibatch candidate scoring"| node_ev
node_ev -->|"runs program per devset example"| node_mod
node_ev -->|"metric&#40;example, prediction&#41;"| node_out


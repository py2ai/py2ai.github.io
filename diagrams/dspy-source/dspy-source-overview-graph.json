{
  "owner": "stanfordnlp",
  "repo": "dspy",
  "branch": "main",
  "groups": [
    {"id": "g_signatures", "name": "Signatures", "label": "Signatures (the typed contract)"},
    {"id": "g_program", "name": "Program", "label": "Program (Modules & Predictors)"},
    {"id": "g_adapters", "name": "Adapters", "label": "Adapters (prompt rendering)"},
    {"id": "g_clients", "name": "LM Clients", "label": "LM Clients (engine + execution)"},
    {"id": "g_optimizers", "name": "Optimizers", "label": "Optimizers (Teleprompters)"},
    {"id": "g_eval", "name": "Evaluation", "label": "Evaluation (metrics)"}
  ],
  "nodes": [
    {"id": "fields", "label": "InputField / OutputField", "file": "field.py", "path": "dspy/signatures/field.py", "group": "Signatures", "groupId": "g_signatures", "desc": "pydantic Field wrappers carrying __dspy_field_type, desc and prefix", "shape": "box"},
    {"id": "sig", "label": "Signature", "file": "signature.py", "path": "dspy/signatures/signature.py", "group": "Signatures", "groupId": "g_signatures", "desc": "declarative I/O contract; the metaclass turns 'in -> out' strings into typed classes", "shape": "hexagon"},
    {"id": "mod", "label": "Module", "file": "module.py", "path": "dspy/primitives/module.py", "group": "Program", "groupId": "g_program", "desc": "__call__ wraps forward(); tracks usage, history and caller modules"},
    {"id": "pred", "label": "Predict", "file": "predict.py", "path": "dspy/predict/predict.py", "group": "Program", "groupId": "g_program", "desc": "leaf predictor: binds Signature, demos, config, then calls the LM"},
    {"id": "state", "label": "Parameter state", "file": "parameter.py", "path": "dspy/predict/parameter.py", "group": "Program", "groupId": "g_program", "desc": "demos, traces and train sets attached to each predictor", "shape": "database"},
    {"id": "out", "label": "Prediction", "file": "prediction.py", "path": "dspy/primitives/prediction.py", "group": "Program", "groupId": "g_program", "desc": "from_completions wraps parsed outputs against the signature"},
    {"id": "adapter", "label": "Adapter", "file": "base.py", "path": "dspy/adapters/base.py", "group": "Adapters", "groupId": "g_adapters", "desc": "format() renders the Prompt, __call__ runs the LM, parse() decodes the reply"},
    {"id": "chat", "label": "ChatAdapter / JSONAdapter", "file": "chat_adapter.py", "path": "dspy/adapters/chat_adapter.py", "group": "Adapters", "groupId": "g_adapters", "desc": "field-tagged chat turns or provider structured-output JSON"},
    {"id": "lm", "label": "LM (BaseLM)", "file": "base_lm.py", "path": "dspy/clients/base_lm.py", "group": "LM Clients", "groupId": "g_clients", "desc": "lm(Request) -> Response executed through an engine", "shape": "hexagon"},
    {"id": "exec", "label": "Execution layer", "file": "execution.py", "path": "dspy/clients/execution.py", "group": "LM Clients", "groupId": "g_clients", "desc": "cache key, lookup/store, retries, candidate fan-out"},
    {"id": "opt", "label": "Teleprompter.compile", "file": "teleprompt.py", "path": "dspy/teleprompt/teleprompt.py", "group": "Optimizers", "groupId": "g_optimizers", "desc": "optimizers compile programs: BootstrapFewShot, MIPROv2, GEPA", "shape": "hexagon"},
    {"id": "ev", "label": "Evaluate", "file": "evaluate.py", "path": "dspy/evaluate/evaluate.py", "group": "Evaluation", "groupId": "g_eval", "desc": "parallel devset scoring with a metric function"}
  ],
  "edges": [
    {"from": "fields", "to": "sig", "label": "declare typed inputs/outputs"},
    {"from": "sig", "to": "mod", "label": "Modules compose predictors"},
    {"from": "sig", "to": "pred", "label": "ensure_signature binds the contract"},
    {"from": "mod", "to": "pred", "label": "named_predictors() finds leaves"},
    {"from": "pred", "to": "state", "label": "demos & traces accumulate"},
    {"from": "pred", "to": "adapter", "label": "forward(): format -> call -> parse"},
    {"from": "chat", "to": "adapter", "label": "Chat/JSON adapters implement it"},
    {"from": "adapter", "to": "lm", "label": "Prompt -> lm(Request)"},
    {"from": "lm", "to": "exec", "label": "prepare -> execute -> finalize"},
    {"from": "exec", "to": "lm", "label": "cache hits & retries"},
    {"from": "exec", "to": "adapter", "label": "Responses back to parse"},
    {"from": "adapter", "to": "out", "label": "Prediction.from_completions"},
    {"from": "state", "to": "opt", "label": "traces become training signal"},
    {"from": "opt", "to": "pred", "label": "compile(): writes demos & instructions"},
    {"from": "opt", "to": "ev", "label": "minibatch candidate scoring"},
    {"from": "ev", "to": "mod", "label": "runs program per devset example"},
    {"from": "ev", "to": "out", "label": "metric(example, prediction)"}
  ]
}

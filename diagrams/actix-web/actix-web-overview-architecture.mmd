node_http_server -->|"bind&#40;&#41; L515 / run&#40;&#41; L1407 hand sockets to protocol services"| node_h1_service
node_h1_service -->|"wrap io stream in Codec"| node_dispatcher
node_dispatcher -->|"service.call&#40;Request&#41; per decoded message"| node_app_entry
node_app_entry -->|"factory resolved per worker"| node_app_init_service
node_app_init_service -->|"pooled ServiceRequest"| node_app_routing
node_app_routing -->|"recognize_fn + guards L350"| node_resource_service
node_resource_service -->|"route.check wins"| node_route_service
node_route_service -->|"boxed handler future"| node_handler_service
node_handler_service -->|"Args::from_request L108"| node_from_request
node_from_request -->|"handler.call&#40;data&#41; L111"| node_handler_service
node_http_server -->|"worker = single-threaded runtime"| node_rt


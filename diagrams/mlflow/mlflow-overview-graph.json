{
  "owner": "mlflow",
  "repo": "mlflow",
  "branch": "master",
  "groups": [
    { "id": "api", "name": "api", "label": "Fluent API & Client" },
    { "id": "service", "name": "service", "label": "Tracking Service & Server" },
    { "id": "stores", "name": "stores", "label": "Backend Stores & Registry" },
    { "id": "model", "name": "model", "label": "Model Format & Flavors" }
  ],
  "nodes": [
    { "id": "fluent_api", "label": "mlflow.fluent", "file": "fluent.py", "path": "mlflow/tracking/fluent.py", "group": "api", "groupId": "api", "shape": "box", "desc": "start_run, log_param, log_metric, end_run, active_run" },
    { "id": "mlflow_client", "label": "MlflowClient", "file": "client.py", "path": "mlflow/tracking/client.py", "group": "api", "groupId": "api", "shape": "box", "desc": "Full client: runs, metrics, registry operations" },
    { "id": "cli_server", "label": "mlflow server CLI", "file": "__init__.py", "path": "mlflow/cli/__init__.py", "group": "api", "groupId": "api", "shape": "hexagon", "desc": "Command-line entry point; `mlflow server` at L554" },
    { "id": "svc_client", "label": "TrackingServiceClient", "file": "client.py", "path": "mlflow/tracking/_tracking_service/client.py", "group": "service", "groupId": "service", "shape": "box", "desc": "create_run, log_metric, log_batch, log_artifact" },
    { "id": "svc_utils", "label": "tracking utils", "file": "utils.py", "path": "mlflow/tracking/_tracking_service/utils.py", "group": "service", "groupId": "service", "shape": "box", "desc": "set_tracking_uri and _get_store; store registry dispatch" },
    { "id": "server_app", "label": "REST server", "file": "__init__.py", "path": "mlflow/server/__init__.py", "group": "service", "groupId": "service", "shape": "hexagon", "desc": "_run_server: serves the tracking API and UI" },
    { "id": "file_store", "label": "FileStore", "file": "file_store.py", "path": "mlflow/store/tracking/file_store.py", "group": "stores", "groupId": "stores", "shape": "database", "desc": "Local filesystem backend (./mlruns)" },
    { "id": "sql_store", "label": "SqlAlchemyStore", "file": "sqlalchemy_store.py", "path": "mlflow/store/tracking/sqlalchemy_store.py", "group": "stores", "groupId": "stores", "shape": "database", "desc": "sqlite/postgres/mysql backend; create_run, log_batch" },
    { "id": "registry_store", "label": "Model Registry store", "file": "sqlalchemy_store.py", "path": "mlflow/store/model_registry/sqlalchemy_store.py", "group": "stores", "groupId": "stores", "shape": "database", "desc": "create_registered_model, create_model_version" },
    { "id": "entities", "label": "Run / Metric / Param", "file": "run.py", "path": "mlflow/entities/run.py", "group": "stores", "groupId": "stores", "shape": "document", "desc": "Entities returned by stores and clients" },
    { "id": "model_format", "label": "Model (MLmodel)", "file": "model.py", "path": "mlflow/models/model.py", "group": "model", "groupId": "model", "shape": "document", "desc": "Model class and MLmodel packaging" },
    { "id": "flavors", "label": "Flavors (sklearn, pyfunc)", "file": "__init__.py", "path": "mlflow/sklearn/__init__.py", "group": "model", "groupId": "model", "shape": "box", "desc": "log_model / load_model per framework; pyfunc base" }
  ],
  "edges": [
    { "from": "fluent_api", "to": "mlflow_client", "label": "wraps" },
    { "from": "fluent_api", "to": "entities", "label": "builds Run objects" },
    { "from": "mlflow_client", "to": "svc_client", "label": "delegates" },
    { "from": "mlflow_client", "to": "registry_store", "label": "registry calls" },
    { "from": "svc_client", "to": "svc_utils", "label": "_get_store" },
    { "from": "svc_client", "to": "entities", "label": "returns entities" },
    { "from": "svc_utils", "to": "file_store", "label": "file: scheme" },
    { "from": "svc_utils", "to": "sql_store", "label": "db: scheme" },
    { "from": "cli_server", "to": "server_app", "label": "boots REST + UI" },
    { "from": "server_app", "to": "sql_store", "label": "serves writes" },
    { "from": "file_store", "to": "entities", "label": "writes run metadata" },
    { "from": "sql_store", "to": "entities", "label": "persists rows" },
    { "from": "registry_store", "to": "entities", "label": "RegisteredModel rows" },
    { "from": "flavors", "to": "fluent_api", "label": "logs under a run" },
    { "from": "flavors", "to": "model_format", "label": "writes MLmodel" }
  ]
}

{
  "owner": "GStreamer",
  "repo": "gstreamer",
  "branch": "main",
  "groups": [
    { "id": "construct", "name": "Construct", "label": "Element creation" },
    { "id": "topology", "name": "Topology", "label": "Bins & linking" },
    { "id": "state", "name": "State", "label": "State machine" },
    { "id": "dataflow", "name": "Dataflow", "label": "Buffer flow" },
    { "id": "caps", "name": "Caps", "label": "Format agreement" },
    { "id": "runtime", "name": "Runtime", "label": "Bus & reporting" }
  ],
  "nodes": [
    { "id": "factory", "label": "gst_element_factory_make()", "file": "gstelementfactory.c", "path": "subprojects/gstreamer/gst/gstelementfactory.c", "group": "construct", "groupId": "construct", "desc": "Registry lookup by element name, then instantiates a fresh element" },
    { "id": "bin_add", "label": "gst_bin_add()", "file": "gstbin.c", "path": "subprojects/gstreamer/gst/gstbin.c", "group": "construct", "groupId": "construct", "desc": "Attaches an element as a child of a bin" },
    { "id": "top_bin", "label": "Top-level bin", "file": "gstpipeline.c", "path": "subprojects/gstreamer/gst/gstpipeline.c", "group": "topology", "groupId": "topology", "desc": "The outermost bin: owns clock selection, base time and the shared bus" },
    { "id": "pad_link", "label": "gst_pad_link_full()", "file": "gstpad.c", "path": "subprojects/gstreamer/gst/gstpad.c", "group": "topology", "groupId": "topology", "desc": "Wires a source pad to a sink pad and runs the link-time checks" },
    { "id": "bin_state", "label": "bin change_state", "file": "gstbin.c", "path": "subprojects/gstreamer/gst/gstbin.c", "group": "state", "groupId": "state", "desc": "Walks children in order so sinks change state before sources" },
    { "id": "elem_state", "label": "gst_element_set_state()", "file": "gstelement.c", "path": "subprojects/gstreamer/gst/gstelement.c", "group": "state", "groupId": "state", "desc": "Drives READY, PAUSED, PLAYING with asynchronous commits" },
    { "id": "base_src", "label": "base_src_loop", "file": "gstbasesrc.c", "path": "subprojects/gstreamer/libs/gst/base/gstbasesrc.c", "group": "dataflow", "groupId": "dataflow", "desc": "Source thread: fills a buffer and pushes it downstream" },
    { "id": "pad_push", "label": "gst_pad_push()", "file": "gstpad.c", "path": "subprojects/gstreamer/gst/gstpad.c", "group": "dataflow", "groupId": "dataflow", "desc": "Hands one buffer through probes into the peer chain function" },
    { "id": "fake_sink", "label": "fake_sink render", "file": "gstfakesink.c", "path": "subprojects/gstreamer/plugins/elements/gstfakesink.c", "group": "dataflow", "groupId": "dataflow", "desc": "Terminal pad that consumes buffers without touching them" },
    { "id": "caps", "label": "gst_caps_can_intersect()", "file": "gstcaps.c", "path": "subprojects/gstreamer/gst/gstcaps.c", "group": "caps", "groupId": "caps", "desc": "Fast check that two media format sets can agree" },
    { "id": "capsfilter", "label": "capsfilter transform_caps", "file": "gstcapsfilter.c", "path": "subprojects/gstreamer/plugins/elements/gstcapsfilter.c", "group": "caps", "groupId": "caps", "desc": "Forces a user-supplied caps filter onto the link it sits on" },
    { "id": "bus", "label": "gst_bus_post()", "file": "gstbus.c", "path": "subprojects/gstreamer/gst/gstbus.c", "group": "runtime", "groupId": "runtime", "desc": "Delivers state changes, errors and latency news to the application" }
  ],
  "edges": [
    { "from": "factory", "to": "bin_add", "label": "factory_make() returns instances" },
    { "from": "bin_add", "to": "top_bin", "label": "children attach to the top bin" },
    { "from": "top_bin", "to": "bin_state", "label": "set_state() descends" },
    { "from": "bin_state", "to": "elem_state", "label": "each child transitions" },
    { "from": "top_bin", "to": "pad_link", "label": "app wires src to sink" },
    { "from": "pad_link", "to": "caps", "label": "link-time check" },
    { "from": "capsfilter", "to": "caps", "label": "can these formats agree" },
    { "from": "elem_state", "to": "capsfilter", "label": "PAUSED starts negotiation" },
    { "from": "base_src", "to": "pad_push", "label": "loop pushes a buffer" },
    { "from": "pad_push", "to": "capsfilter", "label": "buffer crosses the filter" },
    { "from": "capsfilter", "to": "fake_sink", "label": "render() consumes it" },
    { "from": "elem_state", "to": "bus", "label": "STATE_CHANGED posted" },
    { "from": "top_bin", "to": "bus", "label": "one shared bus app-ward" }
  ]
}

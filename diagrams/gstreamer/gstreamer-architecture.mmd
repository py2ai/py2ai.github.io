node_parse -->|"grammar calls factory_make&#40;&#41;"| node_factory
node_factory -->|"instances returned"| node_bin_add
node_bin_add -->|"child of the top bin"| node_top_bin
node_top_bin -->|"set_state on the top bin"| node_bin_state
node_bin_state -->|"transitions each child"| node_elem_state
node_elem_state -->|"async commit steps"| node_elem_continue
node_elem_state -->|"pads activate at PAUSED"| node_pad_activate
node_pad_activate -->|"PULL mode arms getrange"| node_pad_getrange
node_top_bin -->|"children report here"| node_bin_msg
node_elem_state -->|"STATE_CHANGED"| node_bus_post
node_bin_msg -->|"reposted app-ward"| node_bus_post
node_bus_post -->|"app waits"| node_bus_poll
node_bus_post -->|"or drains"| node_bus_pop
node_bin_msg -->|"LATENCY message"| node_bin_latency
node_pad_link -->|"link checks formats"| node_caps_can
node_pad_link -->|"peer CAPS during link"| node_caps_query
node_caps_query -->|"fixed-caps decision"| node_caps_subset
node_caps_can -->|"intersect details"| node_caps_zigzag
node_capsfilter_elem -->|"its vmethod"| node_transform_caps
node_elem_state -->|"PAUSED negotiation round"| node_caps_query
node_base_src_loop -->|"request one buffer"| node_base_src_range
node_base_src_range -->|"create vmethod"| node_fake_src
node_base_src_loop -->|"buffer pushed"| node_pad_push
node_pad_push -->|"probe path"| node_pad_push_data
node_pad_push_data -->|"probe callbacks"| node_pad_probe
node_pad_push_data -->|"peer chain call"| node_pad_chain
node_pad_chain -->|"buffer enqueued"| node_queue_chain
node_queue_chain -->|"handoff to src thread"| node_queue_loop
node_queue_loop -->|"push downstream again"| node_pad_push
node_pad_chain -->|"in-place transform"| node_identity
node_identity -->|"push through the filter"| node_capsfilter_elem
node_capsfilter_elem -->|"downstream element"| node_typefind
node_typefind -->|"render consumes"| node_fake_sink
node_pad_push_data -->|"per-buffer trace"| node_debug_log
node_elem_state -->|"state trace"| node_debug_log
node_pad_chain -->|"chain trace"| node_debug_log
node_queue_loop -->|"loop trace"| node_debug_log


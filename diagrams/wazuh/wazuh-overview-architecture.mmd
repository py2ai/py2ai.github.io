node_logcollector -->|"SendMSGtoSCK"| node_mq
node_fim -->|"fim_send_msg"| node_mq
node_mq -->|"Unix-socket datagrams"| node_agentd
node_agentd -->|"submit_event"| node_accumulator
node_accumulator -->|"batch flush"| node_stateless
node_stateless -->|"HTTPS POST /stateless"| node_remoted
node_remoted -->|"route"| node_stateless_ep
node_stateless_ep -->|"UDS /events/enriched"| node_event_api
node_event_api -->|"postEvent"| node_router
node_router -->|"environment ingest"| node_policy
node_policy -->|"index wazuh-events-v5-*"| node_indexer_out


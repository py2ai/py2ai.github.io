    {"id": "splitter", "label": "SentenceSplitter", "file": "sentence.py", "path": "llama-index-core/llama_index/core/node_parser/text/sentence.py", "group": "Ingestion & Data Model", "groupId": "data", "desc": "Sentence-aware chunking with token counting; default chunk size 1024 tokens."},
    {"id": "ingestflow", "label": "Ingestion flow", "file": "transformations.py", "path": "llama-index-core/llama_index/core/ingestion/transformations.py", "group": "Ingestion & Data Model", "groupId": "data", "desc": "The ingestion runner chains transformations (split, embed) and upserts into the vector store, with docstore dedupe."},
    {"id": "embedding", "label": "BaseEmbedding", "file": "base.py", "path": "llama-index-core/llama_index/core/base/embeddings/base.py", "group": "Embedding Models", "groupId": "model", "desc": "Abstract embedder: sync and async paths, per-text and batched modes."},
    {"id": "vquery", "label": "VectorStoreQuery", "file": "types.py", "path": "llama-index-core/llama_index/core/vector_stores/types.py", "group": "Vector Stores", "groupId": "store", "desc": "Universal query object: embedding, top_k, mode, metadata filters."},

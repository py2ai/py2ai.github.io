    {"id": "retriever", "label": "VectorIndexRetriever", "file": "retriever.py", "path": "llama-index-core/llama_index/core/indices/vector_store/retrievers/retriever.py", "group": "Retrieval & Synthesis", "groupId": "query", "desc": "Turns a query string into a VectorStoreQuery and returns NodeWithScore list."},
    {"id": "qengine", "label": "RetrieverQueryEngine", "file": "retriever_query_engine.py", "path": "llama-index-core/llama_index/core/query_engine/retriever_query_engine.py", "group": "Retrieval & Synthesis", "groupId": "query", "desc": "Just a retriever plus a response synthesizer composed through the callback manager."},
    {"id": "synth", "label": "TreeSummarize", "file": "tree_summarize.py", "path": "llama-index-core/llama_index/core/response_synthesizers/tree_summarize.py", "group": "Retrieval & Synthesis", "groupId": "query", "desc": "Hierarchical merge of chunks into an answer; one of the ResponseMode strategies."},
    {"id": "callbacks", "label": "CallbackManager", "file": "base.py", "path": "llama-index-core/llama_index/core/callbacks/base.py", "group": "Runtime: Callbacks & Agents", "groupId": "runtime", "desc": "Traces every stage: on_event_start/end around retrieval, embedding and LLM calls."},
    {"id": "agent", "label": "FunctionAgent", "file": "function_agent.py", "path": "llama-index-core/llama_index/core/agent/workflow/function_agent.py", "group": "Runtime: Callbacks & Agents", "groupId": "runtime", "desc": "Agent layer: an LLM worker loop (on the llama-index-workflows engine) that can call a query engine as a tool."}

node_query_manager -->|"runs lifecycle"| node_sql_query_execution
node_sql_query_execution -->|"plans analyzed SQL"| node_logical_planner
node_logical_planner -->|"applies rule suite"| node_plan_optimizers
node_sql_query_execution -->|"fragments into stages"| node_plan_fragmenter
node_sql_query_execution -->|"starts scheduling"| node_query_scheduler
node_query_scheduler -->|"schedules each stage"| node_stage_scheduler
node_source_partitioned_scheduler -->|"factory returns"| node_stage_scheduler
node_node_scheduler -->|"createNodeSelector"| node_node_selector
node_uniform_node_selector -->|"implements"| node_node_selector
node_source_partitioned_scheduler -->|"places splits"| node_dynamic_split_placement_policy
node_dynamic_split_placement_policy -->|"computeAssignments"| node_node_selector
node_source_partitioned_scheduler -->|"assigns splits to tasks"| node_sql_task
node_sql_query_execution -->|"submits stage tasks"| node_sql_task
node_sql_task -->|"delegates updates"| node_sql_task_execution
node_sql_task_execution -->|"enqueues splits"| node_task_executor
node_time_sharing_task_executor -->|"implements"| node_task_executor
node_sql_task_execution -->|"plans local execution"| node_local_execution_planner
node_local_execution_planner -->|"produces drivers"| node_driver
node_task_executor -->|"runs driver loops"| node_driver
node_driver -->|"advances chain"| node_operator
node_operator -->|"implemented by"| node_scan_filter_and_project_operator
node_operator -->|"implemented by"| node_hash_aggregation_operator
node_operator -->|"implemented by"| node_exchange_operator
node_table_scan_operator -->|"reads source pages"| node_connector_page_source
node_hash_aggregation_operator -->|"aggregates input pages"| node_page
node_exchange_operator -->|"fetches remote pages"| node_http_page_buffer_client
node_http_page_buffer_client -->|"receives page buffers"| node_page
node_driver -->|"streams between operators"| node_page
node_local_exchange -->|"buffers local pages"| node_operator
node_connector -->|"getMetadata"| node_connector_metadata
node_connector -->|"getSplitManager"| node_connector_split_manager
node_connector -->|"getPageSourceProvider"| node_connector_page_source_provider
node_connector -->|"provides page sinks"| node_connector_page_sink
node_connector_page_source_provider -->|"creates page sources"| node_connector_page_source
node_connector_page_source -->|"returns pages"| node_page
node_connector_page_sink -->|"appends pages"| node_page
node_page -->|"holds column blocks"| node_block
node_table_scan_operator -->|"emits pages"| node_page


node_query_manager -->|"starts lifecycle"| node_sql_query_execution
node_sql_query_execution -->|"plans SQL"| node_logical_planner
node_logical_planner -->|"fragments plan"| node_plan_fragmenter
node_sql_query_execution -->|"starts scheduling"| node_query_scheduler
node_query_scheduler -->|"drives stage"| node_source_partitioned_scheduler
node_node_scheduler -->|"supplies nodes"| node_source_partitioned_scheduler
node_source_partitioned_scheduler -->|"assigns splits"| node_sql_task
node_sql_query_execution -->|"submits stages"| node_sql_task
node_sql_task -->|"creates"| node_driver
node_driver -->|"chains"| node_operator
node_operator -->|"reads via SPI"| node_connector
node_connector -->|"streams"| node_page


node_cli_lets_go -->|"reuses uvicorn runner"| node_cli_run
node_cli_run -->|"launches"| node_server_app
node_server_app -->|"wraps requests"| node_server_auth
node_server_app -->|"mounts routers"| node_server_registry
node_server_app -->|"adds metrics"| node_server_metrics
node_server_auth -->|"resolves handlers"| node_server_routes
node_server_registry -.->|"registered routes"| node_server_routes
node_server_registry -->|"builds create_router"| node_api_routes
node_api_routes -->|"typed against"| node_api_inference
node_api_routes -->|"dispatches"| node_core_router
node_core_router -.->|"implements"| node_api_inference
node_api_spec -.->|"documents contract"| node_api_inference
node_responses_builtin -.->|"emits Response objects"| node_api_responses_types
node_core_router -->|"resolve model"| node_routing_table
node_router_vector -->|"get_provider_impl"| node_routing_table
node_router_tools -->|"get_provider_impl"| node_routing_table
node_table_models -.->|"subclass"| node_routing_table
node_table_vector -.->|"subclass"| node_routing_table
node_routing_table -->|"lookup object"| node_store_registry
node_core_router -->|"enforce policies"| node_access_control
node_server_app -.->|"wires tables at startup"| node_routing_table
node_routing_table -->|"instantiate impls"| node_provider_specs
node_provider_specs -.->|"declares adapters"| node_openai_mixin
node_ollama -.->|"extends"| node_openai_mixin
node_vllm -.->|"extends"| node_openai_mixin
node_starter -->|"selects providers"| node_provider_specs
node_starter -.->|"resolved as config"| node_server_app
node_faiss -.->|"metadata store"| node_sqlstore
node_store_registry -.->|"persists objects"| node_kvstore_sqlite


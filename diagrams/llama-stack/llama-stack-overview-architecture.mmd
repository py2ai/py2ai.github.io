  node_server_registry["fastapi_router_registry"]
end

subgraph group_contracts["API Contracts"]
  node_api_inference["Inference protocol<br/>[api.py]"]
  node_api_routes["inference routes<br/>[fastapi_routes.py]"]
end

subgraph group_routing["Routing Core"]
  node_core_router["InferenceRouter<br/>[inference.py]"]
  node_routing_table["CommonRoutingTableImpl<br/>[common.py]"]
  node_store_registry[("DistributionRegistry<br/>[registry.py]")]
end

subgraph group_providers["Providers"]
  node_provider_specs["provider specs<br/>[inference.py]"]

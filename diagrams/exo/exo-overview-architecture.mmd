flowchart TD

subgraph group_g_access["Access Layer"]
  node_api_server["API Server<br/>http-server"]
end

subgraph group_g_cluster["Cluster Fabric"]
  node_main_entry["CLI Entry<br/>entry-point"]
  node_discovery{{"Peer Discovery<br/>protocol-client"}}
  node_info_gatherer["Resource Profiler<br/>monitoring"]
  node_topology[("Topology Graph<br/>data-model")]
  node_election{{"Master Election<br/>consensus"}}
  node_event_router["Event Bus<br/>message-bus"]
end

subgraph group_g_master["Master Brain"]
  node_master_main["Master Controller<br/>orchestration"]
  node_placement{{"Placement Engine<br/>scheduler"}}
end

subgraph group_g_worker["Worker Execution"]
  node_worker_main["Worker Node<br/>orchestration"]
  node_auto_parallel{{"Tensor Parallel Engine<br/>inference-engine"}}
  node_shard_downloader["Shard Downloader<br/>download-manager"]
end

node_main_entry -->|"boots"| node_discovery
node_discovery -->|"maps peers into"| node_topology
node_info_gatherer -->|"profiles into"| node_topology
node_discovery -.->|"provides members"| node_election
node_election -->|"elects"| node_master_main
node_event_router -->|"delivers events"| node_master_main
node_master_main -->|"runs"| node_placement
node_topology -.->|"constrains"| node_placement
node_placement -->|"assigns shards"| node_worker_main
node_event_router -->|"dispatches commands"| node_worker_main
node_worker_main -->|"executes through"| node_auto_parallel
node_api_server -->|"submits tasks"| node_master_main
node_main_entry -->|"serves"| node_api_server
node_shard_downloader -->|"feeds weights"| node_worker_main


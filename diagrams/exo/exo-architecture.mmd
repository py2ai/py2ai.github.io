flowchart TD

subgraph group_g_api["API Layer"]
  node_api_server["API Server<br/>http-server"]
  node_chat_completions["Chat Completions Adapter<br/>api-adapter"]
  node_claude_adapter["Claude Adapter<br/>api-adapter"]
  node_ollama_adapter["Ollama Adapter<br/>api-adapter"]
  node_responses_adapter["Responses Adapter<br/>api-adapter"]
end

subgraph group_g_master["Master"]
  node_master_main["Master Controller<br/>orchestration"]
  node_placement{{"Placement Engine<br/>scheduler"}}
  node_placement_utils["Cycle Solver<br/>algorithm"]
  node_image_store[("Image Store<br/>storage")]
end

subgraph group_g_shared["Shared Kernel"]
  node_election{{"Election<br/>consensus"}}
  node_topology[("Topology Graph<br/>data-model")]
  node_events_types[("Event Types<br/>type-definitions")]
  node_tasks_types[("Task Types<br/>type-definitions")]
  node_model_cards["Model Cards<br/>metadata-catalog"]
  node_apply["State Folder<br/>reducer"]
end

subgraph group_g_routing["Routing and Utilities"]
  node_event_router["Event Router<br/>message-bus"]
  node_router["Topic Router<br/>message-bus"]
  node_channels["Typed Channels<br/>concurrency"]
  node_info_gatherer["Resource Profiler<br/>monitoring"]
  node_net_profile["Link Profiler<br/>monitoring"]
end

subgraph group_g_worker["Worker Engines"]
  node_worker_main["Worker Node<br/>orchestration"]
  node_plan["Local Planner<br/>orchestration"]
  node_supervisor["Runner Supervisor<br/>process-manager"]
  node_runner{{"Runner<br/>execution-agent"}}
  node_auto_parallel{{"Tensor Parallel Engine<br/>inference-engine"}}
  node_generator["Token Generator<br/>inference-engine"]
  node_mlx_cache[("KV Prefix Cache<br/>[cache.py]")]
  node_image_pipeline["Diffusion Runner<br/>inference-engine"]
  node_disaggregated["Disaggregated Protocol<br/>[protocol.py]"]
end

subgraph group_g_infra["Assets and Networking"]
  node_shard_downloader["Shard Downloader<br/>download-manager"]
  node_impl_shard_downloader["HuggingFace Fetcher<br/>download-manager"]
  node_coordinator["Download Coordinator<br/>orchestration"]
  node_discovery{{"LAN Discovery<br/>protocol-client"}}
end

node_api_server -->|"translates via"| node_chat_completions
node_api_server -->|"translates via"| node_claude_adapter
node_api_server -->|"translates via"| node_ollama_adapter
node_api_server -->|"translates via"| node_responses_adapter
node_claude_adapter -->|"emit"| node_tasks_types
node_responses_adapter -->|"emit"| node_tasks_types
node_api_server -->|"publishes tasks"| node_event_router
node_event_router -->|"feeds"| node_master_main
node_master_main -->|"folds state with"| node_apply
node_master_main -->|"consults"| node_placement
node_placement -->|"solves with"| node_placement_utils
node_placement -->|"sizes from"| node_model_cards
node_placement -->|"reads"| node_topology
node_master_main -.->|"saves outputs"| node_image_store
node_master_main -->|"issues commands"| node_event_router
node_event_router -->|"drives"| node_worker_main
node_worker_main -->|"builds"| node_plan
node_plan -->|"queues downloads"| node_coordinator
node_coordinator -->|"requests shards"| node_shard_downloader
node_shard_downloader -->|"delegates to"| node_impl_shard_downloader
node_plan -->|"launches"| node_supervisor
node_supervisor -->|"spawns"| node_runner
node_runner -->|"loads through"| node_auto_parallel
node_auto_parallel -->|"shards into"| node_generator
node_generator -->|"reuses"| node_mlx_cache
node_runner -->|"runs"| node_image_pipeline
node_worker_main -.->|"supports"| node_disaggregated
node_election -->|"elects"| node_master_main
node_discovery -->|"announces peers"| node_topology
node_info_gatherer -->|"profiles into"| node_topology
node_net_profile -->|"measures links"| node_topology
node_event_router -->|"filters topics via"| node_router
node_event_router -.->|"built on"| node_channels
node_events_types -->|"consumed by"| node_apply
node_tasks_types -->|"executed as"| node_runner


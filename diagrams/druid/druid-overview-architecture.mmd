node_overlord_resource -->|"leader runs queue"| node_task_master
node_task_master -->|"manages"| node_task_queue
node_task_queue -->|"locks &amp; dispatch"| node_task_if
node_task_if -->|"implemented by"| node_ss_task
node_ss_task -->|"drives loop"| node_ss_runner
node_ss_runner -->|"ingest rows"| node_incremental_index
node_incremental_index -->|"published segments served"| node_server_manager
node_query_resource -->|"execute"| node_query_lifecycle
node_query_lifecycle -->|"walk query tree"| node_broker_walker
node_broker_walker -->|"fan-out segments"| node_server_manager
node_coordinator -->|"balance &amp; replicate"| node_server_manager


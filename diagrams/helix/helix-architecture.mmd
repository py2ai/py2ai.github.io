node_rope -->|"ops describe rope deltas"| node_operation
node_operation -->|"merged into op list"| node_changeset
node_changeset -->|"apply&#40;&#41; walks rope"| node_changeset_apply
node_changeset_apply -->|"splices text in place"| node_rope
node_changeset -->|"ChangeSet + selection"| node_transaction
node_transaction -->|"apply to doc rope"| node_transaction_apply
node_range -->|"ranges: anchor+head"| node_selection
node_selection -->|"primary_index lookup"| node_selection_primary
node_selection -->|"rides with every edit"| node_transaction
node_movement -->|"extends/collapses heads"| node_selection
node_syntax_loader -->|"compiled language data"| node_syntax
node_syntax -->|"incremental reparse"| node_syntax_update
node_syntax_update -->|"generate_edits&#40;changeset&#41;"| node_changeset
node_highlighter -->|"walks tree layers"| node_syntax
node_editor -->|"documents map"| node_document
node_editor_open -->|"open&#40;path, Action&#41;"| node_editor
node_document -->|"apply_inner"| node_doc_apply
node_doc_apply -->|"consumes Transaction"| node_transaction
node_document -->|"per-view selections"| node_doc_set_selection
node_editor_event -->|"wait_event queue"| node_editor
node_handlers_lsp -->|"apply_edit hook"| node_editor
node_doc_apply -->|"edits sync to servers"| node_handlers_lsp
node_application -->|"draw frame"| node_render
node_application -->|"top-level loop"| node_event_loop
node_event_loop -->|"until idle"| node_event_loop_until_idle
node_event_loop_until_idle -->|"select! biased branch"| node_handle_terminal_events
node_keymap_default -->|"key -&gt; command map"| node_handle_terminal_events
node_handle_terminal_events -->|"MappableCommand::execute"| node_commands
node_commands -->|"build Transaction"| node_transaction
node_commands -->|"mutate selections"| node_selection
node_application -->|"server Call handling"| node_handle_lsp_message
node_application -->|"owns Editor"| node_editor
node_registry -->|"resolve per language"| node_registry_get
node_registry_get -->|"spawn if not reused"| node_start_client
node_start_client -->|"starts process+streams"| node_client
node_registry -->|"SlotMap&lt;Id, Arc&lt;Client&gt;&gt;"| node_client
node_client_call -->|"pending request map"| node_client
node_client -->|"calls merged via SelectAll"| node_registry
node_registry -->|"incoming stream"| node_handle_lsp_message
node_handlers_lsp -->|"didChange notifications"| node_client
node_editor_open -->|"attach servers on open"| node_registry_get
node_doc_apply -->|"ChangeSet -&gt; reparse"| node_syntax_update


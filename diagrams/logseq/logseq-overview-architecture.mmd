subgraph group_ui["UI Layer"]
  node_core["frontend.core<br/>[core.cljs]"]
  node_editor["handler.editor/save-block!<br/>[editor.cljs]"]
end

subgraph group_state["State &amp; Startup"]
  node_handler["frontend.handler/start!<br/>[handler.cljs]"]
  node_state["frontend.state<br/>[state.cljs]"]
end

subgraph group_ops["Outliner Ops"]
  node_op["outliner.op/transact!<br/>[op.cljs]"]
end

subgraph group_worker["DB Worker"]
  node_transact["db.transact/apply-outliner-ops<br/>[transact.cljs]"]
  node_worker["worker.db-worker<br/>[db_worker.cljs]"]
  node_subs["db.subs<br/>[subs.cljs]"]
end

subgraph group_storage["Storage"]
  node_datascript["DataScript conn<br/>[sqlite.cljs]"]
  node_sqlite["db.sqlite file<br/>[sqlite.cljs]"]
end

subgraph group_query["Query Engine"]
  node_query["db.query-dsl/query<br/>[query_dsl.cljs]"]
  node_datalog["db.query-custom<br/>[query_custom.cljs]"]
end

node_core -->|"init calls start!"| node_handler
node_handler -->|"restores repos into state"| node_state
node_editor -->|"builds outliner ops"| node_op
node_op -->|"apply-outliner-ops"| node_transact
node_transact -->|"thread-api request"| node_worker
node_worker -->|"owns the conn"| node_datascript
node_datascript -->|"datoms persisted via storage"| node_sqlite
node_worker -->|"deltas + snapshots"| node_subs
node_subs -->|"refresh editor rows"| node_editor
node_query -->|"thread-api/query-dsl-query"| node_worker
node_datalog -->|"worker-side datalog"| node_worker


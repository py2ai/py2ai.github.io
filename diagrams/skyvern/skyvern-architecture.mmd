node_skyvern_init -->|"lazy export"| node_skyvern_class
node_skyvern_class -->|"agent commands"| node_page_agent
node_skyvern_class -->|"AI commands"| node_page_ai
node_page_ai -.->|"locates elements"| node_ai_locator
node_skyvern_class -->|"embedded server"| node_api_app
node_api_app -->|"mounts"| node_routes
node_routes -->|"includes"| node_sdk_routes
node_sdk_routes -->|"submits runs"| node_run_service
node_run_service -->|"persists"| node_workflow_runs_repo
node_run_service -->|"starts execution"| node_forge_agent
node_api_app -->|"workflow CRUD"| node_workflow_svc
node_workflow_svc -->|"validates blocks"| node_block_model
node_api_app -->|"observer runs"| node_observer_svc
node_observer_svc -->|"emits DAG"| node_block_model
node_forge_agent -->|"builds state"| node_agent_functions
node_agent_functions -->|"renders prompts"| node_prompt_engine
node_prompt_engine -->|"model call"| node_llm_handler
node_config_registry -->|"resolves model"| node_llm_handler
node_config -.->|"provider keys"| node_config_registry
node_forge_agent -->|"routes v3 steps"| node_taskv3_loop
node_taskv3_engine -->|"drives rounds"| node_taskv3_loop
node_taskv3_loop -->|"invokes tools"| node_taskv3_tools
node_taskv3_loop -.->|"terminate?"| node_goal_check
node_taskv3_tools -->|"executes actions"| node_action_handler
node_forge_agent -->|"applies step"| node_action_handler
node_forge_agent -->|"acquires state"| node_browser_manager
node_browser_manager -->|"launches"| node_real_browser_manager
node_real_browser_manager -.->|"attach"| node_cdp
node_forge_agent -->|"scrapes elements"| node_parse_actions
node_parse_actions -->|"element tree context"| node_prompt_engine
node_forge_agent -.->|"run to script"| node_generate_script
node_generate_script -->|"generates callers"| node_skyvern_page
node_skyvern_page -->|"replays actions"| node_action_handler
node_script_reviewer -.->|"review gate"| node_generate_script
node_self_heal -.->|"failure triage"| node_script_reviewer
node_real_browser_manager -->|"captures video"| node_display_recorder
node_display_recorder -->|"uploads recordings"| node_artifacts


flowchart TD

subgraph group_clients["Clients &amp; SDKs"]
  node_web_ui["React Web App<br/>frontend"]
  node_sdk["Python SDK<br/>client library"]
end

subgraph group_api["API Gateway"]
  node_server["RAGFlow Server<br/>Go main"]
  node_router["HTTP Router<br/>route registry"]
end

subgraph group_docflow["Document Flow"]
  node_ingestion["Ingestion Service<br/>task executor"]
  node_deepdoc{{"DeepDoc OCR<br/>vision runtime"}}
  node_chunk["Chunker<br/>text splitter"]
  node_embedder{{"Embedder<br/>vectorizer"}}
end

subgraph group_index["Index &amp; Storage"]
  node_engine["Search Engine<br/>engine interface"]
  node_storage[("Object Storage<br/>blob factory")]
end

subgraph group_agents["Agents &amp; RAG"]
  node_canvas{{"Agent Canvas<br/>workflow runtime"}}
  node_agentic_rag["Agentic RAG<br/>retrieval loop"]
end

node_web_ui -->|"calls"| node_server
node_sdk -->|"calls"| node_server
node_server -->|"serves routes from"| node_router
node_router -->|"uploads documents to"| node_ingestion
node_router -->|"runs agents through"| node_canvas
node_ingestion -->|"parses PDFs with"| node_deepdoc
node_ingestion -->|"splits text via"| node_chunk
node_chunk -->|"feeds"| node_embedder
node_embedder -->|"writes vectors to"| node_engine
node_engine -.->|"offloads to"| node_storage
node_canvas -.->|"grounds with"| node_agentic_rag
node_agentic_rag -->|"queries"| node_engine


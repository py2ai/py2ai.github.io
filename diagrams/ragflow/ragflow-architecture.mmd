flowchart TD

subgraph group_clients["Clients"]
  node_web_ui["React Web App<br/>frontend"]
  node_sdk["Python SDK<br/>client library"]
end

subgraph group_api["API Gateway"]
  node_server["RAGFlow Server<br/>Go main"]
  node_router["HTTP Router<br/>route registry"]
  node_mcp["MCP Server<br/>tool server"]
  node_dao[("DAO Layer<br/>persistence")]
  node_server_cfg["Server Config<br/>settings"]
end

subgraph group_docflow["Document Flow"]
  node_ingestion["Ingestion Service<br/>task executor"]
  node_deepdoc_session["OCR Sessions<br/>ONNX runtime"]
  node_ocr_det["Text Detector<br/>vision model"]
  node_ocr_rec["Text Recognizer<br/>vision model"]
  node_layout["Layout Analyzer<br/>page analysis"]
  node_parsers{{"Format Parsers<br/>parser set"}}
  node_chunk["Chunker<br/>text splitter"]
  node_embedder{{"Embedder<br/>vectorizer"}}
end

subgraph group_agents["Agents &amp; RAG"]
  node_canvas["Canvas<br/>workflow model"]
  node_component_base["Component Base<br/>base class"]
  node_agent_comp["Agent Component<br/>LLM node"]
  node_begin["Begin Component<br/>entry node"]
  node_categorize["Categorize Component<br/>branch node"]
  node_browser["Browser Component<br/>web node"]
  node_runtime["Component Runtime<br/>executor"]
  node_tools{{"Tool Registry<br/>tool belt"}}
  node_agentic_search["Agentic Search Tool<br/>[agentic_search.go]"]
  node_code_exec["Code Executor<br/>sandbox tool"]
  node_agentic_rag["Agentic RAG<br/>retrieval loop"]
  node_prompts{{"Prompt Library<br/>markdown prompts"}}
end

subgraph group_index["Index &amp; Storage"]
  node_engine["Search Engine<br/>engine interface"]
  node_es_client["Elasticsearch Client<br/>engine backend"]
  node_infinity_client["Infinity Client<br/>engine backend"]
  node_engine_types[("Engine Types<br/>shared schema")]
  node_storage[("Object Storage<br/>blob factory")]
end

subgraph group_support["Support"]
  node_tokenizer["Tokenizer<br/>text utilities"]
  node_embedding_svc["Embedding Service<br/>vector API"]
end

node_web_ui -->|"talks to"| node_server
node_sdk -->|"talks to"| node_server
node_server -->|"boots from"| node_server_cfg
node_server -->|"serves routes from"| node_router
node_router -->|"persists metadata in"| node_dao
node_router -->|"queues documents to"| node_ingestion
node_router -->|"runs workflows through"| node_canvas
node_ingestion -->|"invokes"| node_parsers
node_ingestion -->|"runs OCR via"| node_deepdoc_session
node_deepdoc_session -->|"detects text with"| node_ocr_det
node_deepdoc_session -->|"reads glyphs with"| node_ocr_rec
node_parsers -->|"reads PDFs through"| node_layout
node_parsers -->|"emits text to"| node_chunk
node_chunk -->|"feeds"| node_embedder
node_embedder -.->|"counts tokens with"| node_tokenizer
node_embedder -->|"vectors from"| node_embedding_svc
node_embedder -->|"writes vectors to"| node_engine
node_ingestion -.->|"stores originals in"| node_storage
node_canvas -->|"executes through"| node_runtime
node_runtime -->|"instantiates"| node_component_base
node_component_base -->|"starts at"| node_begin
node_component_base -->|"delegates to"| node_agent_comp
node_component_base -.->|"branches via"| node_categorize
node_agent_comp -.->|"browses with"| node_browser
node_agent_comp -->|"calls"| node_tools
node_agent_comp -.->|"reads"| node_prompts
node_tools -->|"searches corpus via"| node_agentic_search
node_tools -.->|"runs code via"| node_code_exec
node_agentic_rag -->|"uses"| node_agentic_search
node_agentic_rag -->|"iterates retrieval against"| node_engine
node_engine -->|"drives Elasticsearch through"| node_es_client
node_engine -->|"drives Infinity through"| node_infinity_client
node_engine -.->|"models chunks as"| node_engine_types
node_engine -.->|"offloads blobs to"| node_storage


node_openai -->|"implements"| node_llm
node_anthropic -->|"implements"| node_llm
node_sqlite -->|"injected runner"| node_run_sql
node_run_sql -->|"extends"| node_tool
node_fastapi -->|"serves"| node_agent
node_legacy -->|"wrapped by adapter"| node_agent
node_legacy -->|"adapts to"| node_registry


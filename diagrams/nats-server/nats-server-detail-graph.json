{
  "owner": "nats-io",
  "repo": "nats-server",
  "branch": "main",
  "groups": [
    { "id": "lifecycle", "name": "Lifecycle", "label": "Server Lifecycle & Config" },
    { "id": "connections", "name": "Connections", "label": "Client Connections & Parsing" },
    { "id": "routing", "name": "Routing", "label": "Interest & Auth" },
    { "id": "jetstream", "name": "JetStream", "label": "JetStream Core" },
    { "id": "storage", "name": "Storage", "label": "Storage Backends" },
    { "id": "clustering", "name": "Clustering", "label": "Clustering & Raft" },
    { "id": "edge", "name": "Edge", "label": "Leaf Nodes & Gateways" },
    { "id": "monitoring", "name": "Monitoring", "label": "Monitoring & Events" }
  ],
  "nodes": [
    {
      "id": "server",
      "label": "Server",
      "file": "server.go",
      "path": "server/server.go",
      "group": "lifecycle",
      "groupId": "lifecycle",
      "desc": "Server.Start brings up listeners, goroutine pools, monitoring and JetStream"
    },
    {
      "id": "opts",
      "label": "Options",
      "file": "opts.go",
      "path": "server/opts.go",
      "group": "lifecycle",
      "groupId": "lifecycle",
      "desc": "Options.ProcessConfigFile loads server config: ports, accounts, JetStream store"
    },
    {
      "id": "reload",
      "label": "Hot reload",
      "file": "reload.go",
      "path": "server/reload.go",
      "group": "lifecycle",
      "groupId": "lifecycle",
      "desc": "Server.Reload applies config changes without dropping connections"
    },
    {
      "id": "const",
      "label": "Constants",
      "file": "const.go",
      "path": "server/const.go",
      "group": "lifecycle",
      "groupId": "lifecycle",
      "desc": "DEFAULT_PORT 4222 and protocol/version constants"
    },
    {
      "id": "client",
      "label": "Client connection",
      "file": "client.go",
      "path": "server/client.go",
      "group": "connections",
      "groupId": "connections",
      "desc": "readLoop drains the socket; one client struct serves clients, routes, leafs, gateways"
    },
    {
      "id": "parser",
      "label": "Parser",
      "file": "parser.go",
      "path": "server/parser.go",
      "group": "connections",
      "groupId": "connections",
      "desc": "client.parse state machine: OP_PUB, OP_SUB, OP_HPUB, OP_MSG transitions"
    },
    {
      "id": "connect",
      "label": "CONNECT handling",
      "file": "client.go",
      "path": "server/client.go",
      "group": "connections",
      "groupId": "connections",
      "desc": "processConnect validates auth, protocol flags and registers the connection"
    },
    {
      "id": "pub",
      "label": "PUB processing",
      "file": "client.go",
      "path": "server/client.go",
      "group": "connections",
      "groupId": "connections",
      "desc": "processPub plus processMsgResults fan out each message to local subs and remote peers"
    },
    {
      "id": "deliver",
      "label": "Delivery",
      "file": "client.go",
      "path": "server/client.go",
      "group": "connections",
      "groupId": "connections",
      "desc": "deliverMsg writes to subscriber write queues with slow-consumer protection"
    },
    {
      "id": "sublist",
      "label": "Sublist trie",
      "file": "sublist.go",
      "path": "server/sublist.go",
      "group": "routing",
      "groupId": "routing",
      "desc": "Insert and Match on a token trie supporting * and > wildcards with cache"
    },
    {
      "id": "accounts",
      "label": "Account",
      "file": "accounts.go",
      "path": "server/accounts.go",
      "group": "routing",
      "groupId": "routing",
      "desc": "Account struct holds its own sl Sublist plus connection and route interest stats"
    },
    {
      "id": "auth",
      "label": "Auth check",
      "file": "auth.go",
      "path": "server/auth.go",
      "group": "routing",
      "groupId": "routing",
      "desc": "checkAuthentication resolves tokens, NKeys, JWTs and per-user permissions"
    },
    {
      "id": "js",
      "label": "JetStream enable",
      "file": "jetstream.go",
      "path": "server/jetstream.go",
      "group": "jetstream",
      "groupId": "jetstream",
      "desc": "EnableJetStream sets up the store dir, sys accounts and encryption keys"
    },
    {
      "id": "js_api",
      "label": "API dispatch",
      "file": "jetstream_api.go",
      "path": "server/jetstream_api.go",
      "group": "jetstream",
      "groupId": "jetstream",
      "desc": "apiDispatch matches $JS.API subjects to stream/consumer request handlers"
    },
    {
      "id": "stream",
      "label": "Stream",
      "file": "stream.go",
      "path": "server/stream.go",
      "group": "jetstream",
      "groupId": "jetstream",
      "desc": "processJetStreamMsg applies dedupe, limits and retention before storing"
    },
    {
      "id": "direct_get",
      "label": "Direct get",
      "file": "stream.go",
      "path": "server/stream.go",
      "group": "jetstream",
      "groupId": "jetstream",
      "desc": "processDirectGetRequest serves fast message fetch straight from blocks"
    },
    {
      "id": "consumer",
      "label": "Consumer",
      "file": "consumer.go",
      "path": "server/consumer.go",
      "group": "jetstream",
      "groupId": "jetstream",
      "desc": "deliverMsg sequences stored messages to pull/push consumers; acks tracked"
    },
    {
      "id": "js_cluster",
      "label": "JS clustering",
      "file": "jetstream_cluster.go",
      "path": "server/jetstream_cluster.go",
      "group": "jetstream",
      "groupId": "jetstream",
      "desc": "enableJetStreamClustering replicates stream state; JetStreamSnapshotMeta checkpoints"
    },
    {
      "id": "raft",
      "label": "Raft group",
      "file": "raft.go",
      "path": "server/raft.go",
      "group": "jetstream",
      "groupId": "jetstream",
      "desc": "raft.Propose replicates meta and stream entries; elections pick the leader"
    },
    {
      "id": "store",
      "label": "Store interfaces",
      "file": "store.go",
      "path": "server/store.go",
      "group": "storage",
      "groupId": "storage",
      "desc": "StreamStore interface contract every backend implements"
    },
    {
      "id": "filestore",
      "label": "File store",
      "file": "filestore.go",
      "path": "server/filestore.go",
      "group": "storage",
      "groupId": "storage",
      "desc": "StoreMsg appends into msg blocks with crc, encryption and async flush"
    },
    {
      "id": "memstore",
      "label": "Memory store",
      "file": "memstore.go",
      "path": "server/memstore.go",
      "group": "storage",
      "groupId": "storage",
      "desc": "memStore.StoreMsg keeps messages in RAM for ephemeral streams"
    },
    {
      "id": "route",
      "label": "Routes",
      "file": "route.go",
      "path": "server/route.go",
      "group": "clustering",
      "groupId": "clustering",
      "desc": "startRouteAcceptLoop, gossip processImplicitRoute and addRoute form the cluster"
    },
    {
      "id": "route_connect",
      "label": "Route connect",
      "file": "route.go",
      "path": "server/route.go",
      "group": "clustering",
      "groupId": "clustering",
      "desc": "connectToRoute solicits peers and forwardNewRouteInfoToKnownServers spreads INFO"
    },
    {
      "id": "gateway",
      "label": "Gateways",
      "file": "gateway.go",
      "path": "server/gateway.go",
      "group": "clustering",
      "groupId": "clustering",
      "desc": "startGatewayAcceptLoop links independent clusters with interest propagation"
    },
    {
      "id": "leafnode",
      "label": "Leaf accept",
      "file": "leafnode.go",
      "path": "server/leafnode.go",
      "group": "edge",
      "groupId": "edge",
      "desc": "startLeafNodeAcceptLoop and createLeafNode onboard edge servers"
    },
    {
      "id": "leaf_remote",
      "label": "Leaf remotes",
      "file": "leafnode.go",
      "path": "server/leafnode.go",
      "group": "edge",
      "groupId": "edge",
      "desc": "connectToRemoteLeafNodeAsynchronously dials the hub with reconnect and creds"
    },
    {
      "id": "monitor",
      "label": "Monitor root",
      "file": "monitor.go",
      "path": "server/monitor.go",
      "group": "monitoring",
      "groupId": "monitoring",
      "desc": "HandleRoot renders the endpoint index; StartMonitoring runs the HTTP server"
    },
    {
      "id": "varz",
      "label": "Varz / Connz",
      "file": "monitor.go",
      "path": "server/monitor.go",
      "group": "monitoring",
      "groupId": "monitoring",
      "desc": "Varz, Connz, Routez and Jsz serialize live state as JSON on the monitor port"
    },
    {
      "id": "events",
      "label": "System events",
      "file": "events.go",
      "path": "server/events.go",
      "group": "monitoring",
      "groupId": "monitoring",
      "desc": "sendInternalMsg publishes advisories on $SYS subjects"
    }
  ],
  "edges": [
    { "from": "server", "to": "opts", "label": "loads config" },
    { "from": "opts", "to": "const", "label": "default port 4222" },
    { "from": "server", "to": "reload", "label": "hot reload" },
    { "from": "server", "to": "client", "label": "accept loop" },
    { "from": "client", "to": "parser", "label": "feed bytes" },
    { "from": "parser", "to": "connect", "label": "CONNECT op" },
    { "from": "connect", "to": "auth", "label": "authenticate" },
    { "from": "auth", "to": "accounts", "label": "resolve account" },
    { "from": "parser", "to": "pub", "label": "PUB op" },
    { "from": "pub", "to": "sublist", "label": "match subject" },
    { "from": "accounts", "to": "sublist", "label": "own trie" },
    { "from": "pub", "to": "deliver", "label": "deliver locally" },
    { "from": "pub", "to": "route", "label": "forward to peers" },
    { "from": "pub", "to": "gateway", "label": "cross-cluster" },
    { "from": "pub", "to": "leafnode", "label": "bridge to edge" },
    { "from": "server", "to": "js", "label": "enable JetStream" },
    { "from": "js", "to": "store", "label": "pick backend" },
    { "from": "client", "to": "js_api", "label": "$JS.API subject" },
    { "from": "js_api", "to": "stream", "label": "stream ops" },
    { "from": "js_api", "to": "consumer", "label": "consumer ops" },
    { "from": "stream", "to": "filestore", "label": "persist" },
    { "from": "stream", "to": "memstore", "label": "ephemeral" },
    { "from": "stream", "to": "store", "label": "implements StreamStore" },
    { "from": "filestore", "to": "store", "label": "implements StreamStore" },
    { "from": "stream", "to": "direct_get", "label": "direct fetch" },
    { "from": "consumer", "to": "deliver", "label": "push to client" },
    { "from": "consumer", "to": "filestore", "label": "read msgs" },
    { "from": "js", "to": "js_cluster", "label": "cluster mode" },
    { "from": "js_cluster", "to": "raft", "label": "meta + stream groups" },
    { "from": "js_cluster", "to": "route", "label": "uses cluster links" },
    { "from": "route", "to": "route_connect", "label": "solicit peers" },
    { "from": "route", "to": "sublist", "label": "sync interest" },
    { "from": "server", "to": "leaf_remote", "label": "solicit leaf remotes" },
    { "from": "leafnode", "to": "route", "label": "hub fan-in" },
    { "from": "server", "to": "monitor", "label": "StartMonitoring" },
    { "from": "monitor", "to": "varz", "label": "endpoint JSON" },
    { "from": "server", "to": "events", "label": "$SYS advisories" },
    { "from": "events", "to": "js", "label": "JetStream stats" }
  ]
}

flowchart TD

subgraph group_connections["Client Connections"]
  node_server_core["Server lifecycle<br/>[server.go]"]
  node_client_conn["Client read loop<br/>[client.go]"]
  node_parser["Protocol parser<br/>[parser.go]"]
end

subgraph group_routing["Pub/Sub Routing Core"]
  node_sublist["Subject trie<br/>[sublist.go]"]
end

subgraph group_jetstream["JetStream Persistence"]
  node_js_enable["JetStream enable<br/>[jetstream.go]"]
  node_js_api["JS API dispatch<br/>[jetstream_api.go]"]
  node_stream["Stream engine<br/>[stream.go]"]
  node_consumer["Consumer delivery<br/>[consumer.go]"]
  node_filestore["File storage<br/>[filestore.go]"]
end

subgraph group_cluster["Clustering &amp; Edge"]
  node_route["Cluster routes<br/>[route.go]"]
  node_leafnode["Leaf nodes<br/>[leafnode.go]"]
end

subgraph group_monitoring["Monitoring &amp; Ops"]
  node_monitor["Monitor endpoints<br/>[monitor.go]"]
end

node_server_core -->|"accepts clients"| node_client_conn
node_client_conn -->|"parses bytes"| node_parser
node_client_conn -->|"insert + match subs"| node_sublist
node_server_core -->|"enables JetStream"| node_js_enable
node_client_conn -->|"$JS.API requests"| node_js_api
node_js_api -->|"create/config streams"| node_stream
node_stream -->|"persist messages"| node_filestore
node_stream -->|"attach consumers"| node_consumer
node_consumer -->|"delivers messages"| node_client_conn
node_consumer -->|"reads state"| node_filestore
node_server_core -->|"solicit + accept routes"| node_route
node_client_conn -->|"forward msgs to peers"| node_route
node_route -->|"sync interest"| node_sublist
node_server_core -->|"accept leaf nodes"| node_leafnode
node_leafnode -->|"edge fan-in to hub"| node_route
node_server_core -->|"starts HTTP monitor"| node_monitor


node_ctx -->|"creates"| node_df
node_df -->|"executes against"| node_ctx
node_ctx -->|"SQL text"| node_parser
node_parser -->|"statements"| node_planner
node_planner -->|"resolves tables"| node_lplan
node_df -->|"builds operators"| node_lplan
node_lplan -->|"unoptimized plan"| node_optimize
node_rules -->|"rule order"| node_optimize
node_optimize -->|"optimized plan"| node_pplanner
node_pplanner -->|"constructs"| node_pexec
node_pexec -->|"pulls batches"| node_psource
node_listing -->|"table providers"| node_planner


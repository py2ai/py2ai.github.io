node_widget -->|"root configuration"| node_adapter
node_adapter -->|"inflates root Element"| node_element
node_element -->|"markNeedsBuild enrolls"| node_build_owner
node_build_owner -.->|"requests frame"| node_scheduler
node_scheduler -->|"persistent callbacks"| node_widgets_binding
node_widgets_binding -->|"flush build phase"| node_build_owner
node_widgets_binding -->|"flush layout + paint"| node_render_object
node_element -->|"mount creates render object"| node_render_object
node_render_object -->|"box specialization"| node_render_box
node_render_box -->|"tree root"| node_render_view
node_render_object -->|"paint emits layers"| node_layer
node_render_view -.->|"compositeFrame hands off scene"| node_rasterizer
node_shell -->|"vsync tick on UI thread"| node_scheduler
node_shell -->|"owns on raster thread"| node_rasterizer


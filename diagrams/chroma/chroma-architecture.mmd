flowchart TD

subgraph group_sdk["Clients &amp; Server"]
  node_py_client{{"Python client<br/>sync API"}}
  node_async_client["Async client<br/>asyncio API"]
  node_js_client["JS client<br/>TypeScript SDK"]
  node_fastapi_server{{"FastAPI server<br/>REST app"}}
  node_fastapi_api["FastAPI adapter<br/>client-side transport"]
end

subgraph group_python["Python Engine"]
  node_app["System app<br/>component wiring"]
  node_config["Config system<br/>typed settings"]
  node_segment_api{{"SegmentAPI<br/>embedded engine"}}
  node_system_db["System DB<br/>metadata interface"]
  node_sysdb[("SQLite sysdb<br/>durable metadata")]
  node_local_manager["Local segment manager<br/>segment lifecycle"]
  node_distributed_manager["Distributed manager<br/>remote segments"]
  node_hnsw[("Local HNSW<br/>in-process index")]
  node_persistent_hnsw[("Persistent HNSW<br/>mmap index")]
  node_metadata_seg["Metadata segment<br/>sqlite records"]
  node_executor["Query executor<br/>plan traversal"]
  node_expression["Expressions<br/>filter AST"]
  node_quota["Quota enforcer<br/>limits"]
  node_posthog["Product telemetry<br/>PostHog events"]
end

subgraph group_rustcore["Rust Services"]
  node_rust_lib{{"Rust library<br/>system assembly"}}
  node_frontend["Frontend<br/>query planning"]
  node_worker_bins{{"Worker services"}}
  node_compactor["Compactor<br/>log to segment"]
  node_log_service[("Log service<br/>write queue")]
  node_sysdb_rs["Rust sysdb<br/>topology metadata"]
end

subgraph group_rustdata["Rust Data Path"]
  node_wal3[("WAL3<br/>replicated log")]
  node_segment["Rust segments<br/>columnar data"]
  node_index["Rust index<br/>vector indexes"]
  node_storage[("Object storage<br/>cloud files")]
  node_blockstore["Blockstore<br/>chunked IO"]
  node_distance["Distance kernels<br/>SIMD math"]
  node_system["Rust system<br/>component registry"]
end

subgraph group_contracts["Shared Contracts"]
  node_rust_bindings["Python bindings<br/>PyO3 bridge"]
  node_idl["Protobuf IDL<br/>shared schemas"]
end

node_py_client -->|"HTTP transport"| node_fastapi_api
node_async_client -->|"async transport"| node_fastapi_api
node_js_client -->|"REST calls"| node_fastapi_server
node_fastapi_server -->|"serve routes"| node_fastapi_api
node_fastapi_server -->|"build System"| node_app
node_app -->|"load settings"| node_config
node_fastapi_api -->|"in-process ops"| node_segment_api
node_segment_api -->|"metadata calls"| node_system_db
node_system_db -->|"SQLite impl"| node_sysdb
node_segment_api -->|"segment routing"| node_local_manager
node_segment_api -.->|"distributed mode"| node_distributed_manager
node_local_manager -->|"create / load"| node_hnsw
node_hnsw -->|"persist index"| node_persistent_hnsw
node_local_manager -->|"record storage"| node_metadata_seg
node_segment_api -->|"run queries"| node_executor
node_executor -->|"evaluate filters"| node_expression
node_app -.->|"enforce limits"| node_quota
node_app -.->|"emit events"| node_posthog
node_py_client -.->|"embedded engine"| node_rust_bindings
node_rust_bindings -->|"PyO3 calls"| node_rust_lib
node_rust_lib -->|"query path"| node_frontend
node_rust_lib -->|"launch services"| node_worker_bins
node_worker_bins -.->|"compaction tasks"| node_compactor
node_compactor -->|"read records"| node_wal3
node_compactor -->|"write segments"| node_segment
node_compactor -->|"build indexes"| node_index
node_frontend -->|"resolve topology"| node_sysdb_rs
node_frontend -->|"tail writes"| node_log_service
node_frontend -.->|"read files"| node_blockstore
node_log_service -->|"durable append"| node_wal3
node_segment -->|"flush data"| node_storage
node_storage -->|"chunk IO"| node_blockstore
node_segment -->|"score vectors"| node_distance
node_rust_lib -->|"wire components"| node_system
node_idl -.->|"generated types"| node_frontend
node_idl -.->|"generated types"| node_fastapi_server


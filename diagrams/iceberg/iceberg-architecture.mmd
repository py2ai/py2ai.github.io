node_hadoop -->|"extends"| node_metastore
node_metastore -->|"loads tables via"| node_tableops
node_metastore -->|"wraps ops in"| node_basetable
node_hadooptables -->|"reads metadata.json directly"| node_parser
node_table -->|"backed by"| node_tableops
node_tableops -->|"current&#40;&#41; / refresh&#40;&#41;"| node_tablemetadata
node_basetable -->|"newTransaction&#40;&#41;"| node_transaction
node_transaction -->|"queues producers, one commit"| node_producer
node_table -->|"currentSnapshot&#40;&#41;"| node_snapshot
node_snapshotref -->|"pins branch or tag"| node_snapshot
node_table -->|"exposes state"| node_tablemetadata
node_schemaupdate -->|"evolves schema in place"| node_tablemetadata
node_tablemetadata -->|"persisted as JSON"| node_parser
node_producer -->|"atomic commit with retries"| node_tableops
node_fastappend -->|"extends"| node_producer
node_merging -->|"extends"| node_producer
node_overwrite -->|"extends"| node_merging
node_replace -->|"extends"| node_merging
node_rewrite -->|"extends"| node_producer
node_merging -->|"tracks file deletions"| node_filtermanager
node_filtermanager -->|"rewrites surviving entries"| node_mreader
node_fastappend -->|"counts added files"| node_summary
node_producer -->|"writes manifests"| node_files
node_files -->|"write&#40;&#41;"| node_mwriter
node_files -->|"read&#40;&#41;"| node_mreader
node_producer -->|"one list per attempt"| node_listwriter
node_snapshot -->|"snapshot output"| node_listwriter
node_scan -->|"planFiles&#40;&#41;"| node_group
node_group -->|"reads entries"| node_mreader
node_deleteindex -->|"indexes delete files"| node_mreader
node_scan -->|"correlates deletes"| node_deleteindex
node_mreader -->|"skips files by stats"| node_metrics
node_scan -->|"opens task files"| node_parquetreader
node_parquetreader -->|"configured by"| node_readconf
node_parquetreader -->|"projects columns"| node_prunecolumns
node_sparkread -->|"engine tuning"| node_scan


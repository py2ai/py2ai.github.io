node_spark -->|"resolves table names"| node_catalog
node_restcatalog -->|"implements"| node_catalog
node_catalog -->|"returns"| node_table
node_table -->|"loads via TableOperations"| node_tablemetadata
node_tablemetadata -->|"persisted as JSON"| node_parser
node_table -->|"currentSnapshot&#40;&#41;"| node_snapshot
node_snapshot -->|"points to"| node_manifestlist
node_manifestlist -->|"lists manifests"| node_manifest
node_manifest -->|"entries describe"| node_datafile
node_parquet -->|"materializes"| node_datafile
node_table -->|"newScan&#40;&#41;"| node_scan
node_scan -->|"plan tasks from"| node_manifest
node_spark -->|"reads splits"| node_scan


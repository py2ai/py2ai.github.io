node_cli -->|"RED.init + RED.start"| node_bootstrap
node_bootstrap -->|"api.init mounts editor app"| node_admin_api
node_bootstrap -->|"runtime init loads nodes"| node_loader
node_loader -->|"registerNodeConstructor"| node_registry
node_admin_api -->|"POST /flows deploy"| node_api_flows
node_api_flows -->|"mutex then setFlows"| node_flow_mgr
node_flow_mgr -->|"Flow.create per tab"| node_flow
node_flow -->|"createNode instances"| node_node_cls
node_node_cls -->|"node.send → _flow.send"| node_flow
node_flow -->|"typeRegistry.get&#40;type&#41;"| node_registry
node_flow -->|"getFlowContext"| node_context
node_ws_comms -->|"subscribe + receive"| node_api_comms
node_api_comms -->|"publish status/events"| node_ws_comms
node_flow_mgr -->|"runtime-event → publish"| node_api_comms
node_api_flows -->|"deploy revision events"| node_api_comms


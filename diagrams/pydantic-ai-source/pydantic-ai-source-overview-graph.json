{
  "owner": "pydantic",
  "repo": "pydantic-ai",
  "branch": "main",
  "groups": [
    { "id": "g_api", "name": "Agent surface", "label": "Agent surface" },
    { "id": "g_engine", "name": "Run graph engine", "label": "Run graph engine" },
    { "id": "g_models", "name": "Model layer", "label": "Model layer" },
    { "id": "g_tools", "name": "Tool layer", "label": "Tool layer" },
    { "id": "g_output", "name": "Output and usage", "label": "Output and usage" },
    { "id": "g_support", "name": "Message plumbing", "label": "Message plumbing" }
  ],
  "nodes": [
    {
      "id": "app",
      "label": "Your application",
      "file": "README.md",
      "path": "README.md",
      "group": null,
      "groupId": null,
      "desc": "Declares an Agent with an output_type and typed tools",
      "shape": "hexagon"
    },
    {
      "id": "agent",
      "label": "Agent",
      "file": "agent/__init__.py",
      "path": "pydantic_ai_slim/pydantic_ai/agent/__init__.py",
      "group": "Agent surface",
      "groupId": "g_api",
      "desc": "Agent class; run/iter/run_sync inherited from AbstractAgent",
      "shape": "box"
    },
    {
      "id": "reqnode",
      "label": "ModelRequestNode",
      "file": "_agent_graph.py",
      "path": "pydantic_ai_slim/pydantic_ai/_agent_graph.py",
      "group": "Run graph engine",
      "groupId": "g_engine",
      "desc": "Prepares ModelRequestParameters and calls Model.request",
      "shape": "box"
    },
    {
      "id": "calltools",
      "label": "CallToolsNode",
      "file": "_agent_graph.py",
      "path": "pydantic_ai_slim/pydantic_ai/_agent_graph.py",
      "group": "Run graph engine",
      "groupId": "g_engine",
      "desc": "Dispatches ToolCallPart to toolsets or validates final output",
      "shape": "box"
    },
    {
      "id": "model",
      "label": "Model protocol",
      "file": "models/__init__.py",
      "path": "pydantic_ai_slim/pydantic_ai/models/__init__.py",
      "group": "Model layer",
      "groupId": "g_models",
      "desc": "Model ABC plus infer_model resolution from a model string",
      "shape": "box"
    },
    {
      "id": "provider",
      "label": "Provider",
      "file": "providers/__init__.py",
      "path": "pydantic_ai_slim/pydantic_ai/providers/__init__.py",
      "group": "Model layer",
      "groupId": "g_models",
      "desc": "infer_provider builds the SDK client from env and api_key",
      "shape": "box"
    },
    {
      "id": "fallback",
      "label": "FallbackModel",
      "file": "models/fallback.py",
      "path": "pydantic_ai_slim/pydantic_ai/models/fallback.py",
      "group": "Model layer",
      "groupId": "g_models",
      "desc": "Wraps models in order, failing over on terminal errors",
      "shape": "box"
    },
    {
      "id": "instr",
      "label": "InstrumentedModel",
      "file": "models/instrumented.py",
      "path": "pydantic_ai_slim/pydantic_ai/models/instrumented.py",
      "group": "Message plumbing",
      "groupId": "g_support",
      "desc": "Wrapper that emits OpenTelemetry spans around requests",
      "shape": "box"
    },
    {
      "id": "messages",
      "label": "ModelRequest / ModelResponse",
      "file": "messages.py",
      "path": "pydantic_ai_slim/pydantic_ai/messages.py",
      "group": "Message plumbing",
      "groupId": "g_support",
      "desc": "Typed message parts: TextPart, ToolCallPart, ToolReturnPart",
      "shape": "document"
    },
    {
      "id": "tools",
      "label": "Tool / ToolDefinition",
      "file": "tools.py",
      "path": "pydantic_ai_slim/pydantic_ai/tools.py",
      "group": "Tool layer",
      "groupId": "g_tools",
      "desc": "Function wrapped with an args schema built from its signature",
      "shape": "box"
    },
    {
      "id": "output",
      "label": "OutputSchema / OutputValidator",
      "file": "_output.py",
      "path": "pydantic_ai_slim/pydantic_ai/_output.py",
      "group": "Output and usage",
      "groupId": "g_output",
      "desc": "Wraps output_type; validates or signals a retry",
      "shape": "box"
    },
    {
      "id": "usage",
      "label": "Usage / UsageLimits",
      "file": "usage.py",
      "path": "pydantic_ai_slim/pydantic_ai/usage.py",
      "group": "Output and usage",
      "groupId": "g_output",
      "desc": "RunUsage accounting; limits checked before each request",
      "shape": "box"
    }
  ],
  "edges": [
    { "from": "app", "to": "agent", "label": "Agent(model, output_type=...)" },
    { "from": "agent", "to": "reqnode", "label": "run/iter starts graph" },
    { "from": "reqnode", "to": "model", "label": "Model.request()" },
    { "from": "model", "to": "provider", "label": "infer_provider -> client" },
    { "from": "reqnode", "to": "messages", "label": "sends ModelRequest" },
    { "from": "model", "to": "messages", "label": "returns ModelResponse" },
    { "from": "fallback", "to": "model", "label": "failover on errors", "style": "dashed" },
    { "from": "instr", "to": "model", "label": "traces every request", "style": "dashed" },
    { "from": "messages", "to": "calltools", "label": "ToolCallPart -> dispatch" },
    { "from": "calltools", "to": "tools", "label": "validate args, execute" },
    { "from": "tools", "to": "messages", "label": "appends ToolReturnPart" },
    { "from": "calltools", "to": "output", "label": "output tool or text" },
    { "from": "output", "to": "messages", "label": "retry prompt on failure" },
    { "from": "reqnode", "to": "usage", "label": "check_before_request" },
    { "from": "calltools", "to": "usage", "label": "accumulate RequestUsage" },
    { "from": "output", "to": "agent", "label": "FinalResult via End" }
  ]
}

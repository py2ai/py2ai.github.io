node_app{{"Your application<br/>[README.md]"}}

node_app -->|"Agent&#40;model, output_type=...&#41;"| node_agent
node_agent -->|"run/iter starts graph"| node_reqnode
node_reqnode -->|"Model.request&#40;&#41;"| node_model
node_model -->|"infer_provider -&gt; client"| node_provider
node_reqnode -->|"sends ModelRequest"| node_messages
node_model -->|"returns ModelResponse"| node_messages
node_fallback -.->|"failover on errors"| node_model
node_instr -.->|"traces every request"| node_model
node_messages -->|"ToolCallPart -&gt; dispatch"| node_calltools
node_calltools -->|"validate args, execute"| node_tools
node_tools -->|"appends ToolReturnPart"| node_messages
node_calltools -->|"output tool or text"| node_output
node_output -->|"retry prompt on failure"| node_messages
node_reqnode -->|"check_before_request"| node_usage
node_calltools -->|"accumulate RequestUsage"| node_usage
node_output -->|"FinalResult via End"| node_agent


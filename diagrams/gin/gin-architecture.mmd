node_serve_http -->|"pool.Get&#40;&#41;.&#40;*Context&#41;"| node_engine_pool
node_engine_pool -->|"pool.New builds the first Context"| node_allocate_context
node_serve_http -->|"writermem.reset + c.reset"| node_ctx_reset
node_serve_http -->|"dispatch"| node_handle_request
node_handle_request -->|"find root for c.Request.Method"| node_tree_get
node_tree_get -->|"linear scan over one tree per method"| node_method_trees
node_handle_request -->|"root.getValue&#40;rPath, c.params, c.skippedNodes, unescape&#41;"| node_get_value
node_get_value -->|"push a frame before wildcard descent"| node_skipped_nodes
node_get_value -->|"value.handlers -&gt; c.handlers, then c.Next&#40;&#41;"| node_handle_request
node_add_route -->|"append methodTree&#123;method, root&#125; on first route"| node_method_trees
node_add_route -->|"root.addRoute&#40;path, handlers&#41;"| node_node_add_route
node_node_add_route -->|"insert terminal node"| node_insert_child
node_node_add_route -->|"keep hottest children first"| node_increment_prio
node_group_handle -->|"engine.addRoute&#40;method, absolutePath, handlers&#41;"| node_add_route
node_group_handle -->|"group middleware + route handler"| node_combine_handlers
node_combine_handlers -->|"merged HandlersChain, size &lt; abortIndex"| node_handlers_chain
node_ctx_next -->|"invoke handlers&#91;c.index&#93; in order"| node_handlers_chain
node_ctx_next -->|"Abort pins the index"| node_ctx_abort
node_ctx_abort -->|"index = math.MaxInt8 &gt;&gt; 1"| node_abort_index
node_abort_with_status -->|"Status + WriteHeaderNow + Abort"| node_ctx_abort
node_ctx_next -->|"final handler reads the request"| node_should_bind
node_should_bind -->|"Default&#40;method, ContentType&#41;"| node_bind_default
node_should_bind_json -->|"binding.JSON.Bind&#40;req, obj&#41;"| node_json_binding
node_bind_default -->|"application/json -&gt; jsonBinding"| node_json_binding
node_json_binding -->|"decodeJSON&#40;req.Body, obj&#41;"| node_decode_json
node_decode_json -->|"validate&#40;obj&#41; after successful decode"| node_binding_validate
node_binding_validate -->|"Validator.ValidateStruct&#40;obj&#41;"| node_default_validator
node_default_validator -->|"lazyinit once, tag 'binding'"| node_validate_struct
node_ctx_json -->|"c.Render&#40;code, render.JSON&#41;"| node_render_json
node_render_json -->|"status + body written through writermem"| node_write_header_now
node_serve_error -->|"runs engine.allNoRoute chain"| node_ctx_next
node_serve_error -->|"default '404 page not found' body"| node_write_header_now
node_handle_request -->|"no route matched"| node_serve_error
node_handle_request -->|"value.tsr &amp;&amp; RedirectTrailingSlash"| node_tsr_redirect
node_ctx_next -->|"defer recover&#40;&#41; wraps the chain"| node_recovery_mw
node_recovery_mw -->|"writes 500 after panic"| node_write_header_now


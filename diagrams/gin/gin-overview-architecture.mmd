node_serve_http -->|"pool.Get&#40;&#41; reuses one *Context per request"| node_ctx_pool
node_serve_http -->|"c.reset&#40;&#41; then handleHTTPRequest&#40;c&#41;"| node_handle_request
node_handle_request -->|"pick the tree whose method matches"| node_method_trees
node_method_trees -->|"root.getValue&#40;rPath, c.params, c.skippedNodes&#41;"| node_get_value
node_get_value -->|"value.handlers stored on Context"| node_combine_handlers
node_combine_handlers -->|"c.Next&#40;&#41; walks the merged chain"| node_ctx_next
node_ctx_next -->|"Abort stops pending handlers"| node_ctx_abort
node_ctx_next -->|"first middleware defers recover&#40;&#41;"| node_recovery_mw
node_ctx_next -->|"final handler parses the request"| node_should_bind
node_should_bind -->|"method + Content-Type choose engine"| node_bind_default
node_bind_default -->|"validate&#40;obj&#41; after decode"| node_validator


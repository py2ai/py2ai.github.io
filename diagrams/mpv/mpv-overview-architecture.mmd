end

node_mpv_main -->|"instantiates"| node_mp_context
node_mpv_main -->|"drives playback"| node_mp_play_files
node_mp_play_files -->|"while &#40;!stop_play&#41; per file"| node_run_playloop
node_run_playloop -->|"each tick"| node_fill_audio_out_buffers
node_run_playloop -->|"each tick"| node_write_video
node_run_playloop -->|"consumes keys"| node_run_command
node_run_playloop -->|"sleeps when idle"| node_mp_wait_events
node_mp_wait_events -.->|"wakeup restarts loop"| node_run_playloop
node_write_video -->|"pulls packets"| node_demux_read_packet_async
node_demux_read_packet_async -->|"wakes reader"| node_demux_thread
node_demux_thread -.->|"refills queue"| node_demux_read_packet_async
node_write_video -->|"queues frames"| node_vo_thread
node_write_video -->|"catches up"| node_check_framedrop
node_vo_thread -.->|"wakes core on frame done"| node_run_playloop


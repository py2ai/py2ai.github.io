node_mpv_main -->|"creates"| node_mp_context
node_mpv_main -->|"drives playback"| node_mp_play_files
node_mp_play_files -->|"STOP state"| node_idle_loop
node_mp_play_files -->|"next entry"| node_play_current_file
node_play_current_file -->|"while &#40;!stop_play&#41;"| node_run_playloop
node_run_playloop -->|"audio first"| node_fill_audio_out_buffers
node_run_playloop -->|"then video"| node_write_video
node_run_playloop -->|"READY to PLAYING"| node_handle_playback_restart
node_run_playloop -->|"one seek per tick"| node_execute_queued_seek
node_run_playloop -->|"end detection"| node_handle_eof
node_run_playloop -->|"after sleep"| node_mp_process_input
node_run_playloop -->|"sleep until woken"| node_mp_wait_events
node_mp_set_timeout -->|"sets deadline"| node_mp_wait_events
node_mp_wait_events -.->|"returns on wakeup"| node_run_playloop
node_mp_process_input -->|"one command each"| node_run_command
node_run_command -->|"pause toggle"| node_set_pause_state
node_set_pause_state -->|"re-run loop"| node_mp_wakeup_core
node_run_command -->|"seek key"| node_execute_queued_seek
node_write_video -->|"decode image"| node_video_output_image
node_write_video -->|"packets for decoder"| node_demux_read_packet_async
node_write_video -->|"hand frame to VO"| node_vo_queue_frame
node_write_video -->|"on VD_WAIT"| node_check_framedrop
node_write_video -->|"every shown frame"| node_adjust_sync
node_check_framedrop -->|"fewer decodes"| node_video_output_image
node_vo_queue_frame -->|"queued"| node_vo_thread
node_vo_thread -->|"at vsync target"| node_render_frame
node_render_frame -->|"drop or done"| node_mp_wakeup_core
node_demux_read_packet_async -->|"wakes reader thread"| node_demux_thread
node_demux_thread -->|"loop body"| node_thread_work
node_thread_work -->|"fill queues"| node_read_packet
node_thread_work -->|"periodically"| node_update_cache
node_read_packet -->|"bound memory"| node_prune_old_packets
node_thread_work -->|"more data ready"| node_mp_wakeup_core
node_demux_get_reader_state -->|"reader eof check"| node_handle_eof
node_fill_audio_out_buffers -->|"reload on AO events"| node_reinit_audio_chain
node_reinit_audio_chain -->|"open device"| node_ao_init_best
node_fill_audio_out_buffers -->|"queue full = READY"| node_handle_playback_restart
node_handle_playback_restart -->|"both chains READY"| node_audio_start_ao
node_audio_start_ao -->|"sound starts"| node_mp_wakeup_core


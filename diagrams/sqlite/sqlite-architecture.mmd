node_api_open -->|"connection handle in hand"| node_api_exec
node_api_exec -->|"prepare each SQL string"| node_api_prepare
node_api_exec -->|"step for each result row"| node_api_step
node_api_prepare -->|"internal compile driver"| node_compile_prepare
node_compile_prepare -->|"tokenize zSql"| node_compile_runparser
node_compile_runparser -->|"tokens drive LALR actions"| node_compile_grammar
node_compile_grammar -->|"CREATE TABLE action"| node_build_start
node_build_start -->|"schema row + OP_ParseSchema"| node_build_end
node_build_end -->|"emit schema bootstrap opcodes"| node_vm_addop
node_compile_grammar -->|"SELECT builds a Select object"| node_select
node_select -->|"plan WHERE + joins"| node_where_begin
node_select -->|"lower expressions"| node_expr
node_expr -->|"append opcodes"| node_vm_addop
node_where_begin -->|"emit join-loop opcodes"| node_vm_addop
node_where_begin -.->|"close loops, free plan"| node_where_end
node_api_step -->|"execute the program"| node_vm_exec
node_vm_addop -->|"opcode stream ready"| node_vm_exec
node_vm_exec -->|"OP_Transaction"| node_bt_begin
node_vm_exec -->|"OP_Column / OP_Seek*"| node_bt_cursor
node_vm_exec -.->|"registers &amp; scratch"| node_mem_malloc64
node_bt_begin -->|"locking via the pager"| node_pg_sharedlock
node_bt_cursor -->|"decode record bytes"| node_bt_payload
node_bt_cursor -->|"fetch b-tree pages"| node_pg_get
node_bt_insert -->|"dirty pages for writes"| node_pg_get
node_bt_commit -->|"flush strategy"| node_pg_commit1
node_pg_sharedlock -.->|"rebuild wal-index if stale"| node_wal_recover
node_pg_get -->|"WAL mode: check log first"| node_wal_findframe
node_wal_findframe -->|"copy page image"| node_wal_readframe
node_wal_readframe -->|"read -wal via VFS"| node_vfs_unixread
node_pg_get -->|"page miss: read db file"| node_vfs_unixread
node_pg_commit1 -->|"rollback mode: journal, then write"| node_pg_writepagelist
node_pg_commit1 -->|"WAL mode: begin write txn"| node_wal_writetx
node_wal_writetx -->|"append frames to -wal"| node_wal_frames
node_wal_frames -->|"VFS dispatch"| node_vfs_oswrite
node_pg_writepagelist -->|"VFS dispatch"| node_vfs_oswrite
node_vfs_oswrite -->|"unix VFS implementation"| node_vfs_unixwrite


flowchart TD

subgraph group_g_api["Public API &#40;main.c / legacy.c / prepare.c&#41;"]
  node_exec["sqlite3_exec<br/>[legacy.c]"]
  node_prepare["sqlite3_prepare_v2<br/>[prepare.c]"]
end

subgraph group_g_compile["Tokenizer &amp; Lemon Parser"]
  node_tokenize["sqlite3RunParser<br/>[tokenize.c]"]
  node_grammar["sqlite3Parser<br/>[parse.y]"]
end

subgraph group_g_codegen["Code Generation &amp; Planning"]
  node_build["sqlite3StartTable<br/>[build.c]"]
  node_planner["sqlite3WhereBegin<br/>[where.c]"]
end

subgraph group_g_vm["VDBE Virtual Machine"]
  node_vdbe{{"sqlite3VdbeExec<br/>[vdbe.c]"}}
end

subgraph group_g_storage["B-Tree · Pager · WAL · VFS"]
  node_btree[("sqlite3BtreeBeginTrans<br/>[btree.c]")]
  node_pager[("sqlite3PagerSharedLock<br/>[pager.c]")]
  node_wal[("sqlite3WalFrames<br/>[wal.c]")]
  node_vfs[("unixRead<br/>[os_unix.c]")]
end

subgraph group_g_mem["Memory &amp; Allocation"]
  node_mem["sqlite3_malloc64<br/>[malloc.c]"]
end

node_exec -->|"prepare_v2 per statement"| node_prepare
node_prepare -->|"SQL text in, tokens out"| node_tokenize
node_tokenize -->|"tokens drive the LALR parser"| node_grammar
node_grammar -->|"DDL actions build schema objects"| node_build
node_grammar -->|"query statements are planned here"| node_planner
node_build -->|"DDL emits opcodes"| node_vdbe
node_planner -->|"plan lowered to VDBE program"| node_vdbe
node_prepare -->|"sqlite3VdbeMakeReady"| node_vdbe
node_vdbe -->|"cursor &amp; transaction opcodes"| node_btree
node_vdbe -.->|"registers, cursors, scratch"| node_mem
node_btree -->|"page fetch/dirty via pager"| node_pager
node_btree -.->|"page cache allocations"| node_mem
node_pager -->|"WAL mode: append frames"| node_wal
node_pager -->|"unixRead/unixWrite"| node_vfs
node_wal -->|"-wal file I/O"| node_vfs


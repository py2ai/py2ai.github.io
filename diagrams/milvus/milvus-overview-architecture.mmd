flowchart TD

subgraph group_access["Access"]
  node_sdk["Go client<br/>core"]
  node_proxy{{"Proxy<br/>core"}}
end

subgraph group_coordination["Coordinators"]
  node_rootcoord["RootCoord<br/>core"]
  node_querycoord["QueryCoord<br/>core"]
  node_datacoord["DataCoord<br/>core"]
  node_tso["TSO<br/>core"]
end

subgraph group_logpath["Log path"]
  node_mq[("Message queue<br/>data")]
  node_streamingnode["StreamingNode<br/>core"]
end

subgraph group_execution["Execution"]
  node_datanode["DataNode<br/>core"]
  node_querynode{{"QueryNode<br/>core"}}
end

subgraph group_foundation["Foundation"]
  node_segcore{{"Segcore"}}
  node_storage[("Object storage<br/>data")]
end

node_sdk -->|"gRPC requests"| node_proxy
node_proxy -->|"DDL and metadata"| node_rootcoord
node_proxy -.->|"timestamps writes"| node_tso
node_proxy -->|"publishes messages"| node_mq
node_rootcoord -.->|"allocates time ticks"| node_tso
node_mq -->|"log shards land on"| node_streamingnode
node_streamingnode -->|"feeds flush consumers"| node_datanode
node_streamingnode -->|"streams to subscribers"| node_querynode
node_datanode -->|"writes binlogs"| node_storage
node_datacoord -.->|"directs flush and compaction"| node_datanode
node_datacoord -.->|"organizes segments"| node_storage
node_querycoord -.->|"assigns segments and replicas"| node_querynode
node_querynode -->|"loads sealed segments"| node_storage
node_querynode -->|"executes through"| node_segcore


flowchart TD

subgraph group_access["Access tier"]
  node_sdk["MilvusClient<br/>core"]
  node_proxy["Proxy<br/>core"]
  node_proxy_tasks{{"Task machinery<br/>core"}}
end

subgraph group_coordinators["Coordinators"]
  node_rootcoord["RootCoord<br/>core"]
  node_datacoord["DataCoord<br/>core"]
  node_querycoord_meta["QueryCoord meta<br/>core"]
  node_querycoord_scheduler["Task scheduler<br/>core"]
  node_querycoord_checker["Checkers<br/>core"]
  node_tso["TSO<br/>core"]
end

subgraph group_datapath["Data path"]
  node_mq_msgstream[("MsgStream<br/>data")]
  node_wal["WAL<br/>core"]
  node_datanode["DataNode<br/>core"]
  node_datanode_services["DataNode services<br/>core"]
  node_data_codec["DataCodec<br/>[data_codec.go]"]
  node_binlog_writer[("BinlogWriter<br/>data")]
end

subgraph group_querypath["Query path"]
  node_querynode_pipeline["QueryNode pipeline<br/>core"]
  node_delegator{{"Delegator<br/>core"}}
  node_segments["Segment manager<br/>core"]
  node_local_worker["Local worker<br/>core"]
end

subgraph group_cppcore["C++ engine"]
  node_segcore_sealed{{"Sealed segment<br/>core"}}
  node_segcore_growing["Growing segment<br/>core"]
  node_plan["Plan builder<br/>core"]
  node_exec_driver["Exec driver<br/>core"]
end

subgraph group_foundation["Foundation"]
  node_etcd_kv[("etcd KV<br/>data")]
  node_object_storage[("Azure object storage<br/>data")]
end

node_sdk -->|"gRPC"| node_proxy
node_proxy -->|"wraps requests as"| node_proxy_tasks
node_proxy_tasks -->|"DDL flows to"| node_rootcoord
node_proxy_tasks -->|"DML publishes"| node_mq_msgstream
node_rootcoord -->|"persists metadata"| node_etcd_kv
node_datacoord -->|"persists segment states"| node_etcd_kv
node_rootcoord -.->|"time ticks"| node_tso
node_proxy_tasks -.->|"write timestamps"| node_tso
node_mq_msgstream -->|"log shards"| node_wal
node_wal -->|"consumed by"| node_datanode_services
node_datanode_services -->|"drive"| node_datanode
node_datanode -->|"serializes through"| node_data_codec
node_data_codec -->|"written as"| node_binlog_writer
node_binlog_writer -->|"lands on"| node_object_storage
node_datacoord -.->|"compaction directives"| node_datanode
node_querycoord_meta -->|"informs"| node_querycoord_scheduler
node_querycoord_checker -->|"proposes tasks"| node_querycoord_scheduler
node_querycoord_scheduler -.->|"load and release"| node_querynode_pipeline
node_querynode_pipeline -->|"fills growing"| node_segments
node_wal -->|"streams into"| node_querynode_pipeline
node_delegator -->|"dispatches"| node_local_worker
node_delegator -->|"routes by segment"| node_segments
node_local_worker -->|"executes on"| node_segments
node_segments -->|"sealed data"| node_segcore_sealed
node_segments -->|"growing data"| node_segcore_growing
node_segcore_sealed -->|"compiled by"| node_plan
node_segcore_growing -->|"compiled by"| node_plan
node_plan -->|"runs on"| node_exec_driver
node_querynode_pipeline -.->|"reads sealed files"| node_object_storage
node_delegator -.->|"merged results"| node_proxy


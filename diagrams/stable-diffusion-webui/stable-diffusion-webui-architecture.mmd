node_ui -.->|"applies"| node_styles
node_prompt_parser -.->|"weights applied by"| node_hijack_clip
node_processing -->|"uses"| node_sd_models
node_sd_models -.->|"patched by"| node_sd_hijack
node_sd_hijack -->|"installs"| node_hijack_clip

node_main -->|"create listening connections"| node_conn_new
node_conn_new -->|"attach libevent callback"| node_drive_machine
node_drive_machine -->|"spread conns to workers"| node_dispatch_conn_new
node_dispatch_conn_new -->|"wake worker event loop"| node_thread_libevent_process
node_thread_libevent_process -->|"run state machine"| node_drive_machine
node_drive_machine -->|"text protocol input"| node_try_read_command_ascii
node_try_read_command_ascii -->|"parse and dispatch"| node_process_command_ascii
node_process_command_ascii -->|"meta get mg"| node_process_mget_cmd
node_process_mget_cmd -->|"lookup key"| node_assoc_find
node_process_command_ascii -->|"set allocates item"| node_do_item_alloc
node_do_item_alloc -->|"chunk from slab class"| node_do_slabs_alloc
node_process_mget_cmd -->|"fetch from flash on hit"| node_storage_get_item


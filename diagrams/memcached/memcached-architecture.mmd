node_main -->|"create listening connections"| node_conn_new
node_conn_new -->|"attach libevent callback"| node_drive_machine
node_main -->|"initialize worker threads"| node_setup_thread
node_main -->|"select hash algorithm"| node_hash_init
node_drive_machine -->|"spread accepted conns"| node_dispatch_conn_new
node_dispatch_conn_new -->|"notify worker via pipe"| node_thread_libevent_process
node_thread_libevent_process -->|"run state machine on worker"| node_drive_machine
node_drive_machine -->|"text protocol input"| node_try_read_command_ascii
node_drive_machine -->|"binary protocol input"| node_try_read_command_binary
node_drive_machine -->|"proxy listener conns"| node_try_read_command_proxy
node_try_read_command_ascii -->|"hand parsed line to dispatcher"| node_process_command_ascii
node_try_read_command_binary -->|"decode packet opcode"| node_dispatch_bin_command
node_try_read_command_proxy -->|"queue client request"| node_proxy_process_command
node_process_command_ascii -->|"tokenize text/meta request"| node_process_request
node_process_command_ascii -->|"mg meta get"| node_process_mget_cmd
node_process_command_ascii -->|"me meta debug"| node_process_meta_command
node_process_command_ascii -->|"get/gets/gat/gats"| node_process_get_command
node_process_command_ascii -->|"set/add/replace/cas"| node_process_update_command
node_process_command_ascii -->|"lru_crawler admin"| node_process_lru_crawler_command
node_process_update_command -->|"set path allocates item"| node_do_item_alloc
node_process_mget_cmd -->|"lookup key in cache"| node_item_get
node_process_mget_cmd -->|"read body from flash"| node_storage_get_item
node_process_mget_cmd -->|"vivify links missing item"| node_do_item_link
node_item_get -->|"lock item and bump refcount"| node_do_item_get
node_do_item_get -->|"hash table lookup"| node_assoc_find
node_do_item_alloc -->|"pull chunk from slab class"| node_do_slabs_alloc
node_do_item_link -->|"publish item in hash table"| node_assoc_insert
node_lru_pull_tail -->|"unlink evicted item"| node_assoc_delete
node_lru_pull_tail -->|"recycle evicted chunk"| node_do_slabs_free
node_process_lru_crawler_command -->|"start crawl on slab classes"| node_lru_crawler_crawl
node_storage_write -->|"pull cold items for offload"| node_lru_pull_tail
node_storage_write -->|"allocate flash header item"| node_do_item_alloc
node_storage_write -->|"submit page write"| node_extstore_write
node_proxy_process_command -->|"run Lua routing context"| node_proxy_run_rcontext


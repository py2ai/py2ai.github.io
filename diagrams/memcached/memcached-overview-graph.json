    { "id": "do_slabs_alloc", "label": "do_slabs_alloc", "file": "slabs.c", "path": "slabs.c", "group": "Slabs & Hash", "groupId": "memory", "desc": "Hands out one fixed-size chunk from a slab page freelist" },
    { "id": "assoc_find", "label": "assoc_find", "file": "assoc.c", "path": "assoc.c", "group": "Slabs & Hash", "groupId": "memory", "desc": "Chained hash table lookup keyed by the hashed key" },
    { "id": "storage_get_item", "label": "storage_get_item", "file": "storage.c", "path": "storage.c", "group": "Flash Storage", "groupId": "extstore", "desc": "Issues async reads to fetch an item body back from external flash" }

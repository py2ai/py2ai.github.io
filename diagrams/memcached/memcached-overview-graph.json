    { "id": "extstore", "name": "extstore", "label": "Flash Storage" }
  ],
  "nodes": [
    { "id": "main", "label": "main", "file": "memcached.c", "path": "memcached.c", "group": "Event Core", "groupId": "core", "desc": "Process entry: parses flags, initializes slabs and threads, starts the libevent loop" },
    { "id": "conn_new", "label": "conn_new", "file": "memcached.c", "path": "memcached.c", "group": "Event Core", "groupId": "core", "desc": "Wraps a client socket in a conn struct and binds it to libevent" },
    { "id": "drive_machine", "label": "drive_machine", "file": "memcached.c", "path": "memcached.c", "group": "Event Core", "groupId": "core", "desc": "Per-connection state machine that drives every read, parse and write" },

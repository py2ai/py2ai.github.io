    { "id": "thread_libevent_process", "label": "thread_libevent_process", "file": "thread.c", "path": "thread.c", "group": "Worker Threads", "groupId": "threads", "desc": "Worker event loop callback that picks up connections from the notify pipe" },
    { "id": "try_read_command_ascii", "label": "try_read_command_ascii", "file": "proto_text.c", "path": "proto_text.c", "group": "Protocols", "groupId": "protocols", "desc": "Buffers input until a complete text or meta protocol line arrives" },
    { "id": "process_command_ascii", "label": "process_command_ascii", "file": "proto_text.c", "path": "proto_text.c", "group": "Protocols", "groupId": "protocols", "desc": "Dispatches parsed text and meta commands to their handlers" },

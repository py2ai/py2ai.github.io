end

subgraph group_server["Server"]
  node_routes["FastAPI Routes<br/>HTTP layer"]
  node_route_utils["Route Utils<br/>HTTP helpers"]
  node_server["Server Boot<br/>startup"]
  node_http_server["HTTP Server<br/>uvicorn wrapper"]
  node_node_server["Node Server<br/>alternative runtime"]
  node_oauth["OAuth<br/>[oauth.py]"]
end

subgraph group_runtime["Runtime"]
  node_queue[("Event Queue<br/>job queue")]
  node_state_holder[("Session State<br/>state store")]

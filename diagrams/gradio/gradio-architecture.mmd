  node_flagging["Flagging<br/>data capture"]
  node_utils["Utils<br/>[utils.py]"]
end

subgraph group_extras["Extras"]
  node_mcp{{"MCP Server<br/>tool server"}}
  node_themes["Themes<br/>style system"]
  node_tunneling["Tunneling<br/>share links"]
  node_networking["Networking<br/>port utils"]
end

subgraph group_client["Client"]
  node_client["Gradio Client<br/>API client"]
  node_client_utils["Client Utils<br/>client plumbing"]
end


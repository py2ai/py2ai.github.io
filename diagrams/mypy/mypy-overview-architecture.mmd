node_cli -->|"invokes"| node_build
node_build -->|"feeds sources"| node_fastparse
node_fastparse -->|"emits AST"| node_nodes
node_build -->|"binds modules"| node_semanal
node_semanal -->|"fills symbols"| node_nodes
node_build -->|"checks graph"| node_checker
node_semanal -->|"hands off"| node_checker
node_checker -->|"delegates expressions"| node_checkexpr
node_checkexpr -->|"collects"| node_constraints
node_constraints -->|"solves vars"| node_solver
node_solver -->|"substitutes"| node_types
node_checker -->|"narrows branches"| node_binder
node_checkexpr -->|"type context"| node_types
node_checker -->|"typed AST feeds"| node_mypyc


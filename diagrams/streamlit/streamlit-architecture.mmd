flowchart TD

subgraph group_entry["Entry and Web"]
  node_cli["CLI<br/>Entry"]
  node_bootstrap["Bootstrap<br/>Entry"]
  node_config[("Config<br/>[config.py]")]
  node_server["Starlette Server<br/>Web layer"]
  node_websocket["WebSocket Handler<br/>Web layer"]
  node_static_routes["Static Routes<br/>Web layer"]
end

subgraph group_runtime["Runtime Core"]
  node_runtime["Runtime<br/>Singleton"]
  node_session_manager["Session Manager<br/>Registry"]
  node_app_session["App Session<br/>[app_session.py]"]
  node_forward_msg_queue["ForwardMsg Queue"]
  node_forward_msg_cache[("ForwardMsg Cache")]
  node_media_file_manager["Media File Manager<br/>Storage"]
  node_uploaded_file_manager["Uploaded File Manager<br/>Storage"]
end

subgraph group_script["Script Execution"]
  node_script_runner["ScriptRunner<br/>Executor"]
  node_script_cache["Script Cache<br/>[script_cache.py]"]
  node_exec_code["Exec Code<br/>Executor"]
  node_magic{{"Magic<br/>Transformer"}}
  node_delta_generator["Delta Generator<br/>Core object"]
  node_fragment["Fragments<br/>Mechanism"]
  node_execution_control["Execution Control<br/>Commands"]
  node_cache_data["st.cache_data<br/>Memoization"]
  node_cache_resource["st.cache_resource<br/>Memoization"]
  node_hashing{{"Hashing<br/>[hashing.py]"}}
end

subgraph group_state["State and Watching"]
  node_session_state["Session State<br/>[session_state.py]"]
  node_widgets_registry["Widget Registry<br/>[widgets.py]"]
  node_query_params["Query Params<br/>State"]
  node_watcher["Path Watcher"]
end

subgraph group_protocol["Wire Protocol"]
  node_forward_msg["ForwardMsg<br/>Contract"]
  node_back_msg["BackMsg<br/>Contract"]
  node_delta_proto["Delta<br/>Contract"]
end

subgraph group_frontend["React Frontend"]
  node_app["App.tsx<br/>UI"]
  node_element_tree["Render Tree<br/>UI"]
  node_dataframes["Dataframe Layer<br/>UI"]
  node_components["Element Components<br/>UI"]
end

node_cli -->|"resolves entrypoint"| node_bootstrap
node_bootstrap -->|"reads options"| node_config
node_bootstrap -->|"starts"| node_server
node_server -->|"serves assets"| node_static_routes
node_server -->|"upgrade"| node_websocket
node_websocket -->|"routes messages"| node_runtime
node_runtime -->|"tracks sessions"| node_session_manager
node_session_manager -->|"creates"| node_app_session
node_app_session -->|"enqueues"| node_forward_msg_queue
node_forward_msg_queue -->|"flushes"| node_websocket
node_app_session -->|"caches messages"| node_forward_msg_cache
node_app_session -->|"requests runs"| node_script_runner
node_script_runner -->|"fetches bytecode"| node_script_cache
node_script_cache -->|"executes"| node_exec_code
node_exec_code -->|"script uses st"| node_delta_generator
node_magic -.->|"implicit st.write"| node_delta_generator
node_delta_generator -->|"emits Delta"| node_delta_proto
node_delta_proto -->|"wrapped in"| node_forward_msg
node_forward_msg -->|"queued"| node_forward_msg_queue
node_back_msg -->|"arrives on"| node_websocket
node_back_msg -->|"widget updates"| node_session_state
node_session_state -.->|"schedules rerun"| node_script_runner
node_fragment -.->|"partial runs"| node_script_runner
node_execution_control -->|"rerun and stop"| node_script_runner
node_watcher -.->|"file changed"| node_app_session
node_cache_data -->|"hashes inputs"| node_hashing
node_cache_resource -->|"hashes inputs"| node_hashing
node_app_session -->|"stores uploads"| node_uploaded_file_manager
node_app_session -->|"registers media"| node_media_file_manager
node_media_file_manager -->|"media URLs"| node_static_routes
node_delta_generator -->|"registers widgets"| node_widgets_registry
node_widgets_registry -->|"binds values"| node_session_state
node_query_params -.->|"URL sync"| node_websocket
node_forward_msg -->|"deltas arrive"| node_app
node_app -->|"widget events"| node_back_msg
node_app -->|"applies deltas"| node_element_tree
node_element_tree -->|"mounts elements"| node_components
node_element_tree -->|"renders grids"| node_dataframes


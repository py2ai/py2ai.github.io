flowchart TD

subgraph group_author["Author Surface"]
  node_user_script["Your Script<br/>Entry"]
  node_delta_generator["Delta Generator<br/>Core object"]
  node_elements["Elements and Widgets<br/>Element layer"]
end

subgraph group_python_runtime["Python Runtime"]
  node_runtime["Runtime<br/>Singleton"]
  node_app_session["App Session<br/>[app_session.py]"]
  node_script_runner["ScriptRunner<br/>Executor"]
  node_session_state["Session State<br/>[session_state.py]"]
  node_caching["Caching<br/>Memoization"]
end

subgraph group_protocol["Protocol"]
  node_protos["Protobuf Messages<br/>Contract"]
end

subgraph group_server["Server"]
  node_cli["CLI<br/>Entry"]
  node_websocket["Starlette Server<br/>Web layer"]
end

subgraph group_frontend["React Frontend"]
  node_frontend["React App<br/>UI"]
end

node_cli -->|"bootstraps"| node_runtime
node_cli -->|"starts server"| node_websocket
node_websocket -->|"attaches session"| node_app_session
node_runtime -->|"manages"| node_app_session
node_app_session -->|"executes script"| node_script_runner
node_app_session -->|"owns"| node_session_state
node_user_script -->|"calls st.*"| node_delta_generator
node_script_runner -->|"runs top to bottom"| node_user_script
node_delta_generator -->|"creates"| node_elements
node_elements -->|"serializes Delta"| node_protos
node_protos -->|"ForwardMsg out"| node_websocket
node_websocket -->|"pushes deltas"| node_frontend
node_frontend -->|"sends BackMsg"| node_protos
node_session_state -.->|"widget triggers rerun"| node_script_runner
node_user_script -.->|"memoizes work"| node_caching


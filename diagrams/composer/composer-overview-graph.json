    {"from": "engine", "to": "state", "label": "mutates"},
    {"from": "colout", "to": "algorithm", "label": "subclass"},
    {"from": "blurpool", "to": "algorithm", "label": "subclass"},
    {"from": "train_loop", "to": "ddp_sync", "label": "gradient sync"},

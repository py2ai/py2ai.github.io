    {"id": "engine", "label": "Engine", "file": "composer/core/engine.py", "path": "composer/core/engine.py", "group": "core", "groupId": "core", "desc": "Dispatches events to algorithms and callbacks"},
    {"id": "event", "label": "Event", "file": "composer/core/event.py", "path": "composer/core/event.py", "group": "core", "groupId": "core", "desc": "Enum of training life-cycle events"},
    {"id": "state", "label": "State", "file": "composer/core/state.py", "path": "composer/core/state.py", "group": "core", "groupId": "core", "desc": "Shared training state: model, optimizers, timers"},
    {"id": "algorithm", "label": "Algorithm", "file": "composer/core/algorithm.py", "path": "composer/core/algorithm.py", "group": "core", "groupId": "core", "desc": "Base class for event-triggered speedup methods"},
    {"id": "colout", "label": "ColOut", "file": "composer/algorithms/colout/colout.py", "path": "composer/algorithms/colout/colout.py", "group": "algorithms", "groupId": "algorithms", "desc": "Drops a fraction of rows and columns for speed"},
    {"id": "blurpool", "label": "BlurPool", "file": "composer/algorithms/blurpool/blurpool.py", "path": "composer/algorithms/blurpool/blurpool.py", "group": "algorithms", "groupId": "algorithms", "desc": "Blurs before downsampling to keep shift invariance"},
    {"id": "speed_monitor", "label": "SpeedMonitor", "file": "composer/callbacks/speed_monitor.py", "path": "composer/callbacks/speed_monitor.py", "group": "callbacks", "groupId": "callbacks", "desc": "Tracks throughput and wall-clock training time"},
    {"id": "logger", "label": "Logger", "file": "composer/loggers/logger.py", "path": "composer/loggers/logger.py", "group": "loggers", "groupId": "loggers", "desc": "Fan-out facade over logger destinations"},
    {"id": "ddp_sync", "label": "ddp_sync_context", "file": "composer/distributed/dist_strategy.py", "path": "composer/distributed/dist_strategy.py", "group": "distributed", "groupId": "distributed", "desc": "Controls gradient sync across microbatches"}

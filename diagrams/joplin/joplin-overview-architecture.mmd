end

subgraph group_core["Core Library &#40;packages/lib&#41;"]
  node_baseapp["BaseApplication<br/>Shared bootstrap"]
  node_models["Note / Folder / Resource<br/>Data models"]
  node_baseitem["BaseItem<br/>Syncable base"]
end

subgraph group_storage["SQLite Storage"]
  node_db[("SQLite Database<br/>JoplinDatabase")]
end

subgraph group_sync["Sync Layer"]
  node_synchronizer{{"Synchronizer<br/>Sync engine"}}
  node_synctargets["Sync Targets<br/>[BaseSyncTarget.ts]"]
end

subgraph group_renderer["Markdown Renderer"]
  node_mdtohtml["MdToHtml<br/>markdown-it wrapper"]
end

node_desktop -->|"extends"| node_baseapp

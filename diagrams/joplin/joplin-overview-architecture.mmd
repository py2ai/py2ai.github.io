node_baseitem -->|"SQL queries"| node_db
node_desktop -->|"renders note body"| node_mdtohtml
node_cli -->|"renders note body"| node_mdtohtml
node_mdtohtml -->|"resolves resources"| node_models
node_desktop -->|"background sync"| node_synchronizer
node_cli -->|"manual sync"| node_synchronizer
node_synchronizer -->|"read/write items"| node_db
node_synchronizer -->|"FileApi"| node_synctargets


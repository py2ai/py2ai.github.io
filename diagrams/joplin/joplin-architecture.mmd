flowchart TD

subgraph group_ui["Frontends"]
  node_desktop_app["Application &#40;desktop&#41;<br/>Electron main"]
  node_cli_app["Application &#40;CLI&#41;<br/>Terminal GUI"]
  node_mainscreen["MainScreenComponent<br/>React layout"]
  node_reduxp["reducer &#40;Redux&#41;<br/>immer produce"]
end

subgraph group_core["Core Library &#40;packages/lib&#41;"]
  node_baseapp["BaseApplication<br/>Shared bootstrap"]
  node_setting["Setting<br/>Config store"]
end

subgraph group_storage["SQLite Layer"]
  node_db[("JoplinDatabase<br/>Schema + queries")]
  node_driver["DatabaseDriverNode<br/>node:sqlite"]
  node_better_sqlite["DatabaseDriverBetterSqlite<br/>better-sqlite3"]
  node_note["Note<br/>Markdown body"]
  node_folder["Folder<br/>Notebook tree"]
  node_resource["Resource<br/>Attachments"]
  node_baseitem["BaseItem<br/>Serialization"]
  node_search["SearchEngine<br/>FTS4 index"]
end

subgraph group_sync["Sync Engine"]
  node_synchronizer{{"Synchronizer<br/>3-step loop"}}
  node_fileapi["FileApi<br/>Put/Get/List"]
  node_basetarget["BaseSyncTarget<br/>Target factory"]
  node_joplincloud["SyncTargetJoplinCloud<br/>Hosted"]
  node_onedrive["SyncTargetOneDrive<br/>Microsoft"]
  node_webdav["SyncTargetWebDAV<br/>Nextcloud etc."]
  node_filesystem["SyncTargetFilesystem<br/>Local dir"]
  node_e2ee["EncryptionService<br/>AES / RSA PPK"]
end

subgraph group_render["Markdown Rendering"]
  node_mdtohtml["MdToHtml<br/>markdown-it wrapper"]
  node_rule_fence["fence rule<br/>Code blocks"]
  node_rule_katex["katex rule<br/>Math"]
  node_rule_mermaid["mermaid rule<br/>Diagrams"]
end

subgraph group_plugins["Plugin Framework"]
  node_plugin_service["PluginService<br/>Loader"]
  node_plugin["Plugin<br/>Instance"]
  node_joplin_plugins["JoplinPlugins<br/>register&#40;onStart&#41;"]
  node_runner["PluginRunner<br/>Sandboxed iframe"]
end

subgraph group_server["Joplin Server"]
  node_server_app["Joplin Server<br/>Express app"]
end


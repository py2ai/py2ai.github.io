    {"id": "nnx_rnglib", "label": "Rngs", "file": "flax/nnx/rnglib.py", "path": "flax/nnx/rnglib.py", "group": "nnx_core", "groupId": "nnx_core", "desc": "Named RNG key streams folded into module state"},

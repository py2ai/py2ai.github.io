  node_node_bridge["contextBridge re-export<br/>[context-bridge.ts]"]
end

subgraph group_native["Native C++ Layer"]
  node_node_nipcr["Native emitter &#40;renderer&#41;"]
  node_node_handler["Frame handler &#40;browser&#41;"]
  node_node_dispatchcc["Dispatch to ipcMain JS"]
end

subgraph group_transport["IPC Transport"]
  node_node_mojom["ElectronApiIPC contract<br/>[api.mojom]"]
end

node_node_main_init -->|"exposes API modules"| node_node_modlist
node_node_main_init -->|"wires renderer IPC to ipcMain"| node_node_ipcmain
node_node_main_init -->|"preloads webContents"| node_node_wc
node_node_rinit -->|"pulls internal ipc"| node_node_ipcr
node_node_rinit -->|"exposes contextBridge"| node_node_bridge
node_node_ipcr -->|"backed by linked binding"| node_node_nipcr
node_node_nipcr -->|"sends over mojo channel"| node_node_mojom
node_node_mojom -->|"receiver bound per frame"| node_node_handler
node_node_handler -->|"forwards to JS dispatch"| node_node_dispatchcc
node_node_dispatchcc -->|"emits channel events"| node_node_ipcmain
node_node_dispatchcc -->|"answers via event.sender"| node_node_wc
node_node_win -->|"wraps webContents"| node_node_wc


    {"from": "gemma", "to": "kv_cache", "label": "allocate", "style": "solid"},
    {"from": "gemma", "to": "matmul", "label": "MatMulEnv", "style": "solid"},
    {"from": "forward", "to": "attention", "label": "per layer", "style": "solid"},
    {"from": "attention", "to": "kv_cache", "label": "read/write K,V", "style": "solid"},
    {"from": "attention", "to": "matmul", "label": "QKV GEMMs", "style": "solid"},
    {"from": "attention", "to": "dot", "label": "score dots", "style": "solid"},
    {"from": "weights", "to": "configs", "label": "shapes", "style": "solid"},
    {"from": "weights", "to": "model_store", "label": "named tensors", "style": "solid"},
    {"from": "model_store", "to": "blob_store", "label": "BlobReader", "style": "solid"},

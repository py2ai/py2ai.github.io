  node_finishanalysis["FinishAnalysis"]
end

subgraph group_g3["Physical Execution"]
  node_qe["QueryExecution"]
  node_strategies["JoinSelection"]
  node_adaptive["AdaptiveSparkPlanExec"]
  node_wscg["WholeStageCodegenExec"]
  node_shuffle["ShuffleExchangeExec"]
  node_smj["SortMergeJoinExec"]
end

subgraph group_g4["Core Engine"]
  node_context["SparkContext<br/>[SparkContext.scala]"]
  node_rdd["RDD<br/>[RDD.scala]"]
end

subgraph group_g5["Scheduling"]
  node_dagsched["DAGScheduler<br/>[DAGScheduler.scala]"]
  node_tasksched["TaskSchedulerImpl"]
  node_resulttask["ResultTask<br/>[ResultTask.scala]"]
  node_shufflemaptask["ShuffleMapTask"]
end

subgraph group_g6["Runtime &amp; Storage"]
  node_executor["Executor<br/>[Executor.scala]"]
  node_blockmgr["BlockManager<br/>[BlockManager.scala]"]
  node_memmgr["UnifiedMemoryManager"]
end

subgraph group_g7["Micro-batch Streaming"]
  node_ssc["StreamingContext"]
  node_dstream["DStream<br/>[DStream.scala]"]

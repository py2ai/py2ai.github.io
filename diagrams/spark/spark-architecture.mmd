  node_jobgen["JobGenerator<br/>[JobGenerator.scala]"]
end

node_dataset -->|"created by"| node_session
node_session -->|"plans queries"| node_qe
node_qe -->|"analyze phase"| node_analyzer
node_analyzer -->|"resolved plan"| node_optimizer
node_qe -->|"optimize phase"| node_optimizer
node_optimizer -->|"final batch"| node_finishanalysis
node_qe -->|"sparkPlan"| node_strategies
node_qe -->|"executedPlan"| node_adaptive
node_adaptive -->|"re-plans exchanges"| node_shuffle
node_adaptive -->|"codegen stages"| node_wscg
node_wscg -->|"fuses operators"| node_smj
node_smj -->|"reads shuffle input"| node_shuffle
node_strategies -->|"picks join"| node_smj
node_adaptive -->|"runs RDD jobs"| node_context
node_context -->|"creates RDDs"| node_rdd
node_rdd -->|"actions call runJob"| node_context
node_context -->|"runJob"| node_dagsched
node_dagsched -->|"final stage"| node_resulttask
node_dagsched -->|"map stages"| node_shufflemaptask
node_dagsched -->|"submits task sets"| node_tasksched
node_tasksched -->|"resourceOffers"| node_executor
node_executor -->|"fetches blocks"| node_blockmgr
node_executor -->|"acquires memory"| node_memmgr
node_blockmgr -->|"storage pool"| node_memmgr
node_shufflemaptask -->|"writes map output"| node_blockmgr
node_rdd -->|"caches partitions"| node_blockmgr
node_ssc -->|"input streams"| node_dstream
node_ssc -->|"start&#40;&#41;"| node_jobsched
node_dstream -->|"output ops"| node_foreachdstream
node_foreachdstream -->|"generateJob"| node_jobsched
node_jobgen -->|"interval ticks"| node_jobsched
node_jobgen -->|"generateJobs"| node_dstream
node_jobsched -->|"runs each batch"| node_context


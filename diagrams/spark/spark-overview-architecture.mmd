node_dataset -->|"DataFrame ops"| node_session
node_session -->|"plans each query"| node_qe
node_qe -->|"resolve references"| node_analyzer
node_qe -->|"rule-based rewrite"| node_optimizer
node_qe -->|"executedPlan"| node_adaptive
node_adaptive -->|"runs RDD jobs"| node_context
node_context -->|"runJob"| node_dagsched
node_dagsched -->|"submitMissingTasks"| node_tasksched
node_tasksched -->|"launchTask"| node_executor
node_ssc -->|"wraps SparkContext"| node_context
node_ssc -->|"starts micro-batches"| node_jobsched
node_jobsched -->|"submits batch jobs"| node_dagsched


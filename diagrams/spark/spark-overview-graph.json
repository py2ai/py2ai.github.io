{
  "owner": "apache",
  "repo": "spark",
  "branch": "master",
  "groups": [
    {"id": "g1", "name": "api", "label": "API Layer"},
    {"id": "g2", "name": "catalyst", "label": "Catalyst Optimizer"},
    {"id": "g3", "name": "execution", "label": "Physical Execution"},
    {"id": "g4", "name": "core", "label": "Core Engine"},
    {"id": "g5", "name": "scheduler", "label": "Scheduling"},
    {"id": "g6", "name": "cluster", "label": "Cluster Runtime"},
    {"id": "g7", "name": "streaming", "label": "Streaming"}
  ],
  "nodes": [
    {"id": "session", "label": "SparkSession", "file": "SparkSession", "path": "sql/api/src/main/scala/org/apache/spark/sql/SparkSession.scala", "group": "api", "groupId": "g1", "desc": "Entry point that exposes SQL and DataFrame APIs over a cluster."},
    {"id": "dataset", "label": "Dataset", "file": "Dataset", "path": "sql/api/src/main/scala/org/apache/spark/sql/Dataset.scala", "group": "api", "groupId": "g1", "desc": "Lazily transformed typed collection whose ops build logical plans."},
    {"id": "analyzer", "label": "Analyzer", "file": "Analyzer", "path": "sql/catalyst/src/main/scala/org/apache/spark/sql/catalyst/analysis/Analyzer.scala", "group": "catalyst", "groupId": "g2", "desc": "Resolves relations and expressions in the unresolved logical plan."},
    {"id": "optimizer", "label": "Optimizer", "file": "Optimizer", "path": "sql/catalyst/src/main/scala/org/apache/spark/sql/catalyst/optimizer/Optimizer.scala", "group": "catalyst", "groupId": "g2", "desc": "Rewrites the resolved plan with rule batches like predicate pushdown."},
    {"id": "qe", "label": "QueryExecution", "file": "QueryExecution", "path": "sql/core/src/main/scala/org/apache/spark/sql/execution/QueryExecution.scala", "group": "execution", "groupId": "g3", "desc": "Drives each query from analysis through optimization to execution."},
    {"id": "adaptive", "label": "AdaptiveSparkPlanExec", "file": "AdaptiveSparkPlanExec", "path": "sql/core/src/main/scala/org/apache/spark/sql/execution/adaptive/AdaptiveSparkPlanExec.scala", "group": "execution", "groupId": "g3", "desc": "Re-plans the physical plan at runtime as shuffle statistics arrive."},
    {"id": "context", "label": "SparkContext", "file": "SparkContext", "path": "core/src/main/scala/org/apache/spark/SparkContext.scala", "group": "core", "groupId": "g4", "desc": "Cluster connection that runs RDD jobs on behalf of the session."},
    {"id": "dagsched", "label": "DAGScheduler", "file": "DAGScheduler", "path": "core/src/main/scala/org/apache/spark/scheduler/DAGScheduler.scala", "group": "scheduler", "groupId": "g5", "desc": "Splits RDD lineage into shuffle stages and tracks their output."},
    {"id": "tasksched", "label": "TaskSchedulerImpl", "file": "TaskSchedulerImpl", "path": "core/src/main/scala/org/apache/spark/scheduler/TaskSchedulerImpl.scala", "group": "scheduler", "groupId": "g5", "desc": "Matches pending tasks to offered executor resources."},
    {"id": "executor", "label": "Executor", "file": "Executor", "path": "core/src/main/scala/org/apache/spark/executor/Executor.scala", "group": "cluster", "groupId": "g6", "desc": "Worker-side process that launches and runs tasks on partitions."},
    {"id": "ssc", "label": "StreamingContext", "file": "StreamingContext", "path": "streaming/src/main/scala/org/apache/spark/streaming/StreamingContext.scala", "group": "streaming", "groupId": "g7", "desc": "Wraps a SparkContext and starts the micro-batch scheduler."},
    {"id": "jobsched", "label": "JobScheduler", "file": "JobScheduler", "path": "streaming/src/main/scala/org/apache/spark/streaming/scheduler/JobScheduler.scala", "group": "streaming", "groupId": "g7", "desc": "Submits each generated batch interval as a Spark job."}
  ],
  "edges": [
    {"from": "dataset", "to": "session", "label": "DataFrame ops"},
    {"from": "session", "to": "qe", "label": "plans each query"},
    {"from": "qe", "to": "analyzer", "label": "resolve references"},
    {"from": "qe", "to": "optimizer", "label": "rule-based rewrite"},
    {"from": "qe", "to": "adaptive", "label": "executedPlan"},
    {"from": "adaptive", "to": "context", "label": "runs RDD jobs"},
    {"from": "context", "to": "dagsched", "label": "runJob"},
    {"from": "dagsched", "to": "tasksched", "label": "submitMissingTasks"},
    {"from": "tasksched", "to": "executor", "label": "launchTask"},
    {"from": "ssc", "to": "context", "label": "wraps SparkContext"},
    {"from": "ssc", "to": "jobsched", "label": "starts micro-batches"},
    {"from": "jobsched", "to": "dagsched", "label": "submits batch jobs"}
  ]
}

    { "id": "filters", "label": "RegexFilter", "file": "extraction.py", "path": "lm_eval/filters/extraction.py", "group": "g6", "groupId": "g6", "desc": "Extracts the answer out of raw generated text" },
    { "id": "metrics", "label": "Metrics", "file": "metrics.py", "path": "lm_eval/api/metrics.py", "group": "g6", "groupId": "g6", "desc": "Registered metric fns and aggregations like mean and exact_match" }

node_config -->|"new Game&#40;config&#41;"| node_game
node_game -->|"DOM ready"| node_game_boot
node_game_boot -->|"AUTO to WebGL or Canvas"| node_create_renderer
node_game_boot -->|"textures READY event"| node_game_start
node_game_start -->|"loop.start&#40;step&#41;"| node_timestep
node_timestep -->|"rAF or setTimeout tick"| node_timestep_step
node_timestep_step -->|"callback&#40;time, delta&#41;"| node_game_step
node_game_step -->|"PRE_STEP updates managers"| node_input_manager
node_game_step -->|"scene.update&#40;time, delta&#41;"| node_sm_update
node_game_step -->|"scene.render&#40;renderer&#41;"| node_sm_render
node_sm_update -->|"reverse order, status RUNNING"| node_sys_step
node_sys_step -->|"PRE_UPDATE fires GameObject.preUpdate"| node_update_list
node_sys_step -->|"SceneEvents.UPDATE to world.update"| node_arcade
node_update_list -->|"sprites carry physics bodies"| node_body_preupdate
node_body_preupdate -->|"updateFromGameObject + integrate"| node_body
node_arcade -->|"world.update gates fixed step"| node_world
node_world -->|"when elapsed &gt;= frame time"| node_world_step
node_world_step -->|"body.update&#40;delta&#41; applies velocity"| node_body
node_body -->|"postUpdate writes positions back"| node_body_preupdate
node_sm_render -->|"forward order, visible only"| node_sys_render
node_sys_render -->|"sort children by depth"| node_depth_sort
node_depth_sort -->|"reorders the live list"| node_displaylist
node_sys_render -->|"cameras.render&#40;renderer, displayList&#41;"| node_camera_manager
node_camera_manager -->|"render&#40;scene, children, camera&#41;"| node_webgl_renderer
node_camera_manager -->|"same contract on 2D context"| node_canvas_renderer
node_transform -->|"getLocalTransformMatrix"| node_transform_matrix
node_transform_matrix -->|"matrices feed draw calls"| node_webgl_renderer
node_scene -->|"Scene.sys plugin bundle"| node_systems
node_bootscene -->|"loader COMPLETE or no preload"| node_scene_create
node_scene_create -->|"status RUNNING unlocks update"| node_sys_step
node_input_manager -->|"pointers dispatched per scene"| node_input_plugins


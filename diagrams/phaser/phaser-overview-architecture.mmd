node_config -->|"new Game&#40;config&#41;"| node_game
node_game -->|"Game.start wires the loop"| node_timestep
node_timestep -->|"smoothed delta each tick"| node_gamestep
node_gamestep -->|"PRE_STEP updates managers"| node_inputmanager
node_gamestep -->|"scene.update + scene.render"| node_scenemanager
node_scenemanager -->|"bootScene: init, preload, create"| node_scene
node_scene -->|"Scene.sys plugin bundle"| node_systems
node_systems -->|"depthSort before render"| node_displaylist
node_systems -->|"cameras render display list"| node_renderer
node_systems -->|"SceneEvents.UPDATE drives physics"| node_world
node_world -->|"postUpdate syncs body positions"| node_displaylist
node_displaylist -->|"children drawn per camera"| node_renderer
node_renderer -->|"same contract, Canvas fallback"| node_canvasrenderer


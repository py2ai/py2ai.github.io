{
  "owner": "phaserjs",
  "repo": "phaser",
  "branch": "master",
  "groups": [
    { "id": "boot", "name": "Boot", "label": "Boot" },
    { "id": "loop", "name": "Frame Loop", "label": "Frame Loop" },
    { "id": "scenes", "name": "Scenes", "label": "Scenes" },
    { "id": "objects", "name": "Game Objects", "label": "Game Objects" },
    { "id": "render", "name": "Renderers", "label": "Renderers" },
    { "id": "physics", "name": "Physics", "label": "Physics" },
    { "id": "input", "name": "Input", "label": "Input" }
  ],
  "nodes": [
    {
      "id": "config",
      "label": "Game Config",
      "file": "Config.js",
      "path": "src/core/Config.js",
      "group": "Boot",
      "groupId": "boot",
      "desc": "Resolves defaults for width, renderer type, scene list and callbacks."
    },
    {
      "id": "game",
      "label": "Phaser.Game",
      "file": "Game.js",
      "path": "src/core/Game.js",
      "group": "Boot",
      "groupId": "boot",
      "desc": "Root instance: owns config, renderer, loop and the SceneManager; boot() creates the renderer, start() begins the loop."
    },
    {
      "id": "timestep",
      "label": "TimeStep",
      "file": "TimeStep.js",
      "path": "src/core/TimeStep.js",
      "group": "Frame Loop",
      "groupId": "loop",
      "desc": "rAF/setTimeout runner that computes a smoothed delta and invokes Game.step each frame."
    },
    {
      "id": "gamestep",
      "label": "Game.step",
      "file": "Game.js",
      "path": "src/core/Game.js",
      "group": "Frame Loop",
      "groupId": "loop",
      "desc": "One frame: PRE_STEP, user STEP, scene.update, POST_STEP, preRender, scene.render, postRender."
    },
    {
      "id": "scenemanager",
      "label": "SceneManager",
      "file": "SceneManager.js",
      "path": "src/scene/SceneManager.js",
      "group": "Scenes",
      "groupId": "scenes",
      "desc": "Queues, boots and runs scenes; updates in reverse order, renders in forward order."
    },
    {
      "id": "scene",
      "label": "Scene",
      "file": "Scene.js",
      "path": "src/scene/Scene.js",
      "group": "Scenes",
      "groupId": "scenes",
      "desc": "User-facing unit with init/preload/create/update hooks; each gets a Scene.sys bundle."
    },
    {
      "id": "systems",
      "label": "Scene Systems",
      "file": "Systems.js",
      "path": "src/scene/Systems.js",
      "group": "Scenes",
      "groupId": "scenes",
      "desc": "Per-scene plugin host: installs Loader, Add, Cameras, Input, Physics, then steps and renders the scene."
    },
    {
      "id": "displaylist",
      "label": "DisplayList",
      "file": "DisplayList.js",
      "path": "src/gameobjects/DisplayList.js",
      "group": "Game Objects",
      "groupId": "objects",
      "desc": "Ordered list of live Game Objects; depthSort() reorders it before each render."
    },
    {
      "id": "renderer",
      "label": "WebGLRenderer",
      "file": "WebGLRenderer.js",
      "path": "src/renderer/webgl/WebGLRenderer.js",
      "group": "Renderers",
      "groupId": "render",
      "desc": "GPU pipeline: preRender clears, render walks scene children per camera, postRender flushes and snapshots."
    },
    {
      "id": "canvasrenderer",
      "label": "CanvasRenderer",
      "file": "CanvasRenderer.js",
      "path": "src/renderer/canvas/CanvasRenderer.js",
      "group": "Renderers",
      "groupId": "render",
      "desc": "2D-context fallback sharing the same render contract as the WebGL path."
    },
    {
      "id": "world",
      "label": "Arcade World",
      "file": "World.js",
      "path": "src/physics/arcade/World.js",
      "group": "Physics",
      "groupId": "physics",
      "desc": "Steps all enabled bodies, rebuilds the collision tree, then runs collider pairs."
    },
    {
      "id": "inputmanager",
      "label": "InputManager",
      "file": "InputManager.js",
      "path": "src/input/InputManager.js",
      "group": "Input",
      "groupId": "input",
      "desc": "Global DOM event capture that tracks pointers and forwards them to per-scene InputPlugins."
    }
  ],
  "edges": [
    { "from": "config", "to": "game", "label": "new Game(config)" },
    { "from": "game", "to": "timestep", "label": "Game.start wires the loop" },
    { "from": "timestep", "to": "gamestep", "label": "smoothed delta each tick" },
    { "from": "gamestep", "to": "inputmanager", "label": "PRE_STEP updates managers" },
    { "from": "gamestep", "to": "scenemanager", "label": "scene.update + scene.render" },
    { "from": "scenemanager", "to": "scene", "label": "bootScene: init, preload, create" },
    { "from": "scene", "to": "systems", "label": "Scene.sys plugin bundle" },
    { "from": "systems", "to": "displaylist", "label": "depthSort before render" },
    { "from": "systems", "to": "renderer", "label": "cameras render display list" },
    { "from": "systems", "to": "world", "label": "SceneEvents.UPDATE drives physics" },
    { "from": "world", "to": "displaylist", "label": "postUpdate syncs body positions" },
    { "from": "displaylist", "to": "renderer", "label": "children drawn per camera" },
    { "from": "renderer", "to": "canvasrenderer", "label": "same contract, Canvas fallback" }
  ]
}

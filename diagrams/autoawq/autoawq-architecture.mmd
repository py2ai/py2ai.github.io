node_entry_auto -->|"instantiates"| node_base_model
node_entry_auto -->|"carries"| node_awq_config
node_base_model -->|"reads settings from"| node_awq_config
node_llama_model -->|"extends"| node_base_model
node_mpt_model -->|"extends"| node_base_model
node_base_model -->|"wraps activations with"| node_act_module
node_base_model -->|"delegates calibration to"| node_quantizer
node_base_model -->|"rebuilds linears as"| node_wq_gemm
node_quantizer -->|"streams samples from"| node_calib_data
node_quantizer -->|"scans linears with"| node_module_utils
node_quantizer -->|"applies"| node_scale_helpers
node_quantizer -->|"packs into &#40;gemm&#41;"| node_wq_gemm
node_quantizer -->|"packs into &#40;gemv&#41;"| node_wq_gemv
node_quantizer -->|"packs into &#40;gemv_fast&#41;"| node_wq_gemv_fast
node_quantizer -->|"packs into &#40;marlin&#41;"| node_wq_marlin
node_quantizer -->|"frees memory via"| node_general_utils
node_wq_gemm -->|"falls back to"| node_triton_gemm
node_wq_gemm -->|"repacks via"| node_packing_utils
node_llama_model -->|"fuse_layers swaps in"| node_fused_model
node_llama_model -->|"merges qkv with"| node_fused_utils
node_fused_model -->|"stacks"| node_fused_block
node_fused_block -->|"contains"| node_fused_attn
node_fused_block -->|"contains"| node_fused_mlp
node_fused_block -->|"normalizes with"| node_fused_norm
node_fused_attn -->|"shapes caches via"| node_fused_utils
node_fused_model -->|"prepares inputs via"| node_fused_utils
node_example_quantize -->|"calls"| node_entry_auto
node_example_cli -->|"calls"| node_entry_auto
node_wq_marlin -->|"repacks via"| node_packing_utils


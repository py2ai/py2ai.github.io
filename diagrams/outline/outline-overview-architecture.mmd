node_hocuspocus_server -->|"extension chain"| node_persistence_ext
node_persistence_ext -->|"Y.Doc state in/out"| node_postgres
node_persistence_ext -->|"collaborator zsets"| node_redis
node_hocuspocus_server -->|"multiplayer pub/sub"| node_redis
node_react_client -->|"REST /api"| node_koa_api
node_koa_api -->|"documents.* endpoints"| node_document_model
node_document_model -->|"content JSONB + state BLOB"| node_postgres
node_document_model -->|"events after commit"| node_bull_queues
node_document_model -->|"notifyCollaborationServer"| node_hocuspocus_server
node_bull_queues -->|"jobs"| node_worker
node_worker -->|"revisions, backlinks, text index"| node_postgres
node_worker -->|"websocket fan-out"| node_redis


node_main -->|"dispatch argv"| node_cli_start
node_cli_start -->|"bun run &lt;file&gt;"| node_run_boot
node_run_boot -->|"boot"| node_vm_init
node_vm_init -->|"returns *mut VirtualMachine"| node_vm_struct
node_run_boot -->|"Run &#123; ctx, vm &#125;"| node_run_start
node_run_start -->|"loadEntryPoint"| node_load_entry
node_load_entry -->|"JSC loadAndEvaluateModule"| node_cpp_loader
node_cpp_loader -->|"unseen file → Rust hook"| node_transpile_hook
node_transpile_hook -->|"Transpiler::parse"| node_transpiler
node_transpiler -->|"print → ResolvedSource"| node_transpile_hook
node_run_start -->|"while is_event_loop_alive: tick"| node_event_loop
node_event_loop -->|"drain microtasks, tasks"| node_vm_struct
node_vm_struct -->|"Bun.FFI globals"| node_ffi
node_ffi -->|"callback tasks re-enter JS"| node_event_loop


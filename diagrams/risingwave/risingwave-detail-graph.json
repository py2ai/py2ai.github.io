    { "id": "output", "label": "Output", "file": "output.rs", "path": "src/stream/src/executor/exchange/output.rs", "group": "exchange", "groupId": "exchange", "desc": "Send side toward local or remote downstream actors" },
    { "id": "local_hummock", "label": "LocalHummockStorage", "file": "local_hummock_storage.rs", "path": "src/storage/src/hummock/store/local_hummock_storage.rs", "group": "hummock", "groupId": "hummock", "desc": "Implements StateStore with a write buffer and caches" },
    { "id": "hummock_storage", "label": "HummockStorage", "file": "hummock_storage.rs", "path": "src/storage/src/hummock/store/hummock_storage.rs", "group": "hummock", "groupId": "hummock", "desc": "Shared instance serving batch queries at chosen epochs" },
    { "id": "shared_buffer_batch", "label": "SharedBufferBatch", "file": "shared_buffer_batch.rs", "path": "src/storage/src/hummock/shared_buffer/shared_buffer_batch.rs", "group": "hummock", "groupId": "hummock", "desc": "Recent unflushed writes readable before upload" },
    { "id": "event_handler", "label": "HummockEventSender", "file": "hummock_event_handler.rs", "path": "src/storage/src/hummock/event_handler/hummock_event_handler.rs", "group": "hummock", "groupId": "hummock", "desc": "Channels storage events to flush and upload tasks" },
    { "id": "sstable_builder", "label": "SstableBuilder", "file": "builder.rs", "path": "src/storage/src/hummock/sstable/builder.rs", "group": "hummock", "groupId": "hummock", "desc": "Encodes sorted key-value blocks with filters and bloom" },
    { "id": "sstable_store", "label": "SstableStore", "file": "sstable_store.rs", "path": "src/storage/src/hummock/sstable_store.rs", "group": "hummock", "groupId": "hummock", "desc": "Reads and writes SSTable files on object storage" },
    { "id": "merge_iterator", "label": "MergeIterator", "file": "merge_inner.rs", "path": "src/storage/src/hummock/iterator/merge_inner.rs", "group": "hummock", "groupId": "hummock", "desc": "K-way merge across memtable and SSTable levels" },
    { "id": "hummock_version", "label": "HummockVersion", "file": "version.rs", "path": "src/storage/hummock_sdk/src/version.rs", "group": "hummock", "groupId": "hummock", "desc": "Snapshot of the SSTable levels visible at an epoch" },

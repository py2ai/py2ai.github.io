    { "id": "execute_trait", "label": "Execute", "file": "mod.rs", "path": "src/stream/src/executor/mod.rs", "group": "dag", "groupId": "dag", "desc": "Trait every executor implements to produce message streams" },
    { "id": "barrier_type", "label": "Barrier", "file": "mod.rs", "path": "src/stream/src/executor/mod.rs", "group": "dag", "groupId": "dag", "desc": "Control message carrying epoch plus optional mutation" },

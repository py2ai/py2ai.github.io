{
  "owner": "risingwavelabs",
  "repo": "risingwave",
  "branch": "main",
  "groups": [
    { "id": "control", "name": "Meta control plane", "label": "Meta control plane" },
    { "id": "runtime", "name": "Compute runtime", "label": "Compute runtime" },
    { "id": "dag", "name": "Streaming DAG", "label": "Streaming DAG" },
    { "id": "exchange", "name": "Actor exchange", "label": "Actor exchange" },
    { "id": "hummock", "name": "Hummock state store", "label": "Hummock state store" }
  ],
  "nodes": [
    { "id": "meta_serve", "label": "rpc_serve", "file": "server.rs", "path": "src/meta/node/src/server.rs", "group": "control", "groupId": "control", "desc": "Wires up every meta gRPC service and election callbacks" },
    { "id": "ddl_controller", "label": "DdlController", "file": "ddl_controller.rs", "path": "src/meta/src/rpc/ddl_controller.rs", "group": "control", "groupId": "control", "desc": "Runs DDL workflows: create, replace, drop streaming jobs" },
    { "id": "actor_graph_builder", "label": "ActorGraphBuilder", "file": "actor.rs", "path": "src/meta/src/stream/stream_graph/actor.rs", "group": "control", "groupId": "control", "desc": "Turns a stream plan into per-actor graphs with dispatchers" },
    { "id": "global_stream_manager", "label": "GlobalStreamManager", "file": "stream_manager.rs", "path": "src/meta/src/stream/stream_manager.rs", "group": "control", "groupId": "control", "desc": "Broadcasts fragments to compute nodes and tracks jobs" },
    { "id": "global_barrier_manager", "label": "GlobalBarrierManager", "file": "manager.rs", "path": "src/meta/src/barrier/manager.rs", "group": "control", "groupId": "control", "desc": "Sends barrier commands, collects completion from actors" },

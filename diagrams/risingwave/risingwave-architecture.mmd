node_global_stream_manager -->|"broadcast fragments"| node_local_stream_manager
node_barrier_worker -->|"barrier RPC"| node_local_barrier_manager
node_local_barrier_manager -->|"dispatch barriers"| node_local_stream_manager
node_local_stream_manager -->|"spawn actors"| node_actor
node_actor -->|"runs chain"| node_execute_trait
node_execute_trait -->|"control flow"| node_barrier_type
node_local_barrier_manager -->|"injects"| node_barrier_type
node_source_executor -->|"source input"| node_actor
node_hash_agg -->|"agg state"| node_state_table
node_hash_join -->|"join state"| node_state_table
node_materialize -->|"write MV rows"| node_state_table
node_dispatch -->|"fan out"| node_output
node_output -->|"gRPC exchange"| node_remote_input
node_output -->|"same node"| node_local_input
node_remote_input -->|"upstream chunks"| node_actor
node_state_table -->|"read / write"| node_local_hummock
node_local_hummock -->|"recent writes"| node_shared_buffer_batch
node_local_hummock -->|"flush events"| node_event_handler
node_event_handler -->|"encode"| node_sstable_builder
node_sstable_builder -->|"upload SST"| node_sstable_store
node_local_hummock -->|"scan / get"| node_merge_iterator
node_merge_iterator -->|"read blocks"| node_sstable_store
node_hummock_storage -->|"batch reads"| node_sstable_store
node_local_hummock -->|"pin epoch"| node_hummock_version
node_event_handler -->|"commit epoch"| node_hummock_manager
node_compactor_manager -->|"run task"| node_compactor_runner
node_compactor_runner -->|"rewrite levels"| node_sstable_builder


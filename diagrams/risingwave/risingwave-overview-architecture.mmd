node_compute_serve -->|"gRPC client"| node_meta_serve
node_ddl_controller -->|"create MV / sink"| node_global_stream_manager
node_ddl_controller -->|"register tables"| node_hummock_manager
node_compute_serve -->|"starts"| node_local_stream_manager
node_compute_serve -->|"starts"| node_local_barrier_manager
node_global_stream_manager -->|"deploys fragments"| node_local_stream_manager
node_local_stream_manager -->|"spawns"| node_actor
node_global_barrier_manager -->|"flush barriers"| node_local_barrier_manager
node_local_barrier_manager -->|"epoch alignment"| node_actor
node_source_executor -->|"yields chunks"| node_actor
node_actor -->|"state table IO"| node_local_hummock
node_local_hummock -->|"pin / commit"| node_hummock_manager
node_local_barrier_manager -->|"seal memtables"| node_local_hummock
node_hummock_manager -->|"compaction tasks"| node_compactor_runner

